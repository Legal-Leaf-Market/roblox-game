          <string name="Name">Animations</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Animations
-- Every animation the game plays, by slot name. NO invented asset ids:
-- each slot ships as REPLACE_ME until a real animation is uploaded, and
-- the loader (client Modules/AnimUtil) silently skips placeholders, so
-- the game is fully playable before any animation exists.
--
-- To wire one up: upload the animation to the game's group/owner account,
-- then paste its id in place of REPLACE_ME (keep the rbxassetid:// prefix).
--
-- Recommended priorities: Action for attacks/casts, Movement for run and
-- dodge, Idle for meditation idle.

local REPLACE_ME = "rbxassetid://REPLACE_ME"

local Animations = {
	-- Movement
	run = REPLACE_ME, -- looped, forward-leaning cultivator run
	sprint = REPLACE_ME, -- looped, faster martial sprint
	dodge = REPLACE_ME, -- short directional burst

	-- Meditation
	meditateEnter = REPLACE_ME, -- settle into a cross-legged seat
	meditateIdle = REPLACE_ME, -- looped seated breathing
	meditateExit = REPLACE_ME, -- rise from the seat

	-- Unarmed / sword combat
	lightAttack1 = REPLACE_ME,
	lightAttack2 = REPLACE_ME,
	lightAttack3 = REPLACE_ME, -- the finisher swing
	heavyAttack = REPLACE_ME, -- long windup, big follow-through
	block = REPLACE_ME, -- looped guard pose
	hitReact = REPLACE_ME, -- flinch on taking damage

	-- Techniques & cultivation
	castTechnique = REPLACE_ME, -- generic one-hand seal + palm push
	breakthrough = REPLACE_ME, -- arms wide, qi eruption
	auraRelease = REPLACE_ME, -- stance for releasing pressure
}

return table.freeze(Animations)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Config
-- Every tunable number with game-wide reach. One place to balance from.

local Config = {
	GAME_NAME = "Heavenpillar",

	-- ------------------------------ Cultivation ------------------------------
	QI_TICK_SECONDS = 1, -- cadence of the qi/cultivation heartbeat
	MEDITATE_REGEN_MULT = 4, -- qi regen multiplier while meditating
	MEDITATE_XP_MULT = 1, -- meditation cultivation gain (deliberately modest:
	-- fighting, training and questing must beat sitting)
	TRAINING_XP_PER_HIT = 2, -- striking a training dummy
	COMBAT_XP_PER_DAMAGE = 0.25, -- cultivation xp per point of damage dealt to
	-- a real enemy (not dummies)
	KILL_XP_MULT = 1.5, -- kill bonus: victim stage * this

	-- ------------------------------- Movement --------------------------------
	BASE_WALKSPEED = 16,
	SPRINT_MULT = 1.9,
	SPRINT_DRAIN = 16, -- stamina/second
	STAMINA_MAX = 100,
	STAMINA_REGEN = 18,
	DODGE_COOLDOWN = 1.6,
	DODGE_WINDOW = 0.3, -- seconds of evasion after a dodge
	DODGE_SPEED = 95,

	-- -------------------------------- Combat ---------------------------------
	LIGHT_COOLDOWN = 0.38, -- seconds between light swings
	LIGHT_CHAIN_WINDOW = 1.3, -- combo resets if idle longer than this
	HEAVY_COOLDOWN = 2.4,
	HEAVY_MULT = 2.1, -- heavy damage vs light
	FINISHER_MULT = 1.45, -- third light hit
	BLOCK_REDUCTION_LIGHT = 0.6, -- fraction of light damage a block absorbs
	BLOCK_REDUCTION_HEAVY = 0.3, -- heavies punish turtling
	MELEE_RANGE = 9, -- reach of an unarmed/sword swing hitbox
	STUN_ON_FINISHER = 0.5,

	-- ------------------------------ Techniques -------------------------------
	MAX_TECHNIQUES = 12, -- designs a cultivator can hold
	SLOT_COUNT = 6, -- hotbar keys 1-6
	MAX_TECHNIQUE_NAME = 28,
	MAX_COMPONENTS = 4, -- components chained into one technique
	MASTERY_MAX = 100, -- mastery is 0..100%
	INHERITANCE_MULTIPLIER = 0.7, -- passed-down techniques operate at 70%

	-- ----------------------------- Master/Disciple ---------------------------
	MAX_DISCIPLES = 5,

	-- -------------------------------- Economy --------------------------------
	STARTING_SPIRIT_STONES = 15,

	-- --------------------------------- Data ----------------------------------
	AUTOSAVE_SECONDS = 120,
}

return table.freeze(Config)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Items
-- The item catalog. Stackable items live in PlayerData.items by id;
-- technique manuals are unique and live in PlayerData.manuals. Weapon
-- stats stay deliberately modest: cultivation, not gear, is the main
-- source of power in this game.

export type ItemDef = {
	id: string,
	name: string,
	kind: string, -- "weapon" | "herb" | "pill" | "material"
	blurb: string,
	rarity: string, -- "common" | "fine" | "rare" | "precious"

	-- Weapons
	weaponCategory: string?, -- "sword" (sabers, spears, bows arrive later)
	damageMult: number?, -- multiplies melee/technique damage
	qiConductivity: number?, -- multiplies qi technique damage specifically
	stageReq: number?,

	-- Pills
	restoreQiFrac: number?, -- fraction of max qi restored on use
	healFrac: number?,
}

local function item(def: ItemDef): ItemDef
	return table.freeze(def) :: ItemDef
end

local Items = {}

local LIST: { ItemDef } = table.freeze({
	item({ id = "worn_sword", name = "Worn Practice Sword", kind = "weapon", rarity = "common",
		weaponCategory = "sword", damageMult = 1.1, qiConductivity = 1, stageReq = 1,
		blurb = "Ten thousand beginners have held this exact sword. Now it is your turn." }),
	item({ id = "azure_iron_sword", name = "Azure Iron Sword", kind = "weapon", rarity = "fine",
		weaponCategory = "sword", damageMult = 1.25, qiConductivity = 1.1, stageReq = 13,
		blurb = "Vale iron, folded nine times. It hums faintly near running water." }),
	item({ id = "cloudpine_blade", name = "Cloudpine Blade", kind = "weapon", rarity = "rare",
		weaponCategory = "sword", damageMult = 1.4, qiConductivity = 1.25, stageReq = 25,
		blurb = "Quenched in mountain mist. Lighter than it has any right to be." }),

	item({ id = "mistleaf", name = "Mistleaf", kind = "herb", rarity = "common",
		blurb = "A gray-green herb that grows where fog lingers. Alchemists burn through sacks of it." }),
	item({ id = "emberroot", name = "Emberroot", kind = "herb", rarity = "fine",
		blurb = "Warm to the touch even in snow. The root remembers summer." }),

	item({ id = "breath_pill", name = "Breath-Gathering Pill", kind = "pill", rarity = "common",
		restoreQiFrac = 0.5,
		blurb = "Chalky, bitter, effective. Restores half of one's qi sea." }),
	item({ id = "mend_pill", name = "Knit-Flesh Pill", kind = "pill", rarity = "common",
		healFrac = 0.4,
		blurb = "Tastes like iron and regret. Closes wounds from the inside." }),

	item({ id = "spirit_dust", name = "Spirit Dust", kind = "material", rarity = "common",
		blurb = "What is left when a beast's core cools. Smiths and alchemists pay for it." }),
	item({ id = "beast_fang", name = "Beast Fang", kind = "material", rarity = "common",
		blurb = "Proof of a fight something else lost." }),
})
Items.LIST = LIST

local byId: { [string]: ItemDef } = {}
for _, def in LIST do
	byId[def.id] = def
end

function Items.get(id: string): ItemDef?
	return byId[id]
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Net
-- Single owner of every RemoteEvent/RemoteFunction. The server CREATES
-- remotes (get-or-create), the client WAITS for them. Every remote name is
-- declared here and nowhere else, so a typo fails loudly at startup and
-- duplicates are impossible by construction.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local REMOTE_EVENTS: { string } = {
	-- Server -> client state pushes
	"StatsChanged", -- stage, qi, xp, stones, meditating
	"InventoryChanged", -- items, manuals, equipped gear
	"TechniquesChanged", -- designs + hotbar slots
	"SocialChanged", -- sect, master, disciples
	"Notify", -- toast { text, color? }
	"CombatFx", -- broadcast: swings, hits, deaths, breakthroughs (VFX only)
	"DiscipleOffer", -- someone offers to take you as disciple

	-- Client -> server intents (server validates everything)
	"MeditateSet", -- (wants: boolean)
	"AttackRequest", -- (kind: "light"|"heavy", aim: Vector3)
	"BlockSet", -- (blocking: boolean)
	"DodgeRequest", -- () server opens the evasion window
	"CastTechnique", -- (slot: number, aim: Vector3)
}

local REMOTE_FUNCTIONS: { string } = {
	"BreakthroughRequest", -- attempt to advance a stage
	"CreateTechnique", -- design from components
	"DeleteTechnique",
	"EquipTechnique", -- bind to hotbar slot
	"WriteManual", -- author a technique manual (needs 100% mastery)
	"UseManual", -- learn from a held manual
	"GiveManual", -- hand a manual to a nearby player
	"EquipItem",
	"OfferDiscipleship",
	"RespondDiscipleship",
	"RenounceMaster",
	"TeachTechnique", -- direct master->disciple transmission
}

local Net = {}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if folder == nil then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local function assertDeclared(name: string, list: { string }, kind: string)
	if table.find(list, name) == nil then
		error(`Net: "{name}" is not a declared {kind}. Add it to Net.luau.`, 3)
	end
end

function Net.remoteEvent(name: string): RemoteEvent
	assertDeclared(name, REMOTE_EVENTS, "RemoteEvent")
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			return existing :: RemoteEvent
		end
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.remoteFunction(name: string): RemoteFunction
	assertDeclared(name, REMOTE_FUNCTIONS, "RemoteFunction")
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			return existing :: RemoteFunction
		end
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

-- Server bootstrap: create every declared remote up front so clients never
-- hang waiting on one a lazy system hasn't touched yet.
function Net.initServer()
	assert(RunService:IsServer(), "Net.initServer is server-only")
	for _, name in REMOTE_EVENTS do
		Net.remoteEvent(name)
	end
	for _, name in REMOTE_FUNCTIONS do
		Net.remoteFunction(name)
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > RateLimit
-- Fixed-window per-key rate limiter. Every remote handler that an
-- exploiter could spam sits behind one of these.

local RateLimit = {}
RateLimit.__index = RateLimit

export type RateLimit = typeof(setmetatable(
	{} :: { maxCalls: number, window: number, counts: { [number]: number }, windowStart: { [number]: number } },
	RateLimit
))

function RateLimit.new(maxCalls: number, windowSeconds: number): RateLimit
	return setmetatable({
		maxCalls = maxCalls,
		window = windowSeconds,
		counts = {},
		windowStart = {},
	}, RateLimit)
end

function RateLimit.Allow(self: RateLimit, key: number): boolean
	local now = os.clock()
	local start = self.windowStart[key]
	if start == nil or now - start >= self.window then
		self.windowStart[key] = now
		self.counts[key] = 1
		return true
	end
	local count = (self.counts[key] or 0) + 1
	self.counts[key] = count
	return count <= self.maxCalls
end

function RateLimit.Forget(self: RateLimit, key: number)
	self.counts[key] = nil
	self.windowStart[key] = nil
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Realms</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Realms
-- The cultivation ladder: 12 Major Realms, each of 12 Minor Realms, for
-- 144 stages between a mortal and a True Immortal. Stats are formulas,
-- not 144 hand-written rows, so the whole curve rebalances from a few
-- constants. All numbers are original to this game.

local Realms = {}

export type MajorRealm = {
	name: string,
	color: Color3, -- aura / UI accent for the realm band
	epithet: string, -- one line of flavor shown on breakthrough
}

local MAJORS: { MajorRealm } = table.freeze({
	{ name = "Body Tempering", color = Color3.fromRGB(155, 148, 138), epithet = "Flesh is the first furnace." },
	{ name = "Qi Gathering", color = Color3.fromRGB(120, 170, 220), epithet = "Breath by breath, the sea fills." },
	{ name = "Foundation Establishment", color = Color3.fromRGB(96, 180, 150), epithet = "What is built on stone endures." },
	{ name = "Core Formation", color = Color3.fromRGB(88, 150, 235), epithet = "A whirlpool learns to hold its center." },
	{ name = "Golden Core", color = Color3.fromRGB(232, 190, 80), epithet = "A sun the size of a seed." },
	{ name = "Nascent Soul", color = Color3.fromRGB(190, 130, 235), epithet = "The self that steps outside the self." },
	{ name = "Soul Transformation", color = Color3.fromRGB(226, 120, 180), epithet = "The river forgets it was rain." },
	{ name = "Void Refinement", color = Color3.fromRGB(110, 110, 160), epithet = "Emptiness, polished until it shines." },
	{ name = "Dao Integration", color = Color3.fromRGB(140, 220, 220), epithet = "The way walks with you now." },
	{ name = "Tribulation Transcendence", color = Color3.fromRGB(240, 240, 250), epithet = "The heavens themselves object." },
	{ name = "Immortal Ascension", color = Color3.fromRGB(255, 226, 160), epithet = "The last stair has no rail." },
	{ name = "True Immortal", color = Color3.fromRGB(255, 250, 235), epithet = "Mountains are brief. You are not." },
})
Realms.MAJORS = MAJORS

Realms.MINORS_PER_MAJOR = 12
Realms.STAGE_COUNT = #Realms.MAJORS * Realms.MINORS_PER_MAJOR -- 144

local ROMAN = table.freeze({ "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII" })

function Realms.majorOf(stage: number): number
	return math.clamp(math.ceil(stage / Realms.MINORS_PER_MAJOR), 1, #Realms.MAJORS)
end

function Realms.minorOf(stage: number): number
	return ((stage - 1) % Realms.MINORS_PER_MAJOR) + 1
end

function Realms.major(stage: number): MajorRealm
	return Realms.MAJORS[Realms.majorOf(stage)]
end

-- "Foundation Establishment VII"
function Realms.displayName(stage: number): string
	return `{Realms.major(stage).name} {ROMAN[Realms.minorOf(stage)]}`
end

-- ------------------------------ Stat curve -------------------------------
-- Majors are geometric leaps; minors are steady steps inside a major.
-- Every derived stat flows from these few constants.

local HEALTH_BASE = 100
local HEALTH_MAJOR = 1.55
local HEALTH_MINOR = 1.03

local QI_BASE = 100
local QI_MAJOR = 1.6
local QI_MINOR = 1.035

local REGEN_BASE = 2
local REGEN_MAJOR = 1.35
local REGEN_MINOR = 1.02

local STRENGTH_BASE = 6
local STRENGTH_MAJOR = 1.42
local STRENGTH_MINOR = 1.03

export type StageStats = {
	maxHealth: number,
	maxQi: number,
	qiRegen: number,
	strength: number, -- base melee damage before weapons/techniques
	defenseFrac: number, -- 0..0.5 innate damage reduction
	speedBonus: number, -- studs/sec added to base walkspeed
	powerCap: number, -- ceiling on technique power at this stage
}

function Realms.statsFor(stage: number): StageStats
	local m = Realms.majorOf(stage)
	local n = Realms.minorOf(stage)
	local majorStep = m - 1
	local minorStep = n - 1
	return {
		maxHealth = math.floor(HEALTH_BASE * HEALTH_MAJOR ^ majorStep * HEALTH_MINOR ^ minorStep + 0.5),
		maxQi = math.floor(QI_BASE * QI_MAJOR ^ majorStep * QI_MINOR ^ minorStep + 0.5),
		qiRegen = REGEN_BASE * REGEN_MAJOR ^ majorStep * REGEN_MINOR ^ minorStep,
		strength = STRENGTH_BASE * STRENGTH_MAJOR ^ majorStep * STRENGTH_MINOR ^ minorStep,
		defenseFrac = math.min(0.5, 0.02 * majorStep + 0.004 * minorStep),
		speedBonus = 0.35 * majorStep,
		powerCap = 50 * m + 4 * n,
	}
end

-- Cultivation xp needed to leave `stage` for the next one. nil at the top.
-- Crossing into a new Major Realm costs extra: those are the walls the
-- story is about.
function Realms.breakthroughCost(stage: number): number?
	if stage >= Realms.STAGE_COUNT then
		return nil
	end
	local m = Realms.majorOf(stage)
	local n = Realms.minorOf(stage)
	local cost = 30 * 1.9 ^ (m - 1) * (1 + 0.12 * (n - 1))
	if n == Realms.MINORS_PER_MAJOR then
		cost *= 2.2
	end
	return math.floor(cost + 0.5)
end

-- True when leaving this stage means entering a new Major Realm.
function Realms.isMajorCrossing(stage: number): boolean
	return Realms.minorOf(stage) == Realms.MINORS_PER_MAJOR and stage < Realms.STAGE_COUNT
end

-- Heavenly Tribulations guard the gates of the highest majors. (The
-- tribulation encounter itself arrives in its own phase; callers treat
-- `true` as "storm the heavens first".)
function Realms.requiresTribulation(stage: number): boolean
	return Realms.isMajorCrossing(stage) and Realms.majorOf(stage) + 1 >= 10
end

return Realms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">TechniqueMath</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > TechniqueMath
-- Pure math for player-created techniques: composition (components ->
-- stats), rank, realm requirement, mastery, and inheritance. Shared so
-- the design UI can preview honestly; the SERVER's call is the one that
-- counts at cast time.

local Config = require(script.Parent.Config)
local Realms = require(script.Parent.Realms)
local TechniqueParts = require(script.Parent.TechniqueParts)

local TechniqueMath = {}

export type ComputedTechnique = {
	power: number, -- design potential
	damage: number, -- at full potential (realm cap may reduce in play)
	qiCost: number,
	cooldown: number,
	requiredStage: number, -- first stage whose powerCap fits this power
	rank: string, -- flavor grade from power
	reachMult: number, -- Far-Reaching Intent stretches distances
	steps: { TechniqueParts.Part }, -- executable (non-intent) parts, in order
}

local RANKS = table.freeze({
	{ threshold = 0, name = "Mortal-grade" },
	{ threshold = 120, name = "Earth-grade" },
	{ threshold = 260, name = "Heaven-grade" },
	{ threshold = 430, name = "Mystic-grade" },
	{ threshold = 640, name = "Divine-grade" },
})

function TechniqueMath.rankName(power: number): string
	local best = RANKS[1].name
	for _, rank in RANKS do
		if power >= rank.threshold then
			best = rank.name
		end
	end
	return best
end

-- The first stage allowed to wield a technique of this power.
function TechniqueMath.requiredStage(power: number): number
	for stage = 1, Realms.STAGE_COUNT do
		if Realms.statsFor(stage).powerCap >= power then
			return stage
		end
	end
	return Realms.STAGE_COUNT
end

-- Compose components (+ an intensity 1..10 chosen at creation) into a
-- technique. Returns nil + reason when the design is invalid.
function TechniqueMath.compute(category: string, componentIds: { string }, intensity: number): (ComputedTechnique?, string?)
	if table.find(TechniqueParts.CATEGORIES, category) == nil then
		return nil, "Unknown technique category"
	end
	if intensity ~= intensity or intensity < 1 or intensity > 10 or intensity % 1 ~= 0 then
		return nil, "Intensity must be a whole number from 1 to 10"
	end
	if #componentIds < 1 or #componentIds > Config.MAX_COMPONENTS then
		return nil, `A technique chains 1 to {Config.MAX_COMPONENTS} components`
	end

	local totalPower = 0
	local qiCost = 0
	local cooldown = 0.6
	local damageShare = 0
	local reachMult = 1
	local steps: { TechniqueParts.Part } = {}
	local seen: { [string]: boolean } = {}
	local hasAction = false

	for _, id in componentIds do
		local part = TechniqueParts.get(id)
		if part == nil then
			return nil, "Unknown component"
		end
		if seen[id] then
			return nil, `{part.name} cannot appear twice in one technique`
		end
		seen[id] = true
		if not TechniqueParts.allowedIn(id, category) then
			return nil, `{part.name} does not belong to the {category} path`
		end
		totalPower += part.power
		qiCost += part.qiCost
		cooldown += part.cooldown
		damageShare += part.damageShare or 0
		if part.kind == "intent" then
			if part.id == "far_intent" then
				reachMult = 1.34
			end
		else
			hasAction = true
			table.insert(steps, part)
		end
	end
	if not hasAction then
		return nil, "A technique needs at least one motion, strike, wave or burst"
	end

	-- Intensity scales potential, price and punch together.
	local scale = 0.7 + intensity * 0.3 -- 1.0 at intensity 1, 3.7 at 10
	local power = math.floor(totalPower * scale + 0.5)
	local damage = math.max(4, math.floor((10 + totalPower * 0.9) * damageShare * scale * 0.6 + 0.5))
	qiCost = math.max(2, math.floor(qiCost * scale + 0.5))
	cooldown = math.max(0.7, cooldown)

	return {
		power = power,
		damage = damage,
		qiCost = qiCost,
		cooldown = cooldown,
		requiredStage = TechniqueMath.requiredStage(power),
		rank = TechniqueMath.rankName(power),
		reachMult = reachMult,
		steps = steps,
	}, nil
end

-- ------------------------------- Mastery ---------------------------------
-- Mastery runs 0..100%. Stronger techniques take longer to internalize.

function TechniqueMath.masteryGoal(power: number): number
	return math.floor(80 + power * 1.4)
end

function TechniqueMath.masteryPercent(masteryXp: number, power: number): number
	return math.clamp(math.floor(100 * masteryXp / TechniqueMath.masteryGoal(power)), 0, 100)
end

-- Controlled bonuses, per the design bible: never overpowered.
function TechniqueMath.masteryDamageMult(percent: number): number
	return 1 + 0.1 * percent / 100 -- up to +10%
end

function TechniqueMath.masteryQiMult(percent: number): number
	return 1 - 0.15 * percent / 100 -- down to -15% cost
end

function TechniqueMath.masteryCooldownMult(percent: number): number
	return 1 - 0.1 * percent / 100 -- up to 10% faster
end

-- ------------------------------ Inheritance ------------------------------
-- A passed-down technique keeps its full design potential, but operates at
-- 70%, and the wielder's own realm cap applies on top. As the disciple's
-- realm rises, more of the original comes through.
function TechniqueMath.effectivePower(technique: { power: number, inherited: boolean? }, wielderStage: number): number
	local potential = technique.power
	if technique.inherited then
		potential *= Config.INHERITANCE_MULTIPLIER
	end
	local cap = Realms.statsFor(wielderStage).powerCap
	return math.min(potential, cap)
end

return TechniqueMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">TechniqueParts</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > TechniqueParts
-- The secure component library for player-created techniques. Players
-- never script anything: they chain up to MAX_COMPONENTS of these
-- predefined parts (Dash -> Slash -> Spin -> Qi Wave), name the result,
-- and the server computes every number from this data. Adding a part
-- here is the ONLY way new technique behavior enters the game.

export type Part = {
	id: string,
	name: string,
	kind: string, -- "motion" | "strike" | "wave" | "burst" | "intent"
	categories: { string }, -- which technique categories may use it
	power: number, -- contribution to the technique's power rating
	qiCost: number,
	cooldown: number,
	blurb: string,

	-- Execution numbers (used by the kinds that need them)
	distance: number?, -- motion travel / strike reach / wave range
	radius: number?, -- burst AoE
	speed: number?, -- wave projectile speed
	damageShare: number?, -- fraction of technique damage this part carries
}

local function part(p: Part): Part
	return table.freeze(p) :: Part
end

local TechniqueParts = {}

TechniqueParts.CATEGORIES = table.freeze({ "sword", "fist", "movement", "qi" })

local LIST: { Part } = table.freeze({
	-- ------------------------------ Motions ------------------------------
	part({ id = "dash", name = "Gale Step", kind = "motion", categories = { "sword", "fist", "movement", "qi" },
		power = 8, qiCost = 6, cooldown = 1.2, distance = 28,
		blurb = "A burst of footwork that closes or opens distance." }),
	part({ id = "leap", name = "Crane Rise", kind = "motion", categories = { "fist", "movement" },
		power = 8, qiCost = 6, cooldown = 1.2, distance = 34,
		blurb = "Qi under the heels; the ground lets go." }),
	part({ id = "blink_step", name = "Shadow Thread", kind = "motion", categories = { "movement", "qi" },
		power = 18, qiCost = 14, cooldown = 2.6, distance = 42,
		blurb = "A stitch through space. Walls object; distance does not." }),

	-- ------------------------------ Strikes ------------------------------
	part({ id = "slash", name = "Falling Petal Cut", kind = "strike", categories = { "sword" },
		power = 12, qiCost = 7, cooldown = 0.9, distance = 11, damageShare = 1,
		blurb = "One clean arc. The oldest lesson a sword teaches." }),
	part({ id = "thrust", name = "Heron Beak", kind = "strike", categories = { "sword" },
		power = 14, qiCost = 8, cooldown = 1, distance = 15, damageShare = 1.1,
		blurb = "A point moving faster than the eye that follows it." }),
	part({ id = "palm", name = "River-Turning Palm", kind = "strike", categories = { "fist", "qi" },
		power = 12, qiCost = 7, cooldown = 0.9, distance = 9, damageShare = 1,
		blurb = "The open hand, and the current behind it." }),
	part({ id = "flurry", name = "Ten Sparrow Fists", kind = "strike", categories = { "fist" },
		power = 16, qiCost = 10, cooldown = 1.4, distance = 8, damageShare = 1.25,
		blurb = "Not one blow. A weather of them." }),
	part({ id = "spin_cut", name = "Moon-Circling Blade", kind = "strike", categories = { "sword" },
		power = 16, qiCost = 10, cooldown = 1.4, distance = 12, damageShare = 1.2,
		blurb = "The blade orbits; everything near pays the toll." }),

	-- ------------------------------- Waves -------------------------------
	part({ id = "qi_wave", name = "Azure Crescent", kind = "wave", categories = { "sword", "qi" },
		power = 18, qiCost = 12, cooldown = 1.8, distance = 90, speed = 90, damageShare = 1.15,
		blurb = "The cut leaves the sword and keeps going." }),
	part({ id = "qi_bolt", name = "Sky Needle", kind = "wave", categories = { "qi" },
		power = 14, qiCost = 9, cooldown = 1.2, distance = 110, speed = 130, damageShare = 0.95,
		blurb = "A thin, fast thought with an argument at the end." }),

	-- ------------------------------- Bursts ------------------------------
	part({ id = "nova", name = "Bellows Heart", kind = "burst", categories = { "fist", "qi" },
		power = 20, qiCost = 15, cooldown = 2.4, radius = 16, damageShare = 1.1,
		blurb = "Qi held one breath too long, then all at once." }),
	part({ id = "quake", name = "Ox Stamp", kind = "burst", categories = { "fist" },
		power = 18, qiCost = 13, cooldown = 2.2, radius = 13, damageShare = 1,
		blurb = "The mountain does not move. The ground reconsiders." }),

	-- ------------------------------- Intents -----------------------------
	-- Modifiers: no action of their own; they reshape the whole technique.
	part({ id = "swift_intent", name = "Swift Intent", kind = "intent", categories = { "sword", "fist", "movement", "qi" },
		power = 6, qiCost = 4, cooldown = -0.4,
		blurb = "Trades depth for speed: the technique recovers sooner." }),
	part({ id = "heavy_intent", name = "Heavy Intent", kind = "intent", categories = { "sword", "fist" },
		power = 10, qiCost = 8, cooldown = 0.5, damageShare = 0.35,
		blurb = "Slower, and it lands like a verdict." }),
	part({ id = "far_intent", name = "Far-Reaching Intent", kind = "intent", categories = { "sword", "qi" },
		power = 8, qiCost = 6, cooldown = 0.2,
		blurb = "The technique's reach grows a third again." }),
})
TechniqueParts.LIST = LIST

local byId: { [string]: Part } = {}
for _, entry in LIST do
	byId[entry.id] = entry
end

function TechniqueParts.get(id: string): Part?
	return byId[id]
end

function TechniqueParts.allowedIn(id: string, category: string): boolean
	local entry = byId[id]
	return entry ~= nil and table.find(entry.categories, category) ~= nil
end

return TechniqueParts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Types
-- Shared type definitions. PlayerData is the persisted shape; it must stay
-- a plain serializable table (no Instances, no functions, string keys in
-- maps), because it goes straight into the DataStore.

export type Technique = {
	id: string, -- GUID
	name: string,
	category: string, -- "sword" | "fist" | "movement" | "qi"
	components: { string }, -- ordered component ids from TechniqueParts
	power: number, -- design potential (may exceed what the owner can use)
	masteryXp: number, -- raw xp; mastery % derives from it
	origin: string?, -- creator's name when inherited; nil when self-made
	inherited: boolean?, -- true = operates at INHERITANCE_MULTIPLIER
}

export type PlayerData = {
	version: number,

	-- Cultivation
	stage: number, -- 1..144 (see Realms)
	cultivationXp: number,
	qi: number,

	-- Wealth & inventory. items maps itemId -> count; unique items
	-- (technique manuals) live in `manuals` keyed by their BookId.
	spiritStones: number,
	items: { [string]: number },
	manuals: { [string]: { bookId: string, techniqueName: string, technique: Technique } },
	equippedWeapon: string?,

	-- Techniques
	techniques: { Technique },
	slots: { [string]: string }, -- hotbar: "1".."6" -> technique id (string
	-- keys on purpose: sparse numeric keys corrupt in DataStore JSON)

	-- Sect & lineage
	sectId: string?,
	sectRank: string?,
	masterUserId: number?,
	masterName: string?,
	disciples: { { userId: number, name: string } },

	-- Reputation per faction id, quest flags by quest id.
	reputation: { [string]: number },
	quests: { [string]: { state: string, progress: number } },

	settings: { [string]: boolean },
}

return table.freeze({})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">UpdatesData</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > UpdatesData
-- The in-game changelog, newest first. Keep players seeing motion.

export type UpdateEntry = {
	version: string,
	date: string,
	title: string,
	notes: { string },
}

local Updates: { UpdateEntry } = {
	{
		version = "1.0.0",
		date = "2026-08-29",
		title = "Heavenpillar Rises",
		notes = {
			"The game begins again, rebuilt from the first stone: welcome to the Azure Vale, in the shadow of Mount Heavenpillar.",
			"144 steps of cultivation: 12 Major Realms, 12 Minor Realms each, from Body Tempering to True Immortal.",
			"Real combat: light combos, heavy strikes, blocking, dodging, all judged by the server.",
			"Meditate at qi-rich sacred sites for deeper cultivation. Fighting and training cultivate you too.",
			"Design your own techniques from secure components, practice them to 100% mastery, write them into manuals, and pass them to disciples.",
			"Wildlife prowls the vale. It is not friendly.",
		},
	},
}

return table.freeze(Updates)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Script: ServerScriptService > Server
-- Bootstrapper. Requires every system, runs Init() in a DECLARED order
-- (dictionary iteration order is not deterministic, and world-before-
-- gameplay matters), then Start() on all. Systems not in the order list
-- still load, after the listed ones.

local systemsFolder = script:WaitForChild("Systems")

type System = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local ORDER = {
	"DataService",
	"WorldService",
	"CultivationService",
	"CombatService",
	"TechniqueService",
	"DiscipleService",
	"InventoryService",
	"NpcService",
}

local systems: { [string]: System } = {}
local names: { string } = {}

for _, child in systemsFolder:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			systems[child.Name] = result :: System
			table.insert(names, child.Name)
		else
			warn(`[Server] Failed to require system "{child.Name}": {result}`)
		end
	end
end

-- Ordered list first, then anything else alphabetically for stability.
table.sort(names, function(a, b)
	local ia = table.find(ORDER, a) or math.huge
	local ib = table.find(ORDER, b) or math.huge
	if ia ~= ib then
		return ia < ib
	end
	return a < b
end)

for _, name in names do
	local system = systems[name]
	if system.Init then
		local ok, err = pcall(system.Init :: any)
		if not ok then
			warn(`[Server] {name}.Init() failed: {err}`)
		end
	end
end

for _, name in names do
	local system = systems[name]
	if system.Start then
		task.spawn(function()
			local ok, err = pcall(system.Start :: any)
			if not ok then
				warn(`[Server] {name}.Start() failed: {err}`)
			end
		end)
	end
end

print("[Server] Heavenpillar stands.")
]]></string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > CombatService
-- Server-authoritative combat. The client sends INTENT (swing, block,
-- dodge) and plays its own animations for responsiveness; the server
-- validates cooldowns, positions and states, resolves every hitbox, and
-- is the only writer of damage. Exploiters can fire these remotes all
-- day and get nothing the rules don't allow.
--
-- Combat also cultivates: damage dealt to real enemies and strikes on
-- training dummies feed CultivationService.AddXp.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Realms = require(Shared:WaitForChild("Realms"))
local Items = require(Shared:WaitForChild("Items"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))

local DataService = require(script.Parent.DataService)
local CultivationService = require(script.Parent.CultivationService)

local CombatService = {}

local combatFx = Net.remoteEvent("CombatFx")
local attackLimit = RateLimit.new(14, 2)
local stateLimit = RateLimit.new(20, 2)

-- Fired (killerPlayer: Player?, victimHumanoid: Humanoid) when anything
-- dies to combat damage. NpcService listens for loot and respawns.
local slainEvent = Instance.new("BindableEvent")
CombatService.Slain = slainEvent.Event

type CombatState = {
	lastLight: number,
	comboIndex: number,
	lastHeavy: number,
	blocking: boolean,
	dodgeUntil: number,
	lastDodge: number,
}

local states: { [Player]: CombatState } = {}

local function stateFor(player: Player): CombatState
	local state = states[player]
	if state == nil then
		state = { lastLight = 0, comboIndex = 0, lastHeavy = 0, blocking = false, dodgeUntil = 0, lastDodge = 0 }
		states[player] = state
	end
	return state
end

-- ------------------------------ Safe zones ------------------------------

type Zone = { position: Vector3, radius: number }
local safeZones: { Zone } = {}

local function registerZone(marker: Instance)
	if not marker:IsA("BasePart") then
		return
	end
	local radius = marker:GetAttribute("Radius")
	table.insert(safeZones, {
		position = marker.Position,
		radius = if typeof(radius) == "number" then radius else 32,
	})
end

function CombatService.InSafeZone(position: Vector3): boolean
	for _, zone in safeZones do
		if (position - zone.position).Magnitude <= zone.radius then
			return true
		end
	end
	return false
end

-- ------------------------------- Helpers --------------------------------

local function characterParts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if character == nil then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root == nil or not root:IsA("BasePart") or humanoid == nil or humanoid.Health <= 0 then
		return character, nil, nil
	end
	return character, root, humanoid
end

local function humanoidFromPart(part: BasePart): Humanoid?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function sanitizeAim(aim: unknown, fallback: Vector3): Vector3
	if typeof(aim) ~= "Vector3" then
		return fallback
	end
	local v = aim :: Vector3
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z or v.Magnitude > 1e5 then
		return fallback
	end
	return v
end

local function weaponMultipliers(player: Player): (number, number)
	local data = DataService.Get(player)
	local weaponId = if data then data.equippedWeapon else nil
	local weapon = if weaponId then Items.get(weaponId) else nil
	if weapon and weapon.kind == "weapon" then
		return weapon.damageMult or 1, weapon.qiConductivity or 1
	end
	return 1, 1
end

function CombatService.WeaponMultipliers(player: Player): (number, number)
	return weaponMultipliers(player)
end

-- ------------------------------- Damage ---------------------------------

export type DamageOptions = {
	kind: string, -- "light" | "heavy" | "technique" | "npc"
	direction: Vector3?,
	knockback: number?,
	stun: number?,
	dodgeable: boolean?, -- default true; AoE bursts pass false
}

-- The single gate all damage passes through. Returns damage dealt.
function CombatService.DealDamage(attacker: Player?, target: Humanoid, amount: number, options: DamageOptions): number
	if amount <= 0 or target.Health <= 0 then
		return 0
	end
	local targetModel = target.Parent
	if targetModel == nil then
		return 0
	end
	local targetPlayer = Players:GetPlayerFromCharacter(targetModel)
	local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")

	-- Sanctuary: no player is harmed in a safe zone, and no one may harm
	-- outward from one. (NPC beasts never enter them by design.)
	if targetPlayer and targetRoot and targetRoot:IsA("BasePart") and CombatService.InSafeZone(targetRoot.Position) then
		return 0
	end
	if attacker then
		local _, attackerRoot = characterParts(attacker)
		if targetPlayer and attackerRoot and CombatService.InSafeZone(attackerRoot.Position) then
			return 0
		end
		if attacker.Character == targetModel then
			return 0
		end
	end

	-- A well-timed dodge makes melee and single-target technique blows miss.
	if targetPlayer and (options.dodgeable ~= false) then
		local targetState = states[targetPlayer]
		if targetState and os.clock() < targetState.dodgeUntil then
			combatFx:FireAllClients({ kind = "dodged", userId = targetPlayer.UserId })
			return 0
		end
	end

	local dealt = amount

	-- Innate defense from the target's realm (attribute set by whoever
	-- owns the target: CultivationService for players, NpcService for NPCs).
	local defense = target:GetAttribute("DefenseFrac")
	if typeof(defense) == "number" then
		dealt *= 1 - math.clamp(defense, 0, 0.8)
	end

	-- Blocking: strong against light blows, weaker against heavies.
	if targetPlayer then
		local targetState = states[targetPlayer]
		if targetState and targetState.blocking then
			local reduction = if options.kind == "heavy" then Config.BLOCK_REDUCTION_HEAVY else Config.BLOCK_REDUCTION_LIGHT
			dealt *= 1 - reduction
			combatFx:FireAllClients({ kind = "blocked", userId = targetPlayer.UserId })
		end
	end

	dealt = math.max(1, math.floor(dealt + 0.5))
	local wasAlive = target.Health > 0
	target:TakeDamage(dealt)

	-- Knockback and stun ride along the damage.
	local direction = options.direction
	if direction and options.knockback and targetRoot and targetRoot:IsA("BasePart") and not targetRoot.Anchored then
		if direction.Magnitude > 0.01 then
			targetRoot.AssemblyLinearVelocity += direction.Unit * options.knockback + Vector3.new(0, options.knockback * 0.35, 0)
		end
	end
	if options.stun and options.stun > 0 then
		if targetPlayer then
			target:SetAttribute("SpeedFactor", 0)
			task.delay(options.stun, function()
				if targetPlayer.Parent and target.Parent then
					target:SetAttribute("SpeedFactor", 1)
				end
			end)
		else
			local original = target.WalkSpeed
			target.WalkSpeed = 0
			task.delay(options.stun, function()
				if target.Parent then
					target.WalkSpeed = original
				end
			end)
		end
	end

	-- Combat is cultivation. Dummies pay flat training xp; live enemies
	-- pay by the wound, and again on the kill.
	if attacker then
		local isDummy = CollectionService:HasTag(targetModel, "TrainingDummy")
		if isDummy then
			CultivationService.AddXp(attacker, Config.TRAINING_XP_PER_HIT)
		else
			CultivationService.AddXp(attacker, dealt * Config.COMBAT_XP_PER_DAMAGE)
		end
		if wasAlive and target.Health <= 0 then
			if not isDummy then
				local victimStage = target:GetAttribute("Stage")
				local stage = if typeof(victimStage) == "number" then victimStage else 1
				CultivationService.AddXp(attacker, stage * Config.KILL_XP_MULT)
			end
			slainEvent:Fire(attacker, target)
		end
	elseif target.Health <= 0 and wasAlive then
		slainEvent:Fire(nil, target)
	end

	if targetRoot and targetRoot:IsA("BasePart") then
		combatFx:FireAllClients({
			kind = "hit",
			position = targetRoot.Position,
			amount = dealt,
			targetUserId = if targetPlayer then targetPlayer.UserId else nil,
		})
	end

	return dealt
end

-- ---------------------------- Melee resolution ---------------------------

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function meleeTargets(attacker: Player, root: BasePart, aim: Vector3, reach: number): { Humanoid }
	local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
	local direction = if flat.Magnitude > 0.5 then flat.Unit else root.CFrame.LookVector
	local boxCFrame = CFrame.lookAt(root.Position, root.Position + direction) * CFrame.new(0, 0, -reach / 2)
	local attackerCharacter = attacker.Character
	overlapParams.FilterDescendantsInstances = if attackerCharacter then { attackerCharacter :: Instance } else {}
	local found: { Humanoid } = {}
	local seen: { [Humanoid]: boolean } = {}
	for _, part in workspace:GetPartBoundsInBox(boxCFrame, Vector3.new(reach * 0.9, 6, reach), overlapParams) do
		local humanoid = humanoidFromPart(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			table.insert(found, humanoid)
		end
	end
	return found
end

function CombatService.MeleeDirection(root: BasePart, aim: Vector3): Vector3
	local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
	return if flat.Magnitude > 0.5 then flat.Unit else root.CFrame.LookVector
end

local function onAttack(player: Player, kindArg: unknown, aimArg: unknown)
	if not attackLimit:Allow(player.UserId) then
		return
	end
	if kindArg ~= "light" and kindArg ~= "heavy" then
		return
	end
	local kind = kindArg :: string
	local _, root, humanoid = characterParts(player)
	if root == nil or humanoid == nil then
		return
	end
	local state = stateFor(player)
	if state.blocking then
		return -- no swinging from behind a guard
	end
	local now = os.clock()

	local data = DataService.Get(player)
	if data == nil then
		return
	end
	local strength = Realms.statsFor(data.stage).strength
	local weaponMult = (weaponMultipliers(player))
	local aim = sanitizeAim(aimArg, root.Position + root.CFrame.LookVector * 10)
	local direction = CombatService.MeleeDirection(root, aim)

	if kind == "light" then
		if now - state.lastLight < Config.LIGHT_COOLDOWN then
			return
		end
		-- The combo chain: 1 -> 2 -> 3(finisher), resetting when idle.
		if now - state.lastLight > Config.LIGHT_CHAIN_WINDOW then
			state.comboIndex = 0
		end
		state.comboIndex = (state.comboIndex % 3) + 1
		state.lastLight = now

		local isFinisher = state.comboIndex == 3
		local damage = strength * weaponMult * (if isFinisher then Config.FINISHER_MULT else 1)
		for _, target in meleeTargets(player, root, aim, Config.MELEE_RANGE) do
			CombatService.DealDamage(player, target, damage, {
				kind = "light",
				direction = direction,
				knockback = if isFinisher then 26 else nil,
				stun = if isFinisher then Config.STUN_ON_FINISHER else nil,
			})
		end
		combatFx:FireAllClients({
			kind = "swing",
			userId = player.UserId,
			swing = state.comboIndex,
			origin = root.Position,
			direction = direction,
		})
	else
		if now - state.lastHeavy < Config.HEAVY_COOLDOWN then
			return
		end
		state.lastHeavy = now
		state.comboIndex = 0
		local damage = strength * weaponMult * Config.HEAVY_MULT
		-- The heavy lands after its windup; the server owns the timing.
		combatFx:FireAllClients({
			kind = "swing",
			userId = player.UserId,
			swing = 0, -- 0 = heavy windup
			origin = root.Position,
			direction = direction,
		})
		task.delay(0.45, function()
			local _, rootNow, humanoidNow = characterParts(player)
			if rootNow == nil or humanoidNow == nil then
				return
			end
			for _, target in meleeTargets(player, rootNow, aim, Config.MELEE_RANGE + 2) do
				CombatService.DealDamage(player, target, damage, {
					kind = "heavy",
					direction = direction,
					knockback = 34,
				})
			end
		end)
	end
end

-- ------------------------- Block / dodge intents -------------------------

local function onBlockSet(player: Player, wants: unknown)
	if not stateLimit:Allow(player.UserId) then
		return
	end
	stateFor(player).blocking = wants == true
end

local function onDodge(player: Player)
	if not stateLimit:Allow(player.UserId) then
		return
	end
	local state = stateFor(player)
	local now = os.clock()
	if now - state.lastDodge < Config.DODGE_COOLDOWN then
		return
	end
	state.lastDodge = now
	state.dodgeUntil = now + Config.DODGE_WINDOW
	-- The dash itself is client physics (they own their character); the
	-- server only grants the evasion window and tells everyone else.
	combatFx:FireAllClients({ kind = "dodge", userId = player.UserId })
end

-- --------------------------- Training dummies ----------------------------

local function dummyLoop(model: Instance)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	task.spawn(function()
		while model.Parent ~= nil do
			task.wait(1)
			if humanoid.Health <= 0 then
				task.wait(3)
				humanoid.Health = humanoid.MaxHealth
			elseif humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.06)
			end
		end
	end)
end

-- ------------------------------ Lifecycle -------------------------------

function CombatService.Init()
	for _, marker in CollectionService:GetTagged("SafeZone") do
		registerZone(marker)
	end
	CollectionService:GetInstanceAddedSignal("SafeZone"):Connect(registerZone)

	for _, dummy in CollectionService:GetTagged("TrainingDummy") do
		dummyLoop(dummy)
	end
	CollectionService:GetInstanceAddedSignal("TrainingDummy"):Connect(dummyLoop)

	Net.remoteEvent("AttackRequest").OnServerEvent:Connect(onAttack)
	Net.remoteEvent("BlockSet").OnServerEvent:Connect(onBlockSet)
	Net.remoteEvent("DodgeRequest").OnServerEvent:Connect(onDodge)

	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		attackLimit:Forget(player.UserId)
		stateLimit:Forget(player.UserId)
	end)

	-- Death clears combat state so nobody respawns mid-block.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character: Model)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					local state = states[player]
					if state then
						state.blocking = false
						state.comboIndex = 0
					end
				end)
			end
		end)
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">CultivationService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > CultivationService
-- The heart of the game: qi, meditation, cultivation xp, and the climb
-- through 144 stages. The server owns every number; the client only asks
-- to meditate or to attempt a breakthrough.
--
-- Cultivation xp flows in from several systems (combat, training,
-- meditation, later quests/alchemy/encounters) through AddXp, so sitting
-- still is a path but never the only one.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Realms = require(Shared:WaitForChild("Realms"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))

local DataService = require(script.Parent.DataService)

local CultivationService = {}

local combatFx = Net.remoteEvent("CombatFx")
local breakthroughLimit = RateLimit.new(4, 5)

-- Qi-rich places (tagged CultivationZone, Radius + QiMult attributes).
type Zone = { position: Vector3, radius: number, qiMult: number }
local zones: { Zone } = {}

local function registerZone(marker: Instance)
	if not marker:IsA("BasePart") then
		return
	end
	local radius = marker:GetAttribute("Radius")
	local qiMult = marker:GetAttribute("QiMult")
	table.insert(zones, {
		position = marker.Position,
		radius = if typeof(radius) == "number" then radius else 24,
		qiMult = if typeof(qiMult) == "number" then qiMult else 1.5,
	})
end

local function zoneMultiplierAt(position: Vector3): number
	local best = 1
	for _, zone in zones do
		if (position - zone.position).Magnitude <= zone.radius then
			best = math.max(best, zone.qiMult)
		end
	end
	return best
end

-- --------------------------- Character stats ----------------------------

-- Push this player's realm-derived stats onto their live character. The
-- attribute contract: the CLIENT owns humanoid.WalkSpeed and computes it
-- every frame from BaseWalkSpeed/SpeedFactor/SpeedFlat; the server never
-- writes WalkSpeed directly (two writers fight, and the client wins).
function CultivationService.RefreshStats(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if data == nil or humanoid == nil then
		return
	end
	local stats = Realms.statsFor(data.stage)
	local healthFrac = humanoid.Health / math.max(humanoid.MaxHealth, 1)
	humanoid.MaxHealth = stats.maxHealth
	humanoid.Health = math.max(1, stats.maxHealth * healthFrac)
	humanoid:SetAttribute("BaseWalkSpeed", Config.BASE_WALKSPEED + stats.speedBonus)
	humanoid:SetAttribute("SpeedFactor", 1)
	humanoid:SetAttribute("SpeedFlat", 0)
	humanoid:SetAttribute("DefenseFrac", stats.defenseFrac)
	humanoid:SetAttribute("Stage", data.stage)
	humanoid:SetAttribute("MajorRealm", Realms.majorOf(data.stage))
end

-- ------------------------------ Cultivation ------------------------------

function CultivationService.MaxQi(player: Player): number
	local data = DataService.Get(player)
	return if data then Realms.statsFor(data.stage).maxQi else 0
end

function CultivationService.Spend(player: Player, amount: number): boolean
	local data = DataService.Get(player)
	if data == nil or data.qi < amount then
		return false
	end
	data.qi -= amount
	DataService.PushStats(player)
	return true
end

function CultivationService.RestoreQi(player: Player, amount: number)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	data.qi = math.min(CultivationService.MaxQi(player), data.qi + amount)
	DataService.PushStats(player)
end

-- The one gate all cultivation xp passes through.
function CultivationService.AddXp(player: Player, amount: number)
	local data = DataService.Get(player)
	if data == nil or amount <= 0 then
		return
	end
	local cost = Realms.breakthroughCost(data.stage)
	if cost == nil then
		return -- a True Immortal XII has nothing left to gather
	end
	-- Xp pools up to the breakthrough cost and stops: reaching the limit
	-- is the signal to attempt a breakthrough, not a free ride past it.
	data.cultivationXp = math.min(cost, data.cultivationXp + math.floor(amount + 0.5))
	DataService.PushStats(player)
end

local function attemptBreakthrough(player: Player): { [string]: any }
	if not breakthroughLimit:Allow(player.UserId) then
		return { ok = false, error = "Breathe. Then try again." }
	end
	local data = DataService.Get(player)
	if data == nil then
		return { ok = false, error = "Data not loaded yet" }
	end
	local cost = Realms.breakthroughCost(data.stage)
	if cost == nil then
		return { ok = false, error = "There is no realm above yours." }
	end
	if data.cultivationXp < cost then
		return { ok = false, error = "Your foundation is not yet full." }
	end

	local crossing = Realms.isMajorCrossing(data.stage)
	if Realms.requiresTribulation(data.stage) then
		-- The Heavenly Tribulation encounter is its own coming system;
		-- until it exists the heavens grumble but permit passage.
		DataService.Notify(player, "Thunder rolls somewhere above the clouds... and subsides. (Heavenly Tribulations arrive in a coming update.)", Color3.fromRGB(200, 210, 255))
	end

	data.cultivationXp -= cost
	data.stage += 1
	data.qi = Realms.statsFor(data.stage).maxQi
	CultivationService.RefreshStats(player)

	local realmName = Realms.displayName(data.stage)
	if crossing then
		local major = Realms.major(data.stage)
		DataService.Notify(player, `MAJOR BREAKTHROUGH: you have entered the {major.name} Realm. {major.epithet}`, major.color)
	else
		DataService.Notify(player, `Breakthrough: {realmName}.`, Color3.fromRGB(255, 215, 120))
	end

	-- Everyone nearby sees the eruption.
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		combatFx:FireAllClients({
			kind = "breakthrough",
			userId = player.UserId,
			origin = root.Position,
			major = crossing,
			color = Realms.major(data.stage).color,
		})
	end

	DataService.PushStats(player)
	return { ok = true, stage = data.stage, realmName = realmName }
end

-- ------------------------------ Lifecycle -------------------------------

function CultivationService.Init()
	for _, marker in CollectionService:GetTagged("CultivationZone") do
		registerZone(marker)
	end
	CollectionService:GetInstanceAddedSignal("CultivationZone"):Connect(registerZone)

	Net.remoteEvent("MeditateSet").OnServerEvent:Connect(function(player, wants: unknown)
		DataService.SetMeditating(player, wants == true)
		DataService.PushStats(player)
	end)

	Net.remoteFunction("BreakthroughRequest").OnServerInvoke = attemptBreakthrough

	DataService.ObserveLoaded(function(player)
		CultivationService.RefreshStats(player)
		player.CharacterAdded:Connect(function()
			task.defer(CultivationService.RefreshStats, player)
		end)
	end)
end

function CultivationService.Start()
	while true do
		task.wait(Config.QI_TICK_SECONDS)
		for _, player in Players:GetPlayers() do
			local data = DataService.Get(player)
			if data == nil then
				continue
			end
			local stats = Realms.statsFor(data.stage)

			local meditating = DataService.IsMeditating(player)
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if meditating then
				-- Standing up, moving, or dying ends meditation by itself.
				if humanoid == nil or humanoid.Health <= 0 or humanoid.MoveDirection.Magnitude > 0.05 then
					meditating = false
					DataService.SetMeditating(player, false)
				end
			end

			local regen = stats.qiRegen
			local changed = false
			if meditating then
				local zoneMult = if root and root:IsA("BasePart") then zoneMultiplierAt(root.Position) else 1
				regen *= Config.MEDITATE_REGEN_MULT * zoneMult
				-- Meditation gathers cultivation, better in qi-rich places,
				-- but modestly: the world out there pays more.
				CultivationService.AddXp(player, (1 + data.stage * 0.06) * Config.MEDITATE_XP_MULT * zoneMult)
				changed = true
			end

			if data.qi < stats.maxQi then
				data.qi = math.min(stats.maxQi, data.qi + regen)
				changed = true
			elseif data.qi > stats.maxQi then
				data.qi = stats.maxQi
				changed = true
			end

			if changed then
				DataService.PushStats(player)
			end
		end
	end
end

return CultivationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > DataService
-- Owns every player's persisted data: load on join, autosave, save on
-- leave and at server close, and every state push to clients. All other
-- systems mutate data through DataService.Get and then call one Push*.
--
-- DataStore access is wrapped in pcall with an in-memory fallback so
-- Studio (or an outage) degrades to a playable session that will not
-- save, and a profile that never loaded is NEVER written back (it would
-- clobber the real save with defaults). Serializable tables only.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Realms = require(Shared:WaitForChild("Realms"))

local STORE_NAME = "HeavenpillarData_v1"
local KEY_PREFIX = "u_"

local DataService = {}

type Profile = {
	data: Types.PlayerData,
	loaded: boolean,
	meditating: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local loadedEvent = Instance.new("BindableEvent")

local statsChanged = Net.remoteEvent("StatsChanged")
local inventoryChanged = Net.remoteEvent("InventoryChanged")
local techniquesChanged = Net.remoteEvent("TechniquesChanged")
local socialChanged = Net.remoteEvent("SocialChanged")
local notify = Net.remoteEvent("Notify")

local function defaultData(): Types.PlayerData
	return {
		version = 1,
		stage = 1,
		cultivationXp = 0,
		qi = Realms.statsFor(1).maxQi,
		spiritStones = Config.STARTING_SPIRIT_STONES,
		items = { worn_sword = 1, breath_pill = 2 },
		manuals = {},
		equippedWeapon = "worn_sword",
		techniques = {},
		slots = {},
		sectId = nil,
		sectRank = nil,
		masterUserId = nil,
		masterName = nil,
		disciples = {},
		reputation = {},
		quests = {},
		settings = {},
	}
end

-- Fill keys missing from older saves so shape changes never nil-crash.
local function migrate(raw: any): Types.PlayerData
	local fresh = defaultData()
	if typeof(raw) ~= "table" then
		return fresh
	end
	for key, value in fresh :: any do
		if (raw :: any)[key] == nil then
			(raw :: any)[key] = value
		end
	end
	local data = raw :: Types.PlayerData
	data.stage = math.clamp(math.floor(data.stage), 1, Realms.STAGE_COUNT)
	for _, technique in data.techniques do
		if (technique :: any).masteryXp == nil then
			(technique :: any).masteryXp = 0
		end
	end
	return data
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function load(player: Player): Profile
	local profile: Profile = { data = defaultData(), loaded = false, meditating = false }
	local dataStore = getStore()
	if dataStore then
		local ok, result = pcall(function()
			return dataStore:GetAsync(KEY_PREFIX .. player.UserId)
		end)
		if ok then
			profile.data = migrate(result)
			profile.loaded = true
		else
			warn(`[DataService] Load failed for {player.Name}: {result}`)
		end
	end
	return profile
end

local function save(player: Player, profile: Profile)
	if not profile.loaded then
		return
	end
	local dataStore = getStore()
	if dataStore == nil then
		return
	end
	local data = profile.data
	local ok, err = pcall(function()
		dataStore:UpdateAsync(KEY_PREFIX .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn(`[DataService] Save failed for {player.Name}: {err}`)
	end
end

-- ------------------------------ Public API ------------------------------

function DataService.Get(player: Player): Types.PlayerData?
	local profile = profiles[player]
	return if profile then profile.data else nil
end

-- Runs callback for every player whose data is ready, now and later. How
-- systems subscribe without racing the async load.
function DataService.ObserveLoaded(callback: (Player) -> ()): RBXScriptConnection
	for player in profiles do
		task.spawn(callback, player)
	end
	return loadedEvent.Event:Connect(callback)
end

function DataService.IsMeditating(player: Player): boolean
	local profile = profiles[player]
	return if profile then profile.meditating else false
end

function DataService.SetMeditating(player: Player, meditating: boolean)
	local profile = profiles[player]
	if profile then
		profile.meditating = meditating
	end
end

function DataService.Notify(player: Player, text: string, color: Color3?)
	notify:FireClient(player, { text = text, color = color })
end

function DataService.PushStats(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	local data = profile.data
	local stats = Realms.statsFor(data.stage)
	local cost = Realms.breakthroughCost(data.stage)
	statsChanged:FireClient(player, {
		stage = data.stage,
		realmName = Realms.displayName(data.stage),
		majorIndex = Realms.majorOf(data.stage),
		minorIndex = Realms.minorOf(data.stage),
		realmColor = Realms.major(data.stage).color,
		qi = data.qi,
		maxQi = stats.maxQi,
		cultivationXp = data.cultivationXp,
		breakthroughCost = cost,
		spiritStones = data.spiritStones,
		meditating = profile.meditating,
	})
end

function DataService.PushInventory(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	inventoryChanged:FireClient(player, {
		items = data.items,
		manuals = data.manuals,
		equippedWeapon = data.equippedWeapon,
		spiritStones = data.spiritStones,
	})
end

function DataService.PushTechniques(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	techniquesChanged:FireClient(player, {
		techniques = data.techniques,
		slots = data.slots,
		stage = data.stage,
	})
end

function DataService.PushSocial(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	socialChanged:FireClient(player, {
		masterUserId = data.masterUserId,
		masterName = data.masterName,
		disciples = data.disciples,
		sectId = data.sectId,
		sectRank = data.sectRank,
	})
end

function DataService.PushAll(player: Player)
	DataService.PushStats(player)
	DataService.PushInventory(player)
	DataService.PushTechniques(player)
	DataService.PushSocial(player)
end

-- ------------------------------ Lifecycle -------------------------------

local function onPlayerAdded(player: Player)
	local profile = load(player)
	if player.Parent == nil then
		return -- left while loading
	end
	profiles[player] = profile
	DataService.PushAll(player)
	loadedEvent:Fire(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		profiles[player] = nil
		save(player, profile)
	end
end

function DataService.Init()
	Net.initServer()

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		if profiles[player] == nil then
			task.spawn(onPlayerAdded, player)
		end
	end

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for player, profile in profiles do
			save(player, profile)
		end
	end)
end

function DataService.Start()
	while true do
		task.wait(Config.AUTOSAVE_SECONDS)
		for player, profile in profiles do
			task.spawn(save, player, profile)
		end
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DiscipleService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > DiscipleService
-- The master/disciple bond. Offers must be accepted, relationships
-- persist in both players' data, and everything downstream (transmission,
-- inheritance) checks these records server-side.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))

local DataService = require(script.Parent.DataService)

local DiscipleService = {}

local actionLimit = RateLimit.new(6, 5)

-- pendingOffers[discipleUserId] = masterUserId
local pendingOffers: { [number]: number } = {}

local function fail(message: string): { [string]: any }
	return { ok = false, error = message }
end

local function offerDiscipleship(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local targetName = (payload :: { [string]: unknown }).targetName
	if typeof(targetName) ~= "string" then
		return fail("Bad request")
	end
	local target = Players:FindFirstChild(targetName)
	if target == nil or not target:IsA("Player") then
		return fail("No such cultivator here.")
	end
	if target == player then
		return fail("One cannot kowtow to oneself.")
	end
	local targetData = DataService.Get(target :: Player)
	if targetData == nil then
		return fail("They are still arriving.")
	end
	if targetData.masterUserId ~= nil then
		return fail(`{target.Name} already serves a master.`)
	end
	if data.masterUserId == target.UserId then
		return fail("Your own master? The sect would talk.")
	end
	if #data.disciples >= Config.MAX_DISCIPLES then
		return fail(`You already guide {Config.MAX_DISCIPLES} disciples.`)
	end
	for _, disciple in data.disciples do
		if disciple.userId == target.UserId then
			return fail(`{target.Name} is already your disciple.`)
		end
	end

	pendingOffers[target.UserId] = player.UserId
	Net.remoteEvent("DiscipleOffer"):FireClient(target :: Player, {
		masterUserId = player.UserId,
		masterName = player.Name,
	})
	DataService.Notify(player, `You offer to take {target.Name} as your disciple.`)
	return { ok = true }
end

local function respondDiscipleship(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local accept = (payload :: { [string]: unknown }).accept
	local masterUserId = pendingOffers[player.UserId]
	pendingOffers[player.UserId] = nil
	if masterUserId == nil then
		return fail("No offer stands.")
	end
	local master = Players:GetPlayerByUserId(masterUserId)
	local masterData = if master then DataService.Get(master) else nil
	if master == nil or masterData == nil then
		return fail("The master has departed.")
	end
	if accept ~= true then
		DataService.Notify(master, `{player.Name} declines the bond.`)
		return { ok = true, accepted = false }
	end
	if data.masterUserId ~= nil then
		return fail("You already serve a master.")
	end
	if #masterData.disciples >= Config.MAX_DISCIPLES then
		return fail("Their hall is full.")
	end

	data.masterUserId = master.UserId
	data.masterName = master.Name
	table.insert(masterData.disciples, { userId = player.UserId, name = player.Name })

	DataService.Notify(player, `You bow. {master.Name} is now your master.`, Color3.fromRGB(255, 215, 120))
	DataService.Notify(master, `{player.Name} kneels and calls you master.`, Color3.fromRGB(255, 215, 120))
	DataService.PushSocial(player)
	DataService.PushSocial(master)
	return { ok = true, accepted = true }
end

local function renounceMaster(player: Player, _payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	local masterUserId = data.masterUserId
	if masterUserId == nil then
		return fail("You serve no master.")
	end
	data.masterUserId = nil
	data.masterName = nil

	local master = Players:GetPlayerByUserId(masterUserId)
	local masterData = if master then DataService.Get(master) else nil
	if master and masterData then
		for index, disciple in masterData.disciples do
			if disciple.userId == player.UserId then
				table.remove(masterData.disciples, index)
				break
			end
		end
		DataService.Notify(master, `{player.Name} has renounced you as master.`)
		DataService.PushSocial(master)
	end
	-- If the master is offline the stale entry is pruned the next time
	-- their disciple list is used; records always defer to the disciple's
	-- own masterUserId, which is authoritative.

	DataService.Notify(player, "The bond is cut. You walk alone again.")
	DataService.PushSocial(player)
	return { ok = true }
end

function DiscipleService.Init()
	Net.remoteFunction("OfferDiscipleship").OnServerInvoke = offerDiscipleship
	Net.remoteFunction("RespondDiscipleship").OnServerInvoke = respondDiscipleship
	Net.remoteFunction("RenounceMaster").OnServerInvoke = renounceMaster

	Players.PlayerRemoving:Connect(function(player)
		pendingOffers[player.UserId] = nil
		actionLimit:Forget(player.UserId)
	end)
end

return DiscipleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > InventoryService
-- Equipping gear and consuming items. Ownership lives in PlayerData and
-- only the server writes it; the client's inventory screen is a view.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Realms = require(Shared:WaitForChild("Realms"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))

local DataService = require(script.Parent.DataService)
local CultivationService = require(script.Parent.CultivationService)

local InventoryService = {}

local actionLimit = RateLimit.new(10, 4)

local function fail(message: string): { [string]: any }
	return { ok = false, error = message }
end

-- One endpoint for equip/unequip/use, switched on the item's kind.
local function equipItem(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local id = request.id
	local action = request.action -- "equip" | "unequip" | "use"
	if action == "unequip" then
		data.equippedWeapon = nil
		DataService.PushInventory(player)
		return { ok = true }
	end
	if typeof(id) ~= "string" then
		return fail("Bad request")
	end
	local def = Items.get(id)
	if def == nil then
		return fail("Unknown item")
	end
	if (data.items[id] or 0) < 1 then
		return fail("You do not own that.")
	end

	if action == "equip" then
		if def.kind ~= "weapon" then
			return fail("That cannot be wielded.")
		end
		if def.stageReq and data.stage < def.stageReq then
			return fail(`Needs {Realms.displayName(def.stageReq)} to wield.`)
		end
		data.equippedWeapon = id
		DataService.Notify(player, `You take up the {def.name}.`)
		DataService.PushInventory(player)
		return { ok = true }
	elseif action == "use" then
		if def.kind ~= "pill" then
			return fail("That is not something you swallow.")
		end
		data.items[id] -= 1
		if data.items[id] <= 0 then
			data.items[id] = nil
		end
		if def.restoreQiFrac then
			CultivationService.RestoreQi(player, CultivationService.MaxQi(player) * def.restoreQiFrac)
			DataService.Notify(player, `The {def.name} dissolves; qi floods back.`)
		end
		if def.healFrac then
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * def.healFrac)
			end
			DataService.Notify(player, `The {def.name} knits you back together.`)
		end
		DataService.PushInventory(player)
		return { ok = true }
	end
	return fail("Bad request")
end

function InventoryService.Init()
	Net.remoteFunction("EquipItem").OnServerInvoke = equipItem
	Players.PlayerRemoving:Connect(function(player)
		actionLimit:Forget(player.UserId)
	end)
end

-- Grant helper other systems (loot, quests) call.
function InventoryService.Grant(player: Player, itemId: string, count: number)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	data.items[itemId] = (data.items[itemId] or 0) + count
	local def = Items.get(itemId)
	DataService.Notify(player, `+{count} {if def then def.name else itemId}`)
	DataService.PushInventory(player)
end

function InventoryService.GrantStones(player: Player, amount: number)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	data.spiritStones += amount
	DataService.Notify(player, `+{amount} spirit stones`, Color3.fromRGB(150, 220, 255))
	DataService.PushStats(player)
	DataService.PushInventory(player)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">NpcService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > NpcService
-- The enemy framework: spirit beasts that wander, hunt, fight, die, drop,
-- and return. WorldService places tagged BeastSpawn markers; this system
-- populates them. Beast stats derive from their cultivation stage through
-- the same Realms curve players use, so region difficulty is honest.
--
-- All beast bodies are built from parts (no invented mesh ids). When real
-- models exist, swap buildBody for asset spawns and the AI is unchanged.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Realms = require(Shared:WaitForChild("Realms"))

local CombatService = require(script.Parent.CombatService)
local InventoryService = require(script.Parent.InventoryService)

local NpcService = {}

type BeastDef = {
	id: string,
	name: string,
	stageMin: number,
	stageMax: number,
	bodyColor: Color3,
	accentColor: Color3,
	size: number, -- overall scale
	walkSpeed: number,
	runSpeed: number,
	aggroRange: number,
	attackRange: number,
	attackCooldown: number,
	damageMult: number, -- vs its stage strength
	leash: number,
	respawnSeconds: number,
	stones: { min: number, max: number },
	drops: { { itemId: string, chance: number, count: number } },
}

local BEASTS: { [string]: BeastDef } = {
	mistfang = {
		id = "mistfang",
		name = "Mistfang Wolf",
		stageMin = 2,
		stageMax = 4,
		bodyColor = Color3.fromRGB(126, 132, 142),
		accentColor = Color3.fromRGB(210, 218, 228),
		size = 1,
		walkSpeed = 8,
		runSpeed = 17,
		aggroRange = 34,
		attackRange = 6.5,
		attackCooldown = 1.6,
		damageMult = 1,
		leash = 90,
		respawnSeconds = 25,
		stones = { min = 2, max = 5 },
		drops = {
			{ itemId = "beast_fang", chance = 0.6, count = 1 },
			{ itemId = "spirit_dust", chance = 0.35, count = 1 },
		},
	},
	thornback = {
		id = "thornback",
		name = "Thornback Boar",
		stageMin = 5,
		stageMax = 8,
		bodyColor = Color3.fromRGB(104, 82, 62),
		accentColor = Color3.fromRGB(58, 46, 38),
		size = 1.3,
		walkSpeed = 7,
		runSpeed = 19,
		aggroRange = 26,
		attackRange = 7,
		attackCooldown = 2,
		damageMult = 1.35,
		leash = 70,
		respawnSeconds = 40,
		stones = { min = 4, max = 9 },
		drops = {
			{ itemId = "beast_fang", chance = 0.5, count = 2 },
			{ itemId = "spirit_dust", chance = 0.5, count = 1 },
			{ itemId = "emberroot", chance = 0.2, count = 1 },
		},
	},
}

local rng = Random.new()

-- ------------------------------ Beast body -------------------------------

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, collide: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.CanCollide = collide
	if not collide then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function buildBody(def: BeastDef, position: Vector3): (Model, Humanoid, BasePart)
	local scale = def.size
	local model = Instance.new("Model")
	model.Name = def.name

	local root = part(model, "HumanoidRootPart",
		Vector3.new(4.4, 2.6, 6.5) * scale,
		CFrame.new(position + Vector3.new(0, 2.4 * scale, 0)),
		def.bodyColor, Enum.Material.SmoothPlastic, true)
	root.Transparency = 1

	-- Torso, head, muzzle, ears, tail, four stub legs. Stylized, honest.
	part(model, "Torso", Vector3.new(3.6, 2.6, 5.6) * scale,
		root.CFrame, def.bodyColor, Enum.Material.Fabric, false).Massless = true
	part(model, "Head", Vector3.new(2.2, 2, 2.4) * scale,
		root.CFrame * CFrame.new(0, 1 * scale, -3.4 * scale), def.bodyColor, Enum.Material.Fabric, false).Massless = true
	part(model, "Muzzle", Vector3.new(1.2, 1, 1.4) * scale,
		root.CFrame * CFrame.new(0, 0.6 * scale, -4.6 * scale), def.accentColor, Enum.Material.Fabric, false).Massless = true
	for side = -1, 1, 2 do
		part(model, "Ear", Vector3.new(0.6, 1, 0.4) * scale,
			root.CFrame * CFrame.new(side * 0.8 * scale, 2.1 * scale, -3.4 * scale), def.accentColor, Enum.Material.Fabric, false).Massless = true
		for along = -1, 1, 2 do
			part(model, "Leg", Vector3.new(0.9, 2.2, 0.9) * scale,
				root.CFrame * CFrame.new(side * 1.3 * scale, -1.6 * scale, along * 1.9 * scale), def.bodyColor, Enum.Material.Fabric, false).Massless = true
		end
	end
	part(model, "Tail", Vector3.new(0.6, 0.6, 2.2) * scale,
		root.CFrame * CFrame.new(0, 0.6 * scale, 3.6 * scale) * CFrame.Angles(math.rad(-25), 0, 0), def.accentColor, Enum.Material.Fabric, false).Massless = true

	-- Weld everything to the root so physics moves one assembly.
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = child
			weld.Parent = child
		end
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.AutoRotate = true
	humanoid.HipHeight = 1.2 * scale
	humanoid.Parent = model

	model.PrimaryPart = root
	CollectionService:AddTag(model, "Beast")
	return model, humanoid, root
end

-- -------------------------------- The AI ---------------------------------

local function nearestPrey(origin: Vector3, range: number): (Player?, BasePart?)
	local bestPlayer: Player? = nil
	local bestRoot: BasePart? = nil
	local bestDistance = range
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
			-- Beasts do not hunt into sanctuaries.
			if CombatService.InSafeZone(root.Position) then
				continue
			end
			local distance = (root.Position - origin).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				bestPlayer = player
				bestRoot = root
			end
		end
	end
	return bestPlayer, bestRoot
end

local function runBeast(def: BeastDef, home: Vector3, spawnStage: number)
	local model, humanoid, root = buildBody(def, home)
	local stats = Realms.statsFor(spawnStage)
	humanoid.MaxHealth = math.floor(stats.maxHealth * 0.8)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = def.walkSpeed
	humanoid:SetAttribute("Stage", spawnStage)
	humanoid:SetAttribute("DefenseFrac", stats.defenseFrac * 0.5)

	-- Name and realm over its head.
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(10, 2.4)
	gui.StudsOffset = Vector3.new(0, 3.4 * def.size, 0)
	gui.MaxDistance = 140
	gui.Adornee = root
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = `{def.name}\n{Realms.displayName(spawnStage)}`
	label.TextColor3 = Color3.fromRGB(255, 120, 100)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Font = Enum.Font.Garamond
	label.Parent = gui

	model.Parent = workspace
	root:SetNetworkOwner(nil) -- the server drives this body, always

	local lastAttack = 0
	local wanderTarget = home

	task.spawn(function()
		while model.Parent ~= nil and humanoid.Health > 0 do
			local origin = root.Position
			local overLeash = (origin - home).Magnitude > def.leash
			local prey: Player? = nil
			local preyRoot: BasePart? = nil
			if not overLeash then
				prey, preyRoot = nearestPrey(origin, def.aggroRange)
			end

			if prey and preyRoot then
				humanoid.WalkSpeed = def.runSpeed
				local distance = (preyRoot.Position - origin).Magnitude
				if distance <= def.attackRange then
					humanoid:MoveTo(origin)
					local now = os.clock()
					if now - lastAttack >= def.attackCooldown then
						lastAttack = now
						local target = (prey.Character :: Model):FindFirstChildOfClass("Humanoid")
						if target then
							local direction = (preyRoot.Position - origin)
							CombatService.DealDamage(nil, target, stats.strength * def.damageMult, {
								kind = "npc",
								direction = if direction.Magnitude > 0.01 then direction.Unit else Vector3.zAxis,
								knockback = 12,
							})
						end
					end
				else
					humanoid:MoveTo(preyRoot.Position)
				end
			else
				humanoid.WalkSpeed = def.walkSpeed
				if overLeash then
					humanoid:MoveTo(home)
					if (origin - home).Magnitude > def.leash * 1.5 then
						-- Hard reset: something dragged it too far.
						root.CFrame = CFrame.new(home + Vector3.new(0, 3, 0))
						humanoid.Health = humanoid.MaxHealth
					end
				else
					if (origin - wanderTarget).Magnitude < 4 or rng:NextNumber() < 0.15 then
						wanderTarget = home + Vector3.new(rng:NextNumber(-24, 24), 0, rng:NextNumber(-24, 24))
					end
					humanoid:MoveTo(wanderTarget)
				end
			end
			task.wait(0.4)
		end
	end)

	-- Death: linger briefly, vanish, and let the spawner refill the pack.
	humanoid.Died:Connect(function()
		task.delay(2.5, function()
			model:Destroy()
		end)
	end)

	return model, humanoid
end

-- ------------------------------- Spawners --------------------------------

local function runSpawner(marker: BasePart)
	local beastId = marker:GetAttribute("BeastId")
	local count = marker:GetAttribute("Count")
	local def = if typeof(beastId) == "string" then BEASTS[beastId] else nil
	if def == nil then
		warn(`[NpcService] Unknown beast id on {marker:GetFullName()}`)
		return
	end
	local wanted = if typeof(count) == "number" then count else 2

	task.spawn(function()
		local alive: { Model } = {}
		while marker.Parent ~= nil do
			-- Prune the fallen.
			for index = #alive, 1, -1 do
				local model = alive[index]
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if model.Parent == nil or humanoid == nil or humanoid.Health <= 0 then
					table.remove(alive, index)
				end
			end
			while #alive < wanted do
				local offset = Vector3.new(rng:NextNumber(-16, 16), 0, rng:NextNumber(-16, 16))
				local stage = rng:NextInteger(def.stageMin, def.stageMax)
				local model = (runBeast(def, marker.Position + offset, stage))
				table.insert(alive, model)
				task.wait(0.2)
			end
			task.wait(def.respawnSeconds)
		end
	end)
end

local function bindSpawner(marker: Instance)
	if marker:IsA("BasePart") then
		runSpawner(marker)
	end
end

-- --------------------------------- Loot ----------------------------------

local function onSlain(killer: Player?, victim: Humanoid)
	if killer == nil then
		return
	end
	local model = victim.Parent
	if model == nil or not CollectionService:HasTag(model, "Beast") then
		return
	end
	local defId: string? = nil
	for id, def in BEASTS do
		if def.name == model.Name then
			defId = id
			break
		end
	end
	local def = if defId then BEASTS[defId] else nil
	if def == nil then
		return
	end
	InventoryService.GrantStones(killer, rng:NextInteger(def.stones.min, def.stones.max))
	for _, drop in def.drops do
		if rng:NextNumber() < drop.chance then
			InventoryService.Grant(killer, drop.itemId, drop.count)
		end
	end
end

-- ------------------------------ Lifecycle -------------------------------

function NpcService.Init()
	CombatService.Slain:Connect(onSlain)
	for _, marker in CollectionService:GetTagged("BeastSpawn") do
		bindSpawner(marker)
	end
	CollectionService:GetInstanceAddedSignal("BeastSpawn"):Connect(bindSpawner)
end

return NpcService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">TechniqueService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > TechniqueService
-- The defining feature: player-created techniques. Creation from secure
-- components, hotbar slots, server-resolved casting, mastery by practice,
-- technique manuals as real inventory items, and master-to-disciple
-- transmission. Every number is recomputed server-side from the stored
-- design at cast time; a modified client gains nothing.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Realms = require(Shared:WaitForChild("Realms"))
local TechniqueMath = require(Shared:WaitForChild("TechniqueMath"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))

local DataService = require(script.Parent.DataService)
local CultivationService = require(script.Parent.CultivationService)
local CombatService = require(script.Parent.CombatService)

local TechniqueService = {}

local combatFx = Net.remoteEvent("CombatFx")
local castLimit = RateLimit.new(10, 1)
local editLimit = RateLimit.new(8, 5)

-- [userId][techniqueId] = os.clock() when ready again
local cooldowns: { [number]: { [string]: number } } = {}

local function fail(message: string): { [string]: any }
	return { ok = false, error = message }
end

local function findTechnique(data: Types.PlayerData, id: string): Types.Technique?
	for _, technique in data.techniques do
		if technique.id == id then
			return technique
		end
	end
	return nil
end

local function filterName(raw: string, userId: number): string
	local filtered = raw
	local ok, result = pcall(function()
		local obj = TextService:FilterStringAsync(raw, userId)
		return obj:GetNonChatStringForBroadcastAsync()
	end)
	if ok and typeof(result) == "string" then
		filtered = result
	end
	return filtered
end

local function characterParts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if character == nil then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root == nil or not root:IsA("BasePart") or humanoid == nil or humanoid.Health <= 0 then
		return character, nil, nil
	end
	return character, root, humanoid
end

local function humanoidFromPart(part: BasePart): Humanoid?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- --------------------------- Create / manage ----------------------------

local function createTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local category = request.category
	local components = request.components
	local intensity = request.intensity
	local name = request.name
	if typeof(category) ~= "string" or typeof(components) ~= "table" or typeof(intensity) ~= "number" or typeof(name) ~= "string" then
		return fail("Bad request")
	end
	local componentIds: { string } = {}
	for _, id in components :: { unknown } do
		if typeof(id) ~= "string" then
			return fail("Bad request")
		end
		table.insert(componentIds, id)
	end

	if #data.techniques >= Config.MAX_TECHNIQUES then
		return fail(`You can hold {Config.MAX_TECHNIQUES} techniques. Discard one first.`)
	end

	local computed, reason = TechniqueMath.compute(category, componentIds, intensity)
	if computed == nil then
		return fail(reason or "Invalid design")
	end
	if computed.requiredStage > data.stage then
		return fail(`A design of that power needs {Realms.displayName(computed.requiredStage)}.`)
	end

	local cost = math.floor(10 + computed.power * 0.5)
	if data.spiritStones < cost then
		return fail(`Recording this design needs {cost} spirit stones.`)
	end

	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	if #name < 1 or #name > Config.MAX_TECHNIQUE_NAME then
		return fail(`Name must be 1 to {Config.MAX_TECHNIQUE_NAME} characters.`)
	end
	name = filterName(name, player.UserId)

	data.spiritStones -= cost
	local technique: Types.Technique = {
		id = HttpService:GenerateGUID(false),
		name = name,
		category = category,
		components = componentIds,
		power = computed.power,
		masteryXp = 0,
		origin = nil,
		inherited = nil,
	}
	table.insert(data.techniques, technique)

	for slot = 1, Config.SLOT_COUNT do
		if data.slots[tostring(slot)] == nil then
			data.slots[tostring(slot)] = technique.id
			break
		end
	end

	DataService.Notify(player, `{name} takes shape: {computed.rank}, power {computed.power}.`, Color3.fromRGB(255, 215, 120))
	DataService.PushStats(player)
	DataService.PushTechniques(player)
	return { ok = true, technique = technique }
end

local function deleteTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local id = (payload :: { [string]: unknown }).id
	if typeof(id) ~= "string" then
		return fail("Bad request")
	end
	for index, technique in data.techniques do
		if technique.id == id then
			table.remove(data.techniques, index)
			for slot, slotted in data.slots do
				if slotted == id then
					data.slots[slot] = nil
				end
			end
			DataService.PushTechniques(player)
			return { ok = true }
		end
	end
	return fail("No such technique")
end

local function equipTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local slot = request.slot
	local id = request.id
	if typeof(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > Config.SLOT_COUNT then
		return fail("Bad slot")
	end
	if id ~= nil and typeof(id) ~= "string" then
		return fail("Bad request")
	end
	if id ~= nil then
		if findTechnique(data, id :: string) == nil then
			return fail("No such technique")
		end
		for existingSlot, slotted in data.slots do
			if slotted == id then
				data.slots[existingSlot] = nil
			end
		end
		data.slots[tostring(slot)] = id :: string
	else
		data.slots[tostring(slot)] = nil
	end
	DataService.PushTechniques(player)
	return { ok = true }
end

-- ------------------------------- Casting --------------------------------

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function strikeBox(player: Player, root: BasePart, direction: Vector3, reach: number, damage: number)
	local boxCFrame = CFrame.lookAt(root.Position, root.Position + direction) * CFrame.new(0, 0, -reach / 2)
	overlapParams.FilterDescendantsInstances = { player.Character :: any }
	local seen: { [Humanoid]: boolean } = {}
	for _, part in workspace:GetPartBoundsInBox(boxCFrame, Vector3.new(reach, 7, reach), overlapParams) do
		local humanoid = humanoidFromPart(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			CombatService.DealDamage(player, humanoid, damage, { kind = "technique", direction = direction, knockback = 14 })
		end
	end
end

local function burstSphere(player: Player, center: Vector3, radius: number, damage: number)
	overlapParams.FilterDescendantsInstances = { player.Character :: any }
	local seen: { [Humanoid]: boolean } = {}
	for _, part in workspace:GetPartBoundsInRadius(center, radius, overlapParams) do
		local humanoid = humanoidFromPart(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			local away = part.Position - center
			local direction = if away.Magnitude > 0.01 then away.Unit else Vector3.yAxis
			CombatService.DealDamage(player, humanoid, damage, { kind = "technique", direction = direction, knockback = 22, dodgeable = false })
		end
	end
end

local function runWave(player: Player, origin: Vector3, direction: Vector3, speed: number, range: number, damage: number)
	task.spawn(function()
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = { player.Character :: any }
		local position = origin
		local traveled = 0
		local unit = direction.Unit
		while traveled < range do
			local dt = task.wait()
			local step = math.min(speed * dt, range - traveled)
			local result = workspace:Raycast(position, unit * step, rayParams)
			if result then
				local humanoid = humanoidFromPart(result.Instance)
				if humanoid then
					CombatService.DealDamage(player, humanoid, damage, { kind = "technique", direction = unit, knockback = 18 })
				end
				return -- waves stop on whatever they meet
			end
			position += unit * step
			traveled += step
		end
	end)
end

local function castTechnique(player: Player, slotArg: unknown, aimArg: unknown)
	if not castLimit:Allow(player.UserId) then
		return
	end
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	if typeof(slotArg) ~= "number" or slotArg % 1 ~= 0 or slotArg < 1 or slotArg > Config.SLOT_COUNT then
		return
	end
	local techniqueId = data.slots[tostring(slotArg)]
	if techniqueId == nil then
		return
	end
	local technique = findTechnique(data, techniqueId)
	if technique == nil then
		return
	end

	local _, root, humanoid = characterParts(player)
	if root == nil or humanoid == nil then
		return
	end

	local computed = (TechniqueMath.compute(technique.category, technique.components, 1))
	-- Recompute from the STORED power (intensity already folded in at
	-- creation): compute() at intensity 1 gives shape; scale to potential.
	if computed == nil then
		return
	end
	local basePower = math.max(computed.power, 1)
	local potentialScale = technique.power / basePower

	-- Realm gate and the inheritance ceiling.
	local effectivePower = TechniqueMath.effectivePower(technique, data.stage)
	if effectivePower <= 0 then
		DataService.Notify(player, "This art is beyond your current realm.")
		return
	end
	local outputScale = effectivePower / technique.power

	-- Sword arts need a sword in hand.
	local weaponMult, qiMult = CombatService.WeaponMultipliers(player)
	if technique.category == "sword" then
		local weaponId = data.equippedWeapon
		if weaponId == nil then
			DataService.Notify(player, "A sword art needs a sword in hand.")
			return
		end
	end

	local masteryPct = TechniqueMath.masteryPercent(technique.masteryXp, technique.power)

	-- Cooldown
	local userCooldowns = cooldowns[player.UserId]
	if userCooldowns == nil then
		userCooldowns = {}
		cooldowns[player.UserId] = userCooldowns
	end
	local now = os.clock()
	local readyAt = userCooldowns[technique.id]
	if readyAt and now < readyAt then
		return
	end

	-- Qi price, eased by mastery.
	local qiCost = math.max(1, math.floor(computed.qiCost * potentialScale * TechniqueMath.masteryQiMult(masteryPct) + 0.5))
	if not CultivationService.Spend(player, qiCost) then
		DataService.Notify(player, "Not enough qi.")
		return
	end
	userCooldowns[technique.id] = now + computed.cooldown * TechniqueMath.masteryCooldownMult(masteryPct)
	DataService.SetMeditating(player, false)

	-- Aim
	local aim = if typeof(aimArg) == "Vector3" and (aimArg :: Vector3).Magnitude < 1e5
		then aimArg :: Vector3
		else root.Position + root.CFrame.LookVector * 10
	local direction = CombatService.MeleeDirection(root, aim)

	local totalDamage = computed.damage * potentialScale * outputScale
		* TechniqueMath.masteryDamageMult(masteryPct)
		* weaponMult
		* (if technique.category == "qi" then qiMult else 1)

	-- Damage divides across the damaging steps by their shares.
	local shareSum = 0
	for _, step in computed.steps do
		shareSum += step.damageShare or 0
	end

	-- Execute the chain, one component per beat.
	task.spawn(function()
		for index, step in computed.steps do
			if index > 1 then
				task.wait(0.28)
			end
			local _, rootNow, humanoidNow = characterParts(player)
			if rootNow == nil or humanoidNow == nil then
				return
			end
			local stepDamage = if shareSum > 0 and step.damageShare
				then totalDamage * (step.damageShare / shareSum)
				else 0
			local reach = (step.distance or 10) * computed.reachMult

			if step.kind == "motion" then
				if step.id == "blink_step" then
					-- Server-moved: a stitch through space, stopped by walls.
					local rayParams = RaycastParams.new()
					rayParams.FilterType = Enum.RaycastFilterType.Exclude
					rayParams.FilterDescendantsInstances = { player.Character :: any }
					local distance = reach
					local blocked = workspace:Raycast(rootNow.Position, direction * distance, rayParams)
					if blocked then
						distance = math.max(0, (blocked.Position - rootNow.Position).Magnitude - 3)
					end
					rootNow.CFrame = CFrame.lookAt(rootNow.Position + direction * distance, rootNow.Position + direction * (distance + 10))
				end
				-- dash/leap velocity is applied by the caster's own client
				-- on the CombatFx event below (it owns its physics).
			elseif step.kind == "strike" then
				strikeBox(player, rootNow, direction, reach, stepDamage)
			elseif step.kind == "wave" then
				runWave(player, rootNow.Position + direction * 3, direction, step.speed or 90, reach, stepDamage)
			elseif step.kind == "burst" then
				burstSphere(player, rootNow.Position, (step.radius or 12) * computed.reachMult, stepDamage)
			end

			combatFx:FireAllClients({
				kind = "techniqueStep",
				userId = player.UserId,
				partId = step.id,
				stepKind = step.kind,
				category = technique.category,
				origin = rootNow.Position,
				direction = direction,
				reach = reach,
				radius = (step.radius or 12) * computed.reachMult,
				speed = step.speed or 90,
			})
		end
	end)

	-- Practice tempers the art and the artist.
	CultivationService.AddXp(player, 1 + technique.power * 0.01)
	if masteryPct < Config.MASTERY_MAX then
		technique.masteryXp += 2 + math.floor(technique.power * 0.02)
		local newPct = TechniqueMath.masteryPercent(technique.masteryXp, technique.power)
		if newPct >= 100 and masteryPct < 100 then
			DataService.Notify(player, `You have fully MASTERED {technique.name}. You may now write its manual, or pass it to a disciple.`, Color3.fromRGB(255, 215, 120))
			DataService.PushTechniques(player)
		elseif math.floor(newPct / 25) > math.floor(masteryPct / 25) then
			DataService.Notify(player, `{technique.name} mastery: {newPct}%.`)
			DataService.PushTechniques(player)
		end
	end
end

-- ---------------------- Manuals & transmission ---------------------------

local MANUAL_COST = 25

local function writeManual(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local id = (payload :: { [string]: unknown }).id
	if typeof(id) ~= "string" then
		return fail("Bad request")
	end
	local technique = findTechnique(data, id)
	if technique == nil then
		return fail("No such technique")
	end
	if technique.inherited then
		return fail("An inherited art cannot be transcribed; only its original creator may write manuals.")
	end
	if TechniqueMath.masteryPercent(technique.masteryXp, technique.power) < 100 then
		return fail("Only a fully mastered art can be written down.")
	end
	if data.spiritStones < MANUAL_COST then
		return fail(`Ink, silk and patience: writing a manual costs {MANUAL_COST} spirit stones.`)
	end

	data.spiritStones -= MANUAL_COST
	local bookId = HttpService:GenerateGUID(false)
	data.manuals[bookId] = {
		bookId = bookId,
		techniqueName = technique.name,
		technique = {
			id = technique.id, -- references the original TechniqueId
			name = technique.name,
			category = technique.category,
			components = table.clone(technique.components),
			power = technique.power,
			masteryXp = 0,
			origin = player.Name,
			inherited = true,
		},
	}
	DataService.Notify(player, `You bind "{technique.name}" into a manual. Give it wisely.`, Color3.fromRGB(255, 215, 120))
	DataService.PushStats(player)
	DataService.PushInventory(player)
	return { ok = true, bookId = bookId }
end

local function useManual(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local bookId = (payload :: { [string]: unknown }).bookId
	if typeof(bookId) ~= "string" then
		return fail("Bad request")
	end
	local manual = data.manuals[bookId]
	if manual == nil then
		return fail("You do not hold that manual.")
	end
	if #data.techniques >= Config.MAX_TECHNIQUES then
		return fail(`You already hold {Config.MAX_TECHNIQUES} techniques.`)
	end
	for _, owned in data.techniques do
		if owned.name == manual.technique.name and owned.category == manual.technique.category then
			return fail(`You already know {manual.technique.name}.`)
		end
	end

	local learned: Types.Technique = {
		id = HttpService:GenerateGUID(false),
		name = manual.technique.name,
		category = manual.technique.category,
		components = table.clone(manual.technique.components),
		power = manual.technique.power,
		masteryXp = 0,
		origin = manual.technique.origin,
		inherited = true,
	}
	table.insert(data.techniques, learned)
	data.manuals[bookId] = nil
	for slot = 1, Config.SLOT_COUNT do
		if data.slots[tostring(slot)] == nil then
			data.slots[tostring(slot)] = learned.id
			break
		end
	end
	DataService.Notify(player, `The pages of "{learned.name}" burn themselves into memory.`, Color3.fromRGB(255, 215, 120))
	DataService.PushInventory(player)
	DataService.PushTechniques(player)
	return { ok = true }
end

local function giveManual(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local bookId = request.bookId
	local targetUserId = request.targetUserId
	if typeof(bookId) ~= "string" or typeof(targetUserId) ~= "number" then
		return fail("Bad request")
	end
	local manual = data.manuals[bookId]
	if manual == nil then
		return fail("You do not hold that manual.")
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	local targetData = if target then DataService.Get(target) else nil
	if target == nil or targetData == nil then
		return fail("They must be here, in this world, to receive it.")
	end
	-- Hand to hand: both parties present and close.
	local _, myRoot = characterParts(player)
	local _, theirRoot = characterParts(target)
	if myRoot == nil or theirRoot == nil or (myRoot.Position - theirRoot.Position).Magnitude > 24 then
		return fail("Stand beside them to hand over a manual.")
	end

	data.manuals[bookId] = nil
	targetData.manuals[bookId] = manual
	DataService.Notify(player, `You hand "{manual.techniqueName}" to {target.Name}.`)
	DataService.Notify(target, `{player.Name} places a manual in your hands: "{manual.techniqueName}".`, Color3.fromRGB(255, 215, 120))
	DataService.PushInventory(player)
	DataService.PushInventory(target)
	return { ok = true }
end

-- Direct transmission: master to own disciple, mastered arts only.
local function teachTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local id = request.id
	local targetUserId = request.targetUserId
	if typeof(id) ~= "string" or typeof(targetUserId) ~= "number" then
		return fail("Bad request")
	end
	local technique = findTechnique(data, id)
	if technique == nil then
		return fail("No such technique")
	end
	if TechniqueMath.masteryPercent(technique.masteryXp, technique.power) < 100 then
		return fail("Master an art fully before passing it down.")
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	local targetData = if target then DataService.Get(target) else nil
	if target == nil or targetData == nil then
		return fail("Your disciple must be here, in this world.")
	end
	if targetData.masterUserId ~= player.UserId then
		return fail("Transmission passes only from master to disciple.")
	end
	if #targetData.techniques >= Config.MAX_TECHNIQUES then
		return fail(`{target.Name} already holds {Config.MAX_TECHNIQUES} techniques.`)
	end
	for _, owned in targetData.techniques do
		if owned.name == technique.name and owned.category == technique.category then
			return fail(`{target.Name} already knows {technique.name}.`)
		end
	end

	local inherited: Types.Technique = {
		id = HttpService:GenerateGUID(false),
		name = technique.name,
		category = technique.category,
		components = table.clone(technique.components),
		power = technique.power,
		masteryXp = 0,
		origin = technique.origin or player.Name,
		inherited = true,
	}
	table.insert(targetData.techniques, inherited)
	for slot = 1, Config.SLOT_COUNT do
		if targetData.slots[tostring(slot)] == nil then
			targetData.slots[tostring(slot)] = inherited.id
			break
		end
	end
	DataService.Notify(target, `Your master {player.Name} transmits {technique.name} to you!`, Color3.fromRGB(255, 215, 120))
	DataService.Notify(player, `You pass {technique.name} down to {target.Name}. Teaching sharpens your own dao.`)
	CultivationService.AddXp(player, 40)
	DataService.PushTechniques(target)
	return { ok = true }
end

-- ------------------------------ Lifecycle -------------------------------

function TechniqueService.Init()
	Net.remoteFunction("CreateTechnique").OnServerInvoke = createTechnique
	Net.remoteFunction("DeleteTechnique").OnServerInvoke = deleteTechnique
	Net.remoteFunction("EquipTechnique").OnServerInvoke = equipTechnique
	Net.remoteFunction("WriteManual").OnServerInvoke = writeManual
	Net.remoteFunction("UseManual").OnServerInvoke = useManual
	Net.remoteFunction("GiveManual").OnServerInvoke = giveManual
	Net.remoteFunction("TeachTechnique").OnServerInvoke = teachTechnique
	Net.remoteEvent("CastTechnique").OnServerEvent:Connect(castTechnique)

	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player.UserId] = nil
		castLimit:Forget(player.UserId)
		editLimit:Forget(player.UserId)
	end)
end

return TechniqueService
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="22">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">Flora</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Flora
-- Vegetation for the vale: cone pines (snowy up high), blossom trees,
-- bamboo clumps, boulders, shrubs and fallen logs. Placement queries
-- Terrain.heightAt and slopeAt directly, so trees stand ON the ground,
-- refuse cliffs, keep out of the river, the village, the roads' corridor
-- and the sacred clearings. Crowns never collide and never eat a
-- projectile; trunks do.

local Kit = require(script.Parent.Kit)
local Terrain = require(script.Parent.Terrain)

local Flora = {}

local TRUNK = Color3.fromRGB(92, 70, 52)
local PINE_GREEN = Color3.fromRGB(52, 84, 60)
local PINE_DARK = Color3.fromRGB(40, 66, 48)
local SNOW_WHITE = Color3.fromRGB(238, 242, 246)
local BLOSSOM_PINK = Color3.fromRGB(240, 184, 205)
local BLOSSOM_WHITE = Color3.fromRGB(246, 238, 230)
local BAMBOO_GREEN = Color3.fromRGB(126, 168, 92)

local function puff(parent: Instance, position: Vector3, size: Vector3, color: Color3)
	local part = Kit.part({
		name = "Foliage",
		size = Vector3.new(1, 1, 1),
		position = position,
		color = color,
		material = Enum.Material.Grass,
		canCollide = false,
		castShadow = false,
		parent = parent,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = size
	mesh.Parent = part
end

local function pineTree(parent: Instance, position: Vector3, rng: Random, snowy: boolean)
	local height = rng:NextNumber(24, 42)
	local lean = rng:NextNumber(-0.06, 0.06)
	Kit.part({
		name = "Pine_Trunk",
		size = Vector3.new(2.6, height, 2.6),
		cframe = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(lean, 0, lean),
		color = TRUNK,
		material = Enum.Material.Wood,
		parent = parent,
	})
	local layers = rng:NextInteger(4, 5)
	for layer = 1, layers do
		local t = (layer - 1) / layers
		local layerY = position.Y + height * (0.5 + 0.55 * t)
		local diameter = (22 - t * 13) * rng:NextNumber(0.9, 1.12)
		local color = if snowy and layer == layers
			then SNOW_WHITE
			elseif layer % 2 == 0 then PINE_DARK
			else PINE_GREEN
		Kit.cylinder(parent, "Pine_Canopy", Vector3.new(position.X, layerY, position.Z), height * 0.14, diameter,
			color, if snowy and layer == layers then Enum.Material.Snow else Enum.Material.Grass, false)
	end
	Kit.cylinder(parent, "Pine_Tip", Vector3.new(position.X, position.Y + height * 1.08, position.Z), height * 0.12, 5,
		if snowy then SNOW_WHITE else PINE_GREEN, if snowy then Enum.Material.Snow else Enum.Material.Grass, false, false)
end

local function blossomTree(parent: Instance, position: Vector3, rng: Random)
	local height = rng:NextNumber(18, 28)
	local lean = rng:NextNumber(-0.12, 0.12)
	Kit.part({
		name = "Blossom_Trunk",
		size = Vector3.new(2.2, height, 2.2),
		cframe = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(lean, 0, -lean),
		color = Color3.fromRGB(70, 54, 44),
		material = Enum.Material.Wood,
		parent = parent,
	})
	local crown = position + Vector3.new(lean * height * 4, height, lean * height * 4)
	for _ = 1, rng:NextInteger(4, 6) do
		local offset = Vector3.new(rng:NextNumber(-7, 7), rng:NextNumber(-2, 5), rng:NextNumber(-7, 7))
		local width = rng:NextNumber(9, 14)
		puff(parent, crown + offset, Vector3.new(width, width * 0.65, width),
			if rng:NextNumber() < 0.7 then BLOSSOM_PINK else BLOSSOM_WHITE)
	end
end

local function bambooClump(parent: Instance, position: Vector3, rng: Random)
	for _ = 1, rng:NextInteger(4, 6) do
		local culmHeight = rng:NextNumber(34, 56)
		local base = position + Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5))
		Kit.part({
			name = "Bamboo_Culm",
			size = Vector3.new(1.3, culmHeight, 1.3),
			cframe = CFrame.new(base + Vector3.new(0, culmHeight / 2, 0))
				* CFrame.Angles(rng:NextNumber(-0.05, 0.05), 0, rng:NextNumber(-0.05, 0.05)),
			color = BAMBOO_GREEN,
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		local top = base + Vector3.new(0, culmHeight, 0)
		puff(parent, top, Vector3.new(rng:NextNumber(10, 14), rng:NextNumber(6, 8), rng:NextNumber(10, 14)), Color3.fromRGB(104, 146, 78))
		puff(parent, top + Vector3.new(rng:NextNumber(-5, 5), -rng:NextNumber(4, 8), rng:NextNumber(-5, 5)),
			Vector3.new(rng:NextNumber(7, 10), rng:NextNumber(4, 6), rng:NextNumber(7, 10)), Color3.fromRGB(126, 166, 92))
	end
end

local function boulder(parent: Instance, position: Vector3, rng: Random, snowy: boolean)
	local size = rng:NextNumber(4, 11)
	Kit.part({
		name = "Boulder",
		size = Vector3.new(size, size * 0.7, size * rng:NextNumber(0.7, 1.3)),
		cframe = CFrame.new(position + Vector3.new(0, size * 0.2, 0))
			* CFrame.Angles(rng:NextNumber(0, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(0, 0.3)),
		color = if snowy then Color3.fromRGB(205, 212, 220) else Color3.fromRGB(120, 116, 112),
		material = Enum.Material.Slate,
		parent = parent,
	})
end

local function fallenLog(parent: Instance, position: Vector3, rng: Random)
	local length = rng:NextNumber(8, 13)
	Kit.part({
		name = "FallenLog",
		size = Vector3.new(length, 2, 2),
		cframe = CFrame.new(position + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
		color = Color3.fromRGB(86, 66, 48),
		material = Enum.Material.Wood,
		shape = Enum.PartType.Cylinder,
		parent = parent,
	})
end

local function shrubs(parent: Instance, position: Vector3, rng: Random)
	for _ = 1, rng:NextInteger(2, 3) do
		local size = rng:NextNumber(3, 5.5)
		puff(parent, position + Vector3.new(rng:NextNumber(-4, 4), size * 0.3, rng:NextNumber(-4, 4)),
			Vector3.new(size, size * 0.7, size),
			if rng:NextNumber() < 0.8 then Color3.fromRGB(78, 112, 64) else Color3.fromRGB(126, 150, 84))
	end
end

-- ------------------------------- Scatter ---------------------------------

-- Corridors trees must respect (the roads laid by Vale, by construction).
local ROAD_LINES: { { Vector2 } } = {
	{ Vector2.new(170, 262), Vector2.new(140, 288), Vector2.new(122, 296) },
	{ Vector2.new(42, 308), Vector2.new(-40, 300), Vector2.new(-140, 270) },
	{ Vector2.new(170, 96), Vector2.new(150, 20), Vector2.new(110, -70), Vector2.new(80, -140) },
	{ Vector2.new(226, 150), Vector2.new(320, 110), Vector2.new(392, 74) },
}

local function nearRoad(x: number, z: number): boolean
	for _, line in ROAD_LINES do
		for index = 1, #line - 1 do
			local a = line[index]
			local b = line[index + 1]
			local abx, abz = b.X - a.X, b.Y - a.Y
			local lengthSq = abx * abx + abz * abz
			local t = math.clamp(((x - a.X) * abx + (z - a.Y) * abz) / lengthSq, 0, 1)
			local cx, cz = a.X + abx * t, a.Y + abz * t
			if (x - cx) ^ 2 + (z - cz) ^ 2 < 13 * 13 then
				return true
			end
		end
	end
	return false
end

function Flora.build(parent: Instance)
	local rng = Random.new(9)
	local planted = 0
	local attempts = 0
	while planted < 230 and attempts < 900 do
		attempts += 1
		local x = rng:NextNumber(-680, 680)
		local z = rng:NextNumber(-680, 680)
		local h = Terrain.heightAt(x, z)
		if h < 3 or h > 200 then
			continue -- beach, sea, or the bare heights
		end
		if Terrain.slopeAt(x, z) > 0.65 then
			continue -- cliffs keep no orchards
		end
		if (Vector2.new(x, z) - Terrain.VILLAGE).Magnitude < 175 then
			continue
		end
		if (Vector2.new(x, z) - Terrain.GROVE).Magnitude < 60 then
			continue
		end
		if (Vector2.new(x, z) - Terrain.SHELF).Magnitude < 40 then
			continue
		end
		if Terrain.riverDistance(x, z) < 26 then
			continue
		end
		if nearRoad(x, z) then
			continue
		end
		planted += 1
		local position = Vector3.new(x, h, z)
		local roll = rng:NextNumber()
		if h > 110 then
			-- Mountain country: pines, snow-dusted higher up, and stone.
			if roll < 0.7 then
				pineTree(parent, position, rng, h > 150)
			else
				boulder(parent, position, rng, h > 150)
			end
		elseif x > 300 then
			-- The east runs to bamboo.
			if roll < 0.5 then
				bambooClump(parent, position, rng)
			elseif roll < 0.8 then
				blossomTree(parent, position, rng)
			else
				shrubs(parent, position, rng)
			end
		else
			if roll < 0.34 then
				pineTree(parent, position, rng, false)
			elseif roll < 0.6 then
				blossomTree(parent, position, rng)
			elseif roll < 0.74 then
				boulder(parent, position, rng, false)
			elseif roll < 0.88 then
				shrubs(parent, position, rng)
			else
				fallenLog(parent, position, rng)
			end
		end
	end
end

return Flora
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Kit
-- The construction toolkit for the handcrafted world. Xianxia
-- architecture: curved tiled roofs with upturned corners, timber-framed
-- halls on stone plinths, pavilions, paifang gates, round paper lanterns.
--
-- Standing rules, all learned the hard way:
--  * Decoration never collides, never answers queries, never eats a
--    projectile: canCollide=false implies CanQuery/CanTouch=false.
--  * Small decor casts no shadows (castShadow=false); there is a budget.
--  * Lanterns are BALLS with caps and tassels, never bare neon cubes.
--  * Doors are real openings; halls have interiors.
--  * Everything is placed at true ground height by the caller (the
--    terrain module exposes exact heights; nothing floats, nothing sinks).

local CollectionService = game:GetService("CollectionService")

local Kit = {}

export type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame?,
	position: Vector3?,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	castShadow: boolean?,
	shape: Enum.PartType?,
	parent: Instance,
}

function Kit.part(props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.name or "Part"
	part.Size = props.size
	if props.cframe then
		part.CFrame = props.cframe
	elseif props.position then
		part.Position = props.position
	end
	part.Color = props.color or Color3.fromRGB(163, 162, 165)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	local canCollide = if props.canCollide == nil then true else props.canCollide
	part.CanCollide = canCollide
	if not canCollide then
		part.CanQuery = false
		part.CanTouch = false
	end
	if props.castShadow == false then
		part.CastShadow = false
	end
	if props.shape then
		part.Shape = props.shape
	end
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = props.parent
	return part
end

function Kit.wedge(props: PartProps): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = props.name or "Wedge"
	wedge.Size = props.size
	if props.cframe then
		wedge.CFrame = props.cframe
	elseif props.position then
		wedge.Position = props.position
	end
	wedge.Color = props.color or Color3.fromRGB(163, 162, 165)
	wedge.Material = props.material or Enum.Material.SmoothPlastic
	wedge.Transparency = props.transparency or 0
	local canCollide = if props.canCollide == nil then true else props.canCollide
	wedge.CanCollide = canCollide
	if not canCollide then
		wedge.CanQuery = false
		wedge.CanTouch = false
	end
	if props.castShadow == false then
		wedge.CastShadow = false
	end
	wedge.Anchored = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = props.parent
	return wedge
end

-- Vertical cylinder (Roblox cylinders lie along X; this stands one up).
function Kit.cylinder(parent: Instance, name: string, center: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material, canCollide: boolean?, castShadow: boolean?): Part
	return Kit.part({
		name = name,
		size = Vector3.new(height, diameter, diameter),
		cframe = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		material = material,
		canCollide = canCollide,
		castShadow = castShadow,
		shape = Enum.PartType.Cylinder,
		parent = parent,
	})
end

-- ------------------------------- Roofs ----------------------------------

-- A Chinese tiled roof about a yaw frame: cap, four sloping eaves, ridge
-- beam, upturned corner tips, gable ornaments.
function Kit.roof(parent: Instance, cf: CFrame, width: number, depth: number, y: number, color: Color3, material: Enum.Material?)
	local mat = material or Enum.Material.Slate
	local overhang = 5
	local capW = width + overhang * 2
	local capD = depth + overhang * 2
	local function at(offset: Vector3): CFrame
		return cf * CFrame.new(offset)
	end
	Kit.part({
		name = "Roof_Cap",
		size = Vector3.new(capW, 2, capD),
		cframe = at(Vector3.new(0, y + 1, 0)),
		color = color,
		material = mat,
		parent = parent,
	})
	local sides = { Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) }
	for _, dir in sides do
		local len = if dir.Z ~= 0 then capW else capD
		local off = if dir.Z ~= 0 then capD / 2 + 2 else capW / 2 + 2
		local edge = at(dir * off + Vector3.new(0, y + 0.8, 0))
		local outward = at(dir * (off + 5) + Vector3.new(0, y + 0.8, 0))
		Kit.wedge({
			name = "Roof_Eave",
			size = Vector3.new(len + 2, 2.4, 4.4),
			cframe = CFrame.lookAt(edge.Position, outward.Position) * CFrame.Angles(0, math.pi, 0),
			color = color,
			material = mat,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
	end
	local alongX = width >= depth
	local ridgeLen = (if alongX then width else depth) * 0.7
	Kit.part({
		name = "Roof_Ridge",
		size = if alongX then Vector3.new(ridgeLen, 1.4, 1.8) else Vector3.new(1.8, 1.4, ridgeLen),
		cframe = at(Vector3.new(0, y + 2.3, 0)),
		color = color,
		material = mat,
		canCollide = false,
		castShadow = false,
		parent = parent,
	})
	for cornerX = -1, 1, 2 do
		for cornerZ = -1, 1, 2 do
			Kit.wedge({
				name = "Roof_Upturn",
				size = Vector3.new(3, 2, 3.6),
				cframe = at(Vector3.new(cornerX * (capW / 2 + 1.4), y + 1.4, cornerZ * (capD / 2 + 1.4)))
					* CFrame.Angles(0, math.atan2(cornerX :: number, cornerZ :: number), 0)
					* CFrame.Angles(math.rad(-28), 0, 0),
				color = color,
				material = mat,
				canCollide = false,
				castShadow = false,
				parent = parent,
			})
		end
	end
end

-- ------------------------------ Lanterns ---------------------------------

-- Round red paper lantern with cap and tassel. The only lantern shape in
-- the game; bare neon cubes are banned by bitter experience.
function Kit.lantern(parent: Instance, position: Vector3, diameter: number, withLight: boolean): Part
	local ball = Kit.part({
		name = "Lantern_Ball",
		size = Vector3.new(diameter, diameter, diameter),
		position = position,
		color = Color3.fromRGB(226, 66, 46),
		material = Enum.Material.Neon,
		canCollide = false,
		castShadow = false,
		shape = Enum.PartType.Ball,
		parent = parent,
	})
	Kit.part({
		name = "Lantern_Cap",
		size = Vector3.new(diameter * 0.5, 0.45, diameter * 0.5),
		position = position + Vector3.new(0, diameter * 0.55, 0),
		color = Color3.fromRGB(56, 42, 32),
		material = Enum.Material.Wood,
		canCollide = false,
		castShadow = false,
		parent = parent,
	})
	Kit.part({
		name = "Lantern_Tassel",
		size = Vector3.new(0.28, diameter * 0.5, 0.28),
		position = position - Vector3.new(0, diameter * 0.7, 0),
		color = Color3.fromRGB(206, 172, 84),
		material = Enum.Material.Fabric,
		canCollide = false,
		castShadow = false,
		parent = parent,
	})
	if withLight then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 158, 108)
		light.Brightness = 1.3
		light.Range = 24
		light.Shadows = false
		light.Parent = ball
	end
	return ball
end

-- A wooden post with a hanging lantern; the street light of the vale.
function Kit.lanternPost(parent: Instance, position: Vector3, withLight: boolean)
	Kit.part({
		name = "LanternPost",
		size = Vector3.new(0.9, 10, 0.9),
		position = position + Vector3.new(0, 5, 0),
		color = Color3.fromRGB(74, 53, 39),
		material = Enum.Material.Wood,
		parent = parent,
	})
	Kit.part({
		name = "LanternPost_Arm",
		size = Vector3.new(0.7, 0.7, 3),
		position = position + Vector3.new(0, 9.6, 1.4),
		color = Color3.fromRGB(74, 53, 39),
		material = Enum.Material.Wood,
		canCollide = false,
		castShadow = false,
		parent = parent,
	})
	Kit.lantern(parent, position + Vector3.new(0, 8.2, 2.6), 1.9, withLight)
end

-- ------------------------------ Buildings --------------------------------

export type HouseSpec = {
	width: number,
	depth: number,
	floors: number,
	plaster: Color3,
	timber: Color3,
	roofColor: Color3,
	roofMaterial: Enum.Material?,
	hollow: boolean?, -- true = enterable room with furniture
	lanternLights: boolean?,
}

local STONE = Color3.fromRGB(148, 146, 142)

function Kit.house(parent: Instance, cf: CFrame, spec: HouseSpec)
	local w, d = spec.width, spec.depth
	local floorHeight = 13
	local seed = Random.new(math.floor(cf.X * 7 + cf.Z * 13) % 100000)
	local tint = seed:NextNumber(-0.04, 0.05)
	local plaster = if tint >= 0
		then spec.plaster:Lerp(Color3.new(1, 1, 1), tint)
		else spec.plaster:Lerp(Color3.fromRGB(96, 84, 66), -tint)
	local timber = spec.timber
	local doorW = if spec.hollow then 9 else 6.5
	local doorX = if spec.hollow then 0 else -w / 4
	local function at(offset: Vector3): CFrame
		return cf * CFrame.new(offset)
	end

	-- Stone plinth and steps to the door.
	Kit.part({
		name = "House_Plinth",
		size = Vector3.new(w + 5, 2.2, d + 5),
		cframe = at(Vector3.new(0, 1.1, 0)),
		color = STONE,
		material = Enum.Material.Slate,
		parent = parent,
	})
	for stepIndex = 1, 3 do
		Kit.part({
			name = "House_Step",
			size = Vector3.new(doorW + 4, 0.7, 1.7),
			cframe = at(Vector3.new(doorX, 2.2 - stepIndex * 0.7, d / 2 + 2.6 + stepIndex * 1.5)),
			color = STONE,
			material = Enum.Material.Slate,
			parent = parent,
		})
	end

	local y = 2.2
	for floor = 1, spec.floors do
		if spec.hollow and floor == 1 then
			local wallT = 1.5
			Kit.part({ name = "House_Wall", size = Vector3.new(w, floorHeight, wallT),
				cframe = at(Vector3.new(0, y + floorHeight / 2, -d / 2 + wallT / 2)),
				color = plaster, material = Enum.Material.SmoothPlastic, parent = parent })
			for sideSign = -1, 1, 2 do
				Kit.part({ name = "House_Wall", size = Vector3.new(wallT, floorHeight, d - wallT * 2),
					cframe = at(Vector3.new(sideSign * (w / 2 - wallT / 2), y + floorHeight / 2, 0)),
					color = plaster, material = Enum.Material.SmoothPlastic, parent = parent })
			end
			local segW = (w - doorW - 2) / 2
			for doorSide = -1, 1, 2 do
				Kit.part({ name = "House_Wall", size = Vector3.new(segW, floorHeight, wallT),
					cframe = at(Vector3.new(doorSide * (doorW / 2 + 1 + segW / 2), y + floorHeight / 2, d / 2 - wallT / 2)),
					color = plaster, material = Enum.Material.SmoothPlastic, parent = parent })
			end
			Kit.part({ name = "House_Lintel", size = Vector3.new(doorW + 2, floorHeight - 10, wallT),
				cframe = at(Vector3.new(0, y + 10 + (floorHeight - 10) / 2, d / 2 - wallT / 2)),
				color = plaster, material = Enum.Material.SmoothPlastic, parent = parent })
			Kit.part({ name = "House_Floor", size = Vector3.new(w - wallT, 0.4, d - wallT),
				cframe = at(Vector3.new(0, y + 0.2, 0)),
				color = Color3.fromRGB(124, 96, 66), material = Enum.Material.WoodPlanks, parent = parent })
		else
			Kit.part({
				name = "House_Wall",
				size = Vector3.new(w, floorHeight, d),
				cframe = at(Vector3.new(0, y + floorHeight / 2, 0)),
				color = plaster,
				material = Enum.Material.SmoothPlastic,
				parent = parent,
			})
		end
		-- Corner posts and timber bands.
		for cx = -1, 1, 2 do
			for cz = -1, 1, 2 do
				Kit.part({
					name = "House_Post",
					size = Vector3.new(1.8, floorHeight, 1.8),
					cframe = at(Vector3.new(cx * w / 2, y + floorHeight / 2, cz * d / 2)),
					color = timber,
					material = Enum.Material.Wood,
					parent = parent,
				})
			end
		end
		for _, bandY in { y + 0.6, y + floorHeight - 0.6 } do
			Kit.part({
				name = "House_Band",
				size = Vector3.new(w + 1, 1.2, d + 1),
				cframe = at(Vector3.new(0, bandY, 0)),
				color = timber,
				material = Enum.Material.Wood,
				canCollide = false,
				castShadow = false,
				parent = parent,
			})
		end
		-- Windows (skip the door bay on the front face).
		for faceSign = -1, 1, 2 do
			for _, windowX in { -w / 4, w / 4 } do
				if floor == 1 and faceSign == 1 and math.abs(windowX - doorX) < (doorW + 5) / 2 + 2.5 then
					continue
				end
				local faceZ = faceSign * (d / 2 + 0.3)
				Kit.part({
					name = "House_Window",
					size = Vector3.new(4.4, 5.2, 0.6),
					cframe = at(Vector3.new(windowX, y + floorHeight / 2, faceZ)),
					color = timber,
					material = Enum.Material.Wood,
					canCollide = false,
					castShadow = false,
					parent = parent,
				})
				Kit.part({
					name = "House_WindowPanel",
					size = Vector3.new(3.4, 4.2, 0.5),
					cframe = at(Vector3.new(windowX, y + floorHeight / 2, faceZ + faceSign * 0.12)),
					color = Color3.fromRGB(216, 203, 170),
					material = Enum.Material.WoodPlanks,
					canCollide = false,
					castShadow = false,
					parent = parent,
				})
			end
		end
		if floor == 1 then
			Kit.part({
				name = "House_DoorFrame",
				size = Vector3.new(doorW + 1.4, 10.4, 0.7),
				cframe = at(Vector3.new(doorX, y + 5.2, d / 2 + 0.3)),
				color = timber,
				material = Enum.Material.Wood,
				canCollide = false,
				castShadow = false,
				parent = parent,
			})
			if not spec.hollow then
				Kit.part({
					name = "House_Door",
					size = Vector3.new(doorW, 9.6, 0.55),
					cframe = at(Vector3.new(doorX, y + 4.8, d / 2 + 0.45)),
					color = Color3.fromRGB(66, 47, 33),
					material = Enum.Material.WoodPlanks,
					canCollide = false,
					castShadow = false,
					parent = parent,
				})
			end
			-- Couplets and door lanterns.
			for coupletSign = -1, 1, 2 do
				Kit.part({
					name = "House_Couplet",
					size = Vector3.new(1.4, 7.6, 0.3),
					cframe = at(Vector3.new(doorX + coupletSign * (doorW / 2 + 1.6), y + 5, d / 2 + 0.4)),
					color = Color3.fromRGB(178, 44, 38),
					material = Enum.Material.SmoothPlastic,
					canCollide = false,
					castShadow = false,
					parent = parent,
				})
				local lanternWorld = at(Vector3.new(doorX + coupletSign * (doorW / 2 + 3.6), y + 8.6, d / 2 + 1.6))
				Kit.lantern(parent, lanternWorld.Position, 1.7, spec.lanternLights == true)
			end
		end
		Kit.roof(parent, cf, w, d, y + floorHeight, spec.roofColor, spec.roofMaterial)
		y += floorHeight + 1.8
		if spec.floors > 1 then
			w *= 0.82
			d *= 0.82
		end
	end

	-- Furnished interior for hollow builds.
	if spec.hollow then
		local floorY = 2.2 + 0.4
		Kit.part({ name = "Hall_Dais", size = Vector3.new(11, 1.1, 6.5),
			cframe = at(Vector3.new(0, floorY + 0.55, -spec.depth / 2 + 5.5)),
			color = STONE, material = Enum.Material.Slate, parent = parent })
		Kit.part({ name = "Hall_Seat", size = Vector3.new(4.4, 4, 2.6),
			cframe = at(Vector3.new(0, floorY + 3, -spec.depth / 2 + 5)),
			color = spec.timber, material = Enum.Material.Wood, parent = parent })
		for shelfSign = -1, 1, 2 do
			Kit.part({ name = "Hall_Shelf", size = Vector3.new(2, 8, 10),
				cframe = at(Vector3.new(shelfSign * (spec.width / 2 - 3), floorY + 4, -spec.depth / 2 + 8.5)),
				color = Color3.fromRGB(96, 72, 50), material = Enum.Material.WoodPlanks, parent = parent })
		end
		for matIndex = 0, 3 do
			Kit.part({ name = "Hall_Mat", size = Vector3.new(3.6, 0.25, 3.6),
				cframe = at(Vector3.new(-5 + (matIndex % 2) * 10, floorY + 0.15, 1.5 + math.floor(matIndex / 2) * 6)),
				color = Color3.fromRGB(178, 150, 100), material = Enum.Material.Fabric,
				canCollide = false, castShadow = false, parent = parent })
		end
		local hallLantern = Kit.lantern(parent, (at(Vector3.new(0, floorY + 10.5, 0))).Position, 2, true)
		hallLantern.Color = Color3.fromRGB(230, 170, 90)
	end
end

-- Open pavilion: four posts, a tiered roof, a raised floor. Shelter for
-- shrines and meditation.
function Kit.pavilion(parent: Instance, center: Vector3, size: number, timber: Color3, roofColor: Color3)
	Kit.part({
		name = "Pavilion_Floor",
		size = Vector3.new(size + 4, 1.2, size + 4),
		position = center + Vector3.new(0, 0.6, 0),
		color = STONE,
		material = Enum.Material.Slate,
		parent = parent,
	})
	local postHeight = 15
	for cx = -1, 1, 2 do
		for cz = -1, 1, 2 do
			Kit.part({
				name = "Pavilion_Post",
				size = Vector3.new(1.7, postHeight, 1.7),
				position = center + Vector3.new(cx * size / 2, 1.2 + postHeight / 2, cz * size / 2),
				color = timber,
				material = Enum.Material.Wood,
				parent = parent,
			})
		end
	end
	local yaw = CFrame.new(center.X, center.Y, center.Z)
	Kit.roof(parent, yaw, size + 2, size + 2, 1.2 + postHeight, roofColor)
	Kit.roof(parent, yaw, size * 0.45, size * 0.45, 1.2 + postHeight + 3.8, roofColor)
end

-- Paifang: the ceremonial gate. Returns the signboard for a billboard.
function Kit.paifang(parent: Instance, center: Vector3, facing: Vector3, width: number, timber: Color3, roofColor: Color3): Part
	local side = Vector3.new(-facing.Z, 0, facing.X)
	local pillarHeight = 22
	for s = -1, 1, 2 do
		Kit.part({
			name = "Paifang_Pillar",
			size = Vector3.new(2.6, pillarHeight, 2.6),
			position = center + side * (s * width / 2) + Vector3.new(0, pillarHeight / 2, 0),
			color = timber,
			material = Enum.Material.Wood,
			parent = parent,
		})
		-- Guardian stones at the pillar feet.
		Kit.part({
			name = "Paifang_Foot",
			size = Vector3.new(4, 2.6, 4),
			position = center + side * (s * width / 2) + Vector3.new(0, 1.3, 0),
			color = STONE,
			material = Enum.Material.Slate,
			parent = parent,
		})
	end
	local lintelCF = CFrame.lookAt(center + Vector3.new(0, pillarHeight - 1, 0), center + Vector3.new(0, pillarHeight - 1, 0) + facing)
	Kit.part({
		name = "Paifang_Lintel",
		size = Vector3.new(width + 6, 2.2, 2.8),
		cframe = lintelCF,
		color = timber,
		material = Enum.Material.Wood,
		parent = parent,
	})
	local sign = Kit.part({
		name = "Paifang_Sign",
		size = Vector3.new(width * 0.5, 4, 1.4),
		cframe = lintelCF * CFrame.new(0, 3.2, 0),
		color = Color3.fromRGB(32, 28, 26),
		material = Enum.Material.Wood,
		parent = parent,
	})
	-- Roof measured from the gate's own altitude (a paifang on a hill
	-- once wore its roof at its knees; never again).
	Kit.roof(parent, CFrame.new(center.X, 0, center.Z), width * 0.7, 5, center.Y + pillarHeight + 4, roofColor)
	Kit.lantern(parent, center + side * (width / 2 - 2) + Vector3.new(0, pillarHeight - 3, 0), 1.9, true)
	Kit.lantern(parent, center - side * (width / 2 - 2) + Vector3.new(0, pillarHeight - 3, 0), 1.9, true)
	return sign
end

-- ------------------------------ Gameplay bits ----------------------------

function Kit.billboard(adornee: BasePart, text: string, color: Color3, width: number, height: number, studsOffset: Vector3?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffset = studsOffset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 200
	gui.Adornee = adornee
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextScaled = true
	label.Font = Enum.Font.Garamond
	label.Parent = gui
end

function Kit.safeZone(parent: Instance, position: Vector3, radius: number)
	local marker = Kit.part({
		name = "SafeZone",
		size = Vector3.new(1, 1, 1),
		position = position,
		transparency = 1,
		canCollide = false,
		parent = parent,
	})
	marker:SetAttribute("Radius", radius)
	CollectionService:AddTag(marker, "SafeZone")
end

function Kit.cultivationZone(parent: Instance, position: Vector3, radius: number, qiMult: number, siteName: string)
	local marker = Kit.part({
		name = "CultivationZone",
		size = Vector3.new(1, 1, 1),
		position = position,
		transparency = 1,
		canCollide = false,
		parent = parent,
	})
	marker:SetAttribute("Radius", radius)
	marker:SetAttribute("QiMult", qiMult)
	marker:SetAttribute("SiteName", siteName)
	CollectionService:AddTag(marker, "CultivationZone")
end

function Kit.beastSpawn(parent: Instance, position: Vector3, beastId: string, count: number)
	local marker = Kit.part({
		name = "BeastSpawn_" .. beastId,
		size = Vector3.new(1, 1, 1),
		position = position,
		transparency = 1,
		canCollide = false,
		parent = parent,
	})
	marker:SetAttribute("BeastId", beastId)
	marker:SetAttribute("Count", count)
	CollectionService:AddTag(marker, "BeastSpawn")
end

function Kit.spawnLocation(parent: Instance, position: Vector3): SpawnLocation
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(10, 1, 10)
	spawnLoc.Position = position
	spawnLoc.Anchored = true
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Material = Enum.Material.Slate
	spawnLoc.Color = Color3.fromRGB(120, 118, 122)
	spawnLoc.Parent = parent
	return spawnLoc
end

function Kit.trainingDummy(parent: Instance, position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Training Dummy"
	local root = Kit.part({
		name = "HumanoidRootPart",
		size = Vector3.new(2.4, 3.6, 1.6),
		position = position + Vector3.new(0, 2.8, 0),
		color = Color3.fromRGB(150, 110, 70),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})
	Kit.part({
		name = "Head",
		size = Vector3.new(1.6, 1.6, 1.6),
		position = position + Vector3.new(0, 5.4, 0),
		color = Color3.fromRGB(170, 130, 85),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})
	Kit.part({
		name = "Base",
		size = Vector3.new(4, 1, 4),
		position = position + Vector3.new(0, 0.5, 0),
		color = Color3.fromRGB(110, 85, 55),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 400
	humanoid.Health = 400
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	model.PrimaryPart = root
	CollectionService:AddTag(model, "TrainingDummy")
	Kit.billboard(root, "Training Dummy", Color3.fromRGB(230, 220, 200), 8, 1.4, Vector3.new(0, 4.4, 0))
	model.Parent = parent
	return model
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">Terrain</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Terrain
-- The Azure Vale's landform, generated as a NOISE HEIGHTFIELD: one
-- deterministic height function evaluated per column, written as voxel
-- terrain. This is what finally kills the flat-faced wedge mountains and
-- balloon hills of the old world: every slope here is continuous, every
-- ridge is noise, and every placement in the world can ask heightAt() for
-- the exact ground level, so nothing floats and nothing is buried.
--
-- Deliberately compact (±768 studs). A small world drawn densely beats a
-- vast one drawn thin; new regions attach beyond the rim in later phases.

local Terrain = {}

Terrain.SPAN = 768 -- world runs x,z in [-SPAN, SPAN]
Terrain.CELL = 12 -- column width in studs
Terrain.SEA_LEVEL = 0

-- Landmark centers other modules build against.
Terrain.VILLAGE = Vector2.new(170, 150)
Terrain.VILLAGE_HEIGHT = 11
Terrain.SUMMIT = Vector2.new(0, -520)
Terrain.SUMMIT_HEIGHT = 296
Terrain.SHELF = Vector2.new(-140, -330) -- mountainside meditation shelf
Terrain.SHELF_HEIGHT = 95
Terrain.GROVE = Vector2.new(430, 60) -- bamboo grove clearing

local voxels = workspace.Terrain

-- The mountains: {x, z, height, radius}. The great peak is Heavenpillar;
-- the rest shape the vale's rim.
local MOUNTAINS = {
	{ x = 0, z = -520, h = 330, r = 350 },
	{ x = -380, z = -330, h = 150, r = 190 },
	{ x = 390, z = -350, h = 180, r = 210 },
	{ x = 560, z = 180, h = 80, r = 220 },
	{ x = -520, z = 280, h = 70, r = 200 },
	{ x = 180, z = 560, h = 60, r = 190 },
	{ x = -260, z = 520, h = 55, r = 170 },
}

-- The river: mountain gorge to the southern sea.
local RIVER: { Vector2 } = {
	Vector2.new(0, -330),
	Vector2.new(30, -80),
	Vector2.new(90, 160),
	Vector2.new(60, 400),
	Vector2.new(110, 720),
}
local RIVER_HALF_WIDTH = 17

local function distanceToPolyline(x: number, z: number, points: { Vector2 }): number
	local best = math.huge
	for index = 1, #points - 1 do
		local a = points[index]
		local b = points[index + 1]
		local abx, abz = b.X - a.X, b.Y - a.Y
		local lengthSq = abx * abx + abz * abz
		local t = math.clamp(((x - a.X) * abx + (z - a.Y) * abz) / lengthSq, 0, 1)
		local cx, cz = a.X + abx * t, a.Y + abz * t
		best = math.min(best, math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2))
	end
	return best
end

function Terrain.riverDistance(x: number, z: number): number
	return distanceToPolyline(x, z, RIVER)
end

local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- The height function. Deterministic; the entire vale flows from here.
function Terrain.heightAt(x: number, z: number): number
	-- Rolling meadow base.
	local h = 10
		+ math.noise(x * 0.0045 + 7.13, z * 0.0045 + 7.13) * 8
		+ math.noise(x * 0.013 + 31.7, z * 0.013 + 31.7) * 3

	-- Mountains: radial profile roughened by ridge noise so no slope is a
	-- clean cone.
	for _, mountain in MOUNTAINS do
		local d = math.sqrt((x - mountain.x) ^ 2 + (z - mountain.z) ^ 2)
		if d < mountain.r then
			local t = 1 - d / mountain.r
			local ridge = 0.78 + 0.44 * math.abs(math.noise(x * 0.008 + 3.3, z * 0.008 + 3.3))
			h += mountain.h * t ^ 1.7 * ridge
		end
	end

	-- Island falloff into the sea.
	local fromCenter = math.sqrt(x * x + z * z)
	if fromCenter > 620 then
		h -= ((fromCenter - 620) / 140) ^ 1.5 * 60
	end

	-- The river carves its channel below sea level; water self-fills.
	local dRiver = distanceToPolyline(x, z, RIVER)
	if dRiver < RIVER_HALF_WIDTH then
		local channel = -4 * smooth(1 - dRiver / RIVER_HALF_WIDTH) - 0.5
		local blend = smooth(dRiver / RIVER_HALF_WIDTH)
		h = math.min(h, channel * (1 - blend) + h * blend)
		h = math.min(h, -3.5 + 4 * blend)
	end

	-- Flattened build sites, blended smoothly into the land.
	local function plateau(centerX: number, centerZ: number, radius: number, blendRadius: number, level: number)
		local d = math.sqrt((x - centerX) ^ 2 + (z - centerZ) ^ 2)
		if d < blendRadius then
			local t = smooth(math.max(0, d - radius) / math.max(blendRadius - radius, 1))
			h = level * (1 - t) + h * t
		end
	end
	plateau(Terrain.VILLAGE.X, Terrain.VILLAGE.Y, 120, 190, Terrain.VILLAGE_HEIGHT)
	plateau(Terrain.SUMMIT.X, Terrain.SUMMIT.Y, 44, 90, Terrain.SUMMIT_HEIGHT)
	plateau(Terrain.SHELF.X, Terrain.SHELF.Y, 30, 60, Terrain.SHELF_HEIGHT)
	plateau(Terrain.GROVE.X, Terrain.GROVE.Y, 46, 90, 14)

	return h
end

function Terrain.slopeAt(x: number, z: number): number
	local step = Terrain.CELL
	local here = Terrain.heightAt(x, z)
	local dx = math.abs(Terrain.heightAt(x + step, z) - here)
	local dz = math.abs(Terrain.heightAt(x, z + step) - here)
	return math.max(dx, dz) / step
end

-- ------------------------------- Building --------------------------------

local function fillBlock(center: Vector3, size: Vector3, material: Enum.Material)
	voxels:FillBlock(CFrame.new(center), size, material)
end

function Terrain.build()
	local span = Terrain.SPAN
	local cell = Terrain.CELL

	-- The sea, in quadrants (single giant fills hit region limits), and a
	-- sand bed beneath it.
	for cx = -1, 1, 2 do
		for cz = -1, 1, 2 do
			fillBlock(
				Vector3.new(cx * span / 2, -13, cz * span / 2),
				Vector3.new(span + cell, 26, span + cell),
				Enum.Material.Water
			)
		end
	end
	fillBlock(Vector3.new(0, -29, 0), Vector3.new(span * 2 + cell * 2, 8, span * 2 + cell * 2), Enum.Material.Sand)

	-- Height columns. Grass by default; rock where steep, snow up high,
	-- sand at the waterline, leafy patches by noise.
	for x = -span, span, cell do
		for z = -span, span, cell do
			local h = Terrain.heightAt(x, z)
			if h <= -20 then
				continue -- open sea; the water fill already owns it
			end
			local slope = Terrain.slopeAt(x, z)
			local material: Enum.Material
			if h > 235 then
				material = Enum.Material.Snow
			elseif slope > 1.05 then
				material = Enum.Material.Rock
			elseif h < 2.5 then
				material = Enum.Material.Sand
			elseif math.noise(x * 0.006 + 91.2, z * 0.006 + 91.2) > 0.24 then
				material = Enum.Material.LeafyGrass
			else
				material = Enum.Material.Grass
			end
			local bottom = -24
			fillBlock(
				Vector3.new(x, (h + bottom) / 2, z),
				Vector3.new(cell + 0.5, h - bottom, cell + 0.5),
				material
			)
		end
	end

	-- Animated grass on the meadows.
	pcall(function()
		voxels.Decoration = true;
		(voxels :: any).GrassLength = 0.75
	end)
end

return Terrain
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Vale</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Vale
-- The handcrafted layer of the Azure Vale: Willowrest village, the river
-- bridge, stone paths, the sacred meditation sites, and the beast ranges.
-- Every position is placed at Terrain.heightAt ground truth: nothing
-- floats, nothing sinks. Nothing here is scattered at random; the vale
-- is laid out like somebody lives in it.

local Kit = require(script.Parent.Kit)
local Terrain = require(script.Parent.Terrain)

local Vale = {}

local TIMBER = Color3.fromRGB(74, 53, 39)
local PLASTER = Color3.fromRGB(236, 229, 214)
local ROOF_BLUE = Color3.fromRGB(62, 74, 88)
local ROOF_STRAW = Color3.fromRGB(178, 148, 76)
local STONE = Color3.fromRGB(152, 148, 140)

local function ground(x: number, z: number): Vector3
	return Vector3.new(x, Terrain.heightAt(x, z), z)
end

-- Face a build position AWAY from a target so its +Z door looks at it.
local function doorToward(position: Vector3, target: Vector3): CFrame
	local flatTarget = Vector3.new(target.X, position.Y, target.Z)
	return CFrame.lookAt(position, position * 2 - flatTarget)
end

-- A stone path following the terrain, sampled and laid slab by slab.
local function path(parent: Instance, points: { Vector2 }, width: number)
	for index = 1, #points - 1 do
		local a = points[index]
		local b = points[index + 1]
		local length = (b - a).Magnitude
		local steps = math.max(1, math.floor(length / 13))
		for step = 0, steps - 1 do
			local t0 = step / steps
			local t1 = (step + 1) / steps
			local p0 = a:Lerp(b, t0)
			local p1 = a:Lerp(b, t1)
			local h0 = Terrain.heightAt(p0.X, p0.Y)
			local h1 = Terrain.heightAt(p1.X, p1.Y)
			local from = Vector3.new(p0.X, h0 + 0.55, p0.Y)
			local to = Vector3.new(p1.X, h1 + 0.55, p1.Y)
			Kit.part({
				name = "Path",
				size = Vector3.new(width, 0.7, (to - from).Magnitude + 2),
				cframe = CFrame.lookAt((from + to) / 2, to),
				color = Color3.fromRGB(172, 164, 150),
				material = Enum.Material.Cobblestone,
				canCollide = false,
				castShadow = false,
				parent = parent,
			})
		end
	end
end

-- ------------------------------ Willowrest -------------------------------

local function buildVillage(parent: Instance)
	local vx, vz = Terrain.VILLAGE.X, Terrain.VILLAGE.Y
	local plazaCenter = ground(vx, vz)

	-- Plaza: a stone circle with the spawn at its heart.
	Kit.cylinder(parent, "Plaza", plazaCenter + Vector3.new(0, 1, 0), 1.4, 62, STONE, Enum.Material.Cobblestone)
	Kit.spawnLocation(parent, plazaCenter + Vector3.new(0, 2, 8))

	-- The village gate, facing the south road.
	local gatePos = ground(vx, vz + 110)
	local sign = Kit.paifang(parent, gatePos, Vector3.new(0, 0, 1), 26, TIMBER, ROOF_BLUE)
	Kit.billboard(sign, "Willowrest\nA quiet place to begin an endless road", Color3.fromRGB(235, 228, 210), 20, 3, Vector3.new(0, 4, 0))

	-- Houses ringing the plaza: hand-placed, each angled to face it.
	local houses = {
		{ x = vx - 70, z = vz - 40, straw = false },
		{ x = vx + 72, z = vz - 30, straw = true },
		{ x = vx - 78, z = vz + 42, straw = true },
		{ x = vx + 80, z = vz + 48, straw = false },
		{ x = vx + 20, z = vz + 78, straw = true },
		{ x = vx - 30, z = vz - 84, straw = false },
	}
	for _, spot in houses do
		local position = ground(spot.x, spot.z)
		Kit.house(parent, doorToward(position, plazaCenter), {
			width = 26,
			depth = 20,
			floors = 1,
			plaster = PLASTER,
			timber = TIMBER,
			roofColor = if spot.straw then ROOF_STRAW else ROOF_BLUE,
			roofMaterial = if spot.straw then Enum.Material.Grass else Enum.Material.Slate,
		})
	end

	-- The village hall: two stories, enterable, lit. The seat of what
	-- passes for authority in Willowrest.
	local hallPos = ground(vx, vz - 95)
	Kit.house(parent, doorToward(hallPos, plazaCenter), {
		width = 42,
		depth = 30,
		floors = 2,
		plaster = PLASTER,
		timber = TIMBER,
		roofColor = ROOF_BLUE,
		roofMaterial = Enum.Material.Slate,
		hollow = true,
		lanternLights = true,
	})

	-- Training yard west of the plaza: mats, dummies, a weapon rack.
	local yardCenter = ground(vx - 95, vz + 5)
	Kit.cylinder(parent, "TrainingYard", yardCenter + Vector3.new(0, 0.8, 0), 1, 40, Color3.fromRGB(168, 158, 140), Enum.Material.Ground)
	for index = -1, 1 do
		Kit.trainingDummy(parent, yardCenter + Vector3.new(index * 12, 1.2, -8))
		Kit.part({
			name = "TrainingMat",
			size = Vector3.new(5, 0.3, 5),
			position = yardCenter + Vector3.new(index * 12, 1.5, 6),
			color = Color3.fromRGB(178, 150, 100),
			material = Enum.Material.Fabric,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
	end
	Kit.part({
		name = "WeaponRack",
		size = Vector3.new(8, 5, 1),
		position = yardCenter + Vector3.new(0, 3.6, 16),
		color = TIMBER,
		material = Enum.Material.Wood,
		parent = parent,
	})

	-- A well, a notice board, market stalls by the gate: the small
	-- furniture of an inhabited place.
	local wellPos = plazaCenter + Vector3.new(38, 0, -16)
	Kit.cylinder(parent, "Well_Ring", wellPos + Vector3.new(0, 2.4, 0), 2.6, 7.5, Color3.fromRGB(140, 138, 134), Enum.Material.Cobblestone)
	Kit.cylinder(parent, "Well_Hole", wellPos + Vector3.new(0, 3.85, 0), 0.3, 5, Color3.fromRGB(24, 26, 30), Enum.Material.SmoothPlastic, false, false)
	Kit.roof(parent, CFrame.new(wellPos.X, 0, wellPos.Z), 6, 6, wellPos.Y + 8.6, ROOF_BLUE)

	local boardPos = ground(vx + 26, vz + 92)
	Kit.part({
		name = "NoticeBoard",
		size = Vector3.new(8, 5.5, 0.7),
		cframe = doorToward(boardPos + Vector3.new(0, 5.4, 0), plazaCenter),
		color = Color3.fromRGB(96, 72, 50),
		material = Enum.Material.WoodPlanks,
		parent = parent,
	})

	for stallSign = -1, 1, 2 do
		local stallPos = ground(vx + stallSign * 24, vz + 66)
		local stallCF = doorToward(stallPos, plazaCenter)
		Kit.part({
			name = "Stall_Counter",
			size = Vector3.new(9, 3.2, 2.8),
			cframe = stallCF * CFrame.new(0, 1.6, 0),
			color = Color3.fromRGB(124, 94, 62),
			material = Enum.Material.WoodPlanks,
			parent = parent,
		})
		Kit.part({
			name = "Stall_Awning",
			size = Vector3.new(10, 0.4, 5.5),
			cframe = stallCF * CFrame.new(0, 7.6, -0.5) * CFrame.Angles(math.rad(-9), 0, 0),
			color = if stallSign > 0 then Color3.fromRGB(178, 60, 48) else Color3.fromRGB(214, 200, 170),
			material = Enum.Material.Fabric,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
		for postSign = -1, 1, 2 do
			Kit.part({
				name = "Stall_Post",
				size = Vector3.new(0.7, 7.6, 0.7),
				cframe = stallCF * CFrame.new(postSign * 4.2, 3.8, -1),
				color = TIMBER,
				material = Enum.Material.Wood,
				canCollide = false,
				castShadow = false,
				parent = parent,
			})
		end
	end

	-- Lantern posts along the plaza rim: the village glows at dusk.
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2 + 0.4
		local postPos = ground(vx + math.cos(angle) * 48, vz + math.sin(angle) * 48)
		Kit.lanternPost(parent, postPos, index % 2 == 0)
	end

	-- Sanctuary: the whole village and its yard.
	Kit.safeZone(parent, plazaCenter, 165)
end

-- ------------------------------ The bridge -------------------------------

local function buildBridge(parent: Instance)
	local from = Vector3.new(122, 0, 296)
	local to = Vector3.new(42, 0, 308)
	local bankHeight = math.max(Terrain.heightAt(from.X, from.Z), Terrain.heightAt(to.X, to.Z))
	local deckY = bankHeight + 1.2
	local mid = (from + to) / 2
	local length = (to - from).Magnitude + 6
	local deckCF = CFrame.lookAt(Vector3.new(mid.X, deckY, mid.Z), Vector3.new(to.X, deckY, to.Z))
	Kit.part({
		name = "Bridge_Deck",
		size = Vector3.new(11, 1.4, length),
		cframe = deckCF,
		color = Color3.fromRGB(133, 100, 68),
		material = Enum.Material.WoodPlanks,
		parent = parent,
	})
	for side = -1, 1, 2 do
		Kit.part({
			name = "Bridge_Rail",
			size = Vector3.new(0.9, 2.6, length),
			cframe = deckCF * CFrame.new(side * 5, 1.9, 0),
			color = Color3.fromRGB(94, 70, 48),
			material = Enum.Material.Wood,
			parent = parent,
		})
	end
	-- Gentle ramps so both banks meet the deck cleanly.
	for _, bank in { from, to } do
		local bankH = Terrain.heightAt(bank.X, bank.Z)
		local toward = (Vector3.new(mid.X, 0, mid.Z) - Vector3.new(bank.X, 0, bank.Z)).Unit
		Kit.wedge({
			name = "Bridge_Ramp",
			size = Vector3.new(11, math.max(0.5, deckY - bankH + 0.7), 8),
			cframe = CFrame.lookAt(Vector3.new(bank.X, (deckY + bankH) / 2, bank.Z), Vector3.new(bank.X, (deckY + bankH) / 2, bank.Z) + toward)
				* CFrame.Angles(0, math.pi, 0),
			color = Color3.fromRGB(133, 100, 68),
			material = Enum.Material.WoodPlanks,
			parent = parent,
		})
	end
	Kit.lantern(parent, Vector3.new(from.X, deckY + 6, from.Z), 1.8, true)
	Kit.lantern(parent, Vector3.new(to.X, deckY + 6, to.Z), 1.8, true)
end

-- ---------------------------- Sacred places ------------------------------

local function buildSacredSites(parent: Instance)
	-- Riverheart Pool: a listening deck on the bank where the gorge water
	-- settles. The first cultivation spot a new player finds.
	local poolPos = ground(75, -150)
	Kit.part({
		name = "PoolDeck",
		size = Vector3.new(22, 1.2, 15),
		position = poolPos + Vector3.new(0, 1, 0),
		color = Color3.fromRGB(133, 100, 68),
		material = Enum.Material.WoodPlanks,
		parent = parent,
	})
	for matIndex = -1, 1 do
		Kit.part({
			name = "Meditation_Mat",
			size = Vector3.new(3.4, 0.25, 3.4),
			position = poolPos + Vector3.new(matIndex * 6, 1.75, 2),
			color = Color3.fromRGB(178, 150, 100),
			material = Enum.Material.Fabric,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
	end
	Kit.lantern(parent, poolPos + Vector3.new(-9, 7, 6), 1.8, true)
	Kit.lantern(parent, poolPos + Vector3.new(9, 7, 6), 1.8, true)
	local deck = parent:FindFirstChild("PoolDeck")
	if deck and deck:IsA("BasePart") then
		Kit.billboard(deck, "Riverheart Pool\nThe water carries qi down from the peak. Sit. Listen.", Color3.fromRGB(190, 225, 240), 20, 2.6, Vector3.new(0, 5, 0))
	end
	Kit.cultivationZone(parent, poolPos, 26, 2, "Riverheart Pool")

	-- The mountainside shelf: a pavilion halfway up Heavenpillar.
	local shelfPos = Vector3.new(Terrain.SHELF.X, Terrain.SHELF_HEIGHT, Terrain.SHELF.Y)
	Kit.pavilion(parent, shelfPos, 15, TIMBER, ROOF_BLUE)
	for matIndex = -1, 1 do
		Kit.part({
			name = "Meditation_Mat",
			size = Vector3.new(3.4, 0.25, 3.4),
			position = shelfPos + Vector3.new(matIndex * 5, 1.55, 0),
			color = Color3.fromRGB(178, 150, 100),
			material = Enum.Material.Fabric,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
	end
	Kit.cultivationZone(parent, shelfPos, 30, 2.2, "The Windrest Shelf")

	-- The summit: a stone ring, an old monolith, and the thinnest air on
	-- the island. The strongest open cultivation spot in the vale.
	local summitPos = Vector3.new(Terrain.SUMMIT.X, Terrain.SUMMIT_HEIGHT, Terrain.SUMMIT.Y)
	Kit.cylinder(parent, "Summit_Ring", summitPos + Vector3.new(0, 0.8, 0), 1.2, 52, Color3.fromRGB(210, 205, 190), Enum.Material.Marble)
	local monolith = Kit.part({
		name = "Summit_Monolith",
		size = Vector3.new(4.5, 12, 2.2),
		position = summitPos + Vector3.new(0, 7.4, -16),
		color = Color3.fromRGB(120, 122, 132),
		material = Enum.Material.Slate,
		parent = parent,
	})
	Kit.billboard(monolith, "The Crown of Heavenpillar\nWhat you gather here, the sky gave willingly.", Color3.fromRGB(255, 240, 200), 22, 3, Vector3.new(0, 8, 0))
	for index = 0, 5 do
		local angle = index / 6 * math.pi * 2
		Kit.part({
			name = "Summit_Stone",
			size = Vector3.new(2.2, 4 + (index % 2) * 1.5, 1.6),
			cframe = CFrame.new(summitPos + Vector3.new(math.cos(angle) * 23, 2.6, math.sin(angle) * 23))
				* CFrame.Angles(0, -angle, math.rad((index % 3 - 1) * 6)),
			color = Color3.fromRGB(150, 148, 144),
			material = Enum.Material.Slate,
			parent = parent,
		})
	end
	Kit.cultivationZone(parent, summitPos, 44, 3, "The Crown of Heavenpillar")

	-- The bamboo grove: a green room in the eastern meadow.
	local grovePos = ground(Terrain.GROVE.X, Terrain.GROVE.Y)
	local groveRng = Random.new(41)
	for index = 1, 16 do
		local angle = index / 16 * math.pi * 2
		if math.abs(math.atan2(math.sin(angle - math.pi * 1.5), math.cos(angle - math.pi * 1.5))) < 0.42 then
			continue -- the way in, from the west path
		end
		local culmBase = ground(
			grovePos.X + math.cos(angle) * groveRng:NextNumber(22, 32),
			grovePos.Z + math.sin(angle) * groveRng:NextNumber(22, 32)
		)
		local culmHeight = groveRng:NextNumber(42, 64)
		Kit.part({
			name = "Grove_Bamboo",
			size = Vector3.new(1.5, culmHeight, 1.5),
			cframe = CFrame.new(culmBase + Vector3.new(0, culmHeight / 2, 0))
				* CFrame.Angles(groveRng:NextNumber(-0.04, 0.04), 0, groveRng:NextNumber(-0.04, 0.04)),
			color = Color3.fromRGB(126, 168, 92),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		local leaves = Kit.part({
			name = "Grove_Leaves",
			size = Vector3.new(1, 1, 1),
			position = culmBase + Vector3.new(0, culmHeight, 0),
			color = Color3.fromRGB(104, 146, 78),
			material = Enum.Material.Grass,
			canCollide = false,
			castShadow = false,
			parent = parent,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(groveRng:NextNumber(10, 14), groveRng:NextNumber(5, 8), groveRng:NextNumber(10, 14))
		mesh.Parent = leaves
	end
	Kit.pavilion(parent, grovePos, 13, TIMBER, Color3.fromRGB(70, 96, 74))
	Kit.cultivationZone(parent, grovePos, 36, 1.8, "The Whispering Grove")
end

-- ------------------------------ Beast ranges -----------------------------

local function placeBeasts(parent: Instance)
	Kit.beastSpawn(parent, ground(-100, 80) + Vector3.new(0, 2, 0), "mistfang", 2)
	Kit.beastSpawn(parent, ground(300, 340) + Vector3.new(0, 2, 0), "mistfang", 3)
	Kit.beastSpawn(parent, ground(350, -120) + Vector3.new(0, 2, 0), "mistfang", 2)
	Kit.beastSpawn(parent, ground(-320, -80) + Vector3.new(0, 2, 0), "thornback", 2)
	Kit.beastSpawn(parent, ground(240, -260) + Vector3.new(0, 2, 0), "thornback", 2)
end

-- -------------------------------- Roads ----------------------------------

local function buildRoads(parent: Instance)
	-- Village gate south, west over the bridge.
	path(parent, {
		Vector2.new(170, 262),
		Vector2.new(140, 288),
		Vector2.new(122, 296),
	}, 9)
	path(parent, {
		Vector2.new(42, 308),
		Vector2.new(-40, 300),
		Vector2.new(-140, 270),
	}, 8)
	-- Plaza north toward the pool and the mountain.
	path(parent, {
		Vector2.new(170, 96),
		Vector2.new(150, 20),
		Vector2.new(110, -70),
		Vector2.new(80, -140),
	}, 8)
	-- Plaza east toward the grove.
	path(parent, {
		Vector2.new(226, 150),
		Vector2.new(320, 110),
		Vector2.new(392, 74),
	}, 7)
end

function Vale.build(parent: Instance)
	buildVillage(parent)
	buildBridge(parent)
	buildSacredSites(parent)
	buildRoads(parent)
	placeBeasts(parent)
end

return Vale
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > WorldService
-- Builds the Azure Vale at server start (terrain, then the handcrafted
-- layer, then vegetation) and tunes the sky. Everything from code, so the
-- whole game rebuilds from a clean checkout; nothing is hand-placed in
-- Studio and later lost.

local Lighting = game:GetService("Lighting")

local Terrain = require(script.Parent.World.Terrain)
local Vale = require(script.Parent.World.Vale)
local Flora = require(script.Parent.World.Flora)

local WorldService = {}

local function tuneSky()
	-- Late golden afternoon: warm, hazy, readable. Combat clarity beats
	-- postcard saturation, so every effect here is conservative.
	Lighting.ClockTime = 16.4
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.Ambient = Color3.fromRGB(96, 90, 78)
	Lighting.OutdoorAmbient = Color3.fromRGB(138, 128, 112)

	if Lighting:FindFirstChildOfClass("Atmosphere") == nil then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.38
		atmosphere.Offset = 0.5
		atmosphere.Color = Color3.fromRGB(222, 214, 198)
		atmosphere.Decay = Color3.fromRGB(130, 120, 104)
		atmosphere.Haze = 2.6
		atmosphere.Glare = 0.5
		atmosphere.Parent = Lighting
	end
	pcall(function()
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.66
		clouds.Density = 0.38
		clouds.Color = Color3.fromRGB(235, 230, 220)
		clouds.Parent = workspace.Terrain
	end)
	if Lighting:FindFirstChildOfClass("BloomEffect") == nil then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 26
		bloom.Threshold = 1.15
		bloom.Parent = Lighting
	end
	if Lighting:FindFirstChildOfClass("SunRaysEffect") == nil then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.07
		rays.Spread = 0.7
		rays.Parent = Lighting
	end
	if Lighting:FindFirstChildOfClass("ColorCorrectionEffect") == nil then
		local grade = Instance.new("ColorCorrectionEffect")
		grade.Contrast = 0.05
		grade.Saturation = 0.05
		grade.TintColor = Color3.fromRGB(255, 246, 230)
		grade.Parent = Lighting
	end
end

function WorldService.Init()
	if workspace:FindFirstChild("World") then
		return -- already built (Studio re-run)
	end
	local world = Instance.new("Folder")
	world.Name = "World"

	Terrain.build()
	Vale.build(world)
	Flora.build(world)
	tuneSky()

	world.Parent = workspace
	print("[WorldService] The Azure Vale lies open beneath Heavenpillar.")
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="28">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="29">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">400</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="30">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- LocalScript: StarterPlayer > StarterPlayerScripts > Client
-- Client bootstrapper: requires every controller, Init() then Start().

local controllersFolder = script:WaitForChild("Controllers")
local modulesFolder = script:WaitForChild("Modules")

-- Core modules first: remote listeners and the animation loader must be
-- live before any controller reads them.
require(modulesFolder:WaitForChild("ClientState")).Init()
require(modulesFolder:WaitForChild("AnimUtil")).Init()

type Controller = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local controllers: { [string]: Controller } = {}

for _, child in controllersFolder:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			controllers[child.Name] = result :: Controller
		else
			warn(`[Client] Failed to require controller "{child.Name}": {result}`)
		end
	end
end

for name, controller in controllers do
	if controller.Init then
		local ok, err = pcall(controller.Init :: any)
		if not ok then
			warn(`[Client] {name}.Init() failed: {err}`)
		end
	end
end

for name, controller in controllers do
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start :: any)
			if not ok then
				warn(`[Client] {name}.Start() failed: {err}`)
			end
		end)
	end
end

print("[Client] Ready to cultivate.")
]]></string>
        </Properties>
        <Item class="Folder" referent="32">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > CombatController
-- Combat input (left click light chain, right click heavy, hold F to
-- block) and the renderer for every CombatFx broadcast: swings, hits,
-- damage numbers, blocks, dodges, technique steps, breakthroughs. All
-- visuals; every outcome already happened on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local AnimUtil = require(script.Parent.Parent.Modules.AnimUtil)

local CombatController = {}

local player = Players.LocalPlayer
local attackRemote = Net.remoteEvent("AttackRequest")
local blockRemote = Net.remoteEvent("BlockSet")

local vfxFolder: Folder? = nil

local function effectsParent(): Folder
	if vfxFolder and vfxFolder.Parent then
		return vfxFolder :: Folder
	end
	local folder = Instance.new("Folder")
	folder.Name = "ClientVFX"
	folder.Parent = workspace
	vfxFolder = folder
	return folder
end

local function ghost(size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	if shape then
		part.Shape = shape
	end
	part.Parent = effectsParent()
	return part
end

local function fadeOut(part: Part, duration: number, goal: { [string]: any }?)
	local props: { [string]: any } = goal or {}
	props.Transparency = 1
	local tween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween.Completed:Once(function()
		part:Destroy()
	end)
	tween:Play()
end

local function characterRootOf(userId: number): BasePart?
	local other = Players:GetPlayerByUserId(userId)
	local model = if other then other.Character else nil
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

-- ------------------------------ Renderers --------------------------------

local SWING_COLOR = Color3.fromRGB(226, 230, 240)

local function renderSwing(origin: Vector3, direction: Vector3, swing: number)
	if swing == 0 then
		-- Heavy windup: a gathering ring at the feet.
		local ring = ghost(Vector3.new(0.6, 5, 5), CFrame.new(origin - Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 170, 90), Enum.PartType.Cylinder)
		ring.Transparency = 0.4
		fadeOut(ring, 0.5, { Size = Vector3.new(0.4, 11, 11) })
		return
	end
	local arcCF = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0, -4.5)
		* CFrame.Angles(0, 0, math.rad((swing - 2) * 24))
	local arc = ghost(Vector3.new(8, 0.5, 8), arcCF, SWING_COLOR)
	arc.Transparency = 0.45
	fadeOut(arc, 0.22, { Size = Vector3.new(10.5, 0.2, 10.5) })
end

local function renderHit(position: Vector3, amount: number)
	local spark = ghost(Vector3.new(1.4, 1.4, 1.4), CFrame.new(position), Color3.fromRGB(255, 200, 120), Enum.PartType.Ball)
	spark.Transparency = 0.2
	fadeOut(spark, 0.3, { Size = Vector3.new(3.4, 3.4, 3.4) })

	-- A floating damage number, drifting up.
	local anchor = ghost(Vector3.new(0.2, 0.2, 0.2), CFrame.new(position + Vector3.new(math.random(-15, 15) / 10, 2.4, math.random(-15, 15) / 10)), Color3.new(1, 1, 1))
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(4, 1.6)
	gui.AlwaysOnTop = true
	gui.Adornee = anchor
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = tostring(amount)
	label.TextColor3 = Color3.fromRGB(255, 226, 160)
	label.TextStrokeTransparency = 0.1
	label.TextStrokeColor3 = Color3.fromRGB(40, 20, 10)
	label.TextScaled = true
	label.Font = Enum.Font.Merriweather
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = anchor.CFrame + Vector3.new(0, 3.4, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.75, function()
		anchor:Destroy()
	end)
end

local function renderShield(userId: number, color: Color3)
	local root = characterRootOf(userId)
	if root == nil then
		return
	end
	local shell = ghost(Vector3.new(6, 6, 6), root.CFrame, color, Enum.PartType.Ball)
	shell.Transparency = 0.65
	fadeOut(shell, 0.25, { Size = Vector3.new(7.5, 7.5, 7.5) })
end

local function renderBreakthrough(origin: Vector3, color: Color3, major: boolean)
	local pillar = ghost(Vector3.new(5, 140, 5), CFrame.new(origin + Vector3.new(0, 70, 0)), color)
	pillar.Transparency = 0.25
	fadeOut(pillar, if major then 2.2 else 1.4, { Size = Vector3.new(1, 170, 1) })
	local ring = ghost(Vector3.new(0.6, 2, 2), CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.PartType.Cylinder)
	ring.Transparency = 0.2
	fadeOut(ring, 0.8, { Size = Vector3.new(0.4, if major then 44 else 26, if major then 44 else 26) })
end

local function renderTechniqueStep(event: { [string]: any })
	local origin = event.origin :: Vector3
	local direction = event.direction :: Vector3
	local stepKind = tostring(event.stepKind)
	local color = if event.category == "sword" then Color3.fromRGB(200, 220, 255)
		elseif event.category == "fist" then Color3.fromRGB(255, 190, 120)
		elseif event.category == "movement" then Color3.fromRGB(160, 235, 200)
		else Color3.fromRGB(150, 200, 255)

	if stepKind == "strike" then
		local reach = tonumber(event.reach) or 10
		local arcCF = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0, -reach / 2)
		local arc = ghost(Vector3.new(reach, 0.6, reach), arcCF, color)
		arc.Transparency = 0.35
		fadeOut(arc, 0.3, { Size = Vector3.new(reach * 1.2, 0.2, reach * 1.2) })
	elseif stepKind == "wave" then
		local reach = tonumber(event.reach) or 60
		local speed = tonumber(event.speed) or 90
		local ball = ghost(Vector3.new(1.8, 1.8, 1.8), CFrame.new(origin), color, Enum.PartType.Ball)
		local travelTime = reach / math.max(speed, 1)
		local tween = TweenService:Create(ball, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
			CFrame = CFrame.new(origin + direction.Unit * reach),
		})
		tween.Completed:Once(function()
			fadeOut(ball, 0.15)
		end)
		tween:Play()
	elseif stepKind == "burst" then
		local radius = tonumber(event.radius) or 12
		local ring = ghost(Vector3.new(0.6, 2, 2), CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.PartType.Cylinder)
		ring.Transparency = 0.25
		fadeOut(ring, 0.45, { Size = Vector3.new(0.4, radius * 2, radius * 2) })
		local dome = ghost(Vector3.new(2, 2, 2), CFrame.new(origin), color, Enum.PartType.Ball)
		dome.Transparency = 0.55
		fadeOut(dome, 0.45, { Size = Vector3.new(radius * 1.5, radius * 1.5, radius * 1.5) })
	elseif stepKind == "motion" then
		local flash = ghost(Vector3.new(3, 3, 3), CFrame.new(origin), color, Enum.PartType.Ball)
		flash.Transparency = 0.5
		fadeOut(flash, 0.3, { Size = Vector3.new(6, 6, 6) })
		-- Our own dash/leap components apply their impulse HERE: the
		-- client owns its physics, so approved movement feels instant.
		if event.userId == player.UserId then
			local model = player.Character
			local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
			if root and root:IsA("BasePart") then
				local reach = tonumber(event.reach) or 28
				if event.partId == "dash" then
					root.AssemblyLinearVelocity = direction.Unit * (reach * 3.2) + Vector3.new(0, 10, 0)
				elseif event.partId == "leap" then
					root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, reach * 2.2, root.AssemblyLinearVelocity.Z)
				end
				AnimUtil.play("dodge", 0.05)
			end
		end
	end
	if event.userId == player.UserId and stepKind ~= "motion" then
		AnimUtil.play("castTechnique", 0.08)
	end
end

-- -------------------------------- Input ----------------------------------

local blocking = false

local function setBlocking(wants: boolean)
	if blocking == wants then
		return
	end
	blocking = wants
	blockRemote:FireServer(wants)
	if wants then
		AnimUtil.play("block", 0.1, true)
	else
		AnimUtil.stop("block", 0.15)
	end
end

local lightSwingIndex = 0

local function onVfx(payload: unknown)
	if typeof(payload) ~= "table" then
		return
	end
	local event = payload :: { [string]: any }
	local kind = event.kind
	if kind == "swing" and typeof(event.origin) == "Vector3" and typeof(event.direction) == "Vector3" then
		renderSwing(event.origin, event.direction, tonumber(event.swing) or 1)
	elseif kind == "hit" and typeof(event.position) == "Vector3" then
		renderHit(event.position, tonumber(event.amount) or 0)
	elseif kind == "blocked" and typeof(event.userId) == "number" then
		renderShield(event.userId, Color3.fromRGB(190, 210, 240))
	elseif kind == "dodged" and typeof(event.userId) == "number" then
		renderShield(event.userId, Color3.fromRGB(160, 235, 200))
	elseif kind == "dodge" and typeof(event.userId) == "number" and event.userId ~= player.UserId then
		local root = characterRootOf(event.userId)
		if root then
			local flash = ghost(Vector3.new(2.4, 2.4, 2.4), root.CFrame, Color3.fromRGB(160, 235, 200), Enum.PartType.Ball)
			flash.Transparency = 0.5
			fadeOut(flash, 0.3, { Size = Vector3.new(5, 5, 5) })
		end
	elseif kind == "breakthrough" and typeof(event.origin) == "Vector3" then
		local color = if typeof(event.color) == "Color3" then event.color else Color3.fromRGB(255, 220, 130)
		renderBreakthrough(event.origin, color, event.major == true)
		if event.userId == player.UserId then
			AnimUtil.play("breakthrough", 0.1)
		end
	elseif kind == "techniqueStep" and typeof(event.origin) == "Vector3" and typeof(event.direction) == "Vector3" then
		renderTechniqueStep(event)
	end
end

function CombatController.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local mouse = player:GetMouse()
			attackRemote:FireServer("light", mouse.Hit.Position)
			lightSwingIndex = (lightSwingIndex % 3) + 1
			AnimUtil.play(`lightAttack{lightSwingIndex}`, 0.06)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			local mouse = player:GetMouse()
			attackRemote:FireServer("heavy", mouse.Hit.Position)
			AnimUtil.play("heavyAttack", 0.06)
		elseif input.KeyCode == Enum.KeyCode.F then
			setBlocking(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.F then
			setBlocking(false)
		end
	end)

	Net.remoteEvent("CombatFx").OnClientEvent:Connect(onVfx)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">CultivationController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > CultivationController
-- Meditation (G to sit and gather qi; standing or walking ends it) and
-- the breakthrough request (B, or the HUD button). While meditating a
-- soft aura breathes around the character; the sit itself uses the
-- meditation animation slots when they exist and a plain Humanoid.Sit as
-- the graceful fallback.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local ClientState = require(script.Parent.Parent.Modules.ClientState)
local AnimUtil = require(script.Parent.Parent.Modules.AnimUtil)

local CultivationController = {}

local player = Players.LocalPlayer
local meditating = false
local aura: ParticleEmitter? = nil

local function setAura(active: boolean)
	if not active then
		if aura then
			aura.Enabled = false
		end
		return
	end
	local model = player.Character
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return
	end
	if aura == nil or aura.Parent == nil or aura.Parent.Parent ~= model then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "MeditationAura"
		emitter.Rate = 6
		emitter.Lifetime = NumberRange.new(1.2, 2)
		emitter.Speed = NumberRange.new(0.6, 1.4)
		emitter.Size = NumberSequence.new(0.35, 0)
		emitter.Transparency = NumberSequence.new(0.35, 1)
		emitter.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255))
		emitter.LightEmission = 0.7
		emitter.Parent = root
		aura = emitter
	end
	(aura :: ParticleEmitter).Enabled = true
end

local function setMeditating(wants: boolean)
	if meditating == wants then
		return
	end
	meditating = wants
	Net.remoteEvent("MeditateSet"):FireServer(wants)
	local model = player.Character
	local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
	if wants then
		AnimUtil.play("meditateEnter", 0.15)
		task.delay(0.3, function()
			if meditating then
				local idle = AnimUtil.play("meditateIdle", 0.2, true)
				if idle == nil and humanoid then
					humanoid.Sit = true -- fallback until real animations exist
				end
			end
		end)
	else
		AnimUtil.stop("meditateIdle", 0.2)
		AnimUtil.play("meditateExit", 0.1)
		if humanoid then
			humanoid.Sit = false
		end
	end
	setAura(wants)
end

local function requestBreakthrough()
	task.spawn(function()
		Net.remoteFunction("BreakthroughRequest"):InvokeServer()
	end)
end

CultivationController.RequestBreakthrough = requestBreakthrough

function CultivationController.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			setMeditating(not meditating)
		elseif input.KeyCode == Enum.KeyCode.B then
			requestBreakthrough()
		end
	end)

	-- The server may end meditation (movement, damage, breakthrough);
	-- mirror its verdict so pose and aura never linger wrongly.
	ClientState.StatsChanged:Connect(function()
		local stats = ClientState.stats
		if stats and stats.meditating == false and meditating then
			meditating = false
			AnimUtil.stop("meditateIdle", 0.2)
			local model = player.Character
			local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then
				humanoid.Sit = false
			end
			setAura(false)
		end
	end)

	player.CharacterAdded:Connect(function()
		meditating = false
		aura = nil
	end)
end

return CultivationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">DaoController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > DaoController
-- The Dao panel: your master, your disciples, offering discipleship to
-- another cultivator by name, and cutting the bond. Sects join this
-- window in their own phase.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)
local Panels = require(script.Parent.Parent.Modules.Panels)

local DaoController = {}

local windowRoot: Frame
local masterLabel: TextLabel
local disciplesLabel: TextLabel
local offerBox: TextBox

local function invoke(remoteName: string, payload: { [string]: any })
	task.spawn(function()
		local result = Net.remoteFunction(remoteName):InvokeServer(payload)
		if typeof(result) == "table" and result.ok ~= true and typeof(result.error) == "string" then
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "The bond refuses",
					Text = result.error,
					Duration = 4,
				})
			end)
		end
	end)
end

local function renderSocial()
	local social = ClientState.social
	if social == nil then
		masterLabel.Text = "Master: none. You walk alone."
		disciplesLabel.Text = "Disciples: none yet."
		return
	end
	masterLabel.Text = if typeof(social.masterName) == "string"
		then `Master: {social.masterName}`
		else "Master: none. You walk alone."
	local disciples = social.disciples :: { { userId: number, name: string } }?
	if disciples and #disciples > 0 then
		local names = {}
		for _, disciple in disciples do
			table.insert(names, disciple.name)
		end
		disciplesLabel.Text = `Disciples ({#disciples}): {table.concat(names, ", ")}`
	else
		disciplesLabel.Text = "Disciples: none yet."
	end
end

function DaoController.Init()
	local screen = UiKit.screen("DaoWindow", 30)
	local body: Frame
	windowRoot, body = UiKit.window(screen, "The Dao of Others", UDim2.fromOffset(360, 250), UDim2.new(0.5, -180, 0.5, -160))

	masterLabel = UiKit.label(body, "", UDim2.new(1, -8, 0, 20), UDim2.fromOffset(4, 4), { textSize = 13, bold = true })
	disciplesLabel = UiKit.label(body, "", UDim2.new(1, -8, 0, 36), UDim2.fromOffset(4, 26), { textSize = 11, wrap = true })

	UiKit.label(body, "Take a disciple (they must accept):", UDim2.new(1, -8, 0, 16), UDim2.fromOffset(4, 72), {
		textSize = 11,
		color = UiKit.Colors.textDim,
	})
	offerBox = UiKit.textBox(body, "Their exact username...", UDim2.new(1, -110, 0, 24), UDim2.fromOffset(4, 90))
	UiKit.button(body, "Offer", UDim2.fromOffset(96, 24), UDim2.new(1, -100, 0, 90), function()
		if #offerBox.Text > 0 then
			invoke("OfferDiscipleship", { targetName = offerBox.Text })
		end
	end, { textSize = 11 })

	UiKit.label(body, "Mastered arts are taught from the Arts window.\nA manual can carry an art to anyone; transmission is disciples only.",
		UDim2.new(1, -8, 0, 34), UDim2.fromOffset(4, 122), {
			textSize = 10,
			color = UiKit.Colors.textDim,
			wrap = true,
		})

	UiKit.button(body, "Renounce my master", UDim2.fromOffset(150, 24), UDim2.new(0.5, -75, 1, -30), function()
		invoke("RenounceMaster", {})
	end, { textSize = 11, color = UiKit.Colors.danger })

	Panels.register("dao", function()
		windowRoot.Visible = not windowRoot.Visible
		if windowRoot.Visible then
			renderSocial()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.N then
			Panels.toggle("dao")
		end
	end)

	ClientState.SocialChanged:Connect(function()
		if windowRoot.Visible then
			renderSocial()
		end
	end)
end

return DaoController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > HudController
-- The always-on interface, ink on paper: identity top-right, vitals and
-- hotbar bottom-center, the cultivation bar with its breakthrough seal,
-- menu chips, toasts, hints, and the disciple-offer prompt.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)
local Panels = require(script.Parent.Parent.Modules.Panels)
local CultivationController = require(script.Parent.CultivationController)

local HudController = {}

local player = Players.LocalPlayer

local realmLabel: TextLabel
local stonesLabel: TextLabel
local healthBar: UiKit.Bar
local qiBar: UiKit.Bar
local staminaBar: UiKit.Bar
local cultivationBar: UiKit.Bar
local breakButton: TextButton
local meditateLabel: TextLabel
local toastArea: Frame

type SlotUi = { root: Frame, name: TextLabel, cooldown: Frame }
local slotUis: { SlotUi } = {}

local function renderStats()
	local stats = ClientState.stats
	if stats == nil then
		return
	end
	realmLabel.Text = tostring(stats.realmName)
	realmLabel.TextColor3 = if typeof(stats.realmColor) == "Color3" then stats.realmColor:Lerp(UiKit.Colors.ink, 0.45) else UiKit.Colors.text
	stonesLabel.Text = `Spirit Stones: {stats.spiritStones}`
	qiBar.set(math.clamp(stats.qi / math.max(stats.maxQi, 1), 0, 1), `QI  {math.floor(stats.qi)} / {stats.maxQi}`)

	local cost = tonumber(stats.breakthroughCost)
	if cost then
		local fraction = math.clamp(stats.cultivationXp / math.max(cost, 1), 0, 1)
		cultivationBar.set(fraction, `CULTIVATION  {math.floor(stats.cultivationXp)} / {cost}`)
		breakButton.Visible = fraction >= 1
	else
		cultivationBar.set(1, "THE PEAK")
		breakButton.Visible = false
	end
	meditateLabel.Visible = stats.meditating == true
end

local function renderSlots()
	local techniques = ClientState.techniques
	for slot = 1, Config.SLOT_COUNT do
		local ui = slotUis[slot]
		local techniqueId = if techniques then (techniques.slots :: { [string]: string })[tostring(slot)] else nil
		local slotName = ""
		if techniques and techniqueId then
			for _, technique in techniques.techniques :: { { [string]: any } } do
				if technique.id == techniqueId then
					slotName = tostring(technique.name)
					break
				end
			end
		end
		ui.name.Text = slotName
		ui.root.BackgroundTransparency = if slotName == "" then 0.7 else 0.1
	end
end

local function startCooldownSweep(slot: number, duration: number)
	local ui = slotUis[slot]
	if ui == nil or duration <= 0 then
		return
	end
	ui.cooldown.Size = UDim2.fromScale(1, 1)
	ui.cooldown.Visible = true
	local tween = TweenService:Create(ui.cooldown, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.fromScale(1, 0),
	})
	tween.Completed:Once(function()
		ui.cooldown.Visible = false
	end)
	tween:Play()
end

local function toast(text: string, color: Color3?)
	if color then
		local luminance = (color.R + color.G + color.B) / 3
		if luminance > 0.55 then
			color = color:Lerp(UiKit.Colors.ink, 0.55)
		end
	end
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 24)
	card.BackgroundColor3 = UiKit.Colors.paper
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.LayoutOrder = -math.floor(os.clock() * 100)
	card.Parent = toastArea
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = UiKit.Colors.ink
	stroke.Thickness = 1.3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card
	local label = UiKit.label(card, text, UDim2.new(1, -14, 1, 0), UDim2.fromOffset(7, 0), {
		textSize = 11,
		color = color or UiKit.Colors.ink,
		bold = true,
		xalign = Enum.TextXAlignment.Center,
	})
	label.TextTruncate = Enum.TextTruncate.AtEnd
	task.delay(4.2, function()
		local fade = TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 })
		TweenService:Create(card, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		fade.Completed:Once(function()
			card:Destroy()
		end)
		fade:Play()
	end)
end

function HudController.Init()
	local screen = UiKit.screen("Hud", 10)

	-- ------------------------ Top-right identity ------------------------
	local identity = UiKit.frame(screen, UDim2.fromOffset(230, 66), UDim2.new(1, -242, 0, 10))
	identity.BackgroundTransparency = 0.12
	UiKit.label(identity, player.DisplayName, UDim2.new(1, -16, 0, 20), UDim2.fromOffset(10, 4), {
		textSize = 15,
		title = true,
		bold = true,
	})
	realmLabel = UiKit.label(identity, "Body Tempering I", UDim2.new(1, -16, 0, 16), UDim2.fromOffset(10, 24), {
		textSize = 12,
	})
	stonesLabel = UiKit.label(identity, "", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 42), {
		textSize = 10,
		color = UiKit.Colors.textDim,
	})

	-- Menu chips under the identity card.
	local menuEntries = {
		{ caption = "Arts", panel = "arts" },
		{ caption = "Bag", panel = "bag" },
		{ caption = "Dao", panel = "dao" },
		{ caption = "Updates", panel = "updates" },
	}
	for index, entry in menuEntries do
		UiKit.button(screen, entry.caption, UDim2.fromOffset(54, 20), UDim2.new(1, -242 + (index - 1) * 58, 0, 82), function()
			Panels.toggle(entry.panel)
		end, { textSize = 10 })
	end

	-- ---------------------- Bottom center: vitals ----------------------
	local barsWidth = 240
	local bottom = Instance.new("Frame")
	bottom.Size = UDim2.fromOffset(barsWidth, 66)
	bottom.Position = UDim2.new(0.5, -barsWidth / 2, 1, -150)
	bottom.BackgroundTransparency = 1
	bottom.Parent = screen

	healthBar = UiKit.bar(bottom, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 0), UiKit.Colors.health)
	qiBar = UiKit.bar(bottom, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 14), UiKit.Colors.qi)
	staminaBar = UiKit.bar(bottom, UDim2.new(1, 0, 0, 8), UDim2.fromOffset(0, 28), UiKit.Colors.stamina)
	cultivationBar = UiKit.bar(bottom, UDim2.new(1, 0, 0, 10), UDim2.fromOffset(0, 40), UiKit.Colors.xp)

	breakButton = UiKit.button(screen, "BREAK THROUGH", UDim2.fromOffset(130, 24), UDim2.new(0.5, -65, 1, -180), function()
		CultivationController.RequestBreakthrough()
	end, { textSize = 12, color = UiKit.Colors.danger })
	breakButton.Visible = false

	meditateLabel = UiKit.label(screen, "~ Meditating: qi gathers, the dao whispers ~", UDim2.new(0, 380, 0, 20), UDim2.new(0.5, -190, 0, 64), {
		textSize = 14,
		title = true,
		xalign = Enum.TextXAlignment.Center,
	})
	meditateLabel.TextStrokeColor3 = UiKit.Colors.paper
	meditateLabel.TextStrokeTransparency = 0.3
	meditateLabel.Visible = false

	-- ------------------------------ Hotbar ------------------------------
	local slotSize = 52
	local hotbarWidth = Config.SLOT_COUNT * (slotSize + 6)
	local hotbar = Instance.new("Frame")
	hotbar.Size = UDim2.fromOffset(hotbarWidth, slotSize)
	hotbar.Position = UDim2.new(0.5, -hotbarWidth / 2, 1, -slotSize - 12)
	hotbar.BackgroundTransparency = 1
	hotbar.Parent = screen
	for slot = 1, Config.SLOT_COUNT do
		local root = UiKit.frame(hotbar, UDim2.fromOffset(slotSize, slotSize), UDim2.fromOffset((slot - 1) * (slotSize + 6), 0), UiKit.Colors.ink)
		root.BackgroundTransparency = 0.1
		UiKit.label(root, tostring(slot), UDim2.fromOffset(14, 12), UDim2.fromOffset(4, 2), {
			textSize = 10,
			color = UiKit.Colors.paper,
			bold = true,
		})
		local slotName = UiKit.label(root, "", UDim2.new(1, -6, 0, 32), UDim2.fromOffset(3, 15), {
			textSize = 9,
			color = UiKit.Colors.paper,
			xalign = Enum.TextXAlignment.Center,
			wrap = true,
		})
		local cooldown = Instance.new("Frame")
		cooldown.AnchorPoint = Vector2.new(0, 1)
		cooldown.Position = UDim2.fromScale(0, 1)
		cooldown.Size = UDim2.fromScale(1, 0)
		cooldown.BackgroundColor3 = UiKit.Colors.paper
		cooldown.BackgroundTransparency = 0.6
		cooldown.BorderSizePixel = 0
		cooldown.Visible = false
		cooldown.ZIndex = 5
		cooldown.Parent = root
		slotUis[slot] = { root = root, name = slotName, cooldown = cooldown }
	end

	-- Hints.
	local hints = UiKit.label(screen,
		"Click Attack   RClick Heavy   F Block   Q Dodge   Shift Sprint   G Meditate   B Break Through   1-6 Techniques",
		UDim2.new(0, 700, 0, 14), UDim2.new(0.5, -350, 1, -168), {
			textSize = 9,
			xalign = Enum.TextXAlignment.Center,
		})
	hints.TextStrokeColor3 = UiKit.Colors.paper
	hints.TextStrokeTransparency = 0.4

	-- Toasts.
	toastArea = Instance.new("Frame")
	toastArea.Size = UDim2.new(0, 380, 0, 170)
	toastArea.Position = UDim2.new(0.5, -190, 0, 88)
	toastArea.BackgroundTransparency = 1
	toastArea.Parent = screen
	local toastLayout = Instance.new("UIListLayout")
	toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toastLayout.Padding = UDim.new(0, 4)
	toastLayout.Parent = toastArea

	-- Health straight from the humanoid, re-hooked each respawn.
	local function hookHealth(model: Model)
		local humanoid = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
		if humanoid == nil or not humanoid:IsA("Humanoid") then
			return
		end
		local function renderHealth()
			healthBar.set(math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1),
				`HP  {math.floor(humanoid.Health)} / {math.floor(humanoid.MaxHealth)}`)
		end
		humanoid.HealthChanged:Connect(renderHealth)
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(renderHealth)
		renderHealth()
	end
	if player.Character then
		task.spawn(hookHealth, player.Character)
	end
	player.CharacterAdded:Connect(function(model)
		task.spawn(hookHealth, model)
	end)

	-- The disciple-offer prompt.
	local offerFrame = UiKit.frame(screen, UDim2.fromOffset(300, 84), UDim2.new(0.5, -150, 0, 180))
	offerFrame.Visible = false
	local offerText = UiKit.label(offerFrame, "", UDim2.new(1, -16, 0, 36), UDim2.fromOffset(8, 4), {
		textSize = 13,
		wrap = true,
		xalign = Enum.TextXAlignment.Center,
	})
	UiKit.button(offerFrame, "Accept", UDim2.fromOffset(110, 26), UDim2.new(0.5, -120, 1, -34), function()
		offerFrame.Visible = false
		task.spawn(function()
			Net.remoteFunction("RespondDiscipleship"):InvokeServer({ accept = true })
		end)
	end, { textSize = 12 })
	UiKit.button(offerFrame, "Decline", UDim2.fromOffset(110, 26), UDim2.new(0.5, 10, 1, -34), function()
		offerFrame.Visible = false
		task.spawn(function()
			Net.remoteFunction("RespondDiscipleship"):InvokeServer({ accept = false })
		end)
	end, { textSize = 12, color = UiKit.Colors.danger })
	Net.remoteEvent("DiscipleOffer").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.masterName) == "string" then
			offerText.Text = `{payload.masterName} offers to take you as their disciple.`
			offerFrame.Visible = true
		end
	end)

	-- Wiring.
	ClientState.StatsChanged:Connect(renderStats)
	ClientState.TechniquesChanged:Connect(renderSlots)
	ClientState.StaminaChanged:Connect(function(current: number, max: number)
		staminaBar.set(math.clamp(current / math.max(max, 1), 0, 1), "")
	end)
	ClientState.CooldownStarted:Connect(startCooldownSweep)
	Net.remoteEvent("Notify").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.text) == "string" then
			toast(payload.text, payload.color)
		end
	end)
	renderStats()
	renderSlots()
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > InventoryController
-- The Bag: stackable items with equip/use, and technique manuals with
-- learn/give. Giving hands the book to a nearby cultivator, chosen from
-- whoever stands within reach.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)
local Panels = require(script.Parent.Parent.Modules.Panels)

local InventoryController = {}

local player = Players.LocalPlayer

local windowRoot: Frame
local listScroll: ScrollingFrame

local function invoke(remoteName: string, payload: { [string]: any })
	task.spawn(function()
		local result = Net.remoteFunction(remoteName):InvokeServer(payload)
		if typeof(result) == "table" and result.ok ~= true and typeof(result.error) == "string" then
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "The bag disagrees",
					Text = result.error,
					Duration = 4,
				})
			end)
		end
	end)
end

local function nearbyPlayers(range: number): { Player }
	local found: { Player } = {}
	local model = player.Character
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return found
	end
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		local otherRoot = if other.Character then other.Character:FindFirstChild("HumanoidRootPart") else nil
		if otherRoot and otherRoot:IsA("BasePart") and (otherRoot.Position - (root :: BasePart).Position).Magnitude <= range then
			table.insert(found, other)
		end
	end
	return found
end

local function card(orderIndex: number, height: number): Frame
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -8, 0, height)
	frame.BackgroundColor3 = UiKit.Colors.paper
	frame.BorderSizePixel = 0
	frame.LayoutOrder = orderIndex
	frame.Parent = listScroll
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = UiKit.Colors.ink
	stroke.Thickness = 1.2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	return frame
end

local function renderList()
	for _, child in listScroll:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local inventory = ClientState.inventory
	if inventory == nil then
		return
	end
	local order = 0

	UiKit.label(card(order, 20), `Spirit Stones: {inventory.spiritStones}`, UDim2.new(1, -12, 1, 0), UDim2.fromOffset(8, 0), {
		textSize = 12,
		bold = true,
		color = UiKit.Colors.qi,
	})

	for itemId, count in inventory.items :: { [string]: number } do
		order += 1
		local def = Items.get(itemId)
		local itemCard = card(order, 46)
		local displayName = if def then def.name else itemId
		local equipped = inventory.equippedWeapon == itemId
		UiKit.label(itemCard, `{displayName}  x{count}{if equipped then "   [wielded]" else ""}`, UDim2.new(1, -12, 0, 18), UDim2.fromOffset(8, 2), {
			textSize = 12,
			bold = true,
		})
		UiKit.label(itemCard, if def then def.blurb else "", UDim2.new(1, -140, 0, 22), UDim2.fromOffset(8, 20), {
			textSize = 9,
			color = UiKit.Colors.textDim,
			wrap = true,
		})
		if def and def.kind == "weapon" then
			UiKit.button(itemCard, if equipped then "Unequip" else "Wield", UDim2.fromOffset(60, 20), UDim2.new(1, -66, 0, 22), function()
				invoke("EquipItem", { id = itemId, action = if equipped then "unequip" else "equip" })
			end, { textSize = 10 })
		elseif def and def.kind == "pill" then
			UiKit.button(itemCard, "Swallow", UDim2.fromOffset(60, 20), UDim2.new(1, -66, 0, 22), function()
				invoke("EquipItem", { id = itemId, action = "use" })
			end, { textSize = 10, color = UiKit.Colors.gold })
		end
	end

	for bookId, manual in inventory.manuals :: { [string]: { [string]: any } } do
		order += 1
		local manualCard = card(order, 52)
		UiKit.label(manualCard, `Manual: "{manual.techniqueName}"`, UDim2.new(1, -12, 0, 18), UDim2.fromOffset(8, 2), {
			textSize = 12,
			bold = true,
			color = UiKit.Colors.gold,
		})
		UiKit.label(manualCard, "A technique, bound in silk and patience.", UDim2.new(1, -200, 0, 20), UDim2.fromOffset(8, 22), {
			textSize = 9,
			color = UiKit.Colors.textDim,
		})
		UiKit.button(manualCard, "Study", UDim2.fromOffset(52, 20), UDim2.new(1, -180, 0, 24), function()
			invoke("UseManual", { bookId = bookId })
		end, { textSize = 10 })
		UiKit.button(manualCard, "Give (nearby)", UDim2.fromOffset(110, 20), UDim2.new(1, -122, 0, 24), function()
			local candidates = nearbyPlayers(22)
			if #candidates == 0 then
				pcall(function()
					game:GetService("StarterGui"):SetCore("SendNotification", {
						Title = "No one near",
						Text = "Stand beside someone to hand them a manual.",
						Duration = 4,
					})
				end)
				return
			end
			invoke("GiveManual", { bookId = bookId, targetUserId = candidates[1].UserId })
		end, { textSize = 10, color = UiKit.Colors.paperDim, textColor = UiKit.Colors.text })
	end
end

function InventoryController.Init()
	local screen = UiKit.screen("BagWindow", 30)
	local body: Frame
	windowRoot, body = UiKit.window(screen, "The Bag", UDim2.fromOffset(380, 380), UDim2.new(0.5, -190, 0.5, -210))
	listScroll = UiKit.scroll(body, UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0))

	Panels.register("bag", function()
		windowRoot.Visible = not windowRoot.Visible
		if windowRoot.Visible then
			renderList()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.I then
			Panels.toggle("bag")
		end
	end)

	ClientState.InventoryChanged:Connect(function()
		if windowRoot.Visible then
			renderList()
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > MovementController
-- Body movement the client owns (it owns its character's physics): hold
-- Shift to sprint on a stamina pool, press Q to dodge-dash (the server
-- grants the evasion window; the impulse is local so it feels instant).
--
-- The speed contract with the server: WalkSpeed is computed here every
-- frame as (BaseWalkSpeed + SpeedFlat) * SpeedFactor * sprint. The server
-- writes only those attributes, never WalkSpeed itself.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))

local ClientState = require(script.Parent.Parent.Modules.ClientState)
local AnimUtil = require(script.Parent.Parent.Modules.AnimUtil)

local MovementController = {}

local player = Players.LocalPlayer

local stamina = Config.STAMINA_MAX
local sprinting = false
local speedMult = 1 -- eased so speed ramps instead of popping
local lastDodge = 0

local function character(): (Humanoid?, BasePart?)
	local model = player.Character
	if model == nil then
		return nil, nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	return humanoid, if root and root:IsA("BasePart") then root else nil
end

local function dodge()
	local now = os.clock()
	if now - lastDodge < Config.DODGE_COOLDOWN then
		return
	end
	local humanoid, root = character()
	if humanoid == nil or root == nil or humanoid.Health <= 0 then
		return
	end
	lastDodge = now
	Net.remoteEvent("DodgeRequest"):FireServer()

	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	root.AssemblyLinearVelocity = direction.Unit * Config.DODGE_SPEED + Vector3.new(0, 6, 0)
	AnimUtil.play("dodge", 0.05)

	-- A short qi ribbon off the feet.
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-0.9, -2.9, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0.9, -2.9, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.fromRGB(58, 132, 255), Color3.fromRGB(120, 190, 255))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.28
	trail.LightEmission = 0.6
	trail.Parent = root
	task.delay(0.35, function()
		trail.Enabled = false
		task.wait(0.3)
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)

	local camera = workspace.CurrentCamera
	if camera then
		local baseFov = camera.FieldOfView
		TweenService:Create(camera, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = baseFov + 7 }):Play()
		task.delay(0.14, function()
			TweenService:Create(camera, TweenInfo.new(0.22), { FieldOfView = baseFov }):Play()
		end)
	end
end

function MovementController.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			sprinting = true
		end
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Q then
			dodge()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			sprinting = false
		end
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		local humanoid = (character())
		if humanoid == nil then
			return
		end
		local baseAttr = humanoid:GetAttribute("BaseWalkSpeed")
		local base = if typeof(baseAttr) == "number" then baseAttr else Config.BASE_WALKSPEED
		local flatAttr = humanoid:GetAttribute("SpeedFlat")
		local flat = if typeof(flatAttr) == "number" then flatAttr else 0
		local factorAttr = humanoid:GetAttribute("SpeedFactor")
		local factor = if typeof(factorAttr) == "number" then factorAttr else 1

		local moving = humanoid.MoveDirection.Magnitude > 0.05
		local sprintingNow = sprinting and moving and stamina > 0
		if sprintingNow then
			stamina = math.max(0, stamina - Config.SPRINT_DRAIN * deltaTime)
		else
			stamina = math.min(Config.STAMINA_MAX, stamina + Config.STAMINA_REGEN * deltaTime)
		end
		local targetMult = if sprintingNow then Config.SPRINT_MULT else 1
		speedMult += (targetMult - speedMult) * math.min(1, deltaTime * 7)
		humanoid.WalkSpeed = (base + flat) * factor * speedMult
		ClientState.FireStamina(stamina, Config.STAMINA_MAX)

		-- Sprint animation slot, when one exists.
		if sprintingNow then
			AnimUtil.play("sprint", 0.25, true)
		else
			AnimUtil.stop("sprint", 0.3)
		end
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">TechniqueController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > TechniqueController
-- Casting (keys 1-6, aimed at the mouse) and the Arts window: the list of
-- known techniques with equip/teach/manual/discard actions, and the
-- creation desk where components are chained into a new art. The window
-- previews with the SAME shared math the server enforces, so what it
-- promises is what the server delivers.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Realms = require(Shared:WaitForChild("Realms"))
local TechniqueMath = require(Shared:WaitForChild("TechniqueMath"))
local TechniqueParts = require(Shared:WaitForChild("TechniqueParts"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)
local Panels = require(script.Parent.Parent.Modules.Panels)

local TechniqueController = {}

local player = Players.LocalPlayer
local castRemote = Net.remoteEvent("CastTechnique")

local SLOT_KEYS: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
}

local localCooldowns: { [string]: number } = {}

local function cast(slot: number)
	local techniques = ClientState.techniques
	if techniques == nil then
		return
	end
	local techniqueId = (techniques.slots :: { [string]: string })[tostring(slot)]
	if techniqueId == nil then
		return
	end
	local design: { [string]: any }? = nil
	for _, candidate in techniques.techniques :: { { [string]: any } } do
		if candidate.id == techniqueId then
			design = candidate
			break
		end
	end
	if design == nil then
		return
	end
	local computed = (TechniqueMath.compute(design.category, design.components, 1))
	local now = os.clock()
	if computed then
		local readyAt = localCooldowns[techniqueId]
		if readyAt and now < readyAt then
			return
		end
		localCooldowns[techniqueId] = now + computed.cooldown
		ClientState.FireCooldown(slot, computed.cooldown)
	end
	local mouse = player:GetMouse()
	castRemote:FireServer(slot, mouse.Hit.Position)
end

-- ------------------------------ The window -------------------------------

local windowRoot: Frame
local listScroll: ScrollingFrame
local previewLabel: TextLabel
local chainLabel: TextLabel
local nameBox: TextBox
local intensity = 3
local intensityLabel: TextLabel
local currentCategory = "sword"
local chain: { string } = {}
local categoryButtons: { [string]: TextButton } = {}
local partButtonsFrame: ScrollingFrame

local function refreshPreview()
	chainLabel.Text = if #chain == 0 then "Chain: (choose components)" else "Chain: " .. table.concat(
		(function()
			local names = {}
			for _, id in chain do
				local part = TechniqueParts.get(id)
				table.insert(names, if part then part.name else id)
			end
			return names
		end)(),
		"  >  "
	)
	local computed, reason = TechniqueMath.compute(currentCategory, chain, intensity)
	if computed == nil then
		previewLabel.Text = reason or ""
		return
	end
	previewLabel.Text = `{computed.rank}   power {computed.power}   damage ~{computed.damage}   qi {computed.qiCost}   cooldown {string.format("%.1f", computed.cooldown)}s\nRequires {Realms.displayName(computed.requiredStage)}`
end

local function rebuildPartButtons()
	for _, child in partButtonsFrame:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local order = 0
	for _, part in TechniqueParts.LIST do
		if not TechniqueParts.allowedIn(part.id, currentCategory) then
			continue
		end
		order += 1
		local button = UiKit.button(partButtonsFrame, `{part.name}  ({part.kind})`, UDim2.new(1, -8, 0, 24), UDim2.fromOffset(0, 0), function()
			if table.find(chain, part.id) then
				local index = table.find(chain, part.id)
				if index then
					table.remove(chain, index)
				end
			elseif #chain < Config.MAX_COMPONENTS then
				table.insert(chain, part.id)
			end
			refreshPreview()
		end, { textSize = 11, color = UiKit.Colors.paperDim, textColor = UiKit.Colors.text })
		button.LayoutOrder = order
	end
end

local function setCategory(category: string)
	currentCategory = category
	table.clear(chain)
	for id, button in categoryButtons do
		button.BackgroundColor3 = if id == category then UiKit.Colors.ink else UiKit.Colors.paperDim
		button.TextColor3 = if id == category then UiKit.Colors.paper else UiKit.Colors.text
	end
	rebuildPartButtons()
	refreshPreview()
end

-- Invoke a RemoteFunction and surface a denial as a platform notification
-- (server-approved actions already toast through the Notify channel).
local function invoke(remoteName: string, payload: { [string]: any })
	task.spawn(function()
		local result = Net.remoteFunction(remoteName):InvokeServer(payload)
		if typeof(result) == "table" and result.ok ~= true and typeof(result.error) == "string" then
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "The dao refuses",
					Text = result.error,
					Duration = 4,
				})
			end)
		end
	end)
end

local function renderList()
	for _, child in listScroll:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local techniques = ClientState.techniques
	if techniques == nil then
		return
	end
	local order = 0
	for _, design in techniques.techniques :: { { [string]: any } } do
		order += 1
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, -8, 0, 66)
		card.BackgroundColor3 = UiKit.Colors.paper
		card.BorderSizePixel = 0
		card.LayoutOrder = order
		card.Parent = listScroll
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = card
		local stroke = Instance.new("UIStroke")
		stroke.Color = UiKit.Colors.ink
		stroke.Thickness = 1.2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = card

		local mastery = TechniqueMath.masteryPercent(tonumber(design.masteryXp) or 0, tonumber(design.power) or 1)
		local inheritedTag = if design.inherited then "  (inherited)" else ""
		UiKit.label(card, `{design.name}{inheritedTag}`, UDim2.new(1, -12, 0, 18), UDim2.fromOffset(8, 2), {
			textSize = 13,
			bold = true,
		})
		UiKit.label(card, `{TechniqueMath.rankName(tonumber(design.power) or 0)}   power {design.power}   mastery {mastery}%{if design.origin then `   from {design.origin}` else ""}`,
			UDim2.new(1, -12, 0, 13), UDim2.fromOffset(8, 20), {
				textSize = 10,
				color = UiKit.Colors.textDim,
			})

		-- Slot buttons 1-6.
		for slot = 1, Config.SLOT_COUNT do
			UiKit.button(card, tostring(slot), UDim2.fromOffset(20, 18), UDim2.fromOffset(8 + (slot - 1) * 24, 40), function()
				invoke("EquipTechnique", { slot = slot, id = design.id })
			end, { textSize = 10, color = UiKit.Colors.paperDim, textColor = UiKit.Colors.text })
		end
		if mastery >= 100 then
			UiKit.button(card, "Manual", UDim2.fromOffset(52, 18), UDim2.new(1, -170, 0, 40), function()
				invoke("WriteManual", { id = design.id })
			end, { textSize = 10, color = UiKit.Colors.gold })
			UiKit.button(card, "Teach", UDim2.fromOffset(48, 18), UDim2.new(1, -114, 0, 40), function()
				-- Teach the first disciple stood nearby; the Dao panel
				-- explains the ritual.
				local social = ClientState.social
				local disciples = if social then social.disciples :: { { userId: number, name: string } } else nil
				if disciples and #disciples > 0 then
					invoke("TeachTechnique", { id = design.id, targetUserId = disciples[1].userId })
				else
					warn("[Arts] You have no disciples to teach.")
				end
			end, { textSize = 10 })
		end
		UiKit.button(card, "Discard", UDim2.fromOffset(56, 18), UDim2.new(1, -62, 0, 40), function()
			invoke("DeleteTechnique", { id = design.id })
		end, { textSize = 10, color = UiKit.Colors.danger })
	end
end

local function buildWindow(screen: ScreenGui)
	local body: Frame
	windowRoot, body = UiKit.window(screen, "The Hundred Arts", UDim2.fromOffset(560, 420), UDim2.new(0.5, -280, 0.5, -230))

	-- Left: known techniques.
	UiKit.label(body, "KNOWN ARTS", UDim2.fromOffset(200, 14), UDim2.fromOffset(2, 0), { textSize = 10, bold = true, color = UiKit.Colors.textDim })
	listScroll = UiKit.scroll(body, UDim2.new(0.5, -8, 1, -18), UDim2.fromOffset(0, 18))

	-- Right: the creation desk.
	local desk = Instance.new("Frame")
	desk.Size = UDim2.new(0.5, -4, 1, -18)
	desk.Position = UDim2.new(0.5, 8, 0, 18)
	desk.BackgroundTransparency = 1
	desk.Parent = body

	UiKit.label(desk, "CREATE A NEW ART", UDim2.fromOffset(220, 14), UDim2.fromOffset(2, 0), { textSize = 10, bold = true, color = UiKit.Colors.textDim })
	for index, category in TechniqueParts.CATEGORIES do
		local button = UiKit.button(desk, category:upper(), UDim2.fromOffset(62, 20), UDim2.fromOffset((index - 1) * 66, 18), function()
			setCategory(category)
		end, { textSize = 10, color = UiKit.Colors.paperDim, textColor = UiKit.Colors.text })
		categoryButtons[category] = button
	end

	partButtonsFrame = UiKit.scroll(desk, UDim2.new(1, 0, 0, 150), UDim2.fromOffset(0, 44))
	chainLabel = UiKit.label(desk, "Chain:", UDim2.new(1, 0, 0, 28), UDim2.fromOffset(2, 198), { textSize = 10, wrap = true })
	previewLabel = UiKit.label(desk, "", UDim2.new(1, 0, 0, 34), UDim2.fromOffset(2, 226), { textSize = 10, color = UiKit.Colors.textDim, wrap = true })

	UiKit.label(desk, "Intensity", UDim2.fromOffset(60, 20), UDim2.fromOffset(2, 264), { textSize = 11 })
	UiKit.button(desk, "-", UDim2.fromOffset(22, 20), UDim2.fromOffset(64, 264), function()
		intensity = math.max(1, intensity - 1)
		intensityLabel.Text = tostring(intensity)
		refreshPreview()
	end, { textSize = 12 })
	intensityLabel = UiKit.label(desk, "3", UDim2.fromOffset(24, 20), UDim2.fromOffset(90, 264), { textSize = 12, bold = true, xalign = Enum.TextXAlignment.Center })
	UiKit.button(desk, "+", UDim2.fromOffset(22, 20), UDim2.fromOffset(116, 264), function()
		intensity = math.min(10, intensity + 1)
		intensityLabel.Text = tostring(intensity)
		refreshPreview()
	end, { textSize = 12 })
	UiKit.button(desk, "Clear chain", UDim2.fromOffset(80, 20), UDim2.new(1, -84, 0, 264), function()
		table.clear(chain)
		refreshPreview()
	end, { textSize = 10, color = UiKit.Colors.paperDim, textColor = UiKit.Colors.text })

	nameBox = UiKit.textBox(desk, "Name your art...", UDim2.new(1, -96, 0, 24), UDim2.fromOffset(0, 292))
	UiKit.button(desk, "CREATE", UDim2.fromOffset(88, 24), UDim2.new(1, -90, 0, 292), function()
		invoke("CreateTechnique", {
			category = currentCategory,
			components = table.clone(chain),
			intensity = intensity,
			name = nameBox.Text,
		})
	end, { textSize = 11 })

	setCategory("sword")
end

function TechniqueController.Init()
	local screen = UiKit.screen("ArtsWindow", 30)
	buildWindow(screen)

	Panels.register("arts", function()
		windowRoot.Visible = not windowRoot.Visible
		if windowRoot.Visible then
			renderList()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local slot = SLOT_KEYS[input.KeyCode]
		if slot then
			cast(slot)
		elseif input.KeyCode == Enum.KeyCode.T then
			Panels.toggle("arts")
		end
	end)

	ClientState.TechniquesChanged:Connect(function()
		if windowRoot.Visible then
			renderList()
		end
	end)
end

return TechniqueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">UpdatesController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > UpdatesController
-- The changelog window, reading Shared/UpdatesData. Players who can see
-- the game moving stay.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UpdatesData = require(Shared:WaitForChild("UpdatesData"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local Panels = require(script.Parent.Parent.Modules.Panels)

local UpdatesController = {}

function UpdatesController.Init()
	local screen = UiKit.screen("UpdatesWindow", 30)
	local windowRoot, body = UiKit.window(screen, "From the Annals", UDim2.fromOffset(400, 380), UDim2.new(0.5, -200, 0.5, -210))
	local scroll = UiKit.scroll(body, UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0))

	local order = 0
	for _, entry in UpdatesData do
		order += 1
		local height = 44 + #entry.notes * 26
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, -8, 0, height)
		card.BackgroundColor3 = UiKit.Colors.paper
		card.BorderSizePixel = 0
		card.LayoutOrder = order
		card.Parent = scroll
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = card
		local stroke = Instance.new("UIStroke")
		stroke.Color = UiKit.Colors.ink
		stroke.Thickness = 1.2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = card

		UiKit.label(card, `{entry.version}  ·  {entry.title}`, UDim2.new(1, -12, 0, 20), UDim2.fromOffset(8, 2), {
			textSize = 13,
			bold = true,
		})
		UiKit.label(card, entry.date, UDim2.new(1, -12, 0, 12), UDim2.fromOffset(8, 22), {
			textSize = 9,
			color = UiKit.Colors.textDim,
		})
		for noteIndex, note in entry.notes do
			UiKit.label(card, "· " .. note, UDim2.new(1, -16, 0, 24), UDim2.fromOffset(10, 34 + (noteIndex - 1) * 26), {
				textSize = 10,
				wrap = true,
				yalign = Enum.TextYAlignment.Top,
			})
		end
	end

	Panels.register("updates", function()
		windowRoot.Visible = not windowRoot.Visible
	end)
end

return UpdatesController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="41">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">AnimUtil</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > AnimUtil
-- Loads animation slots from Shared/Animations onto the local character.
-- Placeholder slots (REPLACE_ME) are skipped SILENTLY, so the game plays
-- fully un-animated until real clips are uploaded, and each animation
-- simply appears the moment its id is filled in.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Animations = require(Shared:WaitForChild("Animations"))

local AnimUtil = {}

local player = Players.LocalPlayer
local tracks: { [string]: AnimationTrack } = {}

local function isReal(id: string): boolean
	return not string.find(id, "REPLACE_ME", 1, true)
end

local function loadFor(model: Model)
	table.clear(tracks)
	local humanoid = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
	if humanoid == nil or not humanoid:IsA("Humanoid") then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 10)
	if animator == nil or not animator:IsA("Animator") then
		return
	end
	for slot, id in Animations :: { [string]: string } do
		if not isReal(id) then
			continue
		end
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			tracks[slot] = track
		end
	end
end

-- Play a slot if its animation exists; harmless no-op otherwise.
function AnimUtil.play(slot: string, fadeTime: number?, looped: boolean?): AnimationTrack?
	local track = tracks[slot]
	if track then
		if looped ~= nil then
			track.Looped = looped
		end
		track:Play(fadeTime or 0.1)
	end
	return track
end

function AnimUtil.stop(slot: string, fadeTime: number?)
	local track = tracks[slot]
	if track and track.IsPlaying then
		track:Stop(fadeTime or 0.2)
	end
end

function AnimUtil.Init()
	if player.Character then
		task.spawn(loadFor, player.Character)
	end
	player.CharacterAdded:Connect(function(model)
		task.spawn(loadFor, model)
	end)
end

return AnimUtil
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > ClientState
-- Client-side cache of everything the server pushes, plus signals the UI
-- subscribes to. Controllers read state here instead of each wiring its
-- own remote listeners.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local ClientState = {}

ClientState.stats = nil :: { [string]: any }?
ClientState.inventory = nil :: { [string]: any }?
ClientState.techniques = nil :: { [string]: any }?
ClientState.social = nil :: { [string]: any }?

local statsEvent = Instance.new("BindableEvent")
local inventoryEvent = Instance.new("BindableEvent")
local techniquesEvent = Instance.new("BindableEvent")
local socialEvent = Instance.new("BindableEvent")
local staminaEvent = Instance.new("BindableEvent")
local cooldownEvent = Instance.new("BindableEvent")

ClientState.StatsChanged = statsEvent.Event
ClientState.InventoryChanged = inventoryEvent.Event
ClientState.TechniquesChanged = techniquesEvent.Event
ClientState.SocialChanged = socialEvent.Event
ClientState.StaminaChanged = staminaEvent.Event
ClientState.CooldownStarted = cooldownEvent.Event

function ClientState.FireStamina(current: number, max: number)
	staminaEvent:Fire(current, max)
end

function ClientState.FireCooldown(slot: number, duration: number)
	cooldownEvent:Fire(slot, duration)
end

function ClientState.Init()
	Net.remoteEvent("StatsChanged").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			ClientState.stats = payload
			statsEvent:Fire()
		end
	end)
	Net.remoteEvent("InventoryChanged").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			ClientState.inventory = payload
			inventoryEvent:Fire()
		end
	end)
	Net.remoteEvent("TechniquesChanged").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			ClientState.techniques = payload
			techniquesEvent:Fire()
		end
	end)
	Net.remoteEvent("SocialChanged").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			ClientState.social = payload
			socialEvent:Fire()
		end
	end)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > Panels
-- Tiny registry mapping panel names to toggle functions so the HUD's menu
-- can open any controller's window without controllers knowing each other.

local Panels = {}

local toggles: { [string]: () -> () } = {}

function Panels.register(name: string, toggle: () -> ())
	toggles[name] = toggle
end

function Panels.toggle(name: string)
	local handler = toggles[name]
	if handler then
		handler()
	end
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">UiKit</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > UiKit
-- The ink-and-paper interface language: paper panels, ink text, serif
-- faces, brush-stroke bars. Original to this game. One hard rule from a
-- costly lesson: every UIStroke uses ApplyStrokeMode.Border, or it
-- outlines the text glyphs themselves and everything reads blobby.

local UiKit = {}

UiKit.Colors = {
	ink = Color3.fromRGB(27, 24, 21),
	paper = Color3.fromRGB(246, 243, 233),
	paperDim = Color3.fromRGB(233, 228, 214),
	inset = Color3.fromRGB(222, 216, 200),
	text = Color3.fromRGB(38, 34, 30),
	textDim = Color3.fromRGB(110, 102, 92),
	health = Color3.fromRGB(194, 59, 46),
	qi = Color3.fromRGB(59, 125, 216),
	stamina = Color3.fromRGB(224, 138, 46),
	xp = Color3.fromRGB(150, 122, 200),
	gold = Color3.fromRGB(168, 130, 42),
	danger = Color3.fromRGB(178, 44, 38),
}

local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.Garamond
local BOLD_FONT = Enum.Font.Merriweather

export type LabelOptions = {
	textSize: number?,
	color: Color3?,
	bold: boolean?,
	title: boolean?,
	wrap: boolean?,
	xalign: Enum.TextXAlignment?,
	yalign: Enum.TextYAlignment?,
}

function UiKit.screen(name: string, displayOrder: number): ScreenGui
	local player = game:GetService("Players").LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.DisplayOrder = displayOrder
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

local function stroked(instance: GuiObject, color: Color3, thickness: number)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
end

function UiKit.frame(parent: Instance, size: UDim2, position: UDim2, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = color or UiKit.Colors.paper
	frame.BorderSizePixel = 0
	frame.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = frame
	stroked(frame, UiKit.Colors.ink, 1.8)
	return frame
end

function UiKit.label(parent: Instance, text: string, size: UDim2, position: UDim2, options: LabelOptions?): TextLabel
	local opts: LabelOptions = options or {}
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = opts.color or UiKit.Colors.text
	label.TextSize = (opts.textSize or 12) + (if opts.title then 2 else 0)
	label.Font = if opts.bold then BOLD_FONT elseif opts.title then TITLE_FONT else BODY_FONT
	label.TextWrapped = opts.wrap == true
	label.TextXAlignment = opts.xalign or Enum.TextXAlignment.Left
	label.TextYAlignment = opts.yalign or Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

export type ButtonOptions = {
	textSize: number?,
	color: Color3?,
	textColor: Color3?,
}

function UiKit.button(parent: Instance, text: string, size: UDim2, position: UDim2, callback: () -> (), options: ButtonOptions?): TextButton
	local opts: ButtonOptions = options or {}
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = opts.color or UiKit.Colors.ink
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = opts.textColor or UiKit.Colors.paper
	button.TextSize = opts.textSize or 12
	button.Font = BOLD_FONT
	button.AutoButtonColor = true
	button.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = button
	stroked(button, UiKit.Colors.ink, 1.4)
	button.Activated:Connect(callback)
	return button
end

function UiKit.textBox(parent: Instance, placeholder: string, size: UDim2, position: UDim2): TextBox
	local box = Instance.new("TextBox")
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = UiKit.Colors.inset
	box.BorderSizePixel = 0
	box.PlaceholderText = placeholder
	box.Text = ""
	box.TextColor3 = UiKit.Colors.text
	box.PlaceholderColor3 = UiKit.Colors.textDim
	box.TextSize = 13
	box.Font = BODY_FONT
	box.ClearTextOnFocus = false
	box.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = box
	stroked(box, UiKit.Colors.ink, 1.2)
	return box
end

function UiKit.scroll(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = size
	scroll.Position = position
	scroll.BackgroundColor3 = UiKit.Colors.paperDim
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = UiKit.Colors.ink
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = scroll
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 4)
	layout.Parent = scroll
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = scroll
	return scroll
end

export type Bar = { root: Frame, set: (fraction: number, text: string) -> () }

function UiKit.bar(parent: Instance, size: UDim2, position: UDim2, color: Color3): Bar
	local root = Instance.new("Frame")
	root.Size = size
	root.Position = position
	root.BackgroundColor3 = UiKit.Colors.inset
	root.BorderSizePixel = 0
	root.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = root
	stroked(root, UiKit.Colors.ink, 1.4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = root
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local text = UiKit.label(root, "", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), {
		textSize = 10,
		bold = true,
		color = UiKit.Colors.paper,
		xalign = Enum.TextXAlignment.Center,
	})
	text.TextStrokeColor3 = UiKit.Colors.ink
	text.TextStrokeTransparency = 0.1
	text.ZIndex = 3

	return {
		root = root,
		set = function(fraction: number, barText: string)
			fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
			text.Text = barText
		end,
	}
end

-- A titled paper window with a close button; hidden by default.
function UiKit.window(parent: Instance, title: string, size: UDim2, position: UDim2): (Frame, Frame)
	local root = UiKit.frame(parent, size, position)
	root.Visible = false

	local banner = Instance.new("Frame")
	banner.Size = UDim2.new(1, 0, 0, 30)
	banner.BackgroundColor3 = UiKit.Colors.ink
	banner.BorderSizePixel = 0
	banner.Parent = root
	local bannerCorner = Instance.new("UICorner")
	bannerCorner.CornerRadius = UDim.new(0, 5)
	bannerCorner.Parent = banner
	UiKit.label(banner, title, UDim2.new(1, -40, 1, 0), UDim2.fromOffset(12, 0), {
		textSize = 15,
		title = true,
		bold = true,
		color = UiKit.Colors.paper,
	})
	UiKit.button(banner, "X", UDim2.fromOffset(22, 22), UDim2.new(1, -28, 0, 4), function()
		root.Visible = false
	end, { color = UiKit.Colors.danger, textSize = 12 })

	local body = Instance.new("Frame")
	body.Size = UDim2.new(1, -16, 1, -42)
	body.Position = UDim2.fromOffset(8, 36)
	body.BackgroundTransparency = 1
	body.Parent = root

	return root, body
end

return UiKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
