          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Config
-- Shared, read-only game configuration. Both server and client require this;
-- nothing here may be secret and nothing here is authoritative on its own —
-- the server re-checks every value that matters (costs, cooldowns, limits).

local Config = table.freeze({
	GAME_NAME = "Three Paths", -- working title, rename freely
	VERSION = "0.2.0",

	-- Technique authoring
	MAX_TECHNIQUES = 12, -- techniques a player may keep designed at once
	SLOT_COUNT = 6, -- hotbar slots (keys 1..6)
	MAX_POWER = 10, -- power points pourable into one technique
	MAX_TECHNIQUE_NAME = 30,

	-- Movement / combat baselines
	BASE_WALKSPEED = 16,

	-- Destiny spins (races + talents)
	TALENT_SLOTS = 3,
	RACE_SPIN_STONES = 30, -- spirit stone price when out of free spins
	TALENT_SPIN_STONES = 20,
	STARTING_RACE_SPINS = 3,
	STARTING_TALENT_SPINS = 3,
	BREAKTHROUGH_RACE_SPINS = 2, -- granted on every realm breakthrough
	BREAKTHROUGH_TALENT_SPINS = 2,

	-- Qi loop
	QI_TICK_SECONDS = 1,
	AUTOSAVE_SECONDS = 120,
})

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Elements</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Elements
-- The aspects a technique can be woven with. `path` restricts an element to
-- one of the three paths; a race whose affinity matches the element bypasses
-- that restriction (see Data/Races). `effect` is interpreted by the server's
-- CombatService when a technique of that element lands.

local Types = require(script.Parent.Parent.Types)

export type EffectId = "none" | "burn" | "slow" | "shock" | "knockback" | "poison" | "selfheal" | "lifesteal" | "gust"

export type ElementDef = {
	id: string,
	name: string,
	color: Color3,
	damageMult: number,
	costMult: number,
	path: Types.PathId?, -- nil = open to every path
	effect: EffectId,
	blurb: string,
}

local Elements = {}

local defs: { [string]: ElementDef } = {
	none = {
		id = "none",
		name = "Pure Qi",
		color = Color3.fromRGB(170, 215, 255),
		damageMult = 1.0,
		costMult = 1.0,
		path = nil,
		effect = "none",
		blurb = "Unaspected qi, exactly as it was drawn from heaven and earth.",
	},
	fire = {
		id = "fire",
		name = "Fire",
		color = Color3.fromRGB(255, 120, 60),
		damageMult = 1.1,
		costMult = 1.1,
		path = nil,
		effect = "burn",
		blurb = "Yang at its most violent. Wounds it leaves keep burning.",
	},
	ice = {
		id = "ice",
		name = "Ice",
		color = Color3.fromRGB(150, 220, 255),
		damageMult = 0.95,
		costMult = 1.05,
		path = nil,
		effect = "slow",
		blurb = "Yin condensed to a killing stillness. Struck limbs forget how to hurry.",
	},
	lightning = {
		id = "lightning",
		name = "Lightning",
		color = Color3.fromRGB(180, 140, 255),
		damageMult = 1.2,
		costMult = 1.25,
		path = nil,
		effect = "shock",
		blurb = "Heavenly tribulation, borrowed. Expensive, and it hits like judgment.",
	},
	wind = {
		id = "wind",
		name = "Wind",
		color = Color3.fromRGB(180, 255, 195),
		damageMult = 0.85,
		costMult = 0.8,
		path = nil,
		effect = "gust",
		blurb = "The lightest of the aspects. Techniques woven with wind ask for less qi.",
	},
	earth = {
		id = "earth",
		name = "Earth",
		color = Color3.fromRGB(205, 160, 110),
		damageMult = 1.0,
		costMult = 1.1,
		path = nil,
		effect = "knockback",
		blurb = "The mountain's patience given force. What it strikes, it moves.",
	},
	radiance = {
		id = "radiance",
		name = "Radiance",
		color = Color3.fromRGB(255, 230, 150),
		damageMult = 1.0,
		costMult = 1.05,
		path = "orthodox",
		effect = "selfheal",
		blurb = "The orthodox sects' guarded light. Striking with it mends the striker.",
	},
	venom = {
		id = "venom",
		name = "Venom",
		color = Color3.fromRGB(130, 235, 120),
		damageMult = 0.9,
		costMult = 1.0,
		path = "unorthodox",
		effect = "poison",
		blurb = "The unorthodox answer to a longer blade. The wound is the beginning, not the end.",
	},
	shadow = {
		id = "shadow",
		name = "Shadow",
		color = Color3.fromRGB(140, 90, 200),
		damageMult = 1.05,
		costMult = 1.0,
		path = "demonic",
		effect = "lifesteal",
		blurb = "The demonic path's oldest bargain: what it takes from the struck, it feeds to the striker.",
	},
}

Elements.defs = table.freeze(defs)
Elements.order = table.freeze({ "none", "fire", "ice", "lightning", "wind", "earth", "radiance", "venom", "shadow" })

function Elements.get(id: string): ElementDef?
	return defs[id]
end

return table.freeze(Elements)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Items
-- Weapons and armor of the cultivation world, forged at the Deepforge from
-- mined ore. A weapon's `category` gates which technique categories it can
-- carry (sword techniques need a sword in hand, and so on; movement
-- techniques need nothing). Armor is a flat damage reduction fraction.

local Types = require(script.Parent.Parent.Types)

export type Recipe = {
	ores: { [string]: number },
	spiritStones: number,
}

export type ItemDef = {
	id: string,
	name: string,
	kind: "weapon" | "armor",
	category: Types.TechniqueCategory?, -- weapons only
	damageMult: number, -- weapons only (1.0 = baseline)
	defense: number, -- armor only, fraction of damage absorbed
	realmReq: number,
	recipe: Recipe?, -- nil = not craftable (starter gear)
	blurb: string,
}

local Items = {}

local function weapon(id: string, name: string, category: Types.TechniqueCategory, damageMult: number, realmReq: number, recipe: Recipe?, blurb: string): ItemDef
	return {
		id = id,
		name = name,
		kind = "weapon" :: "weapon",
		category = category,
		damageMult = damageMult,
		defense = 0,
		realmReq = realmReq,
		recipe = recipe,
		blurb = blurb,
	}
end

local function armor(id: string, name: string, defense: number, realmReq: number, recipe: Recipe?, blurb: string): ItemDef
	return {
		id = id,
		name = name,
		kind = "armor" :: "armor",
		category = nil,
		damageMult = 1,
		defense = defense,
		realmReq = realmReq,
		recipe = recipe,
		blurb = blurb,
	}
end

local defs: { [string]: ItemDef } = {
	-- ------------------------------ Starter ------------------------------
	training_sword = weapon("training_sword", "Training Sword", "sword", 1.0, 1, nil,
		"A sect-issue practice jian. It has taught ten thousand disciples and respected none of them."),

	-- ------------------------------ Swords -------------------------------
	azure_flying_sword = weapon("azure_flying_sword", "Azure Flying Sword", "sword", 1.25, 1,
		{ ores = { black_iron = 6 }, spiritStones = 8 },
		"A slim jian quenched in mountain spring water. Eager to leave the hand."),
	coldriver_jian = weapon("coldriver_jian", "Coldriver Jian", "sword", 1.5, 3,
		{ ores = { cold_iron = 8, black_iron = 4 }, spiritStones = 20 },
		"Cold iron folded ninety-nine times. The edge carries winter with it."),
	immortal_jade_sword = weapon("immortal_jade_sword", "Jade Immortal Sword", "sword", 1.9, 5,
		{ ores = { immortal_jade = 4, star_silver = 4 }, spiritStones = 80 },
		"A blade of living jade. It hums along to qi like an old friend joining a song."),

	-- ------------------------------ Sabers -------------------------------
	blackiron_dao = weapon("blackiron_dao", "Black Iron Dao", "blade", 1.2, 1,
		{ ores = { black_iron = 8 }, spiritStones = 8 },
		"A broad, honest saber. Subtlety costs extra."),
	meteoric_dao = weapon("meteoric_dao", "Meteoric Dao", "blade", 1.5, 3,
		{ ores = { meteoric_iron = 7, black_iron = 3 }, spiritStones = 24 },
		"Forged from a fallen star's spine. It still wants to hit the ground hard."),
	profound_gold_saber = weapon("profound_gold_saber", "Profound Gold Saber", "blade", 1.8, 4,
		{ ores = { profound_gold = 5, meteoric_iron = 3 }, spiritStones = 60 },
		"Xuanjin gives the blade its weight; the wielder supplies the grudge."),

	-- ------------------------------- Bows --------------------------------
	starwood_bow = weapon("starwood_bow", "Starwood Bow", "bow", 1.2, 1,
		{ ores = { black_iron = 5 }, spiritStones = 10 },
		"Mountain yew with black iron caps. Loyal out to the edge of sight."),
	star_silver_bow = weapon("star_silver_bow", "Star Silver Bow", "bow", 1.55, 3,
		{ ores = { star_silver = 7, cold_iron = 3 }, spiritStones = 28 },
		"Strung with drawn star silver. On a clear night it aims a little for you."),

	-- ------------------------------- Robes -------------------------------
	disciple_robe = armor("disciple_robe", "Outer Disciple Robe", 0.05, 1,
		{ ores = { black_iron = 2 }, spiritStones = 4 },
		"Coarse sect cloth with iron thread at the seams. Better than pride alone."),
	blackiron_guard_robe = armor("blackiron_guard_robe", "Black Iron Guard Robe", 0.12, 2,
		{ ores = { black_iron = 10 }, spiritStones = 14 },
		"Lamellar scales sewn under silk, the compromise every sect guard makes."),
	coldsilk_robe = armor("coldsilk_robe", "Coldsilk Robe", 0.18, 3,
		{ ores = { cold_iron = 8, star_silver = 2 }, spiritStones = 30 },
		"Cold iron drawn to thread. Blows arrive tired."),
	starweave_vestment = armor("starweave_vestment", "Starweave Vestment", 0.25, 4,
		{ ores = { star_silver = 8, profound_gold = 2 }, spiritStones = 55 },
		"Woven under a meteor shower, and it remembers the sky's indifference."),
	jade_immortal_vestment = armor("jade_immortal_vestment", "Jade Immortal Vestment", 0.35, 5,
		{ ores = { immortal_jade = 5, profound_gold = 3 }, spiritStones = 100 },
		"Plates of immortal jade over profound gold mail. Tribulation lightning has complained about it."),
}

Items.defs = table.freeze(defs)

Items.order = table.freeze({
	"training_sword",
	"azure_flying_sword", "coldriver_jian", "immortal_jade_sword",
	"blackiron_dao", "meteoric_dao", "profound_gold_saber",
	"starwood_bow", "star_silver_bow",
	"disciple_robe", "blackiron_guard_robe", "coldsilk_robe", "starweave_vestment", "jade_immortal_vestment",
})

function Items.get(id: string): ItemDef?
	return defs[id]
end

return table.freeze(Items)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Missions</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Missions
-- Grandmaster Khadun's mining commissions, taken and turned in at the
-- Deepforge. Strictly sequential; the final mission repeats forever so the
-- forge never runs out of work. Ore is consumed from the pouch at turn-in.

export type MissionDef = {
	id: string,
	title: string,
	intro: string, -- dwarf's pitch when offering
	turnIn: string, -- dwarf's line on completion
	needs: { [string]: number }, -- ore id -> count
	rewardStones: number,
	rewardRaceSpins: number,
	rewardTalentSpins: number,
}

local Missions: { MissionDef } = {
	{
		id = "prove_your_arm",
		title = "Prove Your Arm",
		intro = "New hands. Hmph. The Mining Hall grows black iron like weeds. Bring me five, and swing like you mean it.",
		turnIn = "Passable. The mountain won't miss it. Here, stones. Spend them badly.",
		needs = { black_iron = 5 },
		rewardStones = 12,
		rewardRaceSpins = 1,
		rewardTalentSpins = 0,
	},
	{
		id = "cold_for_the_quench",
		title = "Cold for the Quench",
		intro = "My quench barrel's gone lukewarm, which is to say useless. Cold iron, eight pieces. It's the blue-veined stone that hates your fingers.",
		turnIn = "Ahh, hear the water scream? That's the sound of a proper edge being born.",
		needs = { cold_iron = 8 },
		rewardStones = 18,
		rewardRaceSpins = 0,
		rewardTalentSpins = 1,
	},
	{
		id = "sky_debt",
		title = "Sky Debt",
		intro = "Deeper hall, past my forge. Meteoric iron, six lumps. It fell from heaven, so technically heaven owes ME the delivery fee.",
		turnIn = "Star-metal. My father forged with it, and his mother before him. You have my grudging respect.",
		needs = { meteoric_iron = 6 },
		rewardStones = 26,
		rewardRaceSpins = 1,
		rewardTalentSpins = 1,
	},
	{
		id = "silver_for_a_bowstring",
		title = "Silver for a Bowstring",
		intro = "An immortal ordered a bow and paid in insults. Star silver, seven pieces, and I'll consider us all even.",
		turnIn = "Look how it takes the light. Almost worth dealing with immortals. Almost.",
		needs = { star_silver = 7 },
		rewardStones = 36,
		rewardRaceSpins = 1,
		rewardTalentSpins = 1,
	},
	{
		id = "the_heavy_metal",
		title = "The Heavy Metal",
		intro = "Profound gold. Xuanjin. Four pieces, and lift with your legs, cultivator, the ore does not care about your realm.",
		turnIn = "Heavier than sin and twice as useful. The forge sings tonight.",
		needs = { profound_gold = 4 },
		rewardStones = 50,
		rewardRaceSpins = 2,
		rewardTalentSpins = 1,
	},
	{
		id = "jade_of_the_immortals",
		title = "Jade of the Immortals",
		intro = "Now the true work. Immortal jade, four pieces. The deep veins guard it jealously, and so will I, once you hand it over.",
		turnIn = "By the deep roots... perfect stock. As long as the mountain stands, there is work here for you.",
		needs = { immortal_jade = 4 },
		rewardStones = 70,
		rewardRaceSpins = 2,
		rewardTalentSpins = 2,
	},
}

return table.freeze(Missions)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Ores</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Ores
-- The ores of the caves beneath Heavenpillar Mountain. `spirit_stone` is
-- special: mining it pays out spirit stones (the currency) directly instead
-- of stacking in the ore pouch. `tier` decides which cave hall a node may
-- spawn in (1 = Mining Hall, 2 = Deepforge Hall).

export type OreDef = {
	id: string,
	name: string,
	color: Color3,
	tier: number,
	harvestMin: number,
	harvestMax: number,
	respawnSeconds: number,
	blurb: string,
}

local Ores = {}

local defs: { [string]: OreDef } = {
	spirit_stone = {
		id = "spirit_stone",
		name = "Spirit Stone",
		color = Color3.fromRGB(160, 230, 255),
		tier = 1,
		harvestMin = 2,
		harvestMax = 4,
		respawnSeconds = 25,
		blurb = "Crystallized qi of heaven and earth. The only coin a cultivator fully trusts.",
	},
	black_iron = {
		id = "black_iron",
		name = "Black Iron",
		color = Color3.fromRGB(70, 70, 80),
		tier = 1,
		harvestMin = 1,
		harvestMax = 3,
		respawnSeconds = 20,
		blurb = "Mortal iron steeped in mountain yin until it darkened. The floor of every forge.",
	},
	cold_iron = {
		id = "cold_iron",
		name = "Cold Iron",
		color = Color3.fromRGB(140, 190, 220),
		tier = 1,
		harvestMin = 1,
		harvestMax = 2,
		respawnSeconds = 30,
		blurb = "Iron that never warms, even in the furnace. Blades of it bite twice.",
	},
	meteoric_iron = {
		id = "meteoric_iron",
		name = "Meteoric Iron",
		color = Color3.fromRGB(180, 120, 80),
		tier = 2,
		harvestMin = 1,
		harvestMax = 2,
		respawnSeconds = 45,
		blurb = "Fell from beyond the heavens and remembers the falling. Saber smiths pay in blood for it.",
	},
	star_silver = {
		id = "star_silver",
		name = "Star Silver",
		color = Color3.fromRGB(220, 225, 255),
		tier = 2,
		harvestMin = 1,
		harvestMax = 2,
		respawnSeconds = 60,
		blurb = "Silver veined with starlight. Bows strung with it do not miss so much as decline to.",
	},
	profound_gold = {
		id = "profound_gold",
		name = "Profound Gold",
		color = Color3.fromRGB(235, 190, 90),
		tier = 2,
		harvestMin = 1,
		harvestMax = 1,
		respawnSeconds = 90,
		blurb = "Xuanjin, the metal of the deep earth. Heavier than it should be, in every sense.",
	},
	immortal_jade = {
		id = "immortal_jade",
		name = "Immortal Jade",
		color = Color3.fromRGB(120, 235, 170),
		tier = 2,
		harvestMin = 1,
		harvestMax = 1,
		respawnSeconds = 120,
		blurb = "Jade that has drunk ten thousand years of qi. Immortals quarrel over gram weights of it.",
	},
}

Ores.defs = table.freeze(defs)
Ores.order = table.freeze({ "spirit_stone", "black_iron", "cold_iron", "meteoric_iron", "star_silver", "profound_gold", "immortal_jade" })

function Ores.get(id: string): OreDef?
	return defs[id]
end

return table.freeze(Ores)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Paths</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Paths
-- The three great paths of cultivation. Each owns one of the map's cities.
-- Multipliers apply server-side (QiSystem regen, TechniqueService damage
-- and cooldowns); everything here is flavor plus those three numbers.

local Types = require(script.Parent.Parent.Types)

export type PathDef = {
	id: Types.PathId,
	name: string,
	cityName: string,
	teamBrickColor: string, -- BrickColor name for the Team
	primaryColor: Color3, -- city architecture
	accentColor: Color3,
	qiRegenMult: number,
	damageMult: number,
	cooldownMult: number,
	blurb: string,
}

local Paths: { [string]: PathDef } = {
	orthodox = {
		id = "orthodox",
		name = "Orthodox Path",
		cityName = "White Cloud City",
		teamBrickColor = "Institutional white",
		primaryColor = Color3.fromRGB(235, 231, 219),
		accentColor = Color3.fromRGB(212, 175, 55),
		qiRegenMult = 1.25,
		damageMult = 1.0,
		cooldownMult = 1.0,
		blurb = "Righteous sects who temper the self through discipline. Their qi flows deep and steady.",
	},
	unorthodox = {
		id = "unorthodox",
		name = "Unorthodox Path",
		cityName = "Freewind City",
		teamBrickColor = "Sand green",
		primaryColor = Color3.fromRGB(110, 124, 110),
		accentColor = Color3.fromRGB(120, 220, 140),
		qiRegenMult = 1.0,
		damageMult = 1.0,
		cooldownMult = 0.85,
		blurb = "Wandering cultivators bound by no sect law. Their arts strike faster than doctrine allows.",
	},
	demonic = {
		id = "demonic",
		name = "Demonic Path",
		cityName = "Blackfire City",
		teamBrickColor = "Really red",
		primaryColor = Color3.fromRGB(40, 34, 38),
		accentColor = Color3.fromRGB(220, 60, 50),
		qiRegenMult = 0.9,
		damageMult = 1.25,
		cooldownMult = 1.0,
		blurb = "Those who feed their dao with slaughter and forbidden arts. Power now, price later.",
	},
}

return table.freeze(Paths)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Races</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Races
-- The 124 races of the cultivation world, drawn from Chinese myth: the
-- Classic of Mountains and Seas, the Four Symbols, the Four Perils, the
-- dragon courts, the underworld bureaucracy, and the spirits of beast,
-- plant and stone that cultivated a human form.
--
-- Everyone begins as a Mortal Human (fanren). New races come from Destiny
-- spins (server-rolled); any owned race can be equipped.
--
-- Balance lives in ONE place: statsFor() derives a race's modifiers from
-- rarity (how big the bonus budget is) and archetype (where it goes).
-- Individual entries carry identity and flavor only, so 124 races cannot
-- drift into 124 hand-tuned balance problems.

local Types = require(script.Parent.Parent.Types)

export type Archetype = "balanced" | "vitality" | "ferocity" | "wellspring" | "swiftness" | "sage" | "frugal"

export type RaceDef = {
	id: string,
	name: string,
	hanzi: string,
	rarity: Types.Rarity,
	archetype: Archetype,
	affinity: string?, -- element id; usable in techniques regardless of path
	blurb: string,
}

export type RaceStats = {
	maxQiMult: number,
	qiRegenMult: number,
	xpMult: number,
	damageMult: number,
	qiCostMult: number,
	cooldownMult: number,
	defenseBonus: number,
	maxHealthBonus: number,
	walkSpeedBonus: number,
}

local Races = {}

-- Bonus budget per rarity. All archetype effects scale off this single number.
local BUDGET: { [string]: number } = {
	common = 0.06,
	uncommon = 0.10,
	rare = 0.16,
	epic = 0.24,
	legendary = 0.34,
	mythic = 0.46,
}

-- Spin weights (relative). Server rolls against these.
Races.SPIN_WEIGHTS = table.freeze({
	common = 51.5,
	uncommon = 27.0,
	rare = 13.0,
	epic = 6.0,
	legendary = 2.0,
	mythic = 0.5,
})

-- Spirit stones refunded when a spin lands a race already owned.
Races.DUPLICATE_REFUND = table.freeze({
	common = 5,
	uncommon = 10,
	rare = 20,
	epic = 40,
	legendary = 80,
	mythic = 160,
})

local defs: { [string]: RaceDef } = {}
local order: { string } = {}

local function r(id: string, name: string, hanzi: string, rarity: Types.Rarity, archetype: Archetype, affinity: string?, blurb: string)
	assert(defs[id] == nil, `duplicate race id {id}`)
	defs[id] = {
		id = id,
		name = name,
		hanzi = hanzi,
		rarity = rarity,
		archetype = archetype,
		affinity = affinity,
		blurb = blurb,
	}
	table.insert(order, id)
end

-- =========================== MYTHIC (7) ===========================
r("qinglong", "Azure Dragon", "青龙", "mythic", "ferocity", "lightning",
	"The Eastern Symbol itself. Spring storms are its idle breathing.")
r("baihu", "White Tiger", "白虎", "mythic", "ferocity", nil,
	"The Western Symbol, lord of autumn and battle. Metal remembers its claws.")
r("zhuque", "Vermilion Bird", "朱雀", "mythic", "wellspring", "fire",
	"The Southern Symbol, elegant flame that no ash has ever followed.")
r("xuanwu", "Black Tortoise", "玄武", "mythic", "vitality", "ice",
	"The Northern Symbol, serpent and tortoise entwined. Winter is its patience.")
r("qilin", "Qilin", "麒麟", "mythic", "sage", "radiance",
	"Walks without bending grass. Appears only where a sage is about to.")
r("kunpeng", "Kunpeng", "鲲鹏", "mythic", "swiftness", "wind",
	"The fish that became the bird whose wings are weather. Ninety thousand li in one beat.")
r("yinglong", "Winged Dragon", "应龙", "mythic", "balanced", "lightning",
	"The oldest dragon, who dammed the floods and buried Chiyou. It has already won a war of gods.")

-- ========================= LEGENDARY (12) =========================
r("tianlong", "Celestial Dragon", "天龙", "legendary", "wellspring", "lightning",
	"Bearers of the heavenly palaces. Their qi is drawn from above the sky.")
r("shenlong", "Spirit Dragon", "神龙", "legendary", "balanced", "lightning",
	"Masters of rain and wind. Farmers pray to them; emperors pretend to.")
r("zhulong", "Torch Dragon", "烛龙", "legendary", "wellspring", "fire",
	"When its eye opens, day. When it closes, night. It does not blink carelessly.")
r("fenghuang", "Fenghuang", "凤凰", "legendary", "wellspring", "fire",
	"The august firebird whose death is a scheduling matter.")
r("jiuweihu", "Nine-Tailed Fox", "九尾狐", "legendary", "sage", "shadow",
	"Each tail is a century of cunning. It has nine and is collecting more.")
r("pixiu", "Pixiu", "貔貅", "legendary", "frugal", nil,
	"The treasure-beast that devours wealth and has no way to lose it. Qi hoards in it the same way.")
r("baize", "Baize", "白泽", "legendary", "sage", nil,
	"It named every one of the eleven thousand five hundred and twenty spirits. It remembers yours.")
r("jinwu", "Golden Crow", "金乌", "legendary", "ferocity", "fire",
	"Three-legged crow of the sun. Nine of its kin were shot down; this line remembers why.")
r("hundun", "Hundun", "混沌", "legendary", "balanced", nil,
	"Primordial chaos with a face it declined to finish. Order slides off it.")
r("pangu_remnant", "Pangu Remnant", "盘古遗脉", "legendary", "vitality", "earth",
	"Descended from the giant whose corpse became the world. The bones remember being mountains.")
r("yanluo_blood", "Yama Bloodline", "阎罗血脉", "legendary", "ferocity", "shadow",
	"Kin to the judge of the dead. Their killing intent files paperwork later.")
r("tianmo", "Heaven Demon", "天魔", "legendary", "frugal", "shadow",
	"Born in the gap between a cultivator's thought and deed. Temptation given a spine.")

-- =========================== EPIC (22) ============================
r("jiaolong", "Flood Dragon", "蛟龙", "epic", "vitality", "ice",
	"A serpent one storm short of dragonhood. Rivers make room anyway.")
r("qiulong", "Horned Dragon", "虬龙", "epic", "ferocity", "lightning",
	"Horned and impatient, the dragon shape most often met in a bad mood.")
r("fuzanglong", "Treasure Dragon", "伏藏龙", "epic", "frugal", "earth",
	"Coiled under the earth on hoards of jade and ore. Spending qi offends it.")
r("xiangliu", "Xiangliu-kin", "相柳之裔", "epic", "wellspring", "venom",
	"Nine heads, nine appetites, and marshes poisoned wherever it rested.")
r("taotie", "Taotie-kin", "饕餮之裔", "epic", "vitality", nil,
	"The glutton peril, all mouth and want. What it eats, it keeps.")
r("qiongqi", "Qiongqi-kin", "穷奇之裔", "epic", "ferocity", "wind",
	"The winged tiger peril that rewards the wicked. It flies fastest toward a fight.")
r("taowu", "Taowu-kin", "梼杌之裔", "epic", "ferocity", nil,
	"The obstinate peril. It has never once turned around.")
r("jiufeng", "Nine-Headed Phoenix", "九凤", "epic", "wellspring", "fire",
	"Nine heads that do not agree, except about burning.")
r("dapeng", "Great Peng", "大鹏", "epic", "swiftness", "wind",
	"A roc whose shadow is mistaken for dusk. Distance is a rumor to it.")
r("luan_bird", "Luan Bird", "鸾鸟", "epic", "sage", "radiance",
	"The five-colored herald of the Queen Mother of the West. Its song settles quarrels.")
r("xiezhi", "Xiezhi", "獬豸", "epic", "vitality", "radiance",
	"The one-horned arbiter that gores the party in the wrong. Do not lie near it.")
r("tianhu", "Celestial Fox", "天狐", "epic", "sage", nil,
	"A fox that finished its thousand years and got its paperwork approved.")
r("kui_beast", "Kui", "夔", "epic", "ferocity", "lightning",
	"One-legged storm ox. The Yellow Emperor made a war drum of its hide; the line holds a grudge.")
r("longma", "Dragon Horse", "龙马", "epic", "swiftness", nil,
	"Rose from the Yellow River with the trigrams on its back. It carries knowledge at a gallop.")
r("xingtian", "Xingtian-kin", "刑天之裔", "epic", "ferocity", nil,
