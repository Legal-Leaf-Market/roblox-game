r("heibai_wuchang", "Impermanence Twin", "黑白无常", "epic", "swiftness", "shadow",
	"Kin to the two constables of the dead. They always arrive exactly on time.")

-- =========================== RARE (27) ============================
r("panlong", "Coiling Dragon", "蟠龙", "rare", "vitality", nil,
