	"The drowned girl turned bird, filling the sea a pebble at a time. Persistence with wings.")
r("qingniao", "Azure Messenger", "青鸟", "uncommon", "swiftness", nil,
	"The Queen Mother's courier birds. News arrives before the dust does.")
r("shangyang", "Rain Bird", "商羊", "uncommon", "wellspring", "ice",
	"It dances on one leg before a downpour. Farmers watch its knees.")
r("bailu", "White Deer", "白鹿", "uncommon", "sage", nil,
	"Immortals ride it between mountains. It has overheard a great deal of dao.")
r("xiniu", "Spirit Rhinoceros", "灵犀", "uncommon", "vitality", nil,
	"Its horn holds one clear thread to another heart. Hard to move, harder to fool.")
r("ruishi", "Guardian Lion", "瑞狮", "uncommon", "vitality", nil,
	"Stone-lion spirit off its pedestal. It takes thresholds personally.")
r("chanchu", "Golden Toad", "金蟾", "uncommon", "frugal", nil,
	"The three-legged money toad. It spits coins in and swallows nothing out.")
r("qingshe_spirit", "Green Snake", "青蛇", "uncommon", "swiftness", "venom",
	"The White Lady's fiercer sister. Less patience, more fang.")
r("niutou", "Ox-Head", "牛头", "uncommon", "ferocity", nil,
	"Underworld constable stock. Escorting souls builds forearms.")
r("mamian", "Horse-Face", "马面", "uncommon", "swiftness", nil,
	"The other constable. Nobody outruns the schedule.")
r("wangliang", "Wangliang", "魍魉", "uncommon", "frugal", "shadow",
	"Marsh-shadow spirit that mimics voices. It pays for nothing at full price.")
r("chimei", "Chimei", "魑魅", "uncommon", "ferocity", "shadow",
	"Mountain-mist haunt that misleads travelers. Some of them it keeps.")
r("yuangui", "Vengeful Ghost", "冤鬼", "uncommon", "ferocity", "shadow",
	"Dead with a case still open. The grievance does the cultivating.")
r("chenghuang_scion", "City God Scion", "城隍之后", "uncommon", "sage", nil,
	"Descended from a mortal so upright the afterlife gave him a district.")
r("zhizhu_jing", "Spider Spirit", "蜘蛛精", "uncommon", "frugal", "venom",
	"Silk, patience, and a web-shaped budget. Nothing it catches is wasted.")
r("xiezi_jing", "Scorpion Spirit", "蝎子精", "uncommon", "ferocity", "venom",
	"Even Buddhas flinched at the sting. It is aware of this credential.")
r("wugong_jing", "Centipede Spirit", "蜈蚣精", "uncommon", "vitality", "venom",
	"A hundred legs, a hundred grudges, armor between every pair.")
r("huangshulang", "Weasel Spirit", "黄鼠狼", "uncommon", "swiftness", nil,
	"The yellow weasel that borrows luck and repays it crooked. Quick in every sense.")
r("lingzhi_jing", "Lingzhi Spirit", "灵芝精", "uncommon", "wellspring", nil,
	"A medicine mushroom that dosed itself for a thousand years.")
r("zhiren", "Paper Effigy", "纸人", "uncommon", "frugal", nil,
	"A funeral servant that outlived its funeral. Weighs nothing, wants little, burns never (so far).")
r("jueyuan", "Jueyuan Ape", "玃猿", "uncommon", "ferocity", nil,
	"A mountain ape old enough to have opinions about swordsmanship.")

-- ========================== COMMON (30) ===========================
r("fanren", "Mortal Human", "凡人", "common", "sage", nil,
	"No bloodline, no birthright, nothing but comprehension. Every immortal legend starts here.")
r("youhun", "Wandering Soul", "游魂", "common", "frugal", nil,
	"A soul that missed its ferry and kept walking. Travel light, want lighter.")
r("egui", "Hungry Ghost", "饿鬼", "common", "frugal", "shadow",
	"Cursed with a needle throat and a furnace belly. It wastes nothing, ever.")
r("shanxiao", "Mountain Imp", "山魈", "common", "swiftness", nil,
	"One-legged mischief of the high forests. It knows every shortcut it invented.")
r("yeren", "Wildman", "野人", "common", "vitality", nil,
	"The hairy hermit of the deep ranges. Weather is a suggestion.")
r("mao_yao", "Cat Spirit", "猫妖", "common", "swiftness", nil,
	"A cat that noticed people worship things and applied. Lands on its feet by doctrine.")
r("gou_yao", "Dog Spirit", "狗妖", "common", "vitality", nil,
	"Loyalty cultivated into a life philosophy. It holds the line because someone said stay.")
r("shu_jing", "Rat Spirit", "鼠精", "common", "frugal", nil,
	"First animal of the zodiac by way of cheating. Efficiency is a moral position.")
r("zhu_yao", "Pig Spirit", "猪妖", "common", "vitality", nil,
	"Appetite as foundation-building. Surprisingly durable, entirely unashamed.")
r("hou_yao", "Monkey Spirit", "猴妖", "common", "swiftness", nil,
	"Every monkey has heard the story of the stone one. Every monkey has plans.")
r("liyu_jing", "Carp Spirit", "鲤鱼精", "common", "wellspring", nil,
	"Still practicing for the Dragon Gate. The current is a training partner.")
r("hua_yao", "Flower Spirit", "花妖", "common", "wellspring", nil,
	"A garden bloom that drank moonlight past its bedtime for a century.")
r("shumu_jing", "Tree Spirit", "树木精", "common", "vitality", "earth",
	"An old tree that finally pulled its roots. It thinks in decades and hits like one.")
r("ciwei_jing", "Hedgehog Spirit", "刺猬精", "common", "vitality", nil,
	"One of the northern Five Immortal households. Small, spiked, respected.")
r("tudi_folk", "Earth God Folk", "土地民", "common", "balanced", "earth",
	"Villagers blessed by their local Tudigong. Modest gifts, reliably delivered.")
r("changbi_folk", "Long-Armed Folk", "长臂民", "common", "ferocity", nil,
	"From the country where arms reach the fish without a boat. Reach is a birthright.")
r("changgu_folk", "Long-Legged Folk", "长股民", "common", "swiftness", nil,
	"Their neighbors wade for them. A horizon is an afternoon.")
r("xiao_folk", "Small Folk", "小人国", "common", "frugal", nil,
	"The tiny nations of the far seas. Little bodies, precise appetites.")
r("guanxiong_folk", "Hole-Chested Folk", "贯胸民", "common", "wellspring", nil,
	"A tunnel through the chest where a heart's fear would be. Qi circulates strangely well.")
r("yumin_folk", "Feathered Folk", "羽民", "common", "swiftness", "wind",
	"Down-feathered islanders halfway to birds. Falling bores them.")
r("renyu", "Merfolk", "人鱼", "common", "wellspring", nil,
	"River merfolk whose tears are only tears. The pearls come with cultivation.")
r("niu_yao", "Ox Spirit", "牛妖", "common", "vitality", nil,
	"Patience with horns. It plowed for sixty years before asking a single question.")
r("yang_yao", "Goat Spirit", "羊妖", "common", "sage", nil,
	"It ate a library's worth of talisman paper and some of it took.")
r("ji_yao", "Rooster Spirit", "鸡妖", "common", "swiftness", "fire",
	"Announces the sun like it invented it. Ghosts leave when it clears its throat.")
r("gui_jing", "Turtle Spirit", "龟精", "common", "vitality", nil,
	"It intends to outlive the argument. All of them.")
r("wa_jing", "Frog Spirit", "蛙精", "common", "wellspring", nil,
	"A well-bottom sage who finally saw the whole sky and took notes.")
r("hudie_jing", "Butterfly Spirit", "蝴蝶精", "common", "swiftness", nil,
	"Possibly a philosopher dreaming it is a butterfly. Either way, hard to hit.")
r("denglong_jing", "Lantern Spirit", "灯笼精", "common", "frugal", "fire",
	"A festival lantern that refused to be packed away. It budgets its own light.")

do
	-- The bestiary promise: exactly 124 races.
	assert(#order == 124, `expected 124 races, got {#order}`)
end

Races.defs = table.freeze(defs)
Races.order = table.freeze(order)
Races.DEFAULT_RACE = "fanren"

function Races.get(id: string): RaceDef?
	return defs[id]
end

-- Derived modifiers. Deterministic from rarity + archetype so every race of
-- the same tier carries the same total strength, just aimed differently.
function Races.statsFor(id: string): RaceStats
	local def = defs[id] or defs[Races.DEFAULT_RACE]
	local b = BUDGET[def.rarity] or 0

	local stats: RaceStats = {
		maxQiMult = 1,
		qiRegenMult = 1,
		xpMult = 1,
		damageMult = 1,
		qiCostMult = 1,
		cooldownMult = 1,
		defenseBonus = 0,
		maxHealthBonus = 0,
		walkSpeedBonus = 0,
	}

	local a = def.archetype
	if a == "balanced" then
		stats.damageMult += b * 0.3
		stats.maxQiMult += b * 0.3
		stats.xpMult += b * 0.25
		stats.maxHealthBonus += b * 80
	elseif a == "vitality" then
		stats.maxHealthBonus += b * 250
		stats.defenseBonus += b * 0.2
	elseif a == "ferocity" then
		stats.damageMult += b * 0.8
		stats.maxHealthBonus += b * 100
	elseif a == "wellspring" then
		stats.maxQiMult += b * 0.7
		stats.qiRegenMult += b * 0.5
	elseif a == "swiftness" then
		stats.cooldownMult -= b * 0.5
		stats.walkSpeedBonus += b * 8
	elseif a == "sage" then
		stats.xpMult += b * 1.0
		stats.maxQiMult += b * 0.2
	elseif a == "frugal" then
		stats.qiCostMult -= b * 0.6
		stats.qiRegenMult += b * 0.3
	end

	return stats
end

return table.freeze(Races)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Realms</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Realms
-- The cultivation ladder. Index = realm number; breakthroughXp is the
-- cultivation experience needed to advance to the NEXT realm.

export type Realm = {
	name: string,
	maxQi: number,
	qiRegen: number, -- qi per tick while idle
	meditateMult: number, -- regen multiplier while meditating
	meditateXp: number, -- cultivation xp per tick while meditating
	breakthroughXp: number,
}

local Realms: { Realm } = {
	{ name = "Body Tempering", maxQi = 100, qiRegen = 2, meditateMult = 5, meditateXp = 2, breakthroughXp = 100 },
	{ name = "Qi Condensation", maxQi = 160, qiRegen = 3, meditateMult = 5, meditateXp = 3, breakthroughXp = 300 },
	{ name = "Foundation Establishment", maxQi = 240, qiRegen = 4, meditateMult = 5, meditateXp = 4, breakthroughXp = 700 },
	{ name = "Core Formation", maxQi = 350, qiRegen = 5, meditateMult = 6, meditateXp = 6, breakthroughXp = 1500 },
	{ name = "Nascent Soul", maxQi = 500, qiRegen = 7, meditateMult = 6, meditateXp = 8, breakthroughXp = 3000 },
	{ name = "Divine Transformation", maxQi = 700, qiRegen = 9, meditateMult = 6, meditateXp = 10, breakthroughXp = 6000 },
	{ name = "Void Refinement", maxQi = 950, qiRegen = 12, meditateMult = 7, meditateXp = 13, breakthroughXp = 12000 },
	-- Final realm: breakthroughXp is effectively unreachable until more
	-- realms are added above it.
	{ name = "Immortal Ascension", maxQi = 1300, qiRegen = 15, meditateMult = 7, meditateXp = 16, breakthroughXp = 10_000_000 },
}

return table.freeze(Realms)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Talents</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > Talents
-- Innate talents: the physiques, bones, meridians and aptitudes of
-- cultivation lore. Rolled with Destiny spins; up to Config.TALENT_SLOTS
-- equipped at once. Unlike races (whose stats derive from an archetype),
-- talents carry their modifiers directly: each is a small, named push in
-- one direction, and stacking three is the buildcraft.

local Types = require(script.Parent.Parent.Types)

export type TalentDef = {
	id: string,
	name: string,
	rarity: Types.Rarity,
	-- All optional; missing = no effect. Multipliers combine by product,
	-- bonuses by sum (see StatCalc).
	maxQiMult: number?,
	qiRegenMult: number?,
	xpMult: number?,
	damageMult: number?,
	qiCostMult: number?,
	cooldownMult: number?,
	defenseBonus: number?,
	maxHealthBonus: number?,
	walkSpeedBonus: number?,
	categoryDamage: { [string]: number }?, -- technique category -> mult
	elementDamage: { [string]: number }?, -- element id -> mult
	blurb: string,
}

local Talents = {}

Talents.SPIN_WEIGHTS = table.freeze({
	common = 51.5,
	uncommon = 27.0,
	rare = 13.0,
	epic = 6.0,
	legendary = 2.0,
	mythic = 0.5,
})

Talents.DUPLICATE_REFUND = table.freeze({
	common = 4,
	uncommon = 8,
	rare = 16,
	epic = 32,
	legendary = 64,
	mythic = 128,
})

local defs: { [string]: TalentDef } = {}
local order: { string } = {}

local function t(def: TalentDef)
	assert(defs[def.id] == nil, `duplicate talent id {def.id}`)
	defs[def.id] = def
	table.insert(order, def.id)
end

-- ============================ Common (10) ============================
t({ id = "iron_bones", name = "Iron Bones", rarity = "common", maxHealthBonus = 15,
	blurb = "A skeleton that argues back." })
t({ id = "ox_vigor", name = "Ox Vigor", rarity = "common", maxHealthBonus = 10, defenseBonus = 0.02,
	blurb = "Plow-beast stamina in a cultivator's frame." })
t({ id = "long_breath", name = "Long Breath", rarity = "common", qiRegenMult = 1.08,
	blurb = "Each breath draws a little deeper than the last." })
t({ id = "steady_dantian", name = "Steady Dantian", rarity = "common", maxQiMult = 1.06,
	blurb = "A qi sea with well-built shores." })
t({ id = "quick_soles", name = "Quick Soles", rarity = "common", walkSpeedBonus = 1,
	blurb = "Feet that finish deciding before the mind does." })
t({ id = "patient_mind", name = "Patient Mind", rarity = "common", xpMult = 1.08,
	blurb = "Insight favors those who sit still long enough to be found." })
t({ id = "thrifty_meridians", name = "Thrifty Meridians", rarity = "common", qiCostMult = 0.95,
	blurb = "Channels that spill not one drop in transit." })
t({ id = "calloused_skin", name = "Calloused Skin", rarity = "common", defenseBonus = 0.03,
	blurb = "The mountain wind did the tempering for free." })
t({ id = "heavy_hands", name = "Heavy Hands", rarity = "common", damageMult = 1.05,
	blurb = "Everything this body swings arrives with interest." })
t({ id = "cold_focus", name = "Cold Focus", rarity = "common", cooldownMult = 0.96,
	blurb = "The next technique is already half-formed behind the eyes." })

-- =========================== Uncommon (8) ===========================
t({ id = "sword_bone", name = "Sword Bone", rarity = "uncommon", categoryDamage = { sword = 1.08 },
	blurb = "Born with one bone too straight. It points at things." })
t({ id = "saber_marrow", name = "Saber Marrow", rarity = "uncommon", categoryDamage = { blade = 1.08 },
	blurb = "The marrow runs single-edged." })
t({ id = "hawk_eye", name = "Hawk Eye", rarity = "uncommon", categoryDamage = { bow = 1.08 },
	blurb = "Distance is a detail." })
t({ id = "featherfoot", name = "Featherfoot", rarity = "uncommon", walkSpeedBonus = 2,
	blurb = "Snow keeps no record of this one's passing." })
t({ id = "deep_wellspring", name = "Deep Wellspring", rarity = "uncommon", maxQiMult = 1.1,
	blurb = "The dantian's floor is further down than it should be." })
t({ id = "flowing_meridians", name = "Flowing Meridians", rarity = "uncommon", qiRegenMult = 1.12,
	blurb = "Qi returns like a river remembering its bed." })
t({ id = "clear_comprehension", name = "Clear Comprehension", rarity = "uncommon", xpMult = 1.12,
	blurb = "Scriptures read themselves aloud to this mind." })
t({ id = "tough_hide", name = "Tough Hide", rarity = "uncommon", defenseBonus = 0.05,
	blurb = "Blades must first agree with the skin, and it is stubborn." })

-- ============================= Rare (8) =============================
t({ id = "sword_heart", name = "Sword Heart", rarity = "rare", categoryDamage = { sword = 1.12 }, cooldownMult = 0.97,
	blurb = "A heart with an edge. Sword arts answer it like kin." })
t({ id = "blade_intent", name = "Blade Intent", rarity = "rare", categoryDamage = { blade = 1.12 }, damageMult = 1.03,
	blurb = "The saber's grudge, inherited whole." })
t({ id = "piercing_gaze", name = "Piercing Gaze", rarity = "rare", categoryDamage = { bow = 1.12 }, cooldownMult = 0.97,
	blurb = "It sees the landing before the loosing." })
t({ id = "cloudstep_bones", name = "Cloudstep Bones", rarity = "rare", walkSpeedBonus = 3, cooldownMult = 0.95,
	blurb = "Bones cut for treading things that will not hold weight." })
t({ id = "sea_of_qi", name = "Sea of Qi", rarity = "rare", maxQiMult = 1.15,
	blurb = "Where others carry a pond, this one carries weather." })
t({ id = "furnace_blood", name = "Furnace Blood", rarity = "rare", elementDamage = { fire = 1.15 },
	blurb = "The blood runs a few degrees past mortal." })
t({ id = "frost_marrow", name = "Frost Marrow", rarity = "rare", elementDamage = { ice = 1.15 },
	blurb = "Winter settled into the bones and paid rent." })
t({ id = "thunder_veins", name = "Thunder Veins", rarity = "rare", elementDamage = { lightning = 1.15 },
	blurb = "Some storms take shelter in a body." })

-- ============================= Epic (7) =============================
t({ id = "innate_sword_embryo", name = "Innate Sword Embryo", rarity = "epic", categoryDamage = { sword = 1.2 },
	blurb = "A sword seed planted before birth. It has been growing ever since." })
t({ id = "mountain_cleaving_arm", name = "Mountain-Cleaving Arm", rarity = "epic", categoryDamage = { blade = 1.2 },
	blurb = "One arm noticeably more certain than the other." })
t({ id = "heavens_quiver", name = "Heaven's Quiver", rarity = "epic", categoryDamage = { bow = 1.2 },
	blurb = "Arrows leave this hand already sure of their address." })
t({ id = "boundless_dantian", name = "Boundless Dantian", rarity = "epic", maxQiMult = 1.25,
	blurb = "Elders measured it twice and stopped publishing the result." })
t({ id = "hollow_meridians", name = "Hollow Meridians", rarity = "epic", qiCostMult = 0.85,
	blurb = "Channels wide as valley roads. Techniques travel them for almost nothing." })
t({ id = "dao_comprehension", name = "Dao Comprehension", rarity = "epic", xpMult = 1.25,
	blurb = "The dao explains itself here, patiently, twice if needed." })
t({ id = "immovable_body", name = "Immovable Body", rarity = "epic", defenseBonus = 0.08, maxHealthBonus = 30,
	blurb = "A vajra frame. Push it and reconsider your life." })

-- ========================== Legendary (5) ===========================
t({ id = "sword_dao_seed", name = "Sword Dao Seed", rarity = "legendary", categoryDamage = { sword = 1.3 }, cooldownMult = 0.94,
	blurb = "A fragment of the Sword Dao itself, sleeping shallowly." })
t({ id = "heavenly_whisper", name = "Heavenly Dao Whisper", rarity = "legendary", xpMult = 1.4,
	blurb = "Heaven talks in its sleep, and this one sits close." })
t({ id = "primordial_dantian", name = "Primordial Dantian", rarity = "legendary", maxQiMult = 1.35, qiRegenMult = 1.15,
	blurb = "A qi sea from before the seas were divided." })
t({ id = "devouring_veins", name = "Devouring Veins", rarity = "legendary", elementDamage = { shadow = 1.25 }, qiCostMult = 0.92,
	blurb = "Meridians that eat. The demonic path files them as a cautionary tale." })
t({ id = "war_god_physique", name = "War God Physique", rarity = "legendary", damageMult = 1.25, maxHealthBonus = 40,
	blurb = "A frame built to the old specifications, from when gods fought personally." })

-- ============================ Mythic (3) ============================
t({ id = "innate_dao_body", name = "Innate Dao Body", rarity = "mythic",
	maxQiMult = 1.15, qiRegenMult = 1.15, xpMult = 1.15, damageMult = 1.1, qiCostMult = 0.92,
	blurb = "Born already in agreement with the dao. Tribulations feel awkward about it." })
t({ id = "chaos_embryo", name = "Chaos Embryo", rarity = "mythic",
	damageMult = 1.2, maxQiMult = 1.2, qiCostMult = 0.9,
	blurb = "A yolk of the unopened universe, carried where a dantian should be." })
t({ id = "heaven_defying_meridians", name = "Heaven-Defying Meridians", rarity = "mythic",
	cooldownMult = 0.8, qiCostMult = 0.8,
	blurb = "Channels rerouted in defiance of the diagrams heaven approved." })

Talents.defs = table.freeze(defs)
Talents.order = table.freeze(order)

function Talents.get(id: string): TalentDef?
	return defs[id]
end

return table.freeze(Talents)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">TechniqueForms</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Data > TechniqueForms
-- The forms a player-authored technique can take. A technique = form +
-- element + power + a name of the player's choosing; TechniqueMath turns
-- that into final numbers. `kind` is what the server actually executes:
--   melee       swing hitbox in front of the caster
--   projectile  server-simulated bolt (pierce = passes through bodies)
--   aoe_point   delayed blast at the aimed point
--   aoe_self    blast centered on the caster
--   dash        forward burst (client-applied after server approval)
--   leap        upward burst
--   teleport    short blink toward the aim point (server moves the character)
--   speed_buff  temporary walkspeed increase

local Types = require(script.Parent.Parent.Types)

export type FormKind = "melee" | "projectile" | "aoe_point" | "aoe_self" | "dash" | "leap" | "teleport" | "speed_buff"

export type FormDef = {
	id: string,
	name: string,
	category: Types.TechniqueCategory,
	kind: FormKind,
	baseDamage: number,
	baseQiCost: number,
	baseCooldown: number,
	range: number, -- melee reach / projectile travel / aim distance
	radius: number, -- aoe radius (0 where unused)
	speed: number, -- projectile speed / dash impulse
	duration: number, -- buff duration (0 where unused)
	pierce: boolean,
	blurb: string,
}

local function form(def: FormDef): FormDef
	return def
end

local Forms = {}

local defs: { [string]: FormDef } = {
	-- ============================== Movement ==============================
	gale_step = form({
		id = "gale_step",
		name = "Gale Step",
		category = "movement",
		kind = "dash",
		baseDamage = 0,
		baseQiCost = 12,
		baseCooldown = 4,
		range = 0,
		radius = 0,
		speed = 90, -- forward impulse
		duration = 0,
		pierce = false,
		blurb = "A single breath of qi driven through the legs. The ground forgets you touched it.",
	}),
	shadow_flicker = form({
		id = "shadow_flicker",
		name = "Flicker Step",
		category = "movement",
		kind = "teleport",
		baseDamage = 0,
		baseQiCost = 20,
		baseCooldown = 6,
		range = 32, -- blink distance
		radius = 0,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "Fold the space of three steps into one. Watchers see only where you were.",
	}),
	crane_ascent = form({
		id = "crane_ascent",
		name = "Crane Ascent",
		category = "movement",
		kind = "leap",
		baseDamage = 0,
		baseQiCost = 15,
		baseCooldown = 5,
		range = 0,
		radius = 0,
		speed = 80, -- upward impulse
		duration = 0,
		pierce = false,
		blurb = "Rise the way the crane rises: without asking the earth's permission.",
	}),
	river_stride = form({
		id = "river_stride",
		name = "River Stride",
		category = "movement",
		kind = "speed_buff",
		baseDamage = 0,
		baseQiCost = 25,
		baseCooldown = 14,
		range = 0,
		radius = 0,
		speed = 12, -- walkspeed bonus
		duration = 6,
		pierce = false,
		blurb = "Let qi carry the body like a current. For a while, distance stops arguing.",
	}),

	-- ================================ Sword ================================
	flowing_slash = form({
		id = "flowing_slash",
		name = "Flowing Slash",
		category = "sword",
		kind = "melee",
		baseDamage = 18,
		baseQiCost = 10,
		baseCooldown = 2,
		range = 11,
		radius = 0,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "The first sword any sect teaches, honed until water envies it.",
	}),
	crescent_wave = form({
		id = "crescent_wave",
		name = "Crescent Wave",
		category = "sword",
		kind = "projectile",
		baseDamage = 24,
		baseQiCost = 18,
		baseCooldown = 4,
		range = 70,
		radius = 0,
		speed = 90,
		duration = 0,
		pierce = false,
		blurb = "Sword qi released from the edge, a crescent moon thrown flat.",
	}),
	flying_sword = form({
		id = "flying_sword",
		name = "Flying Sword Strike",
		category = "sword",
		kind = "projectile",
		baseDamage = 34,
		baseQiCost = 28,
		baseCooldown = 6,
		range = 120,
		radius = 0,
		speed = 140,
		duration = 0,
		pierce = false,
		blurb = "The classic art of the sword immortals: the blade goes, the hand stays.",
	}),
	ten_thousand_swords = form({
		id = "ten_thousand_swords",
		name = "Ten Thousand Swords",
		category = "sword",
		kind = "aoe_point",
		baseDamage = 20,
		baseQiCost = 40,
		baseCooldown = 10,
		range = 60,
		radius = 14,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "Point at a patch of sky and it rains edges.",
	}),

	-- ================================ Blade ================================
	mountain_cleave = form({
		id = "mountain_cleave",
		name = "Mountain Cleave",
		category = "blade",
		kind = "melee",
		baseDamage = 30,
		baseQiCost = 16,
		baseCooldown = 4,
		range = 12,
		radius = 0,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "The saber does not fence. It decides, once, downward.",
	}),
	cleaving_gale = form({
		id = "cleaving_gale",
		name = "Cleaving Gale",
		category = "blade",
		kind = "projectile",
		baseDamage = 26,
		baseQiCost = 22,
		baseCooldown = 5,
		range = 60,
		radius = 0,
		speed = 70,
		duration = 0,
		pierce = true,
		blurb = "A saber wind wide as a door, and no more inclined to stop.",
	}),
	whirling_guillotine = form({
		id = "whirling_guillotine",
		name = "Whirling Guillotine",
		category = "blade",
		kind = "aoe_self",
		baseDamage = 22,
		baseQiCost = 24,
		baseCooldown = 6,
		range = 0,
		radius = 14,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "One full turn. Everything within a blade's reach learns why the circle is feared.",
	}),

	-- ================================= Bow =================================
	piercing_shot = form({
		id = "piercing_shot",
		name = "Piercing Shot",
		category = "bow",
		kind = "projectile",
		baseDamage = 22,
		baseQiCost = 12,
		baseCooldown = 2.5,
		range = 150,
		radius = 0,
		speed = 160,
		duration = 0,
		pierce = true,
		blurb = "An arrow of condensed qi that treats bodies as suggestions.",
	}),
	comet_arrow = form({
		id = "comet_arrow",
		name = "Comet Arrow",
		category = "bow",
		kind = "projectile",
		baseDamage = 40,
		baseQiCost = 30,
		baseCooldown = 7,
		range = 200,
		radius = 0,
		speed = 200,
		duration = 0,
		pierce = false,
		blurb = "Draw until the bow argues, then loose a falling star sideways.",
	}),
	arrow_tempest = form({
		id = "arrow_tempest",
		name = "Arrow Tempest",
		category = "bow",
		kind = "aoe_point",
		baseDamage = 18,
		baseQiCost = 36,
		baseCooldown = 9,
		range = 90,
		radius = 12,
		speed = 0,
		duration = 0,
		pierce = false,
		blurb = "One arrow leaves the string. A weather system arrives.",
	}),
}

Forms.defs = table.freeze(defs)

Forms.order = table.freeze({
	"gale_step", "shadow_flicker", "crane_ascent", "river_stride",
	"flowing_slash", "crescent_wave", "flying_sword", "ten_thousand_swords",
	"mountain_cleave", "cleaving_gale", "whirling_guillotine",
	"piercing_shot", "comet_arrow", "arrow_tempest",
})

function Forms.get(id: string): FormDef?
	return defs[id]
end

return table.freeze(Forms)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Net
-- Single owner of every RemoteEvent/RemoteFunction in the game.
--
-- The server CREATES remotes (get-or-create), the client WAITS for them, so
-- there is exactly one code path that names a remote and no script ever
-- Instance.new()s one ad hoc. Add new remote names to the lists below; both
-- sides read the same definition, so a typo fails loudly at startup instead
-- of silently at first fire.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

-- Every remote in the game is declared here and nowhere else.
local REMOTE_EVENTS: { string } = {
	-- Server -> client state pushes
	"StatsChanged", -- qi, realm, xp, path, race, spirit stones, meditating
	"InventoryChanged", -- ores, items, equipped gear
	"TechniquesChanged", -- designed techniques + hotbar slots
	"DestinyChanged", -- owned/equipped races and talents, spin counts
	"SpinResult", -- outcome of a race/talent spin, for the reveal animation
	"Notify", -- toast message { text, color? }
	"OpenCrafting", -- player used the Spirit Forge prompt
	"DwarfDialogue", -- mission dialogue payload
	"TechniqueVFX", -- broadcast: someone cast a technique / broke through

	-- Client -> server intents
	"MeditateSet", -- (meditating: boolean)
	"CastTechnique", -- (slot: number, aimPosition: Vector3)
}

local REMOTE_FUNCTIONS: { string } = {
	"SpinRace", -- roll a new race (free spin if any, else spirit stones)
	"SpinTalent", -- roll a new talent
	"EquipRace", -- switch to any owned race
	"EquipTalent", -- set the equipped talent list
	"CreateTechnique", -- design a new technique
	"DeleteTechnique",
	"EquipTechnique", -- bind a technique to a hotbar slot
	"CraftItem", -- forge a weapon/armor from ores
	"EquipItem", -- equip owned weapon/armor
	"MissionAction", -- "accept" | "turnin" at the dwarf
}

local Net = {}

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if folder == nil then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local function assertDeclared(name: string, list: { string }, kind: string)
	if table.find(list, name) == nil then
		error(`Net: "{name}" is not a declared {kind}. Add it to Net.luau.`, 3)
	end
end

function Net.remoteEvent(name: string): RemoteEvent
	assertDeclared(name, REMOTE_EVENTS, "RemoteEvent")
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			return existing :: RemoteEvent
		end
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.remoteFunction(name: string): RemoteFunction
	assertDeclared(name, REMOTE_FUNCTIONS, "RemoteFunction")
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			return existing :: RemoteFunction
		end
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

-- Server bootstrap: create every declared remote up front so clients never
-- wait on one that a lazily-required system hasn't touched yet.
function Net.initServer()
	assert(RunService:IsServer(), "Net.initServer is server-only")
	for _, name in REMOTE_EVENTS do
		Net.remoteEvent(name)
	end
	for _, name in REMOTE_FUNCTIONS do
		Net.remoteFunction(name)
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > RateLimit
-- Fixed-window rate limiter keyed by userId. Every remote handler on the
-- server wraps itself in one of these; a client that spams a remote gets its
-- calls dropped instead of getting server work done.

local RateLimit = {}
RateLimit.__index = RateLimit

type Entry = { count: number, windowStart: number }

export type RateLimit = typeof(setmetatable({} :: {
	_max: number,
	_window: number,
	_entries: { [number]: Entry },
}, RateLimit))

function RateLimit.new(maxPerWindow: number, windowSeconds: number): RateLimit
	return setmetatable({
		_max = maxPerWindow,
		_window = windowSeconds,
		_entries = {},
	}, RateLimit)
end

function RateLimit.Allow(self: RateLimit, userId: number): boolean
	local now = os.clock()
	local entry = self._entries[userId]
	if entry == nil or (now - entry.windowStart) >= self._window then
		self._entries[userId] = { count = 1, windowStart = now }
		return true
	end
	if entry.count >= self._max then
		return false
	end
	entry.count += 1
	return true
end

function RateLimit.Forget(self: RateLimit, userId: number)
	self._entries[userId] = nil
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">StatCalc</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > StatCalc
-- Combines path + race + equipped talents into one Mods table. Pure and
-- shared: the server uses it as the authority, the client uses the same
-- function for previews, so the numbers a player sees are the numbers
-- the server enforces.

local Types = require(script.Parent.Types)
local Paths = require(script.Parent.Data.Paths)
local Races = require(script.Parent.Data.Races)
local Talents = require(script.Parent.Data.Talents)

local StatCalc = {}

function StatCalc.identity(): Types.Mods
	return {
		maxQiMult = 1,
		qiRegenMult = 1,
		xpMult = 1,
		damageMult = 1,
		qiCostMult = 1,
		cooldownMult = 1,
		defenseBonus = 0,
		maxHealthBonus = 0,
		walkSpeedBonus = 0,
		categoryDamage = {},
		elementDamage = {},
	}
end

function StatCalc.combine(path: string?, raceId: string, talentIds: { string }): Types.Mods
	local mods = StatCalc.identity()

	local pathDef = if path then Paths[path] else nil
	if pathDef then
		mods.qiRegenMult *= pathDef.qiRegenMult
		mods.damageMult *= pathDef.damageMult
		mods.cooldownMult *= pathDef.cooldownMult
	end

	local race = Races.statsFor(raceId)
	mods.maxQiMult *= race.maxQiMult
	mods.qiRegenMult *= race.qiRegenMult
	mods.xpMult *= race.xpMult
	mods.damageMult *= race.damageMult
	mods.qiCostMult *= race.qiCostMult
	mods.cooldownMult *= race.cooldownMult
	mods.defenseBonus += race.defenseBonus
	mods.maxHealthBonus += race.maxHealthBonus
	mods.walkSpeedBonus += race.walkSpeedBonus

	for _, talentId in talentIds do
		local talent = Talents.get(talentId)
		if talent == nil then
			continue
		end
		mods.maxQiMult *= talent.maxQiMult or 1
		mods.qiRegenMult *= talent.qiRegenMult or 1
		mods.xpMult *= talent.xpMult or 1
		mods.damageMult *= talent.damageMult or 1
		mods.qiCostMult *= talent.qiCostMult or 1
		mods.cooldownMult *= talent.cooldownMult or 1
		mods.defenseBonus += talent.defenseBonus or 0
		mods.maxHealthBonus += talent.maxHealthBonus or 0
		mods.walkSpeedBonus += talent.walkSpeedBonus or 0
		if talent.categoryDamage then
			for category, mult in talent.categoryDamage do
				mods.categoryDamage[category] = (mods.categoryDamage[category] or 1) * mult
			end
		end
		if talent.elementDamage then
			for element, mult in talent.elementDamage do
				mods.elementDamage[element] = (mods.elementDamage[element] or 1) * mult
			end
		end
	end

	return mods
end

-- Can this element be woven by this character? Path-locked elements open up
-- when the equipped race's affinity matches.
function StatCalc.elementAllowed(elementPath: string?, playerPath: string?, raceId: string, elementId: string): boolean
	if elementPath == nil then
		return true
	end
	if elementPath == playerPath then
		return true
	end
	local race = Races.get(raceId)
	if race and race.affinity == elementId then
		return true
	end
	return false
end

return table.freeze(StatCalc)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">TechniqueMath</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > TechniqueMath
-- Pure derivation of a technique's numbers from (form, element, power).
-- Shared so the creation UI previews exactly what the server will enforce.
-- Character modifiers (path/race/talents/weapon) are applied on top by the
-- server at cast time; nothing here reads player state.

local Types = require(script.Parent.Types)
local Forms = require(script.Parent.Data.TechniqueForms)
local Elements = require(script.Parent.Data.Elements)

local TechniqueMath = {}

local function round1(x: number): number
	return math.floor(x * 10 + 0.5) / 10
end

-- Returns nil (plus a reason) for unknown ids or out-of-range power, so
-- callers on both sides validate through the same gate.
function TechniqueMath.compute(formId: string, elementId: string, power: number): (Types.TechniqueStats?, string?)
	local form = Forms.get(formId)
	if form == nil then
		return nil, "Unknown form"
	end
	local element = Elements.get(elementId)
	if element == nil then
		return nil, "Unknown element"
	end
	if typeof(power) ~= "number" or power ~= power or power % 1 ~= 0 or power < 0 or power > 10 then
		return nil, "Power must be a whole number from 0 to 10"
	end

	local damageScale = 1 + power * 0.12
	local costScale = 1 + power * 0.10
	local cooldownScale = 1 + power * 0.05
	local magnitudeScale = 1 + power * 0.08

	local stats: Types.TechniqueStats = {
		damage = math.floor(form.baseDamage * damageScale * element.damageMult + 0.5),
		qiCost = math.max(1, math.floor(form.baseQiCost * costScale * element.costMult + 0.5)),
		cooldown = round1(form.baseCooldown * cooldownScale),
		range = math.floor(form.range * magnitudeScale + 0.5),
		speed = math.floor(form.speed * magnitudeScale + 0.5),
		radius = math.floor(form.radius * magnitudeScale + 0.5),
		duration = round1(form.duration * magnitudeScale),
		magnitude = round1(magnitudeScale),
		-- Stronger designs demand a deeper realm: power 0-1 -> realm 1,
		-- 2-3 -> 2, ... 10 -> 6.
		requiredRealm = 1 + math.floor(power / 2),
		-- Designing a technique costs spirit stones: comprehension aids,
		-- talisman paper, and a quiet room.
		createCost = 5 + power * 5 + (if element.id == "none" then 0 else 10),
	}
	return stats, nil
end

return table.freeze(TechniqueMath)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Trove</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Trove
-- Minimal cleanup container (Trove/Maid pattern). Anything added to a Trove
-- is released in one :Clean() call, which is how every system in this project
-- avoids leaking RBXScriptConnections and orphaned instances.

export type Cleanable =
	RBXScriptConnection
	| Instance
	| thread
	| () -> ()
	| { Destroy: (any) -> () }

local Trove = {}
Trove.__index = Trove

export type Trove = typeof(setmetatable({} :: {
	_items: { Cleanable },
	_cleaning: boolean,
}, Trove))

function Trove.new(): Trove
	return setmetatable({
		_items = {},
		_cleaning = false,
	}, Trove)
end

-- Track any cleanable object. Returns the same object so calls can be inlined:
--   local part = trove:Add(Instance.new("Part"))
-- (Typed as any -> any rather than generically: a generic method makes the
-- self-referential Trove type incompatible with itself under strict mode.)
function Trove.Add(self: Trove, item: any): any
	assert(not self._cleaning, "Cannot add to a Trove while it is cleaning")
	table.insert(self._items, item)
	return item
end

-- Convenience wrapper: connect and track the connection in one call.
function Trove.Connect(self: Trove, signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
	return self:Add(signal:Connect(handler)) :: RBXScriptConnection
end

-- Release everything in reverse insertion order.
function Trove.Clean(self: Trove)
	if self._cleaning then
		return
	end
	self._cleaning = true

	for index = #self._items, 1, -1 do
		local item = self._items[index]
		self._items[index] = nil

		if typeof(item) == "RBXScriptConnection" then
			item:Disconnect()
		elseif typeof(item) == "Instance" then
			item:Destroy()
		elseif typeof(item) == "thread" then
			task.cancel(item)
		elseif typeof(item) == "function" then
			item()
		elseif typeof(item) == "table" then
			(item :: any):Destroy()
		end
	end

	self._cleaning = false
end

-- Alias so a Trove can itself be added to another Trove.
Trove.Destroy = Trove.Clean

return Trove
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage > Shared > Types
-- Shared type definitions. Data shapes that cross the network or the
-- DataStore boundary live here so server and client agree on them.

export type PathId = "orthodox" | "unorthodox" | "demonic"

export type TechniqueCategory = "movement" | "sword" | "blade" | "bow"

export type Rarity = "common" | "uncommon" | "rare" | "epic" | "legendary" | "mythic"

-- A player-authored cultivation technique. `form` and `element` are ids into
-- Data/TechniqueForms and Data/Elements; `power` is how much qi the player
-- poured into the design (0..10). Stats are always derived from these three
-- via TechniqueMath, never stored, so balance changes apply retroactively.
export type Technique = {
	id: string,
	name: string,
	form: string,
	element: string,
	power: number,
}

-- Persisted per player. Keep DataStore-safe: string keys, no Instances,
-- no mixed arrays. `slots` is keyed "1".."6" (DataStores reject sparse
-- numeric arrays).
export type PlayerData = {
	version: number,
	path: PathId?,
	realm: number,
	cultivationXp: number,
	qi: number,
	spiritStones: number,
	ores: { [string]: number },
	items: { [string]: number },
	equippedWeapon: string?,
	equippedArmor: string?,
	techniques: { Technique },
	slots: { [string]: string },
	missionIndex: number,
	missionAccepted: boolean,

	-- Destiny: races and talents, rolled with spins
	race: string, -- equipped race id (Data/Races), "fanren" by default
	ownedRaces: { [string]: number }, -- id -> times rolled
	equippedTalents: { string }, -- up to Config.TALENT_SLOTS ids
	ownedTalents: { [string]: number },
	raceSpins: number,
	talentSpins: number,
}

-- Derived stats for one technique at one power level.
export type TechniqueStats = {
	damage: number,
	qiCost: number,
	cooldown: number,
	range: number,
	speed: number,
	radius: number,
	duration: number,
	magnitude: number,
	requiredRealm: number,
	createCost: number,
}

-- Aggregate character modifiers from path + race + talents (see StatCalc).
export type Mods = {
	maxQiMult: number,
	qiRegenMult: number,
	xpMult: number,
	damageMult: number,
	qiCostMult: number,
	cooldownMult: number,
	defenseBonus: number, -- added to armor's damage-absorb fraction
	maxHealthBonus: number,
	walkSpeedBonus: number,
	categoryDamage: { [string]: number }, -- extra mult per technique category
	elementDamage: { [string]: number }, -- extra mult per element
}

-- ModuleScripts must return a non-nil value; types are exported above.
return table.freeze({})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Script: ServerScriptService > Server (this folder syncs as a single Script)
-- Bootstrapper: requires every ModuleScript in Systems/, calls Init() on all
-- of them, then Start() on all of them. Two phases so a system can safely
-- reference another system's state in Start() knowing every Init() already ran.

local systemsFolder = script:WaitForChild("Systems")

type System = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local systems: { [string]: System } = {}

for _, child in systemsFolder:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			systems[child.Name] = result :: System
		else
			warn(`[Server] Failed to require system "{child.Name}": {result}`)
		end
	end
end

for name, system in systems do
	if system.Init then
		local ok, err = pcall(system.Init :: any)
		if not ok then
			warn(`[Server] {name}.Init() failed: {err}`)
		end
	end
end

for name, system in systems do
	if system.Start then
		task.spawn(function()
			local ok, err = pcall(system.Start :: any)
			if not ok then
				warn(`[Server] {name}.Start() failed: {err}`)
			end
		end)
	end
end

print("[Server] All systems started")
]]></string>
      </Properties>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > CombatService
-- Server-authoritative damage. Every point of damage in the game flows
-- through DealDamage: safe-zone rules, armor, elemental side effects,
-- lifesteal, and training-dummy upkeep all live here so no technique can
-- reinvent (or bypass) them.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local StatCalc = require(Shared:WaitForChild("StatCalc"))
local Elements = require(Shared:WaitForChild("Data"):WaitForChild("Elements"))
local Items = require(Shared:WaitForChild("Data"):WaitForChild("Items"))

local DataService = require(script.Parent.DataService)

local BASE_HEALTH = 100

local CombatService = {}

type Zone = { position: Vector3, radius: number }
local safeZones: { Zone } = {}

-- ------------------------------ Safe zones ------------------------------

local function registerZone(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	local radius = part:GetAttribute("Radius")
	table.insert(safeZones, {
		position = part.Position,
		radius = if typeof(radius) == "number" then radius else math.max(part.Size.X, part.Size.Z) / 2,
	})
end

function CombatService.InSafeZone(position: Vector3): boolean
	for _, zone in safeZones do
		if (position - zone.position).Magnitude <= zone.radius then
			return true
		end
	end
	return false
end

-- ---------------------------- Character mods ----------------------------

-- Applies path/race/talent/armor modifiers to a live character. Called on
-- spawn and whenever gear, race or talents change.
function CombatService.RefreshMods(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if data == nil or humanoid == nil then
		return
	end

	local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)

	local maxHealth = math.max(25, BASE_HEALTH + mods.maxHealthBonus)
	local healthFrac = humanoid.Health / humanoid.MaxHealth
	humanoid.MaxHealth = maxHealth
	humanoid.Health = math.min(maxHealth, maxHealth * healthFrac)

	humanoid.WalkSpeed = Config.BASE_WALKSPEED + mods.walkSpeedBonus

	local defense = mods.defenseBonus
	local armorId = data.equippedArmor
	if armorId then
		local armor = Items.get(armorId)
		if armor then
			defense += armor.defense
		end
	end
	humanoid:SetAttribute("DefenseFrac", math.clamp(defense, 0, 0.8))
end

-- ------------------------------- Damage ---------------------------------

local function healCaster(caster: Player, amount: number)
	local character = caster.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

local function applyEffect(caster: Player, target: Humanoid, effect: string, dealt: number, direction: Vector3)
	if effect == "burn" then
		task.spawn(function()
			for _ = 1, 3 do
				task.wait(1)
				if target.Health <= 0 then
					return
				end
				target:TakeDamage(math.max(1, dealt * 0.15))
			end
		end)
	elseif effect == "poison" then
		task.spawn(function()
			for _ = 1, 6 do
				task.wait(1)
				if target.Health <= 0 then
					return
				end
				target:TakeDamage(math.max(1, dealt * 0.08))
			end
		end)
	elseif effect == "slow" then
		task.spawn(function()
			local original = target.WalkSpeed
			target.WalkSpeed = original * 0.6
			task.wait(2.5)
			-- Restore through RefreshMods for players (authoritative),
			-- directly for NPCs.
			local targetPlayer = Players:GetPlayerFromCharacter(target.Parent)
			if targetPlayer then
				CombatService.RefreshMods(targetPlayer)
			elseif target.Parent ~= nil then
				target.WalkSpeed = original
			end
		end)
	elseif effect == "shock" then
		task.spawn(function()
			local original = target.WalkSpeed
			target.WalkSpeed = 0
			task.wait(0.4)
			local targetPlayer = Players:GetPlayerFromCharacter(target.Parent)
			if targetPlayer then
				CombatService.RefreshMods(targetPlayer)
			elseif target.Parent ~= nil then
				target.WalkSpeed = original
			end
		end)
	elseif effect == "knockback" or effect == "gust" then
		local root = if target.Parent then (target.Parent :: Instance):FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") and not root.Anchored then
			local strength = if effect == "knockback" then 40 else 15
			root.AssemblyLinearVelocity += direction.Unit * strength + Vector3.new(0, strength * 0.4, 0)
		end
	elseif effect == "selfheal" then
		healCaster(caster, dealt * 0.15)
	elseif effect == "lifesteal" then
		healCaster(caster, dealt * 0.25)
	end
end

-- Returns damage actually dealt (0 = blocked by rules).
function CombatService.DealDamage(caster: Player, target: Humanoid, amount: number, elementId: string, direction: Vector3): number
	if amount <= 0 or target.Health <= 0 then
		return 0
	end
	local targetCharacter = target.Parent
	if targetCharacter == nil then
		return 0
	end

	-- No harming anyone inside a city, and no shooting in from outside.
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	if targetRoot and targetRoot:IsA("BasePart") and CombatService.InSafeZone(targetRoot.Position) then
		return 0
	end
	local casterCharacter = caster.Character
	local casterRoot = if casterCharacter then casterCharacter:FindFirstChild("HumanoidRootPart") else nil
	if casterRoot and casterRoot:IsA("BasePart") and CombatService.InSafeZone(casterRoot.Position) then
		return 0
	end
	if casterCharacter == targetCharacter then
		return 0
	end

	local defense = target:GetAttribute("DefenseFrac")
	local defenseFrac = if typeof(defense) == "number" then defense else 0
	local dealt = amount * (1 - math.clamp(defenseFrac, 0, 0.8))

	target:TakeDamage(dealt)

	local element = Elements.get(elementId)
	if element and element.effect ~= "none" then
		applyEffect(caster, target, element.effect, dealt, direction)
	end

	return dealt
end

-- --------------------------- Training dummies ---------------------------

local function dummyLoop(model: Instance)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	task.spawn(function()
		while model.Parent ~= nil do
			task.wait(1)
			if humanoid.Health <= 0 then
				task.wait(3)
				humanoid.Health = humanoid.MaxHealth
			elseif humanoid.Health < humanoid.MaxHealth then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + humanoid.MaxHealth * 0.05)
			end
		end
	end)
end

-- ------------------------------ Lifecycle -------------------------------

function CombatService.Init()
	for _, part in CollectionService:GetTagged("SafeZone") do
		registerZone(part)
	end
	CollectionService:GetInstanceAddedSignal("SafeZone"):Connect(registerZone)

	for _, dummy in CollectionService:GetTagged("TrainingDummy") do
		dummyLoop(dummy)
	end
	CollectionService:GetInstanceAddedSignal("TrainingDummy"):Connect(dummyLoop)

	DataService.ObserveLoaded(function(player)
		CombatService.RefreshMods(player)
		player.CharacterAdded:Connect(function()
			-- Humanoid may not exist for an instant on spawn.
			task.defer(CombatService.RefreshMods, player)
		end)
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > DataService
-- Owns every player's persisted data: load on join, autosave, save on leave
-- and on server close. Also owns the state pushes to clients, so every
-- mutation site calls one Push* function instead of hand-rolling payloads.
--
-- DataStore access is wrapped in pcall with an in-memory fallback so Studio
-- (or an API outage) degrades to a playable session that simply won't save.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local StatCalc = require(Shared:WaitForChild("StatCalc"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))
local Races = require(Shared:WaitForChild("Data"):WaitForChild("Races"))

local STORE_NAME = "PlayerData_v1"
local KEY_PREFIX = "u_"

local DataService = {}

type Profile = {
	data: Types.PlayerData,
	loaded: boolean, -- false = fallback default (do NOT overwrite the store)
	meditating: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local loadedEvent = Instance.new("BindableEvent")

local statsChanged = Net.remoteEvent("StatsChanged")
local inventoryChanged = Net.remoteEvent("InventoryChanged")
local techniquesChanged = Net.remoteEvent("TechniquesChanged")
local destinyChanged = Net.remoteEvent("DestinyChanged")
local notify = Net.remoteEvent("Notify")

local function defaultData(): Types.PlayerData
	return {
		version = 1,
		path = nil,
		realm = 1,
		cultivationXp = 0,
		qi = Realms[1].maxQi,
		spiritStones = 10,
		ores = {},
		items = { training_sword = 1 },
		equippedWeapon = "training_sword",
		equippedArmor = nil,
		techniques = {},
		slots = {},
		missionIndex = 1,
		missionAccepted = false,
		race = Races.DEFAULT_RACE,
		ownedRaces = { [Races.DEFAULT_RACE] = 1 },
		equippedTalents = {},
		ownedTalents = {},
		raceSpins = Config.STARTING_RACE_SPINS,
		talentSpins = Config.STARTING_TALENT_SPINS,
	}
end

-- Fill any keys missing from an older save so shape changes never nil-crash.
local function migrate(data: any): Types.PlayerData
	local fresh = defaultData()
	if typeof(data) ~= "table" then
		return fresh
	end
	for key, value in fresh :: any do
		if (data :: any)[key] == nil then
			(data :: any)[key] = value
		end
	end
	return data :: Types.PlayerData
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function load(player: Player): Profile
	local profile: Profile = { data = defaultData(), loaded = false, meditating = false }
	local dataStore = getStore()
	if dataStore then
		local ok, result = pcall(function()
			return dataStore:GetAsync(KEY_PREFIX .. player.UserId)
		end)
		if ok then
			profile.data = migrate(result)
			profile.loaded = true
		else
			warn(`[DataService] Load failed for {player.Name}: {result}`)
		end
	end
	return profile
end

local function save(player: Player, profile: Profile)
	-- A profile that never loaded must not clobber the real save with defaults.
	if not profile.loaded then
		return
	end
	local dataStore = getStore()
	if dataStore == nil then
		return
	end
	local data = profile.data
	local ok, err = pcall(function()
		dataStore:UpdateAsync(KEY_PREFIX .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn(`[DataService] Save failed for {player.Name}: {err}`)
	end
end

-- ------------------------------ Public API ------------------------------

function DataService.Get(player: Player): Types.PlayerData?
	local profile = profiles[player]
	return if profile then profile.data else nil
end

-- Runs `callback` for every player whose data is ready, now and in the
-- future. The way systems like PathService and CombatService subscribe
-- without racing the async load.
function DataService.ObserveLoaded(callback: (Player) -> ()): RBXScriptConnection
	for player in profiles do
		task.spawn(callback, player)
	end
	return loadedEvent.Event:Connect(callback)
end

function DataService.IsMeditating(player: Player): boolean
	local profile = profiles[player]
	return if profile then profile.meditating else false
end

function DataService.SetMeditating(player: Player, meditating: boolean)
	local profile = profiles[player]
	if profile then
		profile.meditating = meditating
	end
end

function DataService.Notify(player: Player, text: string, color: Color3?)
	notify:FireClient(player, { text = text, color = color })
end

function DataService.PushStats(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	local data = profile.data
	local realm = Realms[data.realm] or Realms[1]
	local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)
	statsChanged:FireClient(player, {
		qi = data.qi,
		maxQi = math.floor(realm.maxQi * mods.maxQiMult + 0.5),
		realm = data.realm,
		realmName = realm.name,
		cultivationXp = data.cultivationXp,
		breakthroughXp = realm.breakthroughXp,
		path = data.path,
		race = data.race,
		spiritStones = data.spiritStones,
		meditating = profile.meditating,
		equippedTalents = data.equippedTalents,
	})
end

function DataService.PushInventory(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	inventoryChanged:FireClient(player, {
		ores = data.ores,
		items = data.items,
		equippedWeapon = data.equippedWeapon,
		equippedArmor = data.equippedArmor,
		spiritStones = data.spiritStones,
	})
end

function DataService.PushTechniques(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	techniquesChanged:FireClient(player, {
		techniques = data.techniques,
		slots = data.slots,
	})
end

function DataService.PushDestiny(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	destinyChanged:FireClient(player, {
		race = data.race,
		ownedRaces = data.ownedRaces,
		equippedTalents = data.equippedTalents,
		ownedTalents = data.ownedTalents,
		raceSpins = data.raceSpins,
		talentSpins = data.talentSpins,
	})
end

function DataService.PushAll(player: Player)
	DataService.PushStats(player)
	DataService.PushInventory(player)
	DataService.PushTechniques(player)
	DataService.PushDestiny(player)
end

-- ------------------------------ Lifecycle -------------------------------

local function onPlayerAdded(player: Player)
	local profile = load(player)
	if player.Parent == nil then
		return -- left while loading
	end
	profiles[player] = profile
	DataService.PushAll(player)
	loadedEvent:Fire(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		profiles[player] = nil
		save(player, profile)
	end
end

function DataService.Init()
	Net.initServer()

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		if profiles[player] == nil then
			task.spawn(onPlayerAdded, player)
		end
	end

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for player, profile in profiles do
			save(player, profile)
		end
	end)
end

function DataService.Start()
	while true do
		task.wait(Config.AUTOSAVE_SECONDS)
		for player, profile in profiles do
			task.spawn(save, player, profile)
		end
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DestinyService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > DestinyService
-- Destiny spins: races and talents. All RNG is server-side (one Random
-- instance), spins are paid from free-spin balances first and spirit stones
-- second, and duplicates refund stones by rarity. The client only renders
-- the reveal.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))
local Races = require(Shared:WaitForChild("Data"):WaitForChild("Races"))
local Talents = require(Shared:WaitForChild("Data"):WaitForChild("Talents"))

local DataService = require(script.Parent.DataService)
local CombatService = require(script.Parent.CombatService)

local DestinyService = {}

local rng = Random.new()
local spinLimit = RateLimit.new(5, 2)
local spinResult = Net.remoteEvent("SpinResult")

local function fail(message: string): { [string]: any }
	return { ok = false, error = message }
end

-- Rarity buckets, precomputed once per pool.
local function bucket(order: { string }, rarityOf: (string) -> string): { [string]: { string } }
	local buckets: { [string]: { string } } = {}
	for _, id in order do
		local rarity = rarityOf(id)
		if buckets[rarity] == nil then
			buckets[rarity] = {}
		end
		table.insert(buckets[rarity], id)
	end
	return buckets
end

local raceBuckets = bucket(Races.order, function(id)
	local def = Races.get(id)
	return if def then def.rarity else "common"
end)

local talentBuckets = bucket(Talents.order, function(id)
	local def = Talents.get(id)
	return if def then def.rarity else "common"
end)

local function rollRarity(weights: { [string]: number }): string
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll = rng:NextNumber() * total
	for rarity, weight in weights do
		roll -= weight
		if roll <= 0 then
			return rarity
		end
	end
	return "common"
end

local function rollFrom(buckets: { [string]: { string } }, weights: { [string]: number }): string
	local rarity = rollRarity(weights)
	local pool = buckets[rarity]
	if pool == nil or #pool == 0 then
		pool = buckets.common
	end
	return pool[rng:NextInteger(1, #pool)]
end

-- ------------------------------- Spins ----------------------------------

type SpinKind = "race" | "talent"

local function spin(player: Player, kindName: SpinKind): { [string]: any }
	if not spinLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end

	local isRace = kindName == "race"
	local stonePrice = if isRace then Config.RACE_SPIN_STONES else Config.TALENT_SPIN_STONES
	local freeSpins = if isRace then data.raceSpins else data.talentSpins

	local usedFreeSpin = false
	if freeSpins > 0 then
		usedFreeSpin = true
		if isRace then
			data.raceSpins -= 1
		else
			data.talentSpins -= 1
		end
	elseif data.spiritStones >= stonePrice then
		data.spiritStones -= stonePrice
	else
		return fail(`No spins left, and a spin costs {stonePrice} spirit stones.`)
	end

	local rolledId: string
	local rarity: string
	local duplicate = false
	local refund = 0

	if isRace then
		rolledId = rollFrom(raceBuckets, Races.SPIN_WEIGHTS)
		local def = Races.get(rolledId)
		rarity = if def then def.rarity else "common"
		if data.ownedRaces[rolledId] then
			duplicate = true
			refund = (Races.DUPLICATE_REFUND :: { [string]: number })[rarity] or 0
			data.spiritStones += refund
			data.ownedRaces[rolledId] += 1
		else
			data.ownedRaces[rolledId] = 1
		end
	else
		rolledId = rollFrom(talentBuckets, Talents.SPIN_WEIGHTS)
		local def = Talents.get(rolledId)
		rarity = if def then def.rarity else "common"
		if data.ownedTalents[rolledId] then
			duplicate = true
			refund = (Talents.DUPLICATE_REFUND :: { [string]: number })[rarity] or 0
			data.spiritStones += refund
			data.ownedTalents[rolledId] += 1
		else
			data.ownedTalents[rolledId] = 1
		end
	end

	spinResult:FireClient(player, {
		kind = kindName,
		id = rolledId,
		rarity = rarity,
		duplicate = duplicate,
		refund = refund,
		usedFreeSpin = usedFreeSpin,
	})
	DataService.PushStats(player)
	DataService.PushDestiny(player)
	return { ok = true, id = rolledId, rarity = rarity, duplicate = duplicate, refund = refund }
end

-- ------------------------------- Equips ---------------------------------

local function equipRace(player: Player, payload: unknown): { [string]: any }
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local id = (payload :: { [string]: unknown }).id
	if typeof(id) ~= "string" or Races.get(id) == nil then
		return fail("Unknown race")
	end
	if data.ownedRaces[id] == nil then
		return fail("You have not awakened that bloodline.")
	end
	data.race = id
	CombatService.RefreshMods(player)
	DataService.PushStats(player)
	DataService.PushDestiny(player)
	return { ok = true }
end

local function equipTalent(player: Player, payload: unknown): { [string]: any }
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local ids = (payload :: { [string]: unknown }).ids
	if typeof(ids) ~= "table" then
		return fail("Bad request")
	end
	local list = ids :: { unknown }
	if #list > Config.TALENT_SLOTS then
		return fail(`At most {Config.TALENT_SLOTS} talents.`)
	end
	local cleaned: { string } = {}
	local seen: { [string]: boolean } = {}
	for _, id in list do
		if typeof(id) ~= "string" or Talents.get(id) == nil then
			return fail("Unknown talent")
		end
		if data.ownedTalents[id] == nil then
			return fail("You have not awakened that talent.")
		end
		if seen[id] then
			return fail("Duplicate talent")
		end
		seen[id] = true
		table.insert(cleaned, id)
	end
	data.equippedTalents = cleaned
	CombatService.RefreshMods(player)
	DataService.PushStats(player)
	DataService.PushDestiny(player)
	return { ok = true }
end

-- ------------------------------ Lifecycle -------------------------------

function DestinyService.Init()
	Net.remoteFunction("SpinRace").OnServerInvoke = function(player)
		return spin(player, "race")
	end
	Net.remoteFunction("SpinTalent").OnServerInvoke = function(player)
		return spin(player, "talent")
	end
	Net.remoteFunction("EquipRace").OnServerInvoke = equipRace
	Net.remoteFunction("EquipTalent").OnServerInvoke = equipTalent

	Players.PlayerRemoving:Connect(function(player)
		spinLimit:Forget(player.UserId)
	end)
end

return DestinyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ForgeService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > ForgeService
-- The Deepforge: Grandmaster Khadun's mining missions and the crafting of
-- weapons and robes from ore. The dwarf and the forge are world objects
-- tagged by WorldBuilder ("DwarfPrompt" / "ForgePrompt"); everything they
-- can do to a player's data happens here.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))
local Types = require(Shared:WaitForChild("Types"))
local Items = require(Shared:WaitForChild("Data"):WaitForChild("Items"))
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))
local Missions = require(Shared:WaitForChild("Data"):WaitForChild("Missions"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))

local DataService = require(script.Parent.DataService)
local CombatService = require(script.Parent.CombatService)

local DWARF_NAME = "Grandmaster Khadun"
local MAX_FORGE_DISTANCE = 35

local ForgeService = {}

local actionLimit = RateLimit.new(8, 4)
local forgePositions: { Vector3 } = {}

local function fail(message: string): { [string]: any }
	return { ok = false, error = message }
end

local function currentMission(data: Types.PlayerData)
	local index = math.clamp(data.missionIndex, 1, #Missions)
	return Missions[index], index
end

local function hasOres(data: Types.PlayerData, needs: { [string]: number }): boolean
	for oreId, count in needs do
		if (data.ores[oreId] or 0) < count then
			return false
		end
	end
	return true
end

local function nearForge(player: Player): boolean
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	for _, position in forgePositions do
		if (root.Position - position).Magnitude <= MAX_FORGE_DISTANCE then
			return true
		end
	end
	return false
end

-- ------------------------------ Dialogue --------------------------------

local function sendDialogue(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	local mission, index = currentMission(data)
	local needsText = {}
	for oreId, count in mission.needs do
		local ore = Ores.get(oreId)
		table.insert(needsText, `{count}x {if ore then ore.name else oreId}`)
	end

	local canTurnIn = data.missionAccepted and hasOres(data, mission.needs)
	local text: string
	if not data.missionAccepted then
		text = mission.intro
	elseif canTurnIn then
		text = "That gleam in your pack better be my ore. Hand it over."
	else
		text = `Still short. I need {table.concat(needsText, ", ")}. The veins are down in the halls, not up here in the chatting air.`
	end

	Net.remoteEvent("DwarfDialogue"):FireClient(player, {
		npcName = DWARF_NAME,
		missionTitle = mission.title,
		missionNumber = index,
		text = text,
		needs = mission.needs,
		rewardStones = mission.rewardStones,
		rewardRaceSpins = mission.rewardRaceSpins,
		rewardTalentSpins = mission.rewardTalentSpins,
		canAccept = not data.missionAccepted,
		canTurnIn = canTurnIn,
	})
end

local function missionAction(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local action = (payload :: { [string]: unknown }).action
	local mission = (currentMission(data))

	if action == "accept" then
		if data.missionAccepted then
			return fail("Already on a commission.")
		end
		data.missionAccepted = true
		DataService.Notify(player, `Commission accepted: {mission.title}`)
		sendDialogue(player)
		return { ok = true }
	elseif action == "turnin" then
		if not data.missionAccepted then
			return fail("Accept the commission first.")
		end
		if not hasOres(data, mission.needs) then
			return fail("You are short on ore.")
		end
		for oreId, count in mission.needs do
			data.ores[oreId] = (data.ores[oreId] or 0) - count
			if data.ores[oreId] <= 0 then
				data.ores[oreId] = nil
			end
		end
		data.spiritStones += mission.rewardStones
		data.raceSpins += mission.rewardRaceSpins
		data.talentSpins += mission.rewardTalentSpins
		data.missionAccepted = false
		if data.missionIndex < #Missions then
			data.missionIndex += 1
		end

		DataService.Notify(player, mission.turnIn)
		local rewards = `+{mission.rewardStones} spirit stones`
		if mission.rewardRaceSpins > 0 then
			rewards ..= `, +{mission.rewardRaceSpins} race spins`
		end
		if mission.rewardTalentSpins > 0 then
			rewards ..= `, +{mission.rewardTalentSpins} talent spins`
		end
		DataService.Notify(player, rewards, Color3.fromRGB(255, 215, 120))

		DataService.PushStats(player)
		DataService.PushInventory(player)
		DataService.PushDestiny(player)
		sendDialogue(player)
		return { ok = true }
	end
	return fail("Bad request")
end

-- ------------------------------ Crafting --------------------------------

local function craftItem(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local id = (payload :: { [string]: unknown }).id
	if typeof(id) ~= "string" then
		return fail("Bad request")
	end
	local item = Items.get(id)
	if item == nil or item.recipe == nil then
		return fail("The forge does not know that work.")
	end
	if not nearForge(player) then
		return fail("You must be at the Spirit Forge.")
	end
	local recipe = item.recipe :: Items.Recipe
	if data.spiritStones < recipe.spiritStones then
		return fail(`Needs {recipe.spiritStones} spirit stones.`)
	end
	if not hasOres(data, recipe.ores) then
		return fail("You are short on ore.")
	end

	data.spiritStones -= recipe.spiritStones
	for oreId, count in recipe.ores do
		data.ores[oreId] = (data.ores[oreId] or 0) - count
		if data.ores[oreId] <= 0 then
			data.ores[oreId] = nil
		end
	end
	data.items[id] = (data.items[id] or 0) + 1

	DataService.Notify(player, `Forged: {item.name}`, Color3.fromRGB(255, 180, 90))
	DataService.PushStats(player)
	DataService.PushInventory(player)
	return { ok = true }
end

local function equipItem(player: Player, payload: unknown): { [string]: any }
	if not actionLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local slot = request.slot
	local id = request.id
	if slot ~= "weapon" and slot ~= "armor" then
		return fail("Bad request")
	end
	if id ~= nil then
		if typeof(id) ~= "string" then
			return fail("Bad request")
		end
		local item = Items.get(id)
		if item == nil then
			return fail("Unknown item")
		end
		if (data.items[id] or 0) < 1 then
			return fail("You do not own that.")
		end
		local expectedKind = if slot == "weapon" then "weapon" else "armor"
		if item.kind ~= expectedKind then
			return fail("That does not go there.")
		end
		if data.realm < item.realmReq then
			local needed = Realms[item.realmReq]
			return fail(`Needs {needed.name} to wield.`)
		end
	end
	if slot == "weapon" then
		data.equippedWeapon = id :: string?
	else
		data.equippedArmor = id :: string?
	end
	CombatService.RefreshMods(player)
	DataService.PushInventory(player)
	return { ok = true }
end

-- ------------------------------ Lifecycle -------------------------------

local function bindDwarf(instance: Instance)
	local prompt = if instance:IsA("ProximityPrompt") then instance else instance:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt.Triggered:Connect(sendDialogue)
	end
end

local function bindForge(instance: Instance)
	local prompt = if instance:IsA("ProximityPrompt") then instance else instance:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt == nil then
		return
	end
	local parent = prompt:FindFirstAncestorWhichIsA("BasePart") or prompt.Parent
	if parent and parent:IsA("BasePart") then
		table.insert(forgePositions, parent.Position)
	end
	prompt.Triggered:Connect(function(player)
		Net.remoteEvent("OpenCrafting"):FireClient(player)
	end)
end

function ForgeService.Init()
	Net.remoteFunction("MissionAction").OnServerInvoke = missionAction
	Net.remoteFunction("CraftItem").OnServerInvoke = craftItem
	Net.remoteFunction("EquipItem").OnServerInvoke = equipItem

	for _, dwarf in CollectionService:GetTagged("DwarfPrompt") do
		bindDwarf(dwarf)
	end
	CollectionService:GetInstanceAddedSignal("DwarfPrompt"):Connect(bindDwarf)

	for _, forge in CollectionService:GetTagged("ForgePrompt") do
		bindForge(forge)
	end
	CollectionService:GetInstanceAddedSignal("ForgePrompt"):Connect(bindForge)
end

return ForgeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MiningService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > MiningService
-- Ore nodes in the caves under Heavenpillar Mountain. WorldBuilder creates
-- the nodes (tagged "OreNode" with an OreId attribute and a ProximityPrompt);
-- this system owns what happens when one is mined: payout, depletion,
-- respawn, and a little cultivation xp for honest work.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))

local DataService = require(script.Parent.DataService)
local QiSystem = require(script.Parent.QiSystem)

local MAX_MINE_DISTANCE = 20

local MiningService = {}

local rng = Random.new()

local function setDepleted(node: Model, prompt: ProximityPrompt, depleted: boolean)
	prompt.Enabled = not depleted
	for _, descendant in node:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "Crystal" then
			descendant.Transparency = if depleted then 0.85 else 0
		end
	end
end

local function onMined(node: Model, prompt: ProximityPrompt, ore: Ores.OreDef, player: Player)
	local data = DataService.Get(player)
	if data == nil or not prompt.Enabled then
		return
	end

	-- Distance sanity: the prompt already limits range, but prompts are
	-- client-signaled, so verify on the server too.
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local nodePart = node.PrimaryPart or node:FindFirstChildWhichIsA("BasePart")
	if root == nil or not root:IsA("BasePart") or nodePart == nil then
		return
	end
	if (root.Position - nodePart.Position).Magnitude > MAX_MINE_DISTANCE then
		return
	end

	local amount = rng:NextInteger(ore.harvestMin, ore.harvestMax)
	if ore.id == "spirit_stone" then
		data.spiritStones += amount
		DataService.Notify(player, `+{amount} spirit stones`, ore.color)
	else
		data.ores[ore.id] = (data.ores[ore.id] or 0) + amount
		DataService.Notify(player, `+{amount} {ore.name}`, ore.color)
	end

	-- Working the mountain's marrow is cultivation too, barely.
	QiSystem.AddXp(player, 1)

	DataService.PushStats(player)
	DataService.PushInventory(player)

	setDepleted(node, prompt, true)
	task.delay(ore.respawnSeconds, function()
		if node.Parent ~= nil then
			setDepleted(node, prompt, false)
		end
	end)
end

local function bindNode(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local node = instance :: Model
	local oreId = node:GetAttribute("OreId")
	if typeof(oreId) ~= "string" then
		return
	end
	local ore = Ores.get(oreId)
	if ore == nil then
		warn(`[MiningService] Unknown ore id "{oreId}" on {node:GetFullName()}`)
		return
	end
	local prompt = node:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt == nil then
		return
	end
	prompt.Triggered:Connect(function(player)
		onMined(node, prompt, ore, player)
	end)
end

function MiningService.Init()
	for _, node in CollectionService:GetTagged("OreNode") do
		bindNode(node)
	end
	CollectionService:GetInstanceAddedSignal("OreNode"):Connect(bindNode)
end

return MiningService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PathService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > PathService
-- The three paths as Teams, and the shrine in each city where a wanderer
-- pledges. Pledging is permanent (a dao is not a hat) and moves the
-- player's respawns to their path's city via team spawn locations.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Paths = require(Shared:WaitForChild("Data"):WaitForChild("Paths"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = require(script.Parent.DataService)

local WANDERER_TEAM = "Wanderers"
local WANDERER_COLOR = "Medium stone grey"

local PathService = {}

local teams: { [string]: Team } = {}

local function ensureTeam(name: string, brickColorName: string, autoAssignable: boolean): Team
	local existing = Teams:FindFirstChild(name)
	if existing and existing:IsA("Team") then
		return existing
	end
	local team = Instance.new("Team")
	team.Name = name
	team.TeamColor = (BrickColor.new :: any)(brickColorName)
	team.AutoAssignable = autoAssignable
	team.Parent = Teams
	return team
end

local function teamFor(pathId: string?): Team
	if pathId and teams[pathId] then
		return teams[pathId]
	end
	return teams[WANDERER_TEAM]
end

local function syncTeam(player: Player)
	local data = DataService.Get(player)
	player.Team = teamFor(if data then data.path else nil)
end

local function pledge(player: Player, pathId: Types.PathId)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	local pathDef = Paths[pathId]
	if pathDef == nil then
		return
	end
	if data.path ~= nil then
		local current = Paths[data.path :: string]
		DataService.Notify(player, `Your dao is already set. The {current.name} does not release its own.`)
		return
	end
	data.path = pathId
	syncTeam(player)
	DataService.Notify(player, `You have pledged to the {pathDef.name}. {pathDef.cityName} is now your home.`, pathDef.accentColor)
	DataService.PushStats(player)
end

local function bindShrine(shrine: Instance)
	local prompt = shrine:FindFirstChildWhichIsA("ProximityPrompt", true)
	local pathId = shrine:GetAttribute("PathId")
	if prompt == nil or typeof(pathId) ~= "string" then
		return
	end
	prompt.Triggered:Connect(function(player)
		pledge(player, pathId :: Types.PathId)
	end)
end

function PathService.Init()
	teams[WANDERER_TEAM] = ensureTeam(WANDERER_TEAM, WANDERER_COLOR, true)
	for id, def in Paths do
		teams[id] = ensureTeam(def.name, def.teamBrickColor, false)
	end

	DataService.ObserveLoaded(syncTeam)

	for _, shrine in CollectionService:GetTagged("PathShrine") do
		bindShrine(shrine)
	end
	CollectionService:GetInstanceAddedSignal("PathShrine"):Connect(bindShrine)
end

return PathService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">PlayerLifecycle</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > PlayerLifecycle
-- Owns the join/leave path. Every per-player Trove is created here and
-- cleaned here, so other systems can register per-player setup without each
-- reimplementing PlayerAdded/PlayerRemoving bookkeeping.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Trove = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Trove"))

local PlayerLifecycle = {}

local playerTroves: { [Player]: Trove.Trove } = {}

-- Other systems call this to get a Trove that is cleaned when the player leaves.
function PlayerLifecycle.GetTrove(player: Player): Trove.Trove?
	return playerTroves[player]
end

local function onPlayerAdded(player: Player)
	playerTroves[player] = Trove.new()
end

local function onPlayerRemoving(player: Player)
	local trove = playerTroves[player]
	if trove then
		playerTroves[player] = nil
		trove:Clean()
	end
end

function PlayerLifecycle.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Players who joined before this system initialized (Studio test edge case).
	for _, player in Players:GetPlayers() do
		local existing: Trove.Trove? = playerTroves[player]
		if existing == nil then
			onPlayerAdded(player)
		end
	end
end

return PlayerLifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">QiSystem</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > QiSystem
-- The energy loop: qi regeneration, meditation, cultivation experience and
-- realm breakthroughs. Server-authoritative; the client only ever ASKS to
-- meditate and is TOLD its qi.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local StatCalc = require(Shared:WaitForChild("StatCalc"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))

local DataService = require(script.Parent.DataService)

local QiSystem = {}

local techniqueVFX = Net.remoteEvent("TechniqueVFX")

function QiSystem.MaxQi(player: Player): number
	local data = DataService.Get(player)
	if data == nil then
		return 0
	end
	local realm = Realms[data.realm] or Realms[1]
	local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)
	return math.floor(realm.maxQi * mods.maxQiMult + 0.5)
end

-- Deduct qi if the player has enough. The single gate every technique,
-- craft or art pays through.
function QiSystem.Spend(player: Player, amount: number): boolean
	local data = DataService.Get(player)
	if data == nil then
		return false
	end
	if data.qi < amount then
		return false
	end
	data.qi -= amount
	DataService.PushStats(player)
	return true
end

function QiSystem.AddXp(player: Player, amount: number)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)
	data.cultivationXp += math.floor(amount * mods.xpMult + 0.5)
	QiSystem.CheckBreakthrough(player)
end

function QiSystem.CheckBreakthrough(player: Player)
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	local realm = Realms[data.realm]
	if realm == nil or data.realm >= #Realms then
		return
	end
	if data.cultivationXp < realm.breakthroughXp then
		return
	end

	data.cultivationXp -= realm.breakthroughXp
	data.realm += 1
	data.qi = QiSystem.MaxQi(player)
	data.raceSpins += Config.BREAKTHROUGH_RACE_SPINS
	data.talentSpins += Config.BREAKTHROUGH_TALENT_SPINS

	local newRealm = Realms[data.realm]
	DataService.Notify(player, `Breakthrough! You have entered {newRealm.name}.`, Color3.fromRGB(255, 215, 120))
	DataService.Notify(player, `The heavens grant destiny: +{Config.BREAKTHROUGH_RACE_SPINS} race spins, +{Config.BREAKTHROUGH_TALENT_SPINS} talent spins.`)

	-- Golden pillar for everyone nearby.
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		techniqueVFX:FireAllClients({
			kind = "breakthrough",
			casterUserId = player.UserId,
			origin = root.Position,
		})
	end

	DataService.PushStats(player)
	DataService.PushDestiny(player)
end

function QiSystem.Init()
	local meditateSet = Net.remoteEvent("MeditateSet")
	meditateSet.OnServerEvent:Connect(function(player, wants: unknown)
		DataService.SetMeditating(player, wants == true)
		DataService.PushStats(player)
	end)
end

function QiSystem.Start()
	while true do
		task.wait(Config.QI_TICK_SECONDS)
		for _, player in Players:GetPlayers() do
			local data = DataService.Get(player)
			if data == nil then
				continue
			end
			local realm = Realms[data.realm] or Realms[1]
			local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)
			local maxQi = math.floor(realm.maxQi * mods.maxQiMult + 0.5)

			local meditating = DataService.IsMeditating(player)
			if meditating then
				-- Standing up or walking ends meditation without a click.
				local character = player.Character
				local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
				if humanoid == nil or humanoid.MoveDirection.Magnitude > 0.05 or humanoid.Health <= 0 then
					meditating = false
					DataService.SetMeditating(player, false)
				end
			end

			local regen = realm.qiRegen * mods.qiRegenMult
			if meditating then
				regen *= realm.meditateMult
			end

			local changed = false
			if data.qi < maxQi then
				data.qi = math.min(maxQi, data.qi + regen)
				changed = true
			elseif data.qi > maxQi then
				data.qi = maxQi
				changed = true
			end

			if meditating then
				data.cultivationXp += math.floor(realm.meditateXp * mods.xpMult + 0.5)
				changed = true
				QiSystem.CheckBreakthrough(player)
			end

			if changed then
				DataService.PushStats(player)
			end
		end
	end
end

return QiSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TechniqueService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > TechniqueService
-- Player-authored cultivation techniques: creation, hotbar slots, and
-- server-authoritative casting. The client only sends intent (slot + aim
-- point); every number — cost, cooldown, damage, reach — is recomputed here
-- from the stored design, so a modified client gains nothing.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local StatCalc = require(Shared:WaitForChild("StatCalc"))
local TechniqueMath = require(Shared:WaitForChild("TechniqueMath"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))
local Forms = require(Shared:WaitForChild("Data"):WaitForChild("TechniqueForms"))
local Elements = require(Shared:WaitForChild("Data"):WaitForChild("Elements"))
local Items = require(Shared:WaitForChild("Data"):WaitForChild("Items"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))

local DataService = require(script.Parent.DataService)
local QiSystem = require(script.Parent.QiSystem)
local CombatService = require(script.Parent.CombatService)

local TechniqueService = {}

local techniqueVFX = Net.remoteEvent("TechniqueVFX")

local castLimit = RateLimit.new(10, 1)
local editLimit = RateLimit.new(6, 5)

-- [userId][techniqueId] = os.clock() when ready again
local cooldowns: { [number]: { [string]: number } } = {}

-- ------------------------------ Helpers --------------------------------

local function fail(message: string): { ok: boolean, error: string }
	return { ok = false, error = message }
end

local function findTechnique(data: Types.PlayerData, id: string): Types.Technique?
	for _, technique in data.techniques do
		if technique.id == id then
			return technique
		end
	end
	return nil
end

local function filterName(raw: string, userId: number): string
	local filtered = raw
	local ok, result = pcall(function()
		local obj = TextService:FilterStringAsync(raw, userId)
		return obj:GetNonChatStringForBroadcastAsync()
	end)
	if ok and typeof(result) == "string" then
		filtered = result
	end
	return filtered
end

local function validVector(v: unknown): Vector3?
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local vec = v :: Vector3
	if vec.X ~= vec.X or vec.Y ~= vec.Y or vec.Z ~= vec.Z then
		return nil
	end
	if math.abs(vec.X) > 1e5 or math.abs(vec.Y) > 1e5 or math.abs(vec.Z) > 1e5 then
		return nil
	end
	return vec
end

local function characterParts(player: Player): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if character == nil then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root == nil or not root:IsA("BasePart") or humanoid == nil or humanoid.Health <= 0 then
		return character, nil, nil
	end
	return character, root, humanoid
end

local function humanoidFromPart(part: BasePart): Humanoid?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- --------------------------- Creation / slots ---------------------------

local function createTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local formId = request.form
	local elementId = request.element
	local power = request.power
	local name = request.name
	if typeof(formId) ~= "string" or typeof(elementId) ~= "string" or typeof(power) ~= "number" or typeof(name) ~= "string" then
		return fail("Bad request")
	end

	if #data.techniques >= Config.MAX_TECHNIQUES then
		return fail(`You can hold {Config.MAX_TECHNIQUES} techniques. Discard one first.`)
	end

	local stats, reason = TechniqueMath.compute(formId, elementId, power)
	if stats == nil then
		return fail(reason or "Invalid design")
	end
	if data.realm < stats.requiredRealm then
		local needed = Realms[stats.requiredRealm]
		return fail(`A design of that power needs {needed.name}.`)
	end

	local element = Elements.get(elementId)
	if element == nil then
		return fail("Unknown element")
	end
	if not StatCalc.elementAllowed(element.path, data.path, data.race, elementId) then
		return fail(`{element.name} is closed to you. It answers a path or a bloodline you do not hold.`)
	end

	if data.spiritStones < stats.createCost then
		return fail(`Designing this needs {stats.createCost} spirit stones.`)
	end

	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	if #name < 1 or #name > Config.MAX_TECHNIQUE_NAME then
		return fail(`Name must be 1 to {Config.MAX_TECHNIQUE_NAME} characters.`)
	end
	name = filterName(name, player.UserId)

	data.spiritStones -= stats.createCost
	local technique: Types.Technique = {
		id = HttpService:GenerateGUID(false),
		name = name,
		form = formId,
		element = elementId,
		power = math.floor(power),
	}
	table.insert(data.techniques, technique)

	-- Auto-slot into the first free key so the technique is usable at once.
	for slot = 1, Config.SLOT_COUNT do
		if data.slots[tostring(slot)] == nil then
			data.slots[tostring(slot)] = technique.id
			break
		end
	end

	DataService.PushStats(player)
	DataService.PushInventory(player)
	DataService.PushTechniques(player)
	return { ok = true, technique = technique }
end

local function deleteTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local id = (payload :: { [string]: unknown }).id
	if typeof(id) ~= "string" then
		return fail("Bad request")
	end
	for index, technique in data.techniques do
		if technique.id == id then
			table.remove(data.techniques, index)
			for slot, slotted in data.slots do
				if slotted == id then
					data.slots[slot] = nil
				end
			end
			DataService.PushTechniques(player)
			return { ok = true }
		end
	end
	return fail("No such technique")
end

local function equipTechnique(player: Player, payload: unknown): { [string]: any }
	if not editLimit:Allow(player.UserId) then
		return fail("Too many requests")
	end
	local data = DataService.Get(player)
	if data == nil then
		return fail("Data not loaded yet")
	end
	if typeof(payload) ~= "table" then
		return fail("Bad request")
	end
	local request = payload :: { [string]: unknown }
	local slot = request.slot
	local id = request.id
	if typeof(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > Config.SLOT_COUNT then
		return fail("Bad slot")
	end
	if id ~= nil and typeof(id) ~= "string" then
		return fail("Bad request")
	end
	if id ~= nil then
		if findTechnique(data, id :: string) == nil then
			return fail("No such technique")
		end
		-- One technique occupies one slot; clear it from any other.
		for existingSlot, slotted in data.slots do
			if slotted == id then
				data.slots[existingSlot] = nil
			end
		end
		data.slots[tostring(slot)] = id :: string
	else
		data.slots[tostring(slot)] = nil
	end
	DataService.PushTechniques(player)
	return { ok = true }
end

-- ------------------------------- Casting --------------------------------

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function damageInBox(caster: Player, cframe: CFrame, size: Vector3, damage: number, elementId: string, direction: Vector3)
	local character = caster.Character
	overlapParams.FilterDescendantsInstances = if character then { character } else {}
	local seen: { [Humanoid]: boolean } = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, overlapParams) do
		local humanoid = humanoidFromPart(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			CombatService.DealDamage(caster, humanoid, damage, elementId, direction)
		end
	end
end

local function damageInSphere(caster: Player, center: Vector3, radius: number, damage: number, elementId: string)
	local character = caster.Character
	overlapParams.FilterDescendantsInstances = if character then { character } else {}
	local seen: { [Humanoid]: boolean } = {}
	for _, part in workspace:GetPartBoundsInRadius(center, radius, overlapParams) do
		local humanoid = humanoidFromPart(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			local root = part
			local away = (root.Position - center)
			local direction = if away.Magnitude > 0.01 then away else Vector3.new(0, 1, 0)
			CombatService.DealDamage(caster, humanoid, damage, elementId, direction)
		end
	end
end

local function runProjectile(caster: Player, origin: Vector3, direction: Vector3, speed: number, range: number, pierce: boolean, damage: number, elementId: string)
	task.spawn(function()
		local character = caster.Character
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = if character then { character } else {}

		local position = origin
		local traveled = 0
		local unit = direction.Unit
		local hitHumanoids: { [Humanoid]: boolean } = {}

		while traveled < range do
			local dt = task.wait()
			local step = math.min(speed * dt, range - traveled)
			local result = workspace:Raycast(position, unit * step, rayParams)
			if result then
				local humanoid = humanoidFromPart(result.Instance)
				if humanoid and not hitHumanoids[humanoid] then
					hitHumanoids[humanoid] = true
					CombatService.DealDamage(caster, humanoid, damage, elementId, unit)
					if not pierce then
						return
					end
					-- Pass through this body: exclude its whole model and re-step.
					local model = result.Instance:FindFirstAncestorOfClass("Model")
					if model then
						local filter = rayParams.FilterDescendantsInstances
						table.insert(filter, model)
						rayParams.FilterDescendantsInstances = filter
					end
				elseif humanoid == nil then
					return -- terrain, wall, anything solid that isn't a body
				end
			end
			position += unit * step
			traveled += step
		end
	end)
end

local function castTechnique(player: Player, slotArg: unknown, aimArg: unknown)
	if not castLimit:Allow(player.UserId) then
		return
	end
	local data = DataService.Get(player)
	if data == nil then
		return
	end
	if typeof(slotArg) ~= "number" or slotArg % 1 ~= 0 or slotArg < 1 or slotArg > Config.SLOT_COUNT then
		return
	end
	local techniqueId = data.slots[tostring(slotArg)]
	if techniqueId == nil then
		return
	end
	local technique = findTechnique(data, techniqueId)
	if technique == nil then
		return
	end
	local form = Forms.get(technique.form)
	local element = Elements.get(technique.element)
	if form == nil or element == nil then
		return
	end

	local character, root, humanoid = characterParts(player)
	if character == nil or root == nil or humanoid == nil then
		return
	end

	local stats = (TechniqueMath.compute(technique.form, technique.element, technique.power))
	if stats == nil then
		return
	end
	if data.realm < stats.requiredRealm then
		DataService.Notify(player, "Your realm is too shallow for this technique.")
		return
	end
	-- Race/path can change after creation; the element must still answer you.
	if not StatCalc.elementAllowed(element.path, data.path, data.race, element.id) then
		DataService.Notify(player, `{element.name} no longer answers you.`)
		return
	end

	-- Weapon gate: sword/blade/bow techniques need that weapon in hand.
	local weaponMult = 1
	if form.category ~= "movement" then
		local weaponId = data.equippedWeapon
		local weapon = if weaponId then Items.get(weaponId) else nil
		if weapon == nil or weapon.category ~= form.category then
			DataService.Notify(player, `You need a {form.category} equipped to cast this.`)
			return
		end
		weaponMult = weapon.damageMult
	end

	local mods = StatCalc.combine(data.path, data.race, data.equippedTalents)

	-- Cooldown
	local userCooldowns = cooldowns[player.UserId]
	if userCooldowns == nil then
		userCooldowns = {}
		cooldowns[player.UserId] = userCooldowns
	end
	local now = os.clock()
	local readyAt = userCooldowns[technique.id]
	if readyAt and now < readyAt then
		return
	end

	-- Qi
	local qiCost = math.max(1, math.floor(stats.qiCost * mods.qiCostMult + 0.5))
	if not QiSystem.Spend(player, qiCost) then
		DataService.Notify(player, "Not enough qi.")
		return
	end
	userCooldowns[technique.id] = now + stats.cooldown * mods.cooldownMult
	DataService.SetMeditating(player, false)

	-- Aim
	local aim = validVector(aimArg) or (root.Position + root.CFrame.LookVector * 10)
	local flatAim = Vector3.new(aim.X, root.Position.Y, aim.Z)
	local aimDelta = flatAim - root.Position
	local direction = if aimDelta.Magnitude > 0.5 then aimDelta.Unit else root.CFrame.LookVector

	local damage = stats.damage
		* mods.damageMult
		* (mods.categoryDamage[form.category] or 1)
		* (mods.elementDamage[element.id] or 1)
		* weaponMult

	-- Execute by kind. Movement application happens on the caster's client
	-- (it owns its character's physics); everything else resolves here.
	local kind = form.kind
	if kind == "melee" then
		local hitCFrame = CFrame.lookAt(root.Position, root.Position + direction) * CFrame.new(0, 0, -stats.range / 2)
		damageInBox(player, hitCFrame, Vector3.new(stats.range * 0.9, 6, stats.range), damage, element.id, direction)
	elseif kind == "projectile" then
		runProjectile(player, root.Position + direction * 2, direction, stats.speed, stats.range, form.pierce, damage, element.id)
	elseif kind == "aoe_point" then
		local target = aim
		local offset = target - root.Position
		if offset.Magnitude > stats.range then
			target = root.Position + offset.Unit * stats.range
		end
		task.delay(0.35, damageInSphere, player, target, stats.radius, damage, element.id)
	elseif kind == "aoe_self" then
		damageInSphere(player, root.Position, stats.radius, damage, element.id)
	elseif kind == "teleport" then
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = { character }
		local distance = stats.range
		local blocked = workspace:Raycast(root.Position, direction * distance, rayParams)
		if blocked then
			distance = math.max(0, (blocked.Position - root.Position).Magnitude - 3)
		end
		root.CFrame = CFrame.lookAt(root.Position + direction * distance, root.Position + direction * (distance + 10))
	end
	-- dash / leap / speed_buff: applied by the caster's client on the VFX
	-- event below; the qi price and cooldown were already paid here.

	if kind == "speed_buff" then
		task.spawn(function()
			humanoid.WalkSpeed += stats.speed
			task.wait(stats.duration)
			CombatService.RefreshMods(player)
		end)
	end

	-- Practicing an art tempers the practitioner.
	QiSystem.AddXp(player, 1 + technique.power)

	techniqueVFX:FireAllClients({
		kind = "cast",
		casterUserId = player.UserId,
		form = form.id,
		formKind = form.kind,
		element = element.id,
		power = technique.power,
		origin = root.Position,
		direction = direction,
		aim = aim,
		range = stats.range,
		speed = stats.speed,
		radius = stats.radius,
	})
end

-- ------------------------------ Lifecycle -------------------------------

function TechniqueService.Init()
	Net.remoteFunction("CreateTechnique").OnServerInvoke = createTechnique
	Net.remoteFunction("DeleteTechnique").OnServerInvoke = deleteTechnique
	Net.remoteFunction("EquipTechnique").OnServerInvoke = equipTechnique
	Net.remoteEvent("CastTechnique").OnServerEvent:Connect(castTechnique)

	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player.UserId] = nil
		castLimit:Forget(player.UserId)
		editLimit:Forget(player.UserId)
	end)
end

return TechniqueService
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="31">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">BuildKit</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > BuildKit
-- Part-factory helpers for the programmatic map. Everything the world
-- builders stamp out flows through here so geometry defaults (anchored,
-- named, parented) stay consistent.

local CollectionService = game:GetService("CollectionService")

local BuildKit = {}

export type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame?,
	position: Vector3?,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	shape: Enum.PartType?,
	parent: Instance,
}

function BuildKit.part(props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.name or "Part"
	part.Size = props.size
	if props.cframe then
		part.CFrame = props.cframe
	elseif props.position then
		part.Position = props.position
	end
	part.Color = props.color or Color3.fromRGB(163, 162, 165)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.CanCollide = if props.canCollide == nil then true else props.canCollide
	if props.shape then
		part.Shape = props.shape
	end
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = props.parent
	return part
end

-- Axis-aligned box by center.
function BuildKit.box(parent: Instance, name: string, center: Vector3, size: Vector3, color: Color3, material: Enum.Material): Part
	return BuildKit.part({
		name = name,
		size = size,
		position = center,
		color = color,
		material = material,
		parent = parent,
	})
end

-- A wall running along the X axis at depth z, from x1 to x2, with an
-- optional doorway gap (gapCenter/gapWidth in X). Returns the segments.
function BuildKit.wallX(parent: Instance, name: string, z: number, x1: number, x2: number, yBottom: number, height: number, thickness: number, color: Color3, material: Enum.Material, gapCenter: number?, gapWidth: number?)
	local yMid = yBottom + height / 2
	local function segment(fromX: number, toX: number)
		if toX - fromX < 0.5 then
			return
		end
		BuildKit.part({
			name = name,
			size = Vector3.new(toX - fromX, height, thickness),
			position = Vector3.new((fromX + toX) / 2, yMid, z),
			color = color,
			material = material,
			parent = parent,
		})
	end
	if gapCenter and gapWidth then
		segment(x1, gapCenter - gapWidth / 2)
		segment(gapCenter + gapWidth / 2, x2)
	else
		segment(x1, x2)
	end
end

-- Same, running along the Z axis at x.
function BuildKit.wallZ(parent: Instance, name: string, x: number, z1: number, z2: number, yBottom: number, height: number, thickness: number, color: Color3, material: Enum.Material, gapCenter: number?, gapWidth: number?)
	local yMid = yBottom + height / 2
	local function segment(fromZ: number, toZ: number)
		if toZ - fromZ < 0.5 then
			return
		end
		BuildKit.part({
			name = name,
			size = Vector3.new(thickness, height, toZ - fromZ),
			position = Vector3.new(x, yMid, (fromZ + toZ) / 2),
			color = color,
			material = material,
			parent = parent,
		})
	end
	if gapCenter and gapWidth then
		segment(z1, gapCenter - gapWidth / 2)
		segment(gapCenter + gapWidth / 2, z2)
	else
		segment(z1, z2)
	end
end

function BuildKit.wedgePart(props: PartProps): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = props.name or "Wedge"
	wedge.Size = props.size
	if props.cframe then
		wedge.CFrame = props.cframe
	elseif props.position then
		wedge.Position = props.position
	end
	wedge.Color = props.color or Color3.fromRGB(163, 162, 165)
	wedge.Material = props.material or Enum.Material.SmoothPlastic
	wedge.Transparency = props.transparency or 0
	wedge.CanCollide = if props.canCollide == nil then true else props.canCollide
	wedge.Anchored = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = props.parent
	return wedge
end

-- A Chinese tiled roof layer: flat cap plus four outward-sloping eave
-- wedges hanging past the walls. `y` is the underside of the roof.
function BuildKit.chineseRoof(parent: Instance, center: Vector3, width: number, depth: number, y: number, roofColor: Color3)
	local overhang = 3.5
	local capW = width + overhang * 2
	local capD = depth + overhang * 2
	BuildKit.part({
		name = "Roof_Cap",
		size = Vector3.new(capW, 1, capD),
		position = Vector3.new(center.X, y + 0.5, center.Z),
		color = roofColor,
		material = Enum.Material.Slate,
		parent = parent,
	})
	-- Eaves on each side, sloping down and out.
	local eaveH = 1.8
	local sides = {
		{ dir = Vector3.new(0, 0, 1), len = capW },
		{ dir = Vector3.new(0, 0, -1), len = capW },
		{ dir = Vector3.new(1, 0, 0), len = capD },
		{ dir = Vector3.new(-1, 0, 0), len = capD },
	}
	for _, side in sides do
		local edge = Vector3.new(center.X, y + 0.4, center.Z)
			+ side.dir * (if side.dir.Z ~= 0 then capD / 2 + 1.4 else capW / 2 + 1.4)
		BuildKit.wedgePart({
			name = "Roof_Eave",
			size = Vector3.new(side.len + 2, eaveH, 3),
			cframe = CFrame.lookAt(edge, edge + side.dir) * CFrame.Angles(0, math.pi, 0),
			color = roofColor,
			material = Enum.Material.Slate,
			canCollide = false,
			parent = parent,
		})
	end
	-- Ridge beam along the longer axis.
	local ridgeAlongX = width >= depth
	BuildKit.part({
		name = "Roof_Ridge",
		size = if ridgeAlongX then Vector3.new(width * 0.7, 1, 1.6) else Vector3.new(1.6, 1, depth * 0.7),
		position = Vector3.new(center.X, y + 1.4, center.Z),
		color = roofColor,
		material = Enum.Material.Slate,
		parent = parent,
	})
end

-- A multi-story pagoda-style house: plaster walls, timber corner posts,
-- a tiled roof over every floor, each floor slightly narrower.
function BuildKit.pagodaHouse(parent: Instance, center: Vector3, width: number, depth: number, floors: number, plaster: Color3, timber: Color3, roofColor: Color3)
	local floorHeight = 9
	local y = center.Y
	local w, d = width, depth
	for _ = 1, floors do
		BuildKit.part({
			name = "House_Wall",
			size = Vector3.new(w, floorHeight, d),
			position = Vector3.new(center.X, y + floorHeight / 2, center.Z),
			color = plaster,
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		for cx = -1, 1, 2 do
			for cz = -1, 1, 2 do
				BuildKit.part({
					name = "House_Post",
					size = Vector3.new(1.2, floorHeight, 1.2),
					position = Vector3.new(center.X + cx * (w / 2), y + floorHeight / 2, center.Z + cz * (d / 2)),
					color = timber,
					material = Enum.Material.Wood,
					parent = parent,
				})
			end
		end
		BuildKit.chineseRoof(parent, Vector3.new(center.X, 0, center.Z), w, d, y + floorHeight, roofColor)
		y += floorHeight + 1.4
		w *= 0.78
		d *= 0.78
	end
	-- Finial at the peak.
	BuildKit.part({
		name = "House_Finial",
		size = Vector3.new(0.9, 2.4, 0.9),
		position = Vector3.new(center.X, y + 1.2, center.Z),
		color = Color3.fromRGB(212, 175, 55),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = parent,
	})
end

-- A paifang: the ceremonial gate arch that marks a Chinese city entrance.
-- Returns the signboard part so callers can hang a label on it.
function BuildKit.paifang(parent: Instance, center: Vector3, facing: Vector3, width: number, timber: Color3, roofColor: Color3): Part
	local side = Vector3.new(-facing.Z, 0, facing.X)
	local pillarHeight = 17
	for s = -1, 1, 2 do
		BuildKit.part({
			name = "Paifang_Pillar",
			size = Vector3.new(2, pillarHeight, 2),
			position = center + side * (s * width / 2) + Vector3.new(0, pillarHeight / 2, 0),
			color = timber,
			material = Enum.Material.Wood,
			parent = parent,
		})
	end
	local lintelCF = CFrame.lookAt(center + Vector3.new(0, pillarHeight - 1, 0), center + Vector3.new(0, pillarHeight - 1, 0) + facing)
	BuildKit.part({
		name = "Paifang_Lintel",
		size = Vector3.new(width + 5, 1.6, 2.4),
		cframe = lintelCF,
		color = timber,
		material = Enum.Material.Wood,
		parent = parent,
	})
	local sign = BuildKit.part({
		name = "Paifang_Sign",
		size = Vector3.new(width * 0.55, 3, 1.2),
		cframe = lintelCF * CFrame.new(0, 2.4, 0),
		color = Color3.fromRGB(32, 28, 26),
		material = Enum.Material.Wood,
		parent = parent,
	})
	-- Little roof riding the top.
	local roofCenter = center + Vector3.new(0, 0, 0)
	BuildKit.chineseRoof(parent, roofCenter, width * 0.7, 4, pillarHeight + 3.2, roofColor)
	return sign
end

-- An open pavilion: four posts and a tiered roof, no walls. Shelters shrines.
function BuildKit.pavilion(parent: Instance, center: Vector3, size: number, timber: Color3, roofColor: Color3)
	local postHeight = 13
	for cx = -1, 1, 2 do
		for cz = -1, 1, 2 do
			BuildKit.part({
				name = "Pavilion_Post",
				size = Vector3.new(1.4, postHeight, 1.4),
				position = center + Vector3.new(cx * size / 2, postHeight / 2, cz * size / 2),
				color = timber,
				material = Enum.Material.Wood,
				parent = parent,
			})
		end
	end
	BuildKit.chineseRoof(parent, Vector3.new(center.X, 0, center.Z), size + 2, size + 2, center.Y + postHeight, roofColor)
	BuildKit.chineseRoof(parent, Vector3.new(center.X, 0, center.Z), size * 0.5, size * 0.5, center.Y + postHeight + 3.4, roofColor)
end

-- Vertical-axis cylinder (Roblox cylinders lie along local X; we stand it up).
function BuildKit.cylinder(parent: Instance, name: string, center: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material): Part
	return BuildKit.part({
		name = name,
		size = Vector3.new(height, diameter, diameter),
		cframe = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		color = color,
		material = material,
		shape = Enum.PartType.Cylinder,
		parent = parent,
	})
end

function BuildKit.billboard(adornee: BasePart, text: string, color: Color3, width: number, height: number, studsOffset: Vector3?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffset = studsOffset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 220
	gui.Adornee = adornee
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextScaled = true
	label.Font = Enum.Font.Garamond
	label.Parent = gui
end

function BuildKit.prompt(parent: BasePart, actionText: string, objectText: string, holdDuration: number, tag: string?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	if tag then
		CollectionService:AddTag(prompt, tag)
	end
	return prompt
end

function BuildKit.pointLight(parent: BasePart, color: Color3, brightness: number, lightRange: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = lightRange
	light.Shadows = false
	light.Parent = parent
end

-- Invisible safe-zone marker; CombatService reads the tag + Radius attribute.
function BuildKit.safeZone(parent: Instance, position: Vector3, radius: number)
	local marker = BuildKit.part({
		name = "SafeZone",
		size = Vector3.new(1, 1, 1),
		position = position,
		transparency = 1,
		canCollide = false,
		parent = parent,
	})
	marker:SetAttribute("Radius", radius)
	CollectionService:AddTag(marker, "SafeZone")
end

function BuildKit.spawnLocation(parent: Instance, position: Vector3, teamColorName: string?, neutral: boolean): SpawnLocation
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(10, 1, 10)
	spawnLoc.Position = position
	spawnLoc.Anchored = true
	spawnLoc.Neutral = neutral
	if teamColorName then
		spawnLoc.TeamColor = (BrickColor.new :: any)(teamColorName)
	end
	spawnLoc.AllowTeamChangeOnTouch = false
	spawnLoc.Duration = 0
	spawnLoc.Material = Enum.Material.Slate
	spawnLoc.Color = Color3.fromRGB(120, 118, 122)
	spawnLoc.Parent = parent
	return spawnLoc
end

-- An anchored training dummy with a Humanoid so techniques have something
-- honest to hit. CombatService keeps it healed.
function BuildKit.trainingDummy(parent: Instance, position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Training Dummy"

	local root = BuildKit.part({
		name = "HumanoidRootPart",
		size = Vector3.new(2.4, 3.6, 1.6),
		position = position + Vector3.new(0, 2.8, 0),
		color = Color3.fromRGB(150, 110, 70),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})
	BuildKit.part({
		name = "Head",
		size = Vector3.new(1.6, 1.6, 1.6),
		position = position + Vector3.new(0, 5.4, 0),
		color = Color3.fromRGB(170, 130, 85),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})
	BuildKit.part({
		name = "Base",
		size = Vector3.new(4, 1, 4),
		position = position + Vector3.new(0, 0.5, 0),
		color = Color3.fromRGB(110, 85, 55),
		material = Enum.Material.WoodPlanks,
		parent = model,
	})

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 250
	humanoid.Health = 250
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model

	model.PrimaryPart = root
	CollectionService:AddTag(model, "TrainingDummy")
	BuildKit.billboard(root, "Training Dummy", Color3.fromRGB(230, 220, 200), 8, 1.4, Vector3.new(0, 4.6, 0))
	model.Parent = parent
	return model
end

-- An ore node: rock base plus glowing crystals. MiningService binds the tag.
function BuildKit.oreNode(parent: Instance, position: Vector3, oreId: string, oreName: string, color: Color3): Model
	local model = Instance.new("Model")
	model.Name = "OreNode_" .. oreId

	local rock = BuildKit.part({
		name = "Rock",
		size = Vector3.new(4.5, 3, 4.5),
		cframe = CFrame.new(position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, (position.X + position.Z) % 3, 0),
		color = Color3.fromRGB(88, 86, 92),
		material = Enum.Material.Slate,
		parent = model,
	})

	for i = 1, 3 do
		local angle = i * (math.pi * 2 / 3) + position.X
		BuildKit.part({
			name = "Crystal",
			size = Vector3.new(1.1, 2.2 - (i % 2) * 0.6, 1.1),
			cframe = CFrame.new(position + Vector3.new(math.cos(angle) * 1.3, 2.8, math.sin(angle) * 1.3))
				* CFrame.Angles(math.rad(15 * i), angle, math.rad(-10 * i)),
			color = color,
			material = Enum.Material.Neon,
			canCollide = false,
			parent = model,
		})
	end

	model.PrimaryPart = rock
	model:SetAttribute("OreId", oreId)
	BuildKit.prompt(rock, "Mine", oreName, 1.5, nil)
	CollectionService:AddTag(model, "OreNode")
	model.Parent = parent
	return model
end

return BuildKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Cities</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Cities
-- The three path cities, ringed around Heavenpillar Mountain: White Cloud
-- City (orthodox, north), Freewind City (unorthodox, southeast), Blackfire
-- City (demonic, southwest). Each is a walled plaza with a pledge shrine,
-- team spawn, homes, lanterns and training dummies outside the gate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Paths = require(Shared:WaitForChild("Data"):WaitForChild("Paths"))

local BuildKit = require(script.Parent.BuildKit)

local Cities = {}

local CITY_RADIUS = 380
local PLAZA = 150 -- plaza edge length
local WALL_HEIGHT = 20
local WALL_THICKNESS = 4
local GATE_WIDTH = 30

local PLASTER = Color3.fromRGB(238, 231, 214)
local TIMBER = Color3.fromRGB(74, 53, 39)

-- Dark tiled roofs, tinted per path so each city reads at a glance.
local ROOF_COLORS: { [string]: Color3 } = {
	orthodox = Color3.fromRGB(58, 74, 92),
	unorthodox = Color3.fromRGB(52, 73, 59),
	demonic = Color3.fromRGB(38, 30, 32),
}

type CitySpec = {
	pathId: string,
	angle: number, -- degrees around the mountain, 0 = +Z (south)
}

local SPECS: { CitySpec } = {
	{ pathId = "orthodox", angle = 180 }, -- north
	{ pathId = "unorthodox", angle = 60 }, -- southeast
	{ pathId = "demonic", angle = -60 }, -- southwest
}

local function buildCity(parent: Instance, spec: CitySpec)
	local path = Paths[spec.pathId]
	local rad = math.rad(spec.angle)
	local center = Vector3.new(math.sin(rad) * CITY_RADIUS, 0, math.cos(rad) * CITY_RADIUS)
	-- The gate faces the mountain (map origin).
	local toMountain = (Vector3.zero - center) * Vector3.new(1, 0, 1)
	local gateDir = toMountain.Unit

	local city = Instance.new("Folder")
	city.Name = path.cityName:gsub(" ", "")
	city.Parent = parent

	local stone = path.primaryColor
	local accent = path.accentColor
	local roofColor = ROOF_COLORS[spec.pathId] or Color3.fromRGB(45, 42, 44)
	local half = PLAZA / 2

	-- Plaza floor.
	BuildKit.part({
		name = "Plaza",
		size = Vector3.new(PLAZA, 1, PLAZA),
		position = center + Vector3.new(0, 0.5, 0),
		color = stone,
		material = Enum.Material.Cobblestone,
		parent = city,
	})

	-- Walls with a gate on the mountain-facing side. Cities are axis-
	-- aligned; the gate goes in whichever wall faces the mountain most.
	local north = center.Z - half
	local south = center.Z + half
	local west = center.X - half
	local east = center.X + half
	local gateOnZ = math.abs(gateDir.Z) >= math.abs(gateDir.X)
	local gateNorth = gateOnZ and gateDir.Z < 0
	local gateSouth = gateOnZ and gateDir.Z >= 0
	local gateWest = not gateOnZ and gateDir.X < 0
	local gateEast = not gateOnZ and gateDir.X >= 0

	BuildKit.wallX(city, "Wall_N", north, west, east, 0, WALL_HEIGHT, WALL_THICKNESS, stone, Enum.Material.Slate,
		if gateNorth then center.X else nil, if gateNorth then GATE_WIDTH else nil)
	BuildKit.wallX(city, "Wall_S", south, west, east, 0, WALL_HEIGHT, WALL_THICKNESS, stone, Enum.Material.Slate,
		if gateSouth then center.X else nil, if gateSouth then GATE_WIDTH else nil)
	BuildKit.wallZ(city, "Wall_W", west, north, south, 0, WALL_HEIGHT, WALL_THICKNESS, stone, Enum.Material.Slate,
		if gateWest then center.Z else nil, if gateWest then GATE_WIDTH else nil)
	BuildKit.wallZ(city, "Wall_E", east, north, south, 0, WALL_HEIGHT, WALL_THICKNESS, stone, Enum.Material.Slate,
		if gateEast then center.Z else nil, if gateEast then GATE_WIDTH else nil)

	-- Tiled coping caps the walls, with the same gate gaps.
	BuildKit.wallX(city, "Coping_N", north, west - 1, east + 1, WALL_HEIGHT, 1.4, WALL_THICKNESS + 3, roofColor, Enum.Material.Slate,
		if gateNorth then center.X else nil, if gateNorth then GATE_WIDTH else nil)
	BuildKit.wallX(city, "Coping_S", south, west - 1, east + 1, WALL_HEIGHT, 1.4, WALL_THICKNESS + 3, roofColor, Enum.Material.Slate,
		if gateSouth then center.X else nil, if gateSouth then GATE_WIDTH else nil)
	BuildKit.wallZ(city, "Coping_W", west, north - 1, south + 1, WALL_HEIGHT, 1.4, WALL_THICKNESS + 3, roofColor, Enum.Material.Slate,
		if gateWest then center.Z else nil, if gateWest then GATE_WIDTH else nil)
	BuildKit.wallZ(city, "Coping_E", east, north - 1, south + 1, WALL_HEIGHT, 1.4, WALL_THICKNESS + 3, roofColor, Enum.Material.Slate,
		if gateEast then center.Z else nil, if gateEast then GATE_WIDTH else nil)

	-- Paifang arch standing just outside the gate opening.
	local gateWallPos: Vector3
	if gateNorth then
		gateWallPos = Vector3.new(center.X, 0, north)
	elseif gateSouth then
		gateWallPos = Vector3.new(center.X, 0, south)
	elseif gateWest then
		gateWallPos = Vector3.new(west, 0, center.Z)
	else
		gateWallPos = Vector3.new(east, 0, center.Z)
	end
	local sign = BuildKit.paifang(city, gateWallPos + gateDir * 12, gateDir, GATE_WIDTH + 6, TIMBER, roofColor)
	BuildKit.billboard(sign, `{path.cityName}\n{path.name}`, accent, 18, 3, Vector3.new(0, 4, 0))

	-- Pledge shrine at the back of the plaza (opposite the gate).
	local shrinePos = center - gateDir * (half * 0.55)
	local dais = BuildKit.cylinder(city, "Shrine_Dais", shrinePos + Vector3.new(0, 1, 0), 2, 22, accent, Enum.Material.Marble)
	local monolith = BuildKit.part({
		name = "Shrine",
		size = Vector3.new(5, 13, 2.5),
		position = shrinePos + Vector3.new(0, 8.5, 0),
		color = stone,
		material = Enum.Material.Marble,
		parent = city,
	})
	monolith:SetAttribute("PathId", spec.pathId)
	CollectionService:AddTag(monolith, "PathShrine")
	BuildKit.prompt(monolith, "Pledge", path.name, 2, nil)
	BuildKit.billboard(monolith, `Shrine of the {path.name}\n"{path.blurb}"`, accent, 22, 3.4, Vector3.new(0, 9, 0))
	BuildKit.pointLight(dais, accent, 2, 30)
	BuildKit.pavilion(city, shrinePos, 18, TIMBER, roofColor)

	-- Team spawn beside the shrine.
	BuildKit.spawnLocation(city, shrinePos + gateDir * 18 + Vector3.new(0, 1, 0), path.teamBrickColor, false)

	-- Pagoda homes in the plaza corners: two-story, tiled, timber-framed.
	for cx = -1, 1, 2 do
		for cz = -1, 1, 2 do
			local homeCenter = center + Vector3.new(cx * half * 0.6, 0, cz * half * 0.6)
			-- Skip the corner the shrine sits nearest.
			if (homeCenter - shrinePos).Magnitude < 30 then
				continue
			end
			BuildKit.pagodaHouse(city, homeCenter, 24, 20, 2, PLASTER, TIMBER, roofColor)
		end
	end
	-- One taller tower opposite the shrine: the sect hall.
	BuildKit.pagodaHouse(city, center + gateDir * (half * 0.28) + Vector3.new(0, 0, 0), 20, 20, 3, PLASTER, TIMBER, roofColor)

	-- Red lanterns at the plaza corners; every Chinese city street has them.
	local lanternRed = Color3.fromRGB(210, 60, 45)
	for cx = -1, 1, 2 do
		for cz = -1, 1, 2 do
			local post = BuildKit.part({
				name = "Lantern",
				size = Vector3.new(1, 11, 1),
				position = center + Vector3.new(cx * (half - 8), 5.5, cz * (half - 8)),
				color = TIMBER,
				material = Enum.Material.Wood,
				parent = city,
			})
			local lamp = BuildKit.part({
				name = "Lantern_Light",
				size = Vector3.new(2.2, 2.8, 2.2),
				position = post.Position + Vector3.new(0, 6.5, 0),
				color = lanternRed,
				material = Enum.Material.Neon,
				canCollide = false,
				parent = city,
			})
			BuildKit.pointLight(lamp, Color3.fromRGB(255, 150, 110), 1.6, 26)
		end
	end

	-- The whole city is sanctuary.
	BuildKit.safeZone(city, center, PLAZA * 0.75)

	-- Training dummies outside the gate, toward the mountain.
	local gatePos = center + gateDir * (half + 14)
	for i = -1, 1 do
		local side = Vector3.new(-gateDir.Z, 0, gateDir.X) -- perpendicular
		BuildKit.trainingDummy(city, gatePos + side * (i * 12) + gateDir * 16)
	end
end

function Cities.build(parent: Instance)
	for _, spec in SPECS do
		buildCity(parent, spec)
	end
end

return Cities
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Overworld</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Overworld
-- The surface: ground plane (with the mine-shaft hole), Heavenpillar
-- Mountain with its climbing ramps and summit platform, the wanderer spawn,
-- scattered blossom trees, and the sky's mood (Atmosphere).

local Lighting = game:GetService("Lighting")

local BuildKit = require(script.Parent.BuildKit)

local Overworld = {}

-- Shared layout constants (Underworld builds against the same hole).
Overworld.GROUND_TOP = 0
Overworld.HOLE = { x1 = -15, x2 = 15, z1 = 240, z2 = 300 } -- mine shaft opening
Overworld.MAP_HALF = 1024

local GROUND_THICKNESS = 16
local GRASS = Color3.fromRGB(96, 140, 84)
local ROCK = Color3.fromRGB(116, 110, 108)
local ROCK_DARK = Color3.fromRGB(92, 88, 90)

local TIERS = {
	{ radius = 220, height = 45 },
	{ radius = 185, height = 45 },
	{ radius = 150, height = 45 },
	{ radius = 115, height = 45 },
	{ radius = 80, height = 45 },
	{ radius = 50, height = 45 },
}

local function buildGround(parent: Instance)
	local hole = Overworld.HOLE
	local half = Overworld.MAP_HALF
	local y = Overworld.GROUND_TOP - GROUND_THICKNESS / 2
	local function slab(name: string, x1: number, x2: number, z1: number, z2: number)
		BuildKit.part({
			name = name,
			size = Vector3.new(x2 - x1, GROUND_THICKNESS, z2 - z1),
			position = Vector3.new((x1 + x2) / 2, y, (z1 + z2) / 2),
			color = GRASS,
			material = Enum.Material.Grass,
			parent = parent,
		})
	end
	-- Four slabs around the mine-shaft hole.
	slab("Ground_North", -half, half, -half, hole.z1)
	slab("Ground_South", -half, half, hole.z2, half)
	slab("Ground_West", -half, hole.x1, hole.z1, hole.z2)
	slab("Ground_East", hole.x2, half, hole.z1, hole.z2)
end

local function buildMountain(parent: Instance)
	local y = Overworld.GROUND_TOP
	for index, tier in TIERS do
		BuildKit.cylinder(
			parent,
			`Mountain_Tier{index}`,
			Vector3.new(0, y + tier.height / 2, 0),
			tier.height,
			tier.radius * 2,
			if index % 2 == 0 then ROCK_DARK else ROCK,
			Enum.Material.Slate
		)
		y += tier.height
	end

	-- Climbing ramps, alternating around the mountain so the ascent is a
	-- walk, not a wall. Ramp i runs from just outside tier i's radius (on
	-- the surface below) up onto tier i's top.
	local base = Overworld.GROUND_TOP
	for index, tier in TIERS do
		local angle = math.rad(150 + index * 137)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local outer = dir * (tier.radius + 24)
		local inner = dir * (tier.radius - 24)
		local from = Vector3.new(outer.X, base, outer.Z)
		local to = Vector3.new(inner.X, base + tier.height, inner.Z)
		local mid = (from + to) / 2
		local length = (to - from).Magnitude + 10
		BuildKit.part({
			name = `Mountain_Ramp{index}`,
			size = Vector3.new(14, 2, length),
			cframe = CFrame.lookAt(mid, to),
			color = ROCK,
			material = Enum.Material.Cobblestone,
			parent = parent,
		})
		base += tier.height
	end

	-- Summit meditation platform.
	local summitY = base
	local disc = BuildKit.cylinder(parent, "Summit_Platform", Vector3.new(0, summitY + 0.5, 0), 1, 60, Color3.fromRGB(210, 205, 190), Enum.Material.Marble)
	BuildKit.billboard(disc, "Summit of Heavenpillar. Meditate here, above the clouds.", Color3.fromRGB(255, 235, 180), 16, 1.6, Vector3.new(0, 8, 0))
	for i = 1, 6 do
		local angle = i * math.pi / 3
		local pillar = BuildKit.part({
			name = "Summit_Pillar",
			size = Vector3.new(2, 9, 2),
			position = Vector3.new(math.cos(angle) * 26, summitY + 4.5, math.sin(angle) * 26),
			color = Color3.fromRGB(190, 60, 55),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		BuildKit.pointLight(pillar, Color3.fromRGB(255, 200, 120), 1.5, 24)
	end
end

local function buildMineEntrance(parent: Instance)
	local hole = Overworld.HOLE
	-- Stone gate arch on the surface at the shaft's north lip.
	local gateZ = hole.z1 - 2
	BuildKit.part({
		name = "MineGate_PillarWest",
		size = Vector3.new(4, 18, 4),
		position = Vector3.new(hole.x1 - 2, 9, gateZ),
		color = ROCK_DARK,
		material = Enum.Material.Slate,
		parent = parent,
	})
	BuildKit.part({
		name = "MineGate_PillarEast",
		size = Vector3.new(4, 18, 4),
		position = Vector3.new(hole.x2 + 2, 9, gateZ),
		color = ROCK_DARK,
		material = Enum.Material.Slate,
		parent = parent,
	})
	local lintel = BuildKit.part({
		name = "MineGate_Lintel",
		size = Vector3.new((hole.x2 - hole.x1) + 12, 4, 5),
		position = Vector3.new(0, 20, gateZ),
		color = ROCK_DARK,
		material = Enum.Material.Slate,
		parent = parent,
	})
	BuildKit.billboard(lintel, "The Deep Mines of Heavenpillar", Color3.fromRGB(190, 220, 255), 14, 1.6, Vector3.new(0, 3, 0))
end

local function buildWandererSpawn(parent: Instance)
	local position = Vector3.new(0, Overworld.GROUND_TOP, 170)
	local plaza = BuildKit.cylinder(parent, "Wanderer_Plaza", position + Vector3.new(0, 0.25, 0), 0.5, 56, Color3.fromRGB(180, 174, 160), Enum.Material.Cobblestone)
	BuildKit.spawnLocation(parent, position + Vector3.new(0, 1, 0), "Medium stone grey", false)
	BuildKit.safeZone(parent, position, 40)
	BuildKit.billboard(plaza, "Wayfarer's Rest. Three cities, three paths. Choose with care; a dao is for life.", Color3.fromRGB(235, 230, 215), 20, 2, Vector3.new(0, 10, 0))
end

-- A soft foliage puff: a part carrying a sphere mesh so it can be scaled
-- into an ellipsoid (Ball-shaped Parts cannot).
local function puff(parent: Instance, position: Vector3, size: Vector3, color: Color3)
	local part = BuildKit.part({
		name = "Foliage",
		size = Vector3.new(1, 1, 1),
		position = position,
		color = color,
		material = Enum.Material.Grass,
		canCollide = false,
		parent = parent,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = size
	mesh.Parent = part
end

local TRUNK = Color3.fromRGB(92, 70, 52)
local PINE_GREEN = Color3.fromRGB(52, 84, 60)
local PINE_DARK = Color3.fromRGB(40, 66, 48)
local BLOSSOM_PINK = Color3.fromRGB(240, 184, 205)
local BLOSSOM_WHITE = Color3.fromRGB(246, 238, 230)
local BAMBOO_GREEN = Color3.fromRGB(126, 168, 92)

-- Ink-painting pine: a leaning trunk with flat, layered canopy discs.
local function pineTree(parent: Instance, position: Vector3, rng: Random)
	local height = rng:NextNumber(14, 22)
	local lean = rng:NextNumber(-0.09, 0.09)
	BuildKit.part({
		name = "Pine_Trunk",
		size = Vector3.new(1.8, height, 1.8),
		cframe = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(lean, 0, lean),
		color = TRUNK,
		material = Enum.Material.Wood,
		parent = parent,
	})
	local layers = rng:NextInteger(3, 4)
	for layer = 1, layers do
		local t = (layer - 1) / layers
		local layerY = position.Y + height * (0.5 + 0.55 * t)
		local diameter = (14 - t * 8) * rng:NextNumber(0.9, 1.15)
		BuildKit.cylinder(
			parent,
			"Pine_Canopy",
			Vector3.new(position.X + lean * height * t * 6, layerY, position.Z + lean * height * t * 6),
			1.4,
			diameter,
			if layer % 2 == 0 then PINE_DARK else PINE_GREEN,
			Enum.Material.Grass
		)
	end
end

-- Blossom tree: leaning trunk, clustered pink and white puffs.
local function blossomTree(parent: Instance, position: Vector3, rng: Random)
	local height = rng:NextNumber(10, 15)
	local lean = rng:NextNumber(-0.14, 0.14)
	BuildKit.part({
		name = "Blossom_Trunk",
		size = Vector3.new(1.6, height, 1.6),
		cframe = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(lean, 0, -lean),
		color = Color3.fromRGB(70, 54, 44),
		material = Enum.Material.Wood,
		parent = parent,
	})
	local crown = position + Vector3.new(lean * height * 4, height, lean * height * 4)
	local puffs = rng:NextInteger(4, 6)
	for _ = 1, puffs do
		local offset = Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(-1, 4), rng:NextNumber(-5, 5))
		local width = rng:NextNumber(6, 10)
		puff(parent, crown + offset, Vector3.new(width, width * 0.65, width),
			if rng:NextNumber() < 0.7 then BLOSSOM_PINK else BLOSSOM_WHITE)
	end
end

-- Bamboo clump: a handful of thin, tall culms with small leaf puffs.
local function bambooClump(parent: Instance, position: Vector3, rng: Random)
	for _ = 1, rng:NextInteger(5, 8) do
		local culmHeight = rng:NextNumber(16, 26)
		local offset = Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
		local base = position + offset
		BuildKit.part({
			name = "Bamboo_Culm",
			size = Vector3.new(0.7, culmHeight, 0.7),
			cframe = CFrame.new(base + Vector3.new(0, culmHeight / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.05, 0.05), 0, rng:NextNumber(-0.05, 0.05)),
			color = BAMBOO_GREEN,
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		puff(parent, base + Vector3.new(0, culmHeight, 0), Vector3.new(4, 2.5, 4), Color3.fromRGB(110, 150, 82))
	end
end

local function buildFlora(parent: Instance)
	local rng = Random.new(7) -- deterministic: same forest every server
	for _ = 1, 70 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(460, 940)
		local position = Vector3.new(math.cos(angle) * radius, Overworld.GROUND_TOP, math.sin(angle) * radius)
		-- Southeast quadrant grows bamboo (Freewind country); elsewhere
		-- pines dominate with blossoms scattered through.
		if position.X > 120 and position.Z > 60 and rng:NextNumber() < 0.5 then
			bambooClump(parent, position, rng)
		elseif rng:NextNumber() < 0.35 then
			blossomTree(parent, position, rng)
		else
			pineTree(parent, position, rng)
		end
	end
	-- A few blossoms right around the Wayfarer's Rest for the first view.
	for _ = 1, 5 do
		local angle = rng:NextNumber(0, math.pi * 2)
		blossomTree(parent, Vector3.new(math.cos(angle) * rng:NextNumber(45, 70), Overworld.GROUND_TOP, 170 + math.sin(angle) * rng:NextNumber(45, 70)), rng)
	end

	-- Boulders, half-set into the grass.
	for _ = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(300, 900)
		local size = rng:NextNumber(3, 9)
		BuildKit.part({
			name = "Boulder",
			size = Vector3.new(size, size * 0.7, size * rng:NextNumber(0.7, 1.3)),
			cframe = CFrame.new(math.cos(angle) * radius, Overworld.GROUND_TOP + size * 0.2, math.sin(angle) * radius)
				* CFrame.Angles(rng:NextNumber(0, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(0, 0.3)),
			color = Color3.fromRGB(120, 116, 112),
			material = Enum.Material.Slate,
			parent = parent,
		})
	end
end

-- A ring road around the mountain plus a spur, so the three cities and the
-- mine read as connected places instead of objects dropped on a lawn.
local function buildRoads(parent: Instance)
	local roadColor = Color3.fromRGB(203, 194, 172)
	local function road(from: Vector3, to: Vector3, width: number)
		local mid = (from + to) / 2 + Vector3.new(0, 0.15, 0)
		BuildKit.part({
			name = "Road",
			size = Vector3.new(width, 0.35, (to - from).Magnitude + width * 0.5),
			cframe = CFrame.lookAt(mid, Vector3.new(to.X, mid.Y, to.Z)),
			color = roadColor,
			material = Enum.Material.Cobblestone,
			canCollide = false,
			parent = parent,
		})
	end

	local segments = 22
	local ringRadius = 302
	for index = 1, segments do
		local a1 = (index - 1) / segments * math.pi * 2
		local a2 = index / segments * math.pi * 2
		road(
			Vector3.new(math.sin(a1) * ringRadius, Overworld.GROUND_TOP, math.cos(a1) * ringRadius),
			Vector3.new(math.sin(a2) * ringRadius, Overworld.GROUND_TOP, math.cos(a2) * ringRadius),
			9
		)
	end
	-- Spur from the Wayfarer's Rest through the mine gate toward the ring.
	road(Vector3.new(0, Overworld.GROUND_TOP, 170), Vector3.new(0, Overworld.GROUND_TOP, 236), 9)
end

local function tuneSky()
	Lighting.ClockTime = 14.4
	Lighting.Brightness = 2.4
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	if Lighting:FindFirstChildOfClass("Atmosphere") == nil then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.35
		atmosphere.Offset = 0.4
		atmosphere.Color = Color3.fromRGB(199, 199, 214)
		atmosphere.Decay = Color3.fromRGB(106, 112, 125)
		atmosphere.Haze = 1.8
		atmosphere.Parent = Lighting
	end
end

function Overworld.build(parent: Instance)
	buildGround(parent)
	buildMountain(parent)
	buildMineEntrance(parent)
	buildWandererSpawn(parent)
	buildFlora(parent)
	buildRoads(parent)
	tuneSky()
end

return Overworld
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Underworld</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > World > Underworld
-- Everything beneath Heavenpillar: the shaft down from the surface, the
-- Mining Hall (tier-1 ore), the Deepforge Hall (tier-2 ore), the Spirit
-- Forge, and Grandmaster Khadun himself. Built against Overworld.HOLE so
-- the shaft lines up with the hole left in the ground.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))

local BuildKit = require(script.Parent.BuildKit)
local Overworld = require(script.Parent.Overworld)

local Underworld = {}

local FLOOR_Y = -60 -- cave floor (top surface)
local CEILING_Y = -24 -- cave ceiling (bottom surface)
local SLAB = 6
local STONE = Color3.fromRGB(76, 72, 78)
local STONE_DARK = Color3.fromRGB(58, 55, 62)

-- Mining Hall interior bounds
local HALL = { x1 = -90, x2 = 90, z1 = 300, z2 = 460 }
-- Deepforge Hall interior bounds
local FORGE_HALL = { x1 = -70, x2 = 70, z1 = 460, z2 = 600 }
local DOOR_WIDTH = 24

local wallHeight = CEILING_Y - FLOOR_Y

local function floorAndCeiling(parent: Instance, name: string, bounds: { x1: number, x2: number, z1: number, z2: number })
	local cx = (bounds.x1 + bounds.x2) / 2
	local cz = (bounds.z1 + bounds.z2) / 2
	local sx = bounds.x2 - bounds.x1 + SLAB * 2
	local sz = bounds.z2 - bounds.z1
	BuildKit.part({
		name = name .. "_Floor",
		size = Vector3.new(sx, SLAB, sz),
		position = Vector3.new(cx, FLOOR_Y - SLAB / 2, cz),
		color = STONE_DARK,
		material = Enum.Material.Slate,
		parent = parent,
	})
	BuildKit.part({
		name = name .. "_Ceiling",
		size = Vector3.new(sx, SLAB, sz),
		position = Vector3.new(cx, CEILING_Y + SLAB / 2, cz),
		color = STONE_DARK,
		material = Enum.Material.Slate,
		parent = parent,
	})
end

local function torch(parent: Instance, position: Vector3)
	local sconce = BuildKit.part({
		name = "Torch",
		size = Vector3.new(0.8, 3, 0.8),
		position = position,
		color = Color3.fromRGB(70, 55, 40),
		material = Enum.Material.Wood,
		canCollide = false,
		parent = parent,
	})
	local flame = BuildKit.part({
		name = "Torch_Flame",
		size = Vector3.new(1, 1, 1),
		position = position + Vector3.new(0, 2, 0),
		color = Color3.fromRGB(255, 170, 80),
		material = Enum.Material.Neon,
		canCollide = false,
		parent = parent,
	})
	BuildKit.pointLight(flame, Color3.fromRGB(255, 170, 90), 1.8, 34)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Parent = flame
	return sconce
end

local function buildShaft(parent: Instance)
	local hole = Overworld.HOLE
	-- Ramp from the surface lip (z1) down to the hall mouth (z2).
	local from = Vector3.new(0, Overworld.GROUND_TOP, hole.z1 + 1)
	local to = Vector3.new(0, FLOOR_Y, hole.z2 + 2)
	local mid = (from + to) / 2
	local length = (to - from).Magnitude + 8
	BuildKit.part({
		name = "Shaft_Ramp",
		size = Vector3.new(hole.x2 - hole.x1 - 2, 2, length),
		cframe = CFrame.lookAt(mid, to),
		color = STONE,
		material = Enum.Material.Cobblestone,
		parent = parent,
	})
	-- Shaft side and head walls, sealing the underground faces of the hole.
	local depth = Overworld.GROUND_TOP - (FLOOR_Y - SLAB)
	BuildKit.wallZ(parent, "Shaft_WallW", hole.x1, hole.z1, hole.z2, FLOOR_Y - SLAB, depth, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallZ(parent, "Shaft_WallE", hole.x2, hole.z1, hole.z2, FLOOR_Y - SLAB, depth, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallX(parent, "Shaft_WallN", hole.z1 - SLAB / 2, hole.x1 - SLAB, hole.x2 + SLAB, FLOOR_Y - SLAB, depth, SLAB, STONE, Enum.Material.Slate)
end

local function buildMiningHall(parent: Instance)
	local hole = Overworld.HOLE
	floorAndCeiling(parent, "MiningHall", HALL)
	-- North wall: opening where the shaft arrives.
	BuildKit.wallX(parent, "MiningHall_WallN", HALL.z1, HALL.x1 - SLAB, HALL.x2 + SLAB, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate, 0, (hole.x2 - hole.x1))
	-- South wall: doorway to the Deepforge.
	BuildKit.wallX(parent, "MiningHall_WallS", HALL.z2, HALL.x1 - SLAB, HALL.x2 + SLAB, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate, 0, DOOR_WIDTH)
	BuildKit.wallZ(parent, "MiningHall_WallW", HALL.x1, HALL.z1, HALL.z2, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallZ(parent, "MiningHall_WallE", HALL.x2, HALL.z1, HALL.z2, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)

	-- Torches along both long walls.
	for z = HALL.z1 + 20, HALL.z2 - 20, 40 do
		torch(parent, Vector3.new(HALL.x1 + 2, FLOOR_Y + 8, z))
		torch(parent, Vector3.new(HALL.x2 - 2, FLOOR_Y + 8, z))
	end

	-- A pair of dummies so miners can practice between veins.
	BuildKit.trainingDummy(parent, Vector3.new(-60, FLOOR_Y, 320))
	BuildKit.trainingDummy(parent, Vector3.new(60, FLOOR_Y, 320))
end

local function buildDeepforgeHall(parent: Instance)
	floorAndCeiling(parent, "Deepforge", FORGE_HALL)
	BuildKit.wallX(parent, "Deepforge_WallS", FORGE_HALL.z2, FORGE_HALL.x1 - SLAB, FORGE_HALL.x2 + SLAB, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallZ(parent, "Deepforge_WallW", FORGE_HALL.x1, FORGE_HALL.z1, FORGE_HALL.z2, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallZ(parent, "Deepforge_WallE", FORGE_HALL.x2, FORGE_HALL.z1, FORGE_HALL.z2, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)
	-- Filler walls narrowing the hall mouth to the shared doorway.
	BuildKit.wallX(parent, "Deepforge_WallN_W", FORGE_HALL.z1, FORGE_HALL.x1 - SLAB, -DOOR_WIDTH / 2, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)
	BuildKit.wallX(parent, "Deepforge_WallN_E", FORGE_HALL.z1, DOOR_WIDTH / 2, FORGE_HALL.x2 + SLAB, FLOOR_Y, wallHeight, SLAB, STONE, Enum.Material.Slate)

	for z = FORGE_HALL.z1 + 20, FORGE_HALL.z2 - 20, 35 do
		torch(parent, Vector3.new(FORGE_HALL.x1 + 2, FLOOR_Y + 8, z))
		torch(parent, Vector3.new(FORGE_HALL.x2 - 2, FLOOR_Y + 8, z))
	end

	-- ------------------------- The Spirit Forge -------------------------
	BuildKit.part({
		name = "Forge_Furnace",
		size = Vector3.new(10, 12, 10),
		position = Vector3.new(-24, FLOOR_Y + 6, 560),
		color = Color3.fromRGB(50, 46, 52),
		material = Enum.Material.Basalt,
		parent = parent,
	})
	local maw = BuildKit.part({
		name = "Forge_Maw",
		size = Vector3.new(6, 5, 1),
		position = Vector3.new(-24, FLOOR_Y + 4, 554.6),
		color = Color3.fromRGB(255, 120, 40),
		material = Enum.Material.Neon,
		canCollide = false,
		parent = parent,
	})
	BuildKit.pointLight(maw, Color3.fromRGB(255, 130, 50), 3, 44)
	local forgeFire = Instance.new("Fire")
	forgeFire.Size = 8
	forgeFire.Heat = 10
	forgeFire.Parent = maw

	local anvil = BuildKit.part({
		name = "SpiritForge_Anvil",
		size = Vector3.new(6, 3.5, 3),
		position = Vector3.new(-10, FLOOR_Y + 2.5, 552),
		color = Color3.fromRGB(120, 124, 136),
		material = Enum.Material.Metal,
		parent = parent,
	})
	BuildKit.prompt(anvil, "Craft", "Spirit Forge", 0.5, "ForgePrompt")
	BuildKit.billboard(anvil, "The Spirit Forge", Color3.fromRGB(255, 180, 90), 12, 1.8, Vector3.new(0, 4, 0))
	BuildKit.safeZone(parent, Vector3.new(-14, FLOOR_Y, 556), 45)

	-- ---------------------- Grandmaster Khadun ---------------------------
	local dwarf = Instance.new("Model")
	dwarf.Name = "GrandmasterKhadun"
	local base = Vector3.new(-16, FLOOR_Y, 545)
	local skin = Color3.fromRGB(224, 172, 128)
	local body = BuildKit.part({
		name = "Body",
		size = Vector3.new(3.4, 2.8, 2),
		position = base + Vector3.new(0, 2.4, 0),
		color = Color3.fromRGB(122, 62, 44),
		material = Enum.Material.Fabric,
		parent = dwarf,
	})
	BuildKit.part({
		name = "Legs",
		size = Vector3.new(3, 1, 1.8),
		position = base + Vector3.new(0, 0.5, 0),
		color = Color3.fromRGB(60, 52, 48),
		material = Enum.Material.Fabric,
		parent = dwarf,
	})
	BuildKit.part({
		name = "Head",
		size = Vector3.new(1.9, 1.7, 1.8),
		position = base + Vector3.new(0, 4.6, 0),
		color = skin,
		material = Enum.Material.SmoothPlastic,
		parent = dwarf,
	})
	BuildKit.part({
		name = "Beard",
		size = Vector3.new(1.7, 2.4, 0.6),
		position = base + Vector3.new(0, 3.5, -0.9),
		color = Color3.fromRGB(200, 120, 60),
		material = Enum.Material.Fabric,
		canCollide = false,
		parent = dwarf,
	})
	BuildKit.part({
		name = "Helm",
		size = Vector3.new(2.1, 0.9, 2),
		position = base + Vector3.new(0, 5.7, 0),
		color = Color3.fromRGB(130, 134, 146),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = dwarf,
	})
	dwarf.PrimaryPart = body
	BuildKit.prompt(body, "Talk", "Grandmaster Khadun", 0, "DwarfPrompt")
	BuildKit.billboard(body, "Grandmaster Khadun\nKeeper of the Deepforge", Color3.fromRGB(255, 200, 130), 14, 2.4, Vector3.new(0, 5, 0))
	dwarf.Parent = parent
end

local function scatterOre(parent: Instance)
	local rng = Random.new(23) -- deterministic layout
	local function place(oreId: string, count: number, bounds: { x1: number, x2: number, z1: number, z2: number })
		local ore = Ores.get(oreId)
		if ore == nil then
			return
		end
		for _ = 1, count do
			local x = rng:NextNumber(bounds.x1 + 12, bounds.x2 - 12)
			local z = rng:NextNumber(bounds.z1 + 14, bounds.z2 - 14)
			-- Keep the forge corner clear for the dwarf's floor space.
			if z > 530 and x < 5 then
				x += 40
			end
			BuildKit.oreNode(parent, Vector3.new(x, FLOOR_Y, z), ore.id, ore.name, ore.color)
		end
	end

	-- Tier 1: Mining Hall
	place("black_iron", 8, HALL)
	place("cold_iron", 5, HALL)
	place("spirit_stone", 6, HALL)
	-- Tier 2: Deepforge Hall
	place("meteoric_iron", 4, FORGE_HALL)
	place("star_silver", 3, FORGE_HALL)
	place("profound_gold", 2, FORGE_HALL)
	place("immortal_jade", 2, FORGE_HALL)
	place("spirit_stone", 2, FORGE_HALL)
end

function Underworld.build(parent: Instance)
	buildShaft(parent)
	buildMiningHall(parent)
	buildDeepforgeHall(parent)
	scatterOre(parent)
end

return Underworld
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService > Server > Systems > WorldBuilder
-- Stamps the whole map out of code at server start: surface, mountain,
-- three cities, and the caves. Keeping the world in code (rather than in a
-- place file) is what lets the entire game live in git and build from a
-- clean checkout; nothing in Studio is hand-placed.

local Overworld = require(script.Parent.World.Overworld)
local Cities = require(script.Parent.World.Cities)
local Underworld = require(script.Parent.World.Underworld)

local WorldBuilder = {}

function WorldBuilder.Init()
	if workspace:FindFirstChild("World") then
		return -- already built (Studio test re-run)
	end
	local world = Instance.new("Folder")
	world.Name = "World"

	Overworld.build(world)
	Cities.build(world)
	Underworld.build(world)

	world.Parent = workspace
	print("[WorldBuilder] Heavenpillar and the three cities stand.")
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="37">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="38">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="39">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="40">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- LocalScript: StarterPlayer > StarterPlayerScripts > Client
-- Client bootstrapper, mirror of the server one: requires every ModuleScript
-- in Controllers/, calls Init() on all, then Start() on all.

local controllersFolder = script:WaitForChild("Controllers")

type Controller = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local controllers: { [string]: Controller } = {}

for _, child in controllersFolder:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			controllers[child.Name] = result :: Controller
		else
			warn(`[Client] Failed to require controller "{child.Name}": {result}`)
		end
	end
end

for name, controller in controllers do
	if controller.Init then
		local ok, err = pcall(controller.Init :: any)
		if not ok then
			warn(`[Client] {name}.Init() failed: {err}`)
		end
	end
end

for name, controller in controllers do
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start :: any)
			if not ok then
				warn(`[Client] {name}.Start() failed: {err}`)
			end
		end)
	end
end

print("[Client] All controllers started")
]]></string>
        </Properties>
        <Item class="Folder" referent="41">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">CraftingController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > CraftingController
-- The Spirit Forge panel. Opens when the server says the player used the
-- forge prompt; lists every recipe with live affordability against the
-- inventory cache. Crafting itself is validated server-side (including
-- standing at the forge).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Data"):WaitForChild("Items"))
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)

local CraftingController = {}

local window: UiKit.Window
local recipeList: ScrollingFrame

local function clearList(list: ScrollingFrame)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function render()
	clearList(recipeList)
	local inventory = ClientState.inventory
	local order = 0
	for _, itemId in Items.order do
		local item = Items.get(itemId)
		if item == nil or item.recipe == nil then
			continue
		end
		local recipe = item.recipe :: Items.Recipe
		order += 1

		local affordable = true
		local costLines: { string } = {}
		for oreId, needed in recipe.ores do
			local ore = Ores.get(oreId)
			local have = if inventory then inventory.ores[oreId] or 0 else 0
			if have < needed then
				affordable = false
			end
			table.insert(costLines, `{if ore then ore.name else oreId} {have}/{needed}`)
		end
		local stonesHave = if inventory then inventory.spiritStones else 0
		if stonesHave < recipe.spiritStones then
			affordable = false
		end
		table.insert(costLines, `stones {stonesHave}/{recipe.spiritStones}`)

		local row = UiKit.frame(recipeList, UDim2.new(1, -8, 0, 62), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = order
		local detail: string
		if item.kind == "weapon" then
			detail = `{item.category} · damage x{item.damageMult}`
		else
			detail = `robe · absorbs {math.floor(item.defense * 100)}%`
		end
		UiKit.label(row, item.name, UDim2.new(1, -100, 0, 18), UDim2.fromOffset(6, 3), {
			textSize = 13,
			bold = true,
			color = if affordable then UiKit.Colors.text else UiKit.Colors.textDim,
		})
		UiKit.label(row, detail, UDim2.new(1, -100, 0, 13), UDim2.fromOffset(6, 21), {
			textSize = 11,
			color = UiKit.Colors.textDim,
		})
		UiKit.label(row, table.concat(costLines, "  ·  "), UDim2.new(1, -100, 0, 13), UDim2.fromOffset(6, 37), {
			textSize = 10,
			color = if affordable then UiKit.Colors.health else UiKit.Colors.danger,
		})
		UiKit.button(row, "Forge", UDim2.fromOffset(84, 32), UDim2.new(1, -90, 0.5, -16), function()
			task.spawn(function()
				local result = Net.remoteFunction("CraftItem"):InvokeServer({ id = itemId })
				if typeof(result) == "table" and not result.ok and typeof(result.error) == "string" then
					-- Server refusals surface as toasts via Notify already
					-- for successes; show refusal inline here.
					render()
				end
			end)
		end, {
			textSize = 13,
			color = if affordable then UiKit.Colors.gold else UiKit.Colors.panel,
			textColor = if affordable then UiKit.Colors.panel else UiKit.Colors.textDim,
		})
	end
end

function CraftingController.Init()
	window = UiKit.window("Crafting", "The Spirit Forge", UDim2.fromOffset(520, 520), 45)
	recipeList = (UiKit.scroll(window.body, UDim2.new(1, 0, 1, 0), UDim2.fromOffset(0, 0)))

	Net.remoteEvent("OpenCrafting").OnClientEvent:Connect(function()
		render()
		window.setVisible(true)
	end)
	ClientState.InventoryChanged:Connect(function()
		if window.visible() then
			render()
		end
	end)
end

return CraftingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">DestinyController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > DestinyController
-- Destiny (key R): race and talent spins, the reveal, and the collection.
-- 124 races and the talent pool live in shared data; this panel is just an
-- honest window onto what the server rolled for you.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Races = require(Shared:WaitForChild("Data"):WaitForChild("Races"))
local Talents = require(Shared:WaitForChild("Data"):WaitForChild("Talents"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)

local DestinyController = {}

local window: UiKit.Window
local raceSpinButton: TextButton
local talentSpinButton: TextButton
local revealLabel: TextLabel
local raceList: ScrollingFrame
local talentList: ScrollingFrame
local spinning = false

local function clearList(list: ScrollingFrame)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function renderSpinButtons()
	local destiny = ClientState.destiny
	local raceSpins = if destiny then destiny.raceSpins else 0
	local talentSpins = if destiny then destiny.talentSpins else 0
	raceSpinButton.Text = if raceSpins > 0
		then `SPIN RACE  ({raceSpins} free)`
		else `SPIN RACE  ({Config.RACE_SPIN_STONES} stones)`
	talentSpinButton.Text = if talentSpins > 0
		then `SPIN TALENT  ({talentSpins} free)`
		else `SPIN TALENT  ({Config.TALENT_SPIN_STONES} stones)`
end

local function renderRaces()
	clearList(raceList)
	local destiny = ClientState.destiny
	if destiny == nil then
		return
	end
	local index = 0
	for _, raceId in Races.order do
		local owned = destiny.ownedRaces[raceId]
		if owned == nil then
			continue
		end
		local race = Races.get(raceId)
		if race == nil then
			continue
		end
		index += 1
		local equipped = destiny.race == raceId
		local row = UiKit.frame(raceList, UDim2.new(1, -8, 0, 46), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = index
		UiKit.label(row, `{race.name} {race.hanzi}`, UDim2.new(1, -90, 0, 18), UDim2.fromOffset(6, 3), {
			textSize = 13,
			color = UiKit.rarityColor(race.rarity),
			bold = true,
		})
		UiKit.label(row, `{race.rarity} · {race.archetype}{if race.affinity then ` · affinity: {race.affinity}` else ""}`, UDim2.new(1, -90, 0, 14), UDim2.fromOffset(6, 24), {
			textSize = 11,
			color = UiKit.Colors.textDim,
		})
		if equipped then
			UiKit.label(row, "EQUIPPED", UDim2.fromOffset(76, 20), UDim2.new(1, -82, 0.5, -10), {
				textSize = 11,
				color = UiKit.Colors.gold,
				bold = true,
				xalign = Enum.TextXAlignment.Center,
			})
		else
			UiKit.button(row, "Equip", UDim2.fromOffset(76, 26), UDim2.new(1, -82, 0.5, -13), function()
				task.spawn(function()
					Net.remoteFunction("EquipRace"):InvokeServer({ id = raceId })
				end)
			end, { textSize = 12 })
		end
	end
	UiKit.label(raceList, `{index} / {#Races.order} bloodlines awakened`, UDim2.new(1, -8, 0, 20), UDim2.fromOffset(0, 0), {
		textSize = 11,
		color = UiKit.Colors.textDim,
		xalign = Enum.TextXAlignment.Center,
	}).LayoutOrder = 10000
end

local function renderTalents()
	clearList(talentList)
	local destiny = ClientState.destiny
	if destiny == nil then
		return
	end
	local equippedSet: { [string]: boolean } = {}
	for _, id in destiny.equippedTalents do
		equippedSet[id] = true
	end
	local index = 0
	for _, talentId in Talents.order do
		if destiny.ownedTalents[talentId] == nil then
			continue
		end
		local talent = Talents.get(talentId)
		if talent == nil then
			continue
		end
		index += 1
		local equipped = equippedSet[talentId] == true
		local row = UiKit.frame(talentList, UDim2.new(1, -8, 0, 46), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = index
		UiKit.label(row, talent.name, UDim2.new(1, -90, 0, 18), UDim2.fromOffset(6, 3), {
			textSize = 13,
			color = UiKit.rarityColor(talent.rarity),
			bold = true,
		})
		UiKit.label(row, talent.blurb, UDim2.new(1, -90, 0, 14), UDim2.fromOffset(6, 24), {
			textSize = 10,
			color = UiKit.Colors.textDim,
		})
		UiKit.button(row, if equipped then "Unequip" else "Equip", UDim2.fromOffset(76, 26), UDim2.new(1, -82, 0.5, -13), function()
			local newList: { string } = {}
			for _, id in destiny.equippedTalents do
				if id ~= talentId then
					table.insert(newList, id)
				end
			end
			if not equipped then
				if #newList >= Config.TALENT_SLOTS then
					return
				end
				table.insert(newList, talentId)
			end
			task.spawn(function()
				Net.remoteFunction("EquipTalent"):InvokeServer({ ids = newList })
			end)
		end, { textSize = 12, color = if equipped then UiKit.Colors.gold else UiKit.Colors.panelLight, textColor = if equipped then UiKit.Colors.panel else UiKit.Colors.text })
	end
end

local function spin(kind: "race" | "talent")
	if spinning then
		return
	end
	spinning = true
	revealLabel.Text = "The heavens turn..."
	revealLabel.TextColor3 = UiKit.Colors.textDim
	task.spawn(function()
		local remoteName = if kind == "race" then "SpinRace" else "SpinTalent"
		local result = Net.remoteFunction(remoteName):InvokeServer()
		task.wait(0.6) -- let the drum roll breathe
		if typeof(result) == "table" and result.ok then
			local id = tostring(result.id)
			local rarity = tostring(result.rarity)
			local displayName = id
			local blurb = ""
			if kind == "race" then
				local race = Races.get(id)
				if race then
					displayName = `{race.name} {race.hanzi}`
					blurb = race.blurb
				end
			else
				local talent = Talents.get(id)
				if talent then
					displayName = talent.name
					blurb = talent.blurb
				end
			end
			local suffix = if result.duplicate then `  (duplicate: +{result.refund} stones)` else ""
			revealLabel.Text = `{rarity:upper()}  ·  {displayName}{suffix}\n{blurb}`
			revealLabel.TextColor3 = UiKit.rarityColor(rarity)
		elseif typeof(result) == "table" and typeof(result.error) == "string" then
			revealLabel.Text = result.error
			revealLabel.TextColor3 = UiKit.Colors.danger
		end
		spinning = false
	end)
end

function DestinyController.Init()
	window = UiKit.window("Destiny", "Destiny: Bloodlines & Talents", UDim2.fromOffset(780, 560), 40)
	local body = window.body

	raceSpinButton = UiKit.button(body, "SPIN RACE", UDim2.fromOffset(370, 44), UDim2.fromOffset(0, 0), function()
		spin("race")
	end, { color = UiKit.Colors.gold, textColor = UiKit.Colors.panel, textSize = 16 })
	talentSpinButton = UiKit.button(body, "SPIN TALENT", UDim2.fromOffset(370, 44), UDim2.new(1, -370, 0, 0), function()
		spin("talent")
	end, { color = UiKit.Colors.panelLight, textSize = 16 })

	local revealFrame = UiKit.frame(body, UDim2.new(1, 0, 0, 66), UDim2.fromOffset(0, 52), UiKit.Colors.inset)
	revealLabel = UiKit.label(revealFrame, "Spin to awaken a bloodline of the old myths, or a talent of the flesh.", UDim2.new(1, -20, 1, -8), UDim2.fromOffset(10, 4), {
		textSize = 15,
		xalign = Enum.TextXAlignment.Center,
		wrap = true,
		title = true,
	})

	UiKit.label(body, "BLOODLINES", UDim2.fromOffset(300, 16), UDim2.fromOffset(0, 126), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	raceList = (UiKit.scroll(body, UDim2.new(0.5, -6, 1, -146), UDim2.fromOffset(0, 144)))

	UiKit.label(body, `TALENTS (equip up to {Config.TALENT_SLOTS})`, UDim2.fromOffset(300, 16), UDim2.new(0.5, 6, 0, 126), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	talentList = (UiKit.scroll(body, UDim2.new(0.5, -6, 1, -146), UDim2.new(0.5, 6, 0, 144)))

	renderSpinButtons()
	renderRaces()
	renderTalents()

	ClientState.DestinyChanged:Connect(function()
		renderSpinButtons()
		renderRaces()
		renderTalents()
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			window.toggle()
		end
	end)
end

return DestinyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">DialogueController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > DialogueController
-- Grandmaster Khadun's dialogue box: mission pitch, requirements, and the
-- Accept / Turn In buttons. Driven entirely by DwarfDialogue payloads from
-- the server; the buttons call MissionAction and the server re-sends the
-- updated dialogue.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)

local DialogueController = {}

local window: UiKit.Window
local nameLabel: TextLabel
local titleLabel: TextLabel
local textLabel: TextLabel
local needsLabel: TextLabel
local rewardLabel: TextLabel
local acceptButton: TextButton
local turnInButton: TextButton

local function onDialogue(payload: unknown)
	if typeof(payload) ~= "table" then
		return
	end
	local dialogue = payload :: { [string]: any }
	nameLabel.Text = tostring(dialogue.npcName)
	titleLabel.Text = `Commission {dialogue.missionNumber}: {dialogue.missionTitle}`
	textLabel.Text = tostring(dialogue.text)

	local needs = dialogue.needs
	local needsLines: { string } = {}
	if typeof(needs) == "table" then
		for oreId, count in needs :: { [string]: number } do
			local ore = Ores.get(oreId)
			table.insert(needsLines, `{count}x {if ore then ore.name else oreId}`)
		end
	end
	needsLabel.Text = "Needs: " .. table.concat(needsLines, ", ")

	local rewards = { `{dialogue.rewardStones} spirit stones` }
	if tonumber(dialogue.rewardRaceSpins) and dialogue.rewardRaceSpins > 0 then
		table.insert(rewards, `{dialogue.rewardRaceSpins} race spins`)
	end
	if tonumber(dialogue.rewardTalentSpins) and dialogue.rewardTalentSpins > 0 then
		table.insert(rewards, `{dialogue.rewardTalentSpins} talent spins`)
	end
	rewardLabel.Text = "Pays: " .. table.concat(rewards, ", ")

	acceptButton.Visible = dialogue.canAccept == true
	turnInButton.Visible = dialogue.canTurnIn == true
	window.setVisible(true)
end

function DialogueController.Init()
	window = UiKit.window("Dialogue", "The Deepforge", UDim2.fromOffset(480, 300), 50)
	local body = window.body

	nameLabel = UiKit.label(body, "", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 0), {
		textSize = 18,
		color = UiKit.Colors.gold,
		title = true,
	})
	titleLabel = UiKit.label(body, "", UDim2.new(1, 0, 0, 18), UDim2.fromOffset(0, 24), {
		textSize = 13,
		bold = true,
	})
	textLabel = UiKit.label(body, "", UDim2.new(1, 0, 0, 96), UDim2.fromOffset(0, 46), {
		textSize = 14,
		wrap = true,
	})
	textLabel.TextYAlignment = Enum.TextYAlignment.Top
	needsLabel = UiKit.label(body, "", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 148), {
		textSize = 12,
		color = UiKit.Colors.qi,
	})
	rewardLabel = UiKit.label(body, "", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 166), {
		textSize = 12,
		color = UiKit.Colors.xp,
	})

	acceptButton = UiKit.button(body, "Accept Commission", UDim2.new(0.5, -6, 0, 38), UDim2.new(0, 0, 1, -42), function()
		task.spawn(function()
			Net.remoteFunction("MissionAction"):InvokeServer({ action = "accept" })
		end)
	end, { color = UiKit.Colors.gold, textColor = UiKit.Colors.panel })

	turnInButton = UiKit.button(body, "Turn In Ore", UDim2.new(0.5, -6, 0, 38), UDim2.new(0.5, 6, 1, -42), function()
		task.spawn(function()
			Net.remoteFunction("MissionAction"):InvokeServer({ action = "turnin" })
		end)
	end, { color = UiKit.Colors.health, textColor = UiKit.Colors.panel })

	Net.remoteEvent("DwarfDialogue").OnClientEvent:Connect(onDialogue)
end

return DialogueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > HudController
-- The always-on HUD: qi and cultivation bars, realm/path/race line, spirit
-- stones, the 6-slot technique hotbar with cooldown sweeps, toast
-- notifications, and the meditation indicator.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Races = require(Shared:WaitForChild("Data"):WaitForChild("Races"))
local Paths = require(Shared:WaitForChild("Data"):WaitForChild("Paths"))
local Forms = require(Shared:WaitForChild("Data"):WaitForChild("TechniqueForms"))
local Elements = require(Shared:WaitForChild("Data"):WaitForChild("Elements"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)
local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)

local HudController = {}

local qiBar: UiKit.Bar
local xpBar: UiKit.Bar
local identityLabel: TextLabel
local stonesLabel: TextLabel
local meditateLabel: TextLabel
local hintsLabel: TextLabel
local toastArea: Frame

type SlotUi = { root: Frame, name: TextLabel, key: TextLabel, cooldown: Frame }
local slotUis: { SlotUi } = {}

local function renderStats()
	local stats = ClientState.stats
	if stats == nil then
		return
	end
	qiBar.set(math.clamp(stats.qi / math.max(stats.maxQi, 1), 0, 1), `Qi {math.floor(stats.qi)} / {stats.maxQi}`)
	xpBar.set(math.clamp(stats.cultivationXp / math.max(stats.breakthroughXp, 1), 0, 1),
		`Cultivation {stats.cultivationXp} / {stats.breakthroughXp}`)

	local race = Races.get(stats.race)
	local raceName = if race then `{race.name} {race.hanzi}` else stats.race
	local pathDef = if stats.path then Paths[stats.path :: string] else nil
	local pathName = if pathDef then pathDef.name else "Wanderer"
	identityLabel.Text = `{stats.realmName}  ·  {pathName}  ·  {raceName}`
	stonesLabel.Text = `Spirit Stones: {stats.spiritStones}`
	meditateLabel.Visible = stats.meditating
end

local function renderSlots()
	local techniques = ClientState.techniques
	for slot = 1, Config.SLOT_COUNT do
		local ui = slotUis[slot]
		local techniqueId = if techniques then techniques.slots[tostring(slot)] else nil
		local name = ""
		local color = UiKit.Colors.textDim
		if techniques and techniqueId then
			for _, technique in techniques.techniques do
				if technique.id == techniqueId then
					name = technique.name
					local element = Elements.get(technique.element)
					if element then
						color = element.color
					end
					local form = Forms.get(technique.form)
					if form and name == "" then
						name = form.name
					end
					break
				end
			end
		end
		ui.name.Text = name
		ui.name.TextColor3 = color
		ui.root.BackgroundTransparency = if name == "" then 0.6 else 0.15
	end
end

local function startCooldownSweep(slot: number, duration: number)
	local ui = slotUis[slot]
	if ui == nil or duration <= 0 then
		return
	end
	ui.cooldown.Size = UDim2.fromScale(1, 1)
	ui.cooldown.Visible = true
	local tween = TweenService:Create(ui.cooldown, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.fromScale(1, 0),
	})
	tween.Completed:Once(function()
		ui.cooldown.Visible = false
	end)
	tween:Play()
end

local function toast(text: string, color: Color3?)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 24)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or UiKit.Colors.text
	label.TextStrokeTransparency = 0.4
	label.TextStrokeColor3 = UiKit.Colors.ink
	label.TextSize = 16
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.LayoutOrder = -os.clock() -- newest on top
	label.Parent = toastArea
	task.delay(4, function()
		local fade = TweenService:Create(label, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 })
		fade.Completed:Once(function()
			label:Destroy()
		end)
		fade:Play()
	end)
end

function HudController.Init()
	local screen = UiKit.screen("Hud", 10)

	-- Bottom-left vitals.
	local vitals = UiKit.frame(screen, UDim2.fromOffset(300, 96), UDim2.new(0, 16, 1, -190), UiKit.Colors.panel)
	vitals.BackgroundTransparency = 0.25
	identityLabel = UiKit.label(vitals, "", UDim2.new(1, -16, 0, 18), UDim2.fromOffset(8, 4), {
		textSize = 13,
		color = UiKit.Colors.gold,
	})
	qiBar = UiKit.bar(vitals, UDim2.new(1, -16, 0, 22), UDim2.fromOffset(8, 26), UiKit.Colors.qi)
	xpBar = UiKit.bar(vitals, UDim2.new(1, -16, 0, 22), UDim2.fromOffset(8, 52), UiKit.Colors.xp)
	stonesLabel = UiKit.label(vitals, "", UDim2.new(1, -16, 0, 16), UDim2.fromOffset(8, 76), {
		textSize = 12,
		color = UiKit.Colors.textDim,
	})

	-- Meditation indicator.
	meditateLabel = UiKit.label(screen, "~ Meditating: qi gathers, the dao whispers ~", UDim2.new(0, 420, 0, 24), UDim2.new(0.5, -210, 0, 60), {
		textSize = 16,
		color = UiKit.Colors.qi,
		title = true,
		xalign = Enum.TextXAlignment.Center,
	})
	meditateLabel.TextStrokeColor3 = UiKit.Colors.panel
	meditateLabel.TextStrokeTransparency = 0.3
	meditateLabel.Visible = false

	-- Hotbar.
	local slotSize = 86
	local hotbar = Instance.new("Frame")
	hotbar.Size = UDim2.fromOffset(Config.SLOT_COUNT * (slotSize + 6), slotSize)
	hotbar.Position = UDim2.new(0.5, -(Config.SLOT_COUNT * (slotSize + 6)) / 2, 1, -slotSize - 14)
	hotbar.BackgroundTransparency = 1
	hotbar.Parent = screen
	for slot = 1, Config.SLOT_COUNT do
		local root = UiKit.frame(hotbar, UDim2.fromOffset(slotSize, slotSize), UDim2.fromOffset((slot - 1) * (slotSize + 6), 0))
		root.BackgroundTransparency = 0.6
		local key = UiKit.label(root, tostring(slot), UDim2.fromOffset(18, 16), UDim2.fromOffset(5, 2), {
			textSize = 13,
			color = UiKit.Colors.gold,
			bold = true,
		})
		local name = UiKit.label(root, "", UDim2.new(1, -8, 0, 40), UDim2.fromOffset(4, 22), {
			textSize = 12,
			xalign = Enum.TextXAlignment.Center,
			wrap = true,
		})
		local cooldown = Instance.new("Frame")
		cooldown.AnchorPoint = Vector2.new(0, 1)
		cooldown.Position = UDim2.fromScale(0, 1)
		cooldown.Size = UDim2.fromScale(1, 0)
		cooldown.BackgroundColor3 = Color3.new(0, 0, 0)
		cooldown.BackgroundTransparency = 0.45
		cooldown.BorderSizePixel = 0
		cooldown.Visible = false
		cooldown.ZIndex = 5
		cooldown.Parent = root
		slotUis[slot] = { root = root, name = name, key = key, cooldown = cooldown }
	end

	-- Hints footer.
	hintsLabel = UiKit.label(screen, "T Techniques   R Destiny   I Inventory   G Meditate   M Menu", UDim2.new(0, 600, 0, 18), UDim2.new(0.5, -300, 1, -120), {
		textSize = 13,
		color = UiKit.Colors.textDim,
		xalign = Enum.TextXAlignment.Center,
	})

	-- Toasts.
	toastArea = Instance.new("Frame")
	toastArea.Size = UDim2.new(0, 520, 0, 200)
	toastArea.Position = UDim2.new(0.5, -260, 0, 96)
	toastArea.BackgroundTransparency = 1
	toastArea.Parent = screen
	local toastLayout = Instance.new("UIListLayout")
	toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toastLayout.Padding = UDim.new(0, 2)
	toastLayout.Parent = toastArea

	-- Wiring.
	ClientState.StatsChanged:Connect(renderStats)
	ClientState.TechniquesChanged:Connect(renderSlots)
	ClientState.CooldownStarted:Connect(startCooldownSweep)
	Net.remoteEvent("Notify").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.text) == "string" then
			toast(payload.text, payload.color)
		end
	end)
	ClientSettings.Changed:Connect(function(key)
		if key == "showHints" then
			hintsLabel.Visible = ClientSettings.get("showHints")
		end
	end)
	renderStats()
	renderSlots()
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > InventoryController
-- Inventory (key I): the ore pouch and forged gear, with equip buttons.
-- Weapons gate technique categories, so this is also where a swordsman
-- becomes an archer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Ores = require(Shared:WaitForChild("Data"):WaitForChild("Ores"))
local Items = require(Shared:WaitForChild("Data"):WaitForChild("Items"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)

local InventoryController = {}

local window: UiKit.Window
local oreList: ScrollingFrame
local itemList: ScrollingFrame

local function clearList(list: ScrollingFrame)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function render()
	local inventory = ClientState.inventory
	if inventory == nil then
		return
	end

	clearList(oreList)
	local order = 0
	UiKit.label(oreList, `Spirit Stones: {inventory.spiritStones}`, UDim2.new(1, -8, 0, 22), UDim2.fromOffset(0, 0), {
		textSize = 13,
		color = UiKit.Colors.gold,
		bold = true,
	}).LayoutOrder = 0
	for _, oreId in Ores.order do
		local count = inventory.ores[oreId]
		if count == nil or count <= 0 then
			continue
		end
		local ore = Ores.get(oreId)
		if ore == nil then
			continue
		end
		order += 1
		local row = UiKit.frame(oreList, UDim2.new(1, -8, 0, 26), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = order
		UiKit.label(row, `{ore.name}  x{count}`, UDim2.new(1, -12, 1, 0), UDim2.fromOffset(6, 0), {
			textSize = 13,
			color = ore.color,
		})
	end
	if order == 0 then
		UiKit.label(oreList, "The pouch is empty. The mines are under the mountain.", UDim2.new(1, -8, 0, 30), UDim2.fromOffset(0, 0), {
			textSize = 12,
			color = UiKit.Colors.textDim,
			wrap = true,
		}).LayoutOrder = 1
	end

	clearList(itemList)
	local itemOrder = 0
	for _, itemId in Items.order do
		local count = inventory.items[itemId]
		if count == nil or count <= 0 then
			continue
		end
		local item = Items.get(itemId)
		if item == nil then
			continue
		end
		itemOrder += 1
		local slot: "weapon" | "armor" = if item.kind == "weapon" then "weapon" else "armor"
		local equipped = (slot == "weapon" and inventory.equippedWeapon == itemId)
			or (slot == "armor" and inventory.equippedArmor == itemId)
		local row = UiKit.frame(itemList, UDim2.new(1, -8, 0, 48), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = itemOrder
		UiKit.label(row, `{item.name}{if count > 1 then ` x{count}` else ""}`, UDim2.new(1, -96, 0, 18), UDim2.fromOffset(6, 4), {
			textSize = 13,
			bold = true,
		})
		local detail: string
		if item.kind == "weapon" then
			detail = `{item.category} · damage x{item.damageMult}`
		else
			detail = `robe · absorbs {math.floor(item.defense * 100)}%`
		end
		local realm = Realms[item.realmReq]
		if item.realmReq > 1 and realm then
			detail ..= ` · needs {realm.name}`
		end
		UiKit.label(row, detail, UDim2.new(1, -96, 0, 14), UDim2.fromOffset(6, 24), {
			textSize = 11,
			color = UiKit.Colors.textDim,
		})
		if equipped then
			UiKit.button(row, "Unequip", UDim2.fromOffset(80, 28), UDim2.new(1, -86, 0.5, -14), function()
				task.spawn(function()
					Net.remoteFunction("EquipItem"):InvokeServer({ slot = slot, id = nil })
				end)
			end, { textSize = 12, color = UiKit.Colors.gold, textColor = UiKit.Colors.panel })
		else
			UiKit.button(row, "Equip", UDim2.fromOffset(80, 28), UDim2.new(1, -86, 0.5, -14), function()
				task.spawn(function()
					Net.remoteFunction("EquipItem"):InvokeServer({ slot = slot, id = itemId })
				end)
			end, { textSize = 12 })
		end
	end
end

function InventoryController.Init()
	window = UiKit.window("Inventory", "Inventory", UDim2.fromOffset(560, 480), 40)
	local body = window.body

	UiKit.label(body, "ORE POUCH", UDim2.fromOffset(200, 16), UDim2.fromOffset(0, 0), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	oreList = (UiKit.scroll(body, UDim2.new(0.45, -6, 1, -20), UDim2.fromOffset(0, 18)))

	UiKit.label(body, "GEAR", UDim2.fromOffset(200, 16), UDim2.new(0.45, 6, 0, 0), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	itemList = (UiKit.scroll(body, UDim2.new(0.55, -6, 1, -20), UDim2.new(0.45, 6, 0, 18)))

	render()
	ClientState.InventoryChanged:Connect(render)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.I then
			window.toggle()
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">MeditateController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > MeditateController
-- Meditation toggle (key G). Tells the server, sits the character down via
-- a client-side aura; the server owns the actual regen/xp effects and ends
-- meditation automatically when the player moves.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local ClientState = require(script.Parent.Parent.Modules.ClientState)

local MeditateController = {}

local player = Players.LocalPlayer
local aura: Part? = nil

local function setAura(active: boolean)
	if not active then
		if aura then
			aura:Destroy()
			aura = nil
		end
		return
	end
	if aura and aura.Parent then
		return
	end
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return
	end
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 9, 9)
	ring.CFrame = root.CFrame * CFrame.new(0, -2.6, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Color = Color3.fromRGB(120, 210, 255)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.55
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Parent = workspace
	aura = ring
end

function MeditateController.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			local meditating = if ClientState.stats then ClientState.stats.meditating else false
			Net.remoteEvent("MeditateSet"):FireServer(not meditating)
		end
	end)

	ClientState.StatsChanged:Connect(function()
		local stats = ClientState.stats
		setAura(if stats then stats.meditating else false)
	end)
end

return MeditateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > MenuController
-- The main menu shown on join: title, Enter the World, Settings, Controls.
-- Reopens with M. The world loads behind it (spawning is untouched); the
-- menu is an overlay with a blur, so entering is instant.

local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)

local MenuController = {}

local screen: ScreenGui
local blur: BlurEffect

local CONTROLS_TEXT = table.concat({
	"1-6 . . . Cast technique in that slot",
	"T . . . . Technique Forge (design your arts)",
	"R . . . . Destiny (race & talent spins)",
	"I . . . . Inventory & equipment",
	"G . . . . Meditate (restores qi, builds cultivation)",
	"M . . . . This menu",
	"",
	"Mine ore in the caves under the mountain.",
	"Craft weapons at the Spirit Forge in the deep hall.",
	"Pledge a path at any city shrine. Once.",
}, "\n")

local function setOpen(open: boolean)
	screen.Enabled = open
	blur.Enabled = open
end

function MenuController.Init()
	screen = UiKit.screen("MainMenu", 100)
	screen.Enabled = true

	blur = Instance.new("BlurEffect")
	blur.Size = 18
	blur.Parent = Lighting

	-- Paper mist over the whole viewport: with the blur behind it, the world
	-- reads like an unfinished ink painting.
	local wash = Instance.new("Frame")
	wash.Size = UDim2.fromScale(1, 1)
	wash.BackgroundColor3 = UiKit.Colors.panel
	wash.BackgroundTransparency = 0.2
	wash.BorderSizePixel = 0
	wash.Parent = screen

	local panel = UiKit.frame(wash, UDim2.fromOffset(420, 430), UDim2.fromScale(0.5, 0.5))
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.BackgroundTransparency = 0.1

	UiKit.label(panel, Config.GAME_NAME, UDim2.new(1, 0, 0, 64), UDim2.fromOffset(0, 22), {
		textSize = 46,
		color = UiKit.Colors.gold,
		title = true,
		xalign = Enum.TextXAlignment.Center,
	})
	UiKit.label(panel, "A world of qi, three cities, and one mountain.", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 86), {
		textSize = 14,
		color = UiKit.Colors.textDim,
		xalign = Enum.TextXAlignment.Center,
	})

	-- Sub-panels: settings and controls swap into this region.
	local subPanel = UiKit.frame(panel, UDim2.new(1, -40, 0, 150), UDim2.fromOffset(20, 250), UiKit.Colors.inset)
	subPanel.Visible = false
	local subMode = ""

	local function showSub(mode: string)
		for _, child in subPanel:GetChildren() do
			if not child:IsA("UICorner") then
				child:Destroy()
			end
		end
		if mode == subMode or mode == "" then
			subPanel.Visible = false
			subMode = ""
			return
		end
		subMode = mode
		subPanel.Visible = true
		if mode == "controls" then
			UiKit.label(subPanel, CONTROLS_TEXT, UDim2.new(1, -16, 1, -12), UDim2.fromOffset(10, 6), {
				textSize = 13,
				wrap = true,
			})
		elseif mode == "settings" then
			local entries = {
				{ key = "vfxEnabled", name = "Technique visual effects" },
				{ key = "othersVfx", name = "Show other players' effects" },
				{ key = "showHints", name = "On-screen hints" },
			}
			for index, entry in entries do
				local y = 10 + (index - 1) * 44
				UiKit.label(subPanel, entry.name, UDim2.new(1, -120, 0, 36), UDim2.fromOffset(12, y), { textSize = 14 })
				local toggle: TextButton
				local function render()
					local on = ClientSettings.get(entry.key)
					toggle.Text = if on then "ON" else "OFF"
					toggle.BackgroundColor3 = if on then UiKit.Colors.gold else UiKit.Colors.panelLight
					toggle.TextColor3 = if on then UiKit.Colors.panel else UiKit.Colors.text
				end
				toggle = UiKit.button(subPanel, "ON", UDim2.fromOffset(84, 32), UDim2.new(1, -100, 0, y), function()
					ClientSettings.set(entry.key, not ClientSettings.get(entry.key))
					render()
				end)
				render()
			end
		end
	end

	UiKit.button(panel, "Enter the World", UDim2.new(1, -80, 0, 46), UDim2.fromOffset(40, 122), function()
		showSub("")
		setOpen(false)
	end, { color = UiKit.Colors.gold, textColor = UiKit.Colors.panel, textSize = 18 })

	UiKit.button(panel, "Settings", UDim2.new(0.5, -50, 0, 38), UDim2.fromOffset(40, 180), function()
		showSub("settings")
	end)
	UiKit.button(panel, "Controls", UDim2.new(0.5, -50, 0, 38), UDim2.new(0.5, 10, 0, 180), function()
		showSub("controls")
	end)

	UiKit.label(panel, "M reopens this menu", UDim2.new(1, 0, 0, 16), UDim2.new(0, 0, 1, -24), {
		textSize = 12,
		color = UiKit.Colors.textDim,
		xalign = Enum.TextXAlignment.Center,
	})

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.M then
			setOpen(not screen.Enabled)
		end
	end)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">TechniqueController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > TechniqueController
-- Casting input (keys 1-6, aimed at the mouse) and the client-side face of
-- every technique: the VFX broadcast renderer, and the local application of
-- approved movement techniques (the client owns its character's physics, so
-- dashes and leaps feel instant; the server already charged the qi).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local TechniqueMath = require(Shared:WaitForChild("TechniqueMath"))
local Elements = require(Shared:WaitForChild("Data"):WaitForChild("Elements"))

local ClientState = require(script.Parent.Parent.Modules.ClientState)
local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)

local TechniqueController = {}

local player = Players.LocalPlayer
local castRemote = Net.remoteEvent("CastTechnique")

local SLOT_KEYS: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
}

-- --------------------------------- Cast ---------------------------------

local localCooldowns: { [string]: number } = {}

local function cast(slot: number)
	local techniques = ClientState.techniques
	if techniques == nil then
		return
	end
	local techniqueId = techniques.slots[tostring(slot)]
	if techniqueId == nil then
		return
	end
	local technique: { id: string, name: string, form: string, element: string, power: number }? = nil
	for _, candidate in techniques.techniques do
		if candidate.id == techniqueId then
			technique = candidate
			break
		end
	end
	if technique == nil then
		return
	end

	-- Optimistic local cooldown so the hotbar reads honestly; the server
	-- keeps the real one.
	local stats = (TechniqueMath.compute(technique.form, technique.element, technique.power))
	local now = os.clock()
	if stats then
		local readyAt = localCooldowns[techniqueId]
		if readyAt and now < readyAt then
			return
		end
		localCooldowns[techniqueId] = now + stats.cooldown
		ClientState.FireCooldown(slot, stats.cooldown)
	end

	local mouse = player:GetMouse()
	castRemote:FireServer(slot, mouse.Hit.Position)
end

-- --------------------------------- VFX ----------------------------------

local vfxFolder: Folder? = nil

local function effectsParent(): Folder
	if vfxFolder and vfxFolder.Parent then
		return vfxFolder :: Folder
	end
	local folder = Instance.new("Folder")
	folder.Name = "ClientVFX"
	folder.Parent = workspace
	vfxFolder = folder
	return folder
end

local function ghostPart(size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	if shape then
		part.Shape = shape
	end
	part.Parent = effectsParent()
	return part
end

local function fadeOut(part: Part, duration: number, goal: { [string]: any }?)
	local props: { [string]: any } = goal or {}
	props.Transparency = 1
	local tween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween.Completed:Once(function()
		part:Destroy()
	end)
	tween:Play()
end

local function renderProjectile(origin: Vector3, direction: Vector3, speed: number, range: number, color: Color3)
	local ball = ghostPart(Vector3.new(1.6, 1.6, 1.6), CFrame.new(origin), color, Enum.PartType.Ball)
	local travelTime = range / math.max(speed, 1)
	local tween = TweenService:Create(ball, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
		CFrame = CFrame.new(origin + direction.Unit * range),
	})
	tween.Completed:Once(function()
		fadeOut(ball, 0.15)
	end)
	tween:Play()
	-- Thin qi trail.
	local trail = ghostPart(Vector3.new(0.4, 0.4, range), CFrame.lookAt(origin + direction.Unit * (range / 2), origin + direction.Unit * range), color)
	trail.Transparency = 0.75
	fadeOut(trail, math.min(travelTime + 0.3, 1))
end

local function renderMelee(origin: Vector3, direction: Vector3, range: number, color: Color3)
	local arcCFrame = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0, -range / 2)
	local arc = ghostPart(Vector3.new(range * 0.9, 0.6, range), arcCFrame, color)
	arc.Transparency = 0.35
	fadeOut(arc, 0.3, { Size = Vector3.new(range * 1.1, 0.2, range * 1.2) })
end

local function renderBlast(center: Vector3, radius: number, color: Color3, delay: number?)
	task.delay(delay or 0, function()
		local ring = ghostPart(Vector3.new(1, 0.6, 1), CFrame.new(center), color, Enum.PartType.Cylinder)
		ring.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
		ring.Transparency = 0.2
		fadeOut(ring, 0.45, { Size = Vector3.new(0.6, radius * 2, radius * 2) })
		local dome = ghostPart(Vector3.new(2, 2, 2), CFrame.new(center), color, Enum.PartType.Ball)
		dome.Transparency = 0.5
		fadeOut(dome, 0.45, { Size = Vector3.new(radius * 1.6, radius * 1.6, radius * 1.6) })
	end)
end

local function renderBreakthrough(origin: Vector3)
	local pillar = ghostPart(Vector3.new(6, 160, 6), CFrame.new(origin + Vector3.new(0, 80, 0)), Color3.fromRGB(255, 220, 130))
	pillar.Transparency = 0.25
	fadeOut(pillar, 1.6, { Size = Vector3.new(1, 180, 1) })
	renderBlast(origin, 14, Color3.fromRGB(255, 220, 130))
end

-- Movement application for our own approved casts.
local function applyMovement(formKind: string, direction: Vector3, speed: number, aim: Vector3)
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return
	end
	if formKind == "dash" then
		root.AssemblyLinearVelocity = direction.Unit * speed + Vector3.new(0, 12, 0)
	elseif formKind == "leap" then
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, speed, root.AssemblyLinearVelocity.Z)
	end
	-- teleport and speed_buff are fully server-side.
end

local function onVFX(payload: unknown)
	if typeof(payload) ~= "table" then
		return
	end
	local event = payload :: { [string]: any }
	local isSelf = event.casterUserId == player.UserId

	if event.kind == "breakthrough" and typeof(event.origin) == "Vector3" then
		if ClientSettings.get("vfxEnabled") or isSelf then
			renderBreakthrough(event.origin)
		end
		return
	end
	if event.kind ~= "cast" then
		return
	end
	local origin = event.origin
	local direction = event.direction
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
		return
	end

	-- Own movement always applies, even with VFX off; it is gameplay.
	if isSelf then
		applyMovement(event.formKind, direction, tonumber(event.speed) or 0, event.aim)
	end

	if not ClientSettings.get("vfxEnabled") then
		return
	end
	if not isSelf and not ClientSettings.get("othersVfx") then
		return
	end

	local element = Elements.get(tostring(event.element))
	local color = if element then element.color else Color3.fromRGB(170, 215, 255)
	local formKind = tostring(event.formKind)
	local range = tonumber(event.range) or 10
	local radius = tonumber(event.radius) or 8
	local speed = tonumber(event.speed) or 60

	if formKind == "melee" then
		renderMelee(origin, direction, range, color)
	elseif formKind == "projectile" then
		renderProjectile(origin, direction, speed, range, color)
	elseif formKind == "aoe_point" and typeof(event.aim) == "Vector3" then
		renderBlast(event.aim, radius, color, 0.35)
	elseif formKind == "aoe_self" then
		renderBlast(origin, radius, color)
	elseif formKind == "dash" or formKind == "leap" or formKind == "teleport" then
		renderBlast(origin, 4, color)
	elseif formKind == "speed_buff" then
		renderBlast(origin, 5, color)
	end
end

-- ------------------------------ Lifecycle -------------------------------

function TechniqueController.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local slot = SLOT_KEYS[input.KeyCode]
		if slot then
			cast(slot)
		end
	end)

	Net.remoteEvent("TechniqueVFX").OnClientEvent:Connect(onVFX)
end

return TechniqueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">TechniqueForgeController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Controllers > TechniqueForgeController
-- The Technique Forge (key T): where a player designs their own arts.
-- Pick a category, a form, an element, pour in power, name it, create.
-- The preview runs the same TechniqueMath the server enforces, so what
-- you read is what you get.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local StatCalc = require(Shared:WaitForChild("StatCalc"))
local TechniqueMath = require(Shared:WaitForChild("TechniqueMath"))
local Forms = require(Shared:WaitForChild("Data"):WaitForChild("TechniqueForms"))
local Elements = require(Shared:WaitForChild("Data"):WaitForChild("Elements"))
local Realms = require(Shared:WaitForChild("Data"):WaitForChild("Realms"))

local UiKit = require(script.Parent.Parent.Modules.UiKit)
local ClientState = require(script.Parent.Parent.Modules.ClientState)

local TechniqueForgeController = {}

local window: UiKit.Window
local formList: ScrollingFrame
local elementList: ScrollingFrame
local myList: ScrollingFrame
local previewLabel: TextLabel
local powerLabel: TextLabel
local nameBox: TextBox

local selCategory = "sword"
local selForm: string? = "flowing_slash"
local selElement = "none"
local power = 0

local CATEGORIES = { "movement", "sword", "blade", "bow" }

local function clearList(list: ScrollingFrame)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function renderPreview()
	if selForm == nil then
		previewLabel.Text = "Pick a form."
		return
	end
	local stats = (TechniqueMath.compute(selForm :: string, selElement, power))
	if stats == nil then
		previewLabel.Text = "Invalid design."
		return
	end
	local form = Forms.get(selForm :: string)
	local lines = {}
	if form and form.baseDamage > 0 then
		table.insert(lines, `Damage: {stats.damage}`)
	end
	table.insert(lines, `Qi cost: {stats.qiCost}`)
	table.insert(lines, `Cooldown: {stats.cooldown}s`)
	if stats.range > 0 then
		table.insert(lines, `Range: {stats.range}`)
	end
	if stats.radius > 0 then
		table.insert(lines, `Radius: {stats.radius}`)
	end
	if stats.duration > 0 then
		table.insert(lines, `Duration: {stats.duration}s`)
	end
	local realm = Realms[stats.requiredRealm]
	table.insert(lines, `Needs realm: {if realm then realm.name else "?"}`)
	table.insert(lines, `Design cost: {stats.createCost} spirit stones`)

	local stat = ClientState.stats
	if stat and stat.realm < stats.requiredRealm then
		table.insert(lines, "YOUR REALM IS TOO SHALLOW")
	end
	previewLabel.Text = table.concat(lines, "\n")
end

local function renderForms()
	clearList(formList)
	for _, formId in Forms.order do
		local form = Forms.get(formId)
		if form == nil or form.category ~= selCategory then
			continue
		end
		local selected = selForm == formId
		local button = UiKit.button(formList, form.name, UDim2.new(1, -8, 0, 30), UDim2.fromOffset(0, 0), function()
			selForm = formId
			renderForms()
			renderPreview()
		end, { color = if selected then UiKit.Colors.gold else UiKit.Colors.panelLight, textColor = if selected then UiKit.Colors.panel else UiKit.Colors.text })
		button.LayoutOrder = 1
	end
end

local function renderElements()
	clearList(elementList)
	local stats = ClientState.stats
	local path = if stats then stats.path else nil
	local race = if stats then stats.race else "fanren"
	for _, elementId in Elements.order do
		local element = Elements.get(elementId)
		if element == nil then
			continue
		end
		local allowed = StatCalc.elementAllowed(element.path, path, race, elementId)
		local selected = selElement == elementId
		local text = element.name .. (if allowed then "" else " (locked)")
		local button = UiKit.button(elementList, text, UDim2.new(1, -8, 0, 26), UDim2.fromOffset(0, 0), function()
			if allowed then
				selElement = elementId
				renderElements()
				renderPreview()
			end
		end, {
			color = if selected then UiKit.Colors.gold else UiKit.Colors.panelLight,
			textColor = if not allowed then UiKit.Colors.textDim elseif selected then UiKit.Colors.panel else element.color,
			textSize = 13,
		})
		button.LayoutOrder = 1
	end
end

local function renderMine()
	clearList(myList)
	local techniques = ClientState.techniques
	if techniques == nil then
		return
	end
	-- Which technique sits in which slot, for display.
	local slotOf: { [string]: number } = {}
	for slotKey, techniqueId in techniques.slots do
		slotOf[techniqueId] = tonumber(slotKey) or 0
	end
	for index, technique in techniques.techniques do
		local element = Elements.get(technique.element)
		local row = UiKit.frame(myList, UDim2.new(1, -8, 0, 54), UDim2.fromOffset(0, 0), UiKit.Colors.panelLight)
		row.LayoutOrder = index
		local slotText = if slotOf[technique.id] then ` [{slotOf[technique.id]}]` else ""
		UiKit.label(row, technique.name .. slotText, UDim2.new(1, -34, 0, 18), UDim2.fromOffset(6, 3), {
			textSize = 13,
			color = if element then element.color else UiKit.Colors.text,
			bold = true,
		})
		local form = Forms.get(technique.form)
		UiKit.label(row, `{if form then form.name else technique.form} · {if element then element.name else "?"} · power {technique.power}`, UDim2.new(1, -34, 0, 14), UDim2.fromOffset(6, 20), {
			textSize = 11,
			color = UiKit.Colors.textDim,
		})
		for slot = 1, Config.SLOT_COUNT do
			UiKit.button(row, tostring(slot), UDim2.fromOffset(20, 16), UDim2.fromOffset(6 + (slot - 1) * 23, 35), function()
				task.spawn(function()
					Net.remoteFunction("EquipTechnique"):InvokeServer({ slot = slot, id = technique.id })
				end)
			end, { textSize = 11 })
		end
		UiKit.button(row, "X", UDim2.fromOffset(24, 24), UDim2.new(1, -30, 0, 4), function()
			task.spawn(function()
				Net.remoteFunction("DeleteTechnique"):InvokeServer({ id = technique.id })
			end)
		end, { color = UiKit.Colors.danger, textSize = 12 })
	end
end

function TechniqueForgeController.Init()
	window = UiKit.window("TechniqueForge", "Technique Forge", UDim2.fromOffset(760, 540), 40)
	local body = window.body

	-- Column 1: category + forms
	UiKit.label(body, "FORM", UDim2.fromOffset(200, 16), UDim2.fromOffset(0, 0), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	for index, category in CATEGORIES do
		UiKit.button(body, category:upper(), UDim2.fromOffset(102, 26), UDim2.fromOffset(((index - 1) % 2) * 106, 20 + math.floor((index - 1) / 2) * 30), function()
			selCategory = category
			selForm = nil
			renderForms()
			renderPreview()
		end, { textSize = 12 })
	end
	formList = (UiKit.scroll(body, UDim2.fromOffset(212, 380), UDim2.fromOffset(0, 86)))

	-- Column 2: element, power, name, preview, create
	UiKit.label(body, "ELEMENT", UDim2.fromOffset(200, 16), UDim2.fromOffset(224, 0), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	elementList = (UiKit.scroll(body, UDim2.fromOffset(230, 250), UDim2.fromOffset(224, 20)))

	UiKit.label(body, "POWER", UDim2.fromOffset(100, 16), UDim2.fromOffset(224, 280), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	powerLabel = UiKit.label(body, "0", UDim2.fromOffset(40, 28), UDim2.fromOffset(302, 298), { textSize = 18, bold = true, xalign = Enum.TextXAlignment.Center })
	UiKit.button(body, "-", UDim2.fromOffset(32, 28), UDim2.fromOffset(224, 298), function()
		power = math.max(0, power - 1)
		powerLabel.Text = tostring(power)
		renderPreview()
	end)
	UiKit.button(body, "+", UDim2.fromOffset(32, 28), UDim2.fromOffset(260, 298), function()
		power = math.min(Config.MAX_POWER, power + 1)
		powerLabel.Text = tostring(power)
		renderPreview()
	end)

	nameBox = UiKit.textBox(body, "Name your technique...", UDim2.fromOffset(230, 30), UDim2.fromOffset(224, 334))

	UiKit.button(body, "CREATE TECHNIQUE", UDim2.fromOffset(230, 38), UDim2.fromOffset(224, 372), function()
		local form = selForm
		if form == nil then
			return
		end
		local name = nameBox.Text
		if #name == 0 then
			name = "Nameless Art"
		end
		task.spawn(function()
			local result = Net.remoteFunction("CreateTechnique"):InvokeServer({
				form = form,
				element = selElement,
				power = power,
				name = name,
			})
			if typeof(result) == "table" and result.ok then
				nameBox.Text = ""
			end
		end)
	end, { color = UiKit.Colors.gold, textColor = UiKit.Colors.panel, textSize = 15 })

	previewLabel = UiKit.label(body, "", UDim2.fromOffset(230, 120), UDim2.fromOffset(224, 416), {
		textSize = 12,
		color = UiKit.Colors.textDim,
		wrap = true,
	})
	previewLabel.TextYAlignment = Enum.TextYAlignment.Top

	-- Column 3: my techniques
	UiKit.label(body, `MY TECHNIQUES (max {Config.MAX_TECHNIQUES})`, UDim2.fromOffset(260, 16), UDim2.fromOffset(468, 0), { textSize = 12, color = UiKit.Colors.gold, bold = true })
	myList = (UiKit.scroll(body, UDim2.fromOffset(268, 446), UDim2.fromOffset(468, 20)))

	renderForms()
	renderElements()
	renderPreview()
	renderMine()

	ClientState.TechniquesChanged:Connect(renderMine)
	ClientState.StatsChanged:Connect(function()
		renderElements()
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.T then
			window.toggle()
		end
	end)
end

return TechniqueForgeController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="51">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">ClientSettings</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > ClientSettings
-- Player-local settings, owned by the menu's Settings panel and read by the
-- controllers (VFX rendering, hint labels). Purely cosmetic and client-side;
-- nothing here touches the server.

local settings = {
	vfxEnabled = true,
	showHints = true,
	othersVfx = true, -- render other players' technique effects
}

local changedEvent = Instance.new("BindableEvent")

local ClientSettings = {}

ClientSettings.Changed = changedEvent.Event

function ClientSettings.get(key: string): boolean
	return (settings :: { [string]: boolean })[key] == true
end

function ClientSettings.set(key: string, value: boolean)
	local map = settings :: { [string]: boolean }
	if map[key] == nil or map[key] == value then
		return
	end
	map[key] = value
	changedEvent:Fire(key, value)
end

return ClientSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > ClientState
-- The client's cache of everything the server pushes, plus change signals.
-- Controllers read from here and re-render on the signals instead of each
-- binding its own remotes, so one server push updates every panel at once.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

export type Stats = {
	qi: number,
	maxQi: number,
	realm: number,
	realmName: string,
	cultivationXp: number,
	breakthroughXp: number,
	path: string?,
	race: string,
	spiritStones: number,
	meditating: boolean,
	equippedTalents: { string },
}

export type Inventory = {
	ores: { [string]: number },
	items: { [string]: number },
	equippedWeapon: string?,
	equippedArmor: string?,
	spiritStones: number,
}

export type Techniques = {
	techniques: { { id: string, name: string, form: string, element: string, power: number } },
	slots: { [string]: string },
}

export type Destiny = {
	race: string,
	ownedRaces: { [string]: number },
	equippedTalents: { string },
	ownedTalents: { [string]: number },
	raceSpins: number,
	talentSpins: number,
}

local ClientState = {
	stats = nil :: Stats?,
	inventory = nil :: Inventory?,
	techniques = nil :: Techniques?,
	destiny = nil :: Destiny?,
}

local statsEvent = Instance.new("BindableEvent")
local inventoryEvent = Instance.new("BindableEvent")
local techniquesEvent = Instance.new("BindableEvent")
local destinyEvent = Instance.new("BindableEvent")
local cooldownEvent = Instance.new("BindableEvent")

ClientState.StatsChanged = statsEvent.Event
ClientState.InventoryChanged = inventoryEvent.Event
ClientState.TechniquesChanged = techniquesEvent.Event
ClientState.DestinyChanged = destinyEvent.Event
-- Fired by TechniqueController when a cast starts a local cooldown:
-- (slot: number, duration: number)
ClientState.CooldownStarted = cooldownEvent.Event

function ClientState.FireCooldown(slot: number, duration: number)
	cooldownEvent:Fire(slot, duration)
end

Net.remoteEvent("StatsChanged").OnClientEvent:Connect(function(payload)
	ClientState.stats = payload
	statsEvent:Fire(payload)
end)

Net.remoteEvent("InventoryChanged").OnClientEvent:Connect(function(payload)
	ClientState.inventory = payload
	inventoryEvent:Fire(payload)
end)

Net.remoteEvent("TechniquesChanged").OnClientEvent:Connect(function(payload)
	ClientState.techniques = payload
	techniquesEvent:Fire(payload)
end)

Net.remoteEvent("DestinyChanged").OnClientEvent:Connect(function(payload)
	ClientState.destiny = payload
	destinyEvent:Fire(payload)
end)

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">UiKit</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer > StarterPlayerScripts > Client > Modules > UiKit
-- Small UI construction kit shared by every controller. One theme: black
-- ink on paper, the look of a Chinese manhwa page. Panels are paper,
-- chrome is ink, and color appears only where it carries meaning
-- (elements, rarities, danger).

local Players = game:GetService("Players")

local UiKit = {}

UiKit.Colors = {
	ink = Color3.fromRGB(27, 24, 21), -- the black: text, borders, fills
	panel = Color3.fromRGB(246, 243, 233), -- paper: windows, panels
	panelLight = Color3.fromRGB(255, 255, 253), -- raised paper: buttons
	inset = Color3.fromRGB(234, 228, 212), -- recessed paper: lists, inputs
	stroke = Color3.fromRGB(27, 24, 21),
	gold = Color3.fromRGB(27, 24, 21), -- accent = ink in the manhwa theme
	text = Color3.fromRGB(27, 24, 21),
	textDim = Color3.fromRGB(88, 82, 72),
	qi = Color3.fromRGB(35, 32, 28), -- bar fills stay monochrome
	xp = Color3.fromRGB(107, 101, 90),
	health = Color3.fromRGB(68, 64, 58),
	danger = Color3.fromRGB(163, 46, 36), -- the one color: seal red
}

UiKit.RarityColors = {
	common = Color3.fromRGB(120, 114, 104),
	uncommon = Color3.fromRGB(70, 130, 90),
	rare = Color3.fromRGB(60, 100, 160),
	epic = Color3.fromRGB(120, 70, 160),
	legendary = Color3.fromRGB(180, 110, 30),
	mythic = Color3.fromRGB(163, 46, 36),
}

local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.Gotham

function UiKit.screen(name: string, displayOrder: number): ScreenGui
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = name
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = displayOrder
	screen.Parent = playerGui
	return screen
end

local function rounded(instance: GuiObject, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 4)
	corner.Parent = instance
end

local function stroked(instance: GuiObject, color: Color3?, thickness: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or UiKit.Colors.stroke
	stroke.Thickness = thickness or 1.6
	stroke.Transparency = 0
	stroke.Parent = instance
end

function UiKit.frame(parent: Instance, size: UDim2, position: UDim2, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = color or UiKit.Colors.panel
	frame.BorderSizePixel = 0
	frame.Parent = parent
	rounded(frame)
	return frame
end

export type LabelOptions = { textSize: number?, color: Color3?, bold: boolean?, xalign: Enum.TextXAlignment?, title: boolean?, wrap: boolean? }

function UiKit.label(parent: Instance, text: string, size: UDim2, position: UDim2, options: LabelOptions?): TextLabel
	local opts: LabelOptions = options or ({} :: LabelOptions)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextSize = opts.textSize or 14
	label.TextColor3 = opts.color or UiKit.Colors.text
	label.Font = if opts.title then TITLE_FONT elseif opts.bold then Enum.Font.GothamBold else BODY_FONT
	label.TextXAlignment = opts.xalign or Enum.TextXAlignment.Left
	label.TextWrapped = opts.wrap == true
	label.TextTruncate = if opts.wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	label.Parent = parent
	return label
end

export type ButtonOptions = { color: Color3?, textColor: Color3?, textSize: number? }

function UiKit.button(parent: Instance, text: string, size: UDim2, position: UDim2, callback: () -> (), options: ButtonOptions?): TextButton
	local opts: ButtonOptions = options or ({} :: ButtonOptions)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = opts.color or UiKit.Colors.panelLight
	button.BorderSizePixel = 0
	button.Text = text
	button.TextSize = opts.textSize or 14
	button.TextColor3 = opts.textColor or UiKit.Colors.text
	button.Font = Enum.Font.GothamBold
	button.AutoButtonColor = true
	button.Parent = parent
	rounded(button)
	stroked(button)
	button.Activated:Connect(callback)
	return button
end

function UiKit.textBox(parent: Instance, placeholder: string, size: UDim2, position: UDim2): TextBox
	local box = Instance.new("TextBox")
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = UiKit.Colors.panelLight
	box.BorderSizePixel = 0
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = UiKit.Colors.textDim
	box.Text = ""
	box.TextSize = 14
	box.TextColor3 = UiKit.Colors.text
	box.Font = BODY_FONT
	box.ClearTextOnFocus = false
	box.Parent = parent
	rounded(box, 4)
	stroked(box)
	return box
end

function UiKit.scroll(parent: Instance, size: UDim2, position: UDim2): (ScrollingFrame, UIListLayout)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = size
	scroll.Position = position
	scroll.BackgroundColor3 = UiKit.Colors.inset
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = UiKit.Colors.ink
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = parent
	rounded(scroll, 4)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = scroll
	return scroll, layout
end

export type Bar = { frame: Frame, fill: Frame, label: TextLabel, set: (fraction: number, text: string) -> () }

function UiKit.bar(parent: Instance, size: UDim2, position: UDim2, fillColor: Color3): Bar
	local frame = UiKit.frame(parent, size, position, UiKit.Colors.inset)
	stroked(frame)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = fillColor
	fill.BorderSizePixel = 0
	fill.Parent = frame
	rounded(fill)
	-- Outlined text stays legible over both the ink fill and the paper gap.
	local label = UiKit.label(frame, "", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), {
		textSize = 12,
		xalign = Enum.TextXAlignment.Center,
		bold = true,
		color = UiKit.Colors.panel,
	})
	label.TextStrokeColor3 = UiKit.Colors.ink
	label.TextStrokeTransparency = 0
	label.ZIndex = 3
	local bar: Bar
	bar = {
		frame = frame,
		fill = fill,
		label = label,
		set = function(fraction: number, text: string)
			fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
			label.Text = text
		end,
	}
	return bar
end

-- A centered window: paper body, ink title bar, brush-serif title.
export type Window = { screen: ScreenGui, root: Frame, body: Frame, setVisible: (visible: boolean) -> (), toggle: () -> (), visible: () -> boolean }

function UiKit.window(name: string, title: string, size: UDim2, displayOrder: number): Window
	local screen = UiKit.screen(name, displayOrder)
	screen.Enabled = false

	local root = UiKit.frame(screen, size, UDim2.new(0.5, 0, 0.5, 0))
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	stroked(root, UiKit.Colors.ink, 2)

	local titleBar = UiKit.frame(root, UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 0), UiKit.Colors.ink)
	UiKit.label(titleBar, title, UDim2.new(1, -50, 1, 0), UDim2.fromOffset(12, 0), {
		textSize = 21,
		color = UiKit.Colors.panel,
		title = true,
	})

	local window: Window
	local function setVisible(visible: boolean)
		screen.Enabled = visible
	end
	UiKit.button(titleBar, "X", UDim2.fromOffset(26, 26), UDim2.new(1, -30, 0, 4), function()
		setVisible(false)
	end, { color = UiKit.Colors.ink, textColor = UiKit.Colors.panel })

	local body = Instance.new("Frame")
	body.Size = UDim2.new(1, -16, 1, -46)
	body.Position = UDim2.fromOffset(8, 38)
	body.BackgroundTransparency = 1
	body.Parent = root

	window = {
		screen = screen,
		root = root,
		body = body,
		setVisible = setVisible,
		toggle = function()
			setVisible(not screen.Enabled)
		end,
		visible = function()
			return screen.Enabled
		end,
	}
	return window
end

function UiKit.rarityColor(rarity: string): Color3
	return (UiKit.RarityColors :: { [string]: Color3 })[rarity] or UiKit.Colors.text
end

return UiKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="55">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
