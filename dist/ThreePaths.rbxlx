r("dilong", "Earth Dragon", "地龙", "rare", "vitality", "earth",
	"It keeps the underground rivers. Mines flood or hold at its pleasure.")
r("chilong", "Hornless Dragon", "螭龙", "rare", "swiftness", nil,
